# iberiaworkforce.com -> 127.0.0.1:5083 (systemd: iberiaworkforce.service)
#
# 2026-07-31 cutover: this used to serve a static build out of
# /var/www/astro-sites/iberiaworkforce and proxy only /api/lead/* to :5075.
# That left /api/contact and /api/health with no public route. It is now a full
# reverse proxy to the Node app, which serves pages, dist/client assets and all
# /api/* routes from the current monorepo build.
#
# See _README.md in this directory for why the scheme prefixes and `tls internal`
# are required behind Cloudflare.

http://iberiaworkforce.com, http://www.iberiaworkforce.com,
https://iberiaworkforce.com, https://www.iberiaworkforce.com {
	tls internal
	encode zstd gzip

	reverse_proxy 127.0.0.1:5083

	@static path_regexp static \.(css|js|woff|woff2|webp|jpg|jpeg|png|gif|svg|ico|avif|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /var/log/caddy/iberiaworkforce.com-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
