# Connect Group Astro fleet — pnpm settings
# Each site keeps its own package.json + node_modules (symlinks into the store).
# Do NOT shamefully-hoist into one shared node_modules for all domains.

# Shared content-addressed store inside the repo (gitignored)
store-dir=.pnpm-store

# One lockfile at repo root
shared-workspace-lockfile=true

# Prefer isolated linkers (default) — not a single hoisted tree
shamefully-hoist=false

# Faster installs on CI/local when lockfile is present
prefer-frozen-lockfile=false

engine-strict=false
