# Excluded folders
WP-sites-backup/
astro-old-sites-old/
Exported-wp/
.vscode
Lana staging

# Dependencies
node_modules/
.pnpm-store/

# Build output (Astro site / package roots only).
# Do NOT use a bare `dist/` rule — mirrored WP assets live under
# `public/**/dist/` (e.g. theme CSS, wp-includes js) and must stay trackable.
Astro-production/*/dist/
packages/*/dist/
.astro/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables — production secrets (Pipedrive tokens, SMTP passwords,
# dashboard keys). Each site also has its own .gitignore with these rules; this
# repo-wide net means a NEW site added without one is still protected by default.
# Catch every .env variant (.env.prod, .env.staging, .env.local...) and then
# re-allow the committed, secret-free templates.
.env
.env.*
!.env.example
!.env.*.example
# Also catch oddly named env files (e.g. PEO.env, freelancerdxb.env)
Astro-production/**/*.env
!Astro-production/**/*.env.example

# Private key and Caddy runtime storage — never version credentials or a live
# certificate-authority namespace. Public certificate examples should use a
# `.crt.example`/`.pem.example` suffix; real private keys belong outside Git.
**/*.key
**/var-lib-caddy/.local/share/caddy/
**/.local/share/caddy/pki/authorities/
**/.local/share/caddy/certificates/

# OS files
.DS_Store

# Editor
.idea/
*.code-workspace

# Claude Code local settings
.claude/settings.local.json

# Pre-fix build backups (local safety copies, not source)
.dist-backup-*

# Suffixed snapshots taken before migrations — the bare `node_modules/` and
# `dist/` rules above do NOT catch these, and a single commit of them once put
# 1.3 GB of deps, build output and pnpm store into the repo.
node_modules.*/
dist.pre-*/
dist.prev-*/

# Local fleet runtime (pids / logs — not source)
local/pids/
local/logs/

# Scratch WP crawl / parity dumps (use per-site `_crawl/` which sites already gitignore)
_crawl/

# Quarantined bad media dumps (HTML masquerading as images/CSS) — never deploy
Astro-production/**/_quarantine-html-masquerade/

# Per-site runtime data / env (never commit)
Astro-production/**/.data/
Astro-production/**/.env

# H-08: this application is live and must have a reviewable Git baseline even
# on hosts whose local .git/info/exclude predates the import. Keep runtime and
# generated files excluded explicitly after re-including its source tree.
!Astro-production/connectresourcesint.com/
!Astro-production/connectresourcesint.com/**
Astro-production/connectresourcesint.com/.astro/
Astro-production/connectresourcesint.com/.data/
Astro-production/connectresourcesint.com/.env
Astro-production/connectresourcesint.com/.env.*
!Astro-production/connectresourcesint.com/.env.example
Astro-production/connectresourcesint.com/dist/
Astro-production/connectresourcesint.com/dist.*/
Astro-production/connectresourcesint.com/node_modules/
Astro-production/connectresourcesint.com/node_modules.*/
Astro-production/connectresourcesint.com/package-lock.json

# Local audit / handoff PDFs at repo root (keep findings in docs/)
/*.pdf

# Local-only tooling / audit scratch (node tarballs, audit dumps) — never commit
.local/

# Cursor IDE local project settings (rules may also live in ~/.cursor/rules)
.cursor/
