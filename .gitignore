# Excluded folders
WP-sites-backup/
astro-old-sites-old/
Exported-wp/
.vscode
Lana staging

# Dependencies
node_modules/
.pnpm-store/

# Build output (Astro site / package roots only).
# Do NOT use a bare `dist/` rule — mirrored WP assets live under
# `public/**/dist/` (e.g. theme CSS, wp-includes js) and must stay trackable.
Astro-production/*/dist/
packages/*/dist/
.astro/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables — production secrets (Pipedrive tokens, SMTP passwords,
# dashboard keys). Each site also has its own .gitignore with these rules; this
# repo-wide net means a NEW site added without one is still protected by default.
# Catch every .env variant (.env.prod, .env.staging, .env.local...) and then
# re-allow the committed, secret-free templates.
.env
.env.*
!.env.example
!.env.*.example

# OS files
.DS_Store

# Editor
.idea/

# Claude Code local settings
.claude/settings.local.json

# Pre-fix build backups (local safety copies, not source)
.dist-backup-*

# Suffixed snapshots taken before migrations — the bare `node_modules/` and
# `dist/` rules above do NOT catch these, and a single commit of them once put
# 1.3 GB of deps, build output and pnpm store into the repo.
node_modules.*/
dist.pre-*/
dist.prev-*/

# Local fleet runtime (pids / logs — not source)
local/pids/
local/logs/

# Per-site runtime data / env (never commit)
Astro-production/**/.data/
Astro-production/**/.env
