---
import { resolveSeo, organizationSchema, type SeoInput } from "../lib/seo";
import { site, type SeoData } from "../lib/content";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
}

const { seo = {}, fallback, extraCss = [] } = Astro.props;
const meta = resolveSeo(seo, fallback);

const schemas = [organizationSchema(), ...meta.schemas];
const ICON_BASE = '/icons/mbs';
const ICON_V = '3';
/** Inline first so Chrome picks it over cached /favicon.ico on localhost. */
const FAVICON_INLINE =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="4" fill="#1a1a1a"/><circle cx="16" cy="16" r="11" fill="none" stroke="#ffa300" stroke-width="2"/><ellipse cx="16" cy="16" rx="4.5" ry="11" fill="none" stroke="#ffa300" stroke-width="1.5"/><path d="M5 16h22" fill="none" stroke="#ffa300" stroke-width="1.25"/><path d="M6.5 11.5h19M6.5 20.5h19" fill="none" stroke="#ffa300" stroke-width="1"/></svg>',
  );
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href={FAVICON_INLINE} type="image/svg+xml" />
<link rel="icon" href={`${ICON_BASE}/favicon.svg?v=${ICON_V}`} type="image/svg+xml" />
<link rel="icon" type="image/png" href={`${ICON_BASE}/favicon-32x32.png?v=${ICON_V}`} sizes="32x32" />
<link rel="icon" type="image/png" href={`${ICON_BASE}/favicon-16x16.png?v=${ICON_V}`} sizes="16x16" />
<link rel="icon" href={`${ICON_BASE}/favicon.ico?v=${ICON_V}`} sizes="any" />
<link rel="apple-touch-icon" href={`${ICON_BASE}/apple-touch-icon.png?v=${ICON_V}`} />
<link rel="shortcut icon" href={`${ICON_BASE}/favicon.ico?v=${ICON_V}`} />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<meta name="robots" content={meta.robots} />
<link rel="canonical" href={meta.canonical} />

<meta property="og:locale" content="en_US" />
<meta property="og:type" content={meta.ogType} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:site_name" content={meta.siteName} />
<meta property="og:image" content={meta.ogImage} />
<meta property="og:image:secure_url" content={meta.ogImage} />
<meta property="og:image:alt" content={meta.title} />

{meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}
{meta.modifiedTime && <meta property="article:modified_time" content={meta.modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.ogImage} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;400;500;600;700&family=Mukta:wght@400;600;700&family=Poppins:wght@300;400;500;600;700;800&family=Spline+Sans:wght@300;400;500;600;700&display=swap"
/>

{
  extraCss.map((href) => (
    <link rel="stylesheet" href={href} />
  ))
}

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
