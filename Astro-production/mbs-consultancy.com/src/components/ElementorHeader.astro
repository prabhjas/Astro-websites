---
import headerHtml from "../data/header.html?raw";

interface Props {
  currentPath?: string;
  /** Force a nav href active (e.g. "/blog/" for single posts) */
  menuActivePath?: string;
}

const { currentPath = "/", menuActivePath } = Astro.props;

function normalize(path: string) {
  if (!path || path === "/") return "/";
  return path.endsWith("/") ? path : `${path}/`;
}

const path = normalize(menuActivePath || currentPath);

function pickActiveHref(current: string, hrefs: string[]) {
  const matches = hrefs
    .map(normalize)
    .filter((h) => {
      if (h === "/") return current === "/";
      return current === h || current.startsWith(h);
    })
    .sort((a, b) => b.length - a.length);
  return matches[0] || "";
}

function withActiveState(html: string, current: string) {
  // Remove snapshot active classes (often hard-coded to Home)
  let out = html
    .replace(/\s*elementor-item-active/g, "")
    .replace(/\s*current-menu-item/g, "")
    .replace(/\s*current_page_item/g, "")
    .replace(/\s*current-menu-ancestor/g, "")
    .replace(/\s*current-menu-parent/g, "")
    .replace(/\s*aria-current="page"/g, "");

  const allHrefs = [...out.matchAll(/\bhref="(\/[^"#]*)"/g)].map((m) => m[1]);
  const activeDeep = pickActiveHref(current, allHrefs);
  if (!activeDeep) return out;

  // Top-level Impreza items
  let activeTop = activeDeep;
  const topHrefs = ["/", "/services/", "/industries/", "/insights/", "/about-us/", "/contact-us/", "/blog/"];
  if (!topHrefs.includes(normalize(activeDeep))) {
    // Map common service/industry children to parent top items via menu structure
    const liBlocks = out.split(/<\/li>/i);
    for (const block of liBlocks) {
      if (!block.includes(`href="${activeDeep}"`) && !block.includes(`href="${normalize(activeDeep)}"`)) {
        continue;
      }
      const top = block.match(/href="(\/[^"#]*)"[^>]*class="[^"]*w-nav-anchor level_1|class="[^"]*w-nav-anchor level_1[^"]*"[^>]*href="(\/[^"#]*)"/i);
      if (top) {
        activeTop = top[1] || top[2];
        break;
      }
      // First level_1 anchor in this branch
      const first = block.match(/w-nav-anchor level_1[^>]*href="(\/[^"#]*)"|href="(\/[^"#]*)"[^>]*w-nav-anchor level_1/i);
      if (first) {
        activeTop = first[1] || first[2];
        break;
      }
    }
    if (/^\/(audit|immigration|family-business|consulting|crisis|legal|people|strategy|visa|bank-account|accounting|hr-|it-|investment|business-setup|digital-strategy|business-growth|performance|corporate|organization|pro-services)/.test(activeDeep)) {
      activeTop = "/services/";
    } else if (/^\/(automotive|consumer|energy|engineering|financial|government|healthcare|hospitality)/.test(activeDeep)) {
      activeTop = "/industries/";
    }
  }

  const markTop = normalize(activeTop);
  const markDeep = normalize(activeDeep);

  // Mark anchors
  out = out.replace(/<a\s+([^>]*?)>/gi, (full, attrs: string) => {
    const hrefMatch = attrs.match(/\bhref="([^"]+)"/i);
    if (!hrefMatch) return full;
    const h = normalize(hrefMatch[1]);
    const isTop = h === markTop;
    const isDeep = h === markDeep;
    if (!isTop && !isDeep) return full;

    let next = attrs;
    if (!/\baria-current=/i.test(next) && (isTop || isDeep)) next += ` aria-current="page"`;
    return `<a ${next}>`;
  });

  // Mark Impreza <li class="menu-item ...">
  out = out.replace(/<li\b([^>]*class=")([^"]*)(")/gi, (full, pre, cls, post) => {
    const sliceStart = out.indexOf(full);
    // crude: if this li's immediate anchor matches markTop/markDeep
    const after = out.slice(sliceStart, sliceStart + 500);
    const href = after.match(/\bhref="([^"]+)"/);
    if (!href) return full;
    const h = normalize(href[1]);
    let c = cls.replace(/\s+/g, " ").trim();
    if (h === markDeep || h === markTop) {
      if (!/\bcurrent-menu-item\b/.test(c)) c += " current-menu-item";
      if (!/\bcurrent_page_item\b/.test(c)) c += " current_page_item";
    } else if (markDeep.startsWith(h) && h !== "/") {
      if (!/\bcurrent-menu-ancestor\b/.test(c)) c += " current-menu-ancestor";
    }
    return `<li${pre}${c}${post}`;
  });

  return out;
}

const html = withActiveState(headerHtml, path);
---

{/* Impreza header HTML already includes <header id="page-header"> */}
<div class="mbs-site-header" data-mbs-site-header set:html={html} />
