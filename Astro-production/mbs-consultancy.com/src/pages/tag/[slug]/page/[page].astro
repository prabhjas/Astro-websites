---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostCard from "../../../../components/PostCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import {
  getTagBySlug,
  getPostsByTag,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
} from "../../../../lib/content";
import { breadcrumbSchema } from "../../../../lib/seo";
import { notFoundResponse } from "../../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const pageNum = Number(Astro.params.page || "1");
const tag = getTagBySlug(slug);
if (!tag || !Number.isFinite(pageNum) || pageNum < 2) {
  return notFoundResponse();
}
const sorted = getPostsByTag(tag.id);
const totalPages = Math.max(1, Math.ceil(sorted.length / POSTS_PER_PAGE));
if (pageNum > totalPages) {
  return notFoundResponse();
}
const { items, page, totalPages: tp } = paginate(sorted, pageNum, POSTS_PER_PAGE);
const canonical = `${tag.path}page/${page}/`;
---

<BaseLayout
  currentPath={tag.path}
  seo={{
    title: `Tag: ${stripHtml(tag.name)} — Page ${page} | MBS Consultancy`,
    description: tag.description || `Posts tagged ${tag.name}.`,
    canonical,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog/" },
        { name: tag.name, url: tag.path },
        { name: `Page ${page}`, url: canonical },
      ]),
    ],
  }}
>
  <section class="sp-archive-hero">
    <div class="sp-container">
      <Breadcrumbs
        items={[
          { name: "Home", href: "/" },
          { name: "Blog", href: "/blog/" },
          { name: tag.name, href: tag.path },
          { name: `Page ${page}` },
        ]}
      />
      <h1 set:html={tag.name} />
      <p>Page {page} of {tp}</p>
    </div>
  </section>
  <section class="sp-container" style="padding: 1rem 0 4rem">
    <div class="sp-blog-grid">
      {items.map((post) => <PostCard post={post} />)}
    </div>
    <Pagination page={page} totalPages={tp} basePath={tag.path} />
  </section>
</BaseLayout>
