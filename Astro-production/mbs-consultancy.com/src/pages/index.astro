---
import { sanitizeMirrorHtml } from "@connect/site-cms";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getPageByPath,
  smartSliderCssForHtml,
  elementorCssForId,
} from "../lib/content";
import { breadcrumbSchema } from "../lib/seo";
import { dedupeFaqSchema } from "../lib/faq-schema";

export const prerender = false;

const page = getPageByPath("/");
if (!page) throw new Error("Home page missing from content data");

// Elementor/exported bodies are trusted mirrors — hygiene only (not sanitizeCmsHtml).
const { html, schemas: dedupedSchemas } = dedupeFaqSchema(
  sanitizeMirrorHtml(page.bodyHtml || page.content),
  page.seo.schemas || [],
);
// MBS Elementor pages: per-page post-{id}.css only (global wp-custom-mbs.css in live-css-order).
const extraCss = [
  ...smartSliderCssForHtml(html),
  ...elementorCssForId(page.id),
  ...((page.pageCss as string[] | undefined) || []).filter(
    (href) => href !== "/css/impreza-global.css",
  ),
];
---

<BaseLayout
  currentPath="/"
  bodyClass={`home page-template-default page page-id-${page.id} wp-theme-Impreza wp-child-theme-Impreza-child l-body header_hor links_underline rounded_none headerinpos_top state_default wpb-js-composer vc_responsive`}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title,
    description: page.seo.description,
    canonical: "/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...dedupedSchemas,
      breadcrumbSchema([{ name: "Home", url: "/" }]),
    ],
  }}
>
  <Fragment set:html={html} />
</BaseLayout>
