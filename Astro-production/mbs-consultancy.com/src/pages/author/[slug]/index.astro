---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Pagination from "../../../components/Pagination.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import {
  getAuthors,
  getPostsByAuthor,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
  normalizePath,
} from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/seo";
import { notFoundResponse } from "../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const author = getAuthors().find((a) => a.slug === slug);
if (!author) {
  return notFoundResponse();
}
const sorted = getPostsByAuthor(author.id);
const { items, page, totalPages } = paginate(sorted, 1, POSTS_PER_PAGE);

function listingDate(date: string) {
  return new Date(date).toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function primaryCat(post: { categories: number[] }) {
  return "Insights";
}

const authorName = stripHtml(author.name);
---

<BaseLayout
  currentPath={author.path}
  menuActivePath="/insights/"
  bodyClass={`archive author author-${author.slug} wp-theme-Impreza wp-child-theme-Impreza-child l-body`}
  seo={{
    title: `Author: ${authorName} | MBS Consultancy`,
    description: author.description || `Articles by ${authorName}.`,
    canonical: author.path,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Author", url: "/author/" },
        { name: authorName, url: author.path },
      ]),
    ],
  }}
  extraCss={["/css/page-design/authors.css"]}
>
  <main id="page-content" class="l-main">
    <section class="author-detail-hero">
      <div class="author-detail-banner">
        <img
          src="/wp-content/uploads/authors/authors-hero-banner.jpg"
          alt=""
          loading="eager"
        />
      </div>
    </section>

    <section class="author-detail-card">
      {author.avatar && (
        <div class="author-detail-card__avatar">
          <img src={author.avatar} alt={authorName} width="252" height="252" />
        </div>
      )}
      <div class="author-detail-card__info">
        <div class="author-detail-card__name-row">
          <h1 class="author-detail-card__name">{authorName}</h1>
          {author.linkedin && (
            <a href={author.linkedin} class="author-detail-card__linkedin" target="_blank" rel="noopener">
              <img src="/wp-content/uploads/authors/linkedin-icon.svg" alt="LinkedIn" />
            </a>
          )}
        </div>
        {author.title && <p class="author-detail-card__title">{author.title}</p>}
        {author.description && <p class="author-detail-card__bio">{author.description}</p>}
      </div>
    </section>

    <h2 class="author-articles-heading">
      <span>Articles By </span><strong>{authorName}</strong>
    </h2>

    <section class="l-section">
      <div class="l-section-h i-cf">
        <div id="blog-list" class="mbs-archive-list">
          {
            items.map((post) => {
              const href = normalizePath(post.path);
              const link = href.endsWith("/") ? href : `${href}/`;
              const excerpt = stripHtml(post.excerpt || "").slice(0, 160);
              return (
                <div class="post">
                  <a href={link}>
                    <div class="articlepostthumbnailurl">
                      {post.featuredImage ? (
                        <img src={post.featuredImage} alt="" loading="lazy" />
                      ) : null}
                      <div class="category_and_date_wrapper">
                        <div class="datewrap">{listingDate(post.date)}</div>
                        <div class="categorywrap">{primaryCat(post)}</div>
                      </div>
                    </div>
                  </a>
                  <div class="innerpost_wrapper">
                    <div class="postlistingwrap">
                      <a href={link}>
                        <h2 set:html={post.title} />
                      </a>
                      <p>{excerpt}{excerpt.length >= 160 ? "…" : ""}</p>
                    </div>
                    <div class="bloglistingfooterwrap">
                      <div class="link">
                        <a href={link}>
                          Read Article
                          <img src="/wp-content/uploads/2023/07/readarticleicon.svg" alt="" />
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
        {!items.length && <p>No posts by this author.</p>}
        <Pagination page={page} totalPages={totalPages} basePath={author.path} />
      </div>
    </section>
  </main>
</BaseLayout>
