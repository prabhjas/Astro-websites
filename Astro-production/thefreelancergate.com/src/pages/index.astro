---
/**
 * Prefer full live HTML mirror (src/legacy/homepage.cleaned.html).
 * Fallback: JSON body render if mirror missing.
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageByPath } from "../lib/content";
import { breadcrumbSchema } from "../lib/seo";
import { serveLegacyPage } from "../lib/legacy-page";

export const prerender = false;

const mirror = join(process.cwd(), "src/legacy/homepage.cleaned.html");
if (existsSync(mirror)) {
  return serveLegacyPage("homepage");
}

const page = getPageByPath("/");
if (!page) throw new Error("Home page missing from content data");

const html = page.bodyHtml || page.content;
const extraCss = [
  ...(page.pageCss || []),
  page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
];
const bodyClass = `home wp-singular page-template-default page page-id-${page.id} custom-background singular`;
---

<BaseLayout
  currentPath="/"
  bodyClass={bodyClass}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title,
    description: page.seo.description,
    canonical: "/",
    ogImage: page.seo.ogImage,
    robots: typeof page.seo.robots === "string" ? page.seo.robots : undefined,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema([{ name: "Home", url: "/" }]),
    ],
  }}
>
  <div class="sp-page-content" set:html={html} />
</BaseLayout>
