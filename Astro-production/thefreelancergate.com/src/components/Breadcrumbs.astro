---
interface Props {
  items: { name: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="sp-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, i) => (
        <>
          {i > 0 ? (
            <li class="sp-breadcrumbs__sep" aria-hidden="true">
              /
            </li>
          ) : null}
          <li class="sp-breadcrumbs__item">
            {item.href && i < items.length - 1 ? (
              <a href={item.href}>{item.name}</a>
            ) : (
              <span aria-current="page">{item.name}</span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    line-height: 1;
  }

  .sp-breadcrumbs__item,
  .sp-breadcrumbs__sep {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0;
    line-height: 1;
  }

  .sp-breadcrumbs__sep {
    opacity: 0.5;
  }

  a,
  span {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0;
    line-height: 1;
  }
</style>
