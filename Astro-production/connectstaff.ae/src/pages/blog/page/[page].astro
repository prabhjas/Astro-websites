---
/**
 * Blog pagination URLs are legacy WordPress paths. The Insights index uses
 * load-more on /blog/ — redirect paginated URLs to avoid a duplicate template.
 */
export const prerender = false;

const page = Number(Astro.params.page || '1');
if (!Number.isFinite(page) || page < 2) {
  return Astro.redirect('/blog/');
}

return Astro.redirect('/blog/', 301);
---
