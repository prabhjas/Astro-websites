
# Local test URL (fleet-local): http://127.0.0.1:5091  — keep PUBLIC_SITE_URL as https canonical
PUBLIC_SITE_URL=https://connectstaff.ae

# Optional analytics (runtime-gtm.js). Comma/space/semicolon separated lists OK.
PUBLIC_GTM_ID=GTM-T26F4HG2
PUBLIC_GA4_ID=


# --- Lead storage (file-backed source of truth) ---
LEAD_STORE_DIR=.data/leads
LEAD_STORE_MAX_FILE_BYTES=10485760
PIPEDRIVE_MAX_RETRY_ATTEMPTS=5
PIPEDRIVE_REQUEST_TIMEOUT_MS=10000

# --- Pipedrive (required for POST /api/contact) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=connectgroup2
# Alias supported: PIPEDRIVE_API_URL=
PIPEDRIVE_OWNER_ID=13601147
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_LEAD_SOURCE_ID=270
PIPEDRIVE_PERSON_LABEL_IDS=5
PIPEDRIVE_PERSON_VISIBLE_TO=3

# --- Website / form identity ---
WEBSITE_ID=162
WEBSITE_NAME=Connect Staff
FORM_SOURCE=270
FORM_NAME=Connect Staff Contact Form
LEAD_TITLE_PREFIX=Connect Staff

LOG_LEVEL=info

# --- Internal machine API (central CMS / cron) ---
# Per-site dashboard UI removed. Auth:
#   Authorization: Bearer <INTERNAL_JOB_SECRET>
# Also accepts: x-internal-job-secret header or ?secret= (cron).
# One secret per site — never reuse across domains.
INTERNAL_JOB_SECRET=
INTERNAL_ADMIN_DIR=.data/internal-admin
INTERNAL_ENHANCED_LIVE_DIR=.data/enhanced-live
INTERNAL_UPLOAD_DIR=.data/internal-uploads
INTERNAL_UPLOAD_MAX_FILE_BYTES=10485760


FLEET_LOCAL_URL=http://127.0.0.1:5091

# Do NOT set HOST or PORT here — systemd / fleet-local sets them (connectstaff = 5091).
# Use LF line endings only.
# Do NOT rely on FORM_NOTIFICATION_* / SMTP_* for lead notify — Pipedrive + file store.
