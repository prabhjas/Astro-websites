---
/**
 * Author archive pagination — always assembled from live JSON posts.
 */
import { getAuthorPageData, serveAuthorArchive } from '../../../../lib/authors.ts';
import { notFoundResponse } from '../../../../lib/not-found.js';

export const prerender = false;

const slug = Astro.params.slug!;
const page = Number(Astro.params.page || '1');
if (!Number.isFinite(page) || page < 2) {
  return Astro.redirect(`/author/${slug}/`);
}

const data = getAuthorPageData(slug, page);
if (!data || data.totalPages < page) {
  return notFoundResponse();
}
return serveAuthorArchive(data);
---
