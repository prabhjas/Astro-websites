---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { serveAuthorDirectory } from '../../lib/authors.ts';
import { serveLegacyPage } from '../../lib/legacy-page.js';

export const prerender = false;

// Prefer live Impreza/Elementor mirror when prepared.
const mirror = join(process.cwd(), 'src/legacy/author.cleaned.html');
if (existsSync(mirror)) {
  return serveLegacyPage('author');
}

return serveAuthorDirectory();
---
