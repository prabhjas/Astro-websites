---
/**
 * Blog / Insights index — Elementor ECS posts mirror (src/legacy/blog.cleaned.html).
 * "Load more articles" uses /api/blog/load-more/ (Astro), not WP admin-ajax.
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { injectRuntimeGtmLoader } from '../lib/gtm/inject';
import { applySharedChrome, injectLicenceSection } from '../lib/shared-chrome.js';
import { resolveSiteOrigin } from '../lib/seo/site-url';
import { fixBlogArchiveHeadings, applyLegacyMirrorHygiene } from '../lib/mirror-hygiene.js';

export const prerender = false;

/** Initial ECS grid (widget 9a2f334) ships 6 cards; load more appends 6 per click. */
const BLOG_INITIAL = 6;
const BLOG_PER_PAGE = 6;

function absolutizeBlogSeo(html: string): string {
  let origin = 'https://izi.ae';
  try {
    origin = resolveSiteOrigin();
  } catch {
    /* keep default */
  }
  const absolutePage = `${origin}/blog/`;
  let out = html;
  if (/rel=["']canonical["']/i.test(out)) {
    out = out.replace(
      /<link\s+rel=["']canonical["']\s+href=["'][^"']*["']\s*\/?>/i,
      `<link rel="canonical" href="${absolutePage}" />`,
    );
  }
  out = out.replace(
    /<meta\s+[^>]*property=["']og:url["'][^>]*>/gi,
    `<meta property="og:url" content="${absolutePage}" />`,
  );
  out = out.replace(
    /(<meta\s+(?:property|name)=["'](?:og:image|twitter:image)["']\s+content=["'])(\/[^"']+)(["'])/gi,
    `$1${origin}$2$3`,
  );
  return out;
}

function decorateBlogPage(html: string): string {
  let out = html;

  out = out.replace(
    /<script[^>]*id="custom-blog-listing-script-js"[^>]*><\/script>/i,
    '<!-- WP custom-blog-listing removed -->',
  );
  out = out.replace(
    /<script[^>]*src="[^"]*izi-blog-listing\.js[^"]*"[^>]*><\/script>/gi,
    '<!-- izi-blog-listing removed -->',
  );

  // Strip ECS WP admin-ajax — conflicts with Astro /api/blog/load-more.
  out = out.replace(
    /<script[^>]*src="[^"]*ecs_ajax_pagination\.js[^"]*"[^>]*><\/script>/gi,
    '<!-- ecs_ajax_pagination removed (Astro /api/blog/load-more) -->',
  );
  out = out.replace(
    /<script[^>]*>\s*var\s+ecs_ajax_params\s*=[\s\S]*?<\/script>/gi,
    '<!-- ecs_ajax_params removed -->',
  );

  // Wire Astro Load More (replaces javascript:ECS_load_next_page(...)).
  out = out.replace(
    /<nav([^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*)>/i,
    `<nav$1 data-cs-blog-load-more data-next-page="2" data-per-page="${BLOG_PER_PAGE}" data-offset="${BLOG_INITIAL}" data-loading-text="Loading...">`,
  );
  out = out.replace(
    /(<nav[^>]*ecs-load-more-button[\s\S]*?<a[^>]*href=")[^"]*(")/i,
    '$1javascript:void(0)$2',
  );

  if (!out.includes('blog-load-more.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/blog-load-more.js?v=20260810-insights1" defer></script>\n</body>`,
    );
  } else {
    out = out.replace(
      /\/js\/blog-load-more\.js(?:\?[^"']*)?/g,
      '/js/blog-load-more.js?v=20260810-insights1',
    );
  }

  if (!out.includes('astro-mirror-fixes.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/astro-mirror-fixes.js?v=20260810-parity6" defer></script>\n</body>`,
    );
  } else {
    out = out.replace(
      /\/js\/astro-mirror-fixes\.js(?:\?[^"']*)?/g,
      '/js/astro-mirror-fixes.js?v=20260810-parity6',
    );
  }

  if (!out.includes('cf-email-decode.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/cf-email-decode.js" defer></script>\n</body>`,
    );
  }

  if (!out.includes('data-izi-blog-pagination-css')) {
    const css = `<style data-izi-blog-pagination-css="1">
.elementor-pagination.ecs-load-more-button{text-align:center;margin:2rem 0 1rem;}
.elementor-pagination.ecs-load-more-button .elementor-button{
  display:inline-flex;align-items:center;justify-content:center;min-width:180px;padding:12px 28px;
  border-radius:8px;font-weight:600;text-decoration:none;background:#00ADEF;color:#fff!important;border:0;cursor:pointer;
}
.elementor-pagination.ecs-load-more-button .elementor-button:hover{filter:brightness(0.95);}
</style>`;
    out = /<\/head>/i.test(out) ? out.replace(/<\/head>/i, `${css}\n</head>`) : css + out;
  }

  out = fixBlogArchiveHeadings(out);
  return out;
}

const cleanedPath = join(process.cwd(), 'src/legacy/blog.cleaned.html');
if (!existsSync(cleanedPath)) {
  return new Response('Blog page not prepared', { status: 404 });
}

let html = readFileSync(cleanedPath, 'utf8');
html = absolutizeBlogSeo(
  applyLegacyMirrorHygiene(
    decorateBlogPage(injectRuntimeGtmLoader(injectLicenceSection(applySharedChrome(html, 'blog')))),
    'blog',
  ),
);

return new Response(html, {
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    'Cache-Control': 'public, max-age=0',
  },
});
---
