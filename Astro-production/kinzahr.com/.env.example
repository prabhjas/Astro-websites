# On the production host this file is SPLIT:
#   .env       → build-only (PUBLIC_SITE_URL), root:webdev 0644 — no secrets
#   .env.prod  → runtime secrets for systemd (root:site-* 0640) — REQUIRED (no EnvironmentFile=-)
# Local laptop: one gitignored .env with secrets is fine for fleet-local smoke.
#
# Public canonical website origin (no trailing slash required).
# Used by astro.config `site` and Rank Math–style robots/sitemap absolute URLs.
# This is a public origin only — never put secrets in PUBLIC_* variables.
PUBLIC_SITE_URL=https://kinzahr.com

# --- Lead storage (file-backed source of truth) ---
LEAD_STORE_DIR=.data/leads
LEAD_STORE_MAX_FILE_BYTES=10485760
PIPEDRIVE_MAX_RETRY_ATTEMPTS=5
PIPEDRIVE_REQUEST_TIMEOUT_MS=10000

# --- Pipedrive (required for POST /api/contact) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
# Alias supported: PIPEDRIVE_API_URL=
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_LEAD_SOURCE_ID=
PIPEDRIVE_PERSON_LABEL_IDS=
PIPEDRIVE_PERSON_VISIBLE_TO=3

# --- Website / form identity ---
WEBSITE_ID=1
WEBSITE_NAME=KinzaHR
FORM_SOURCE=
FORM_NAME=KinzaHR Contact Form
LEAD_TITLE_PREFIX=KinzaHR

LOG_LEVEL=info

# --- Analytics (interim until FLOW dashboard) ---
# FLOW-saved .data/internal-admin/gtm.json wins when present.
# Use GTM and/or GA4 — both can be set; loader injects via /runtime-gtm.js
PUBLIC_GTM_ID=          # GTM-AAAA or GTM-AAAA,GTM-BBBB
PUBLIC_GA4_ID=          # G-XXXX or G-XXXX,G-YYYY
# Optional full snippets (overrides ID helpers when set):
# GTM_HEAD_SCRIPT=
# GTM_BODY_HTML=
# GTM_FOOTER_SCRIPT=

# --- Internal machine API (central FLOW / CMS / cron) ---
# Per-site dashboard UI removed. Auth:
#   Authorization: Bearer <INTERNAL_JOB_SECRET>
# Also accepts: x-internal-job-secret header. Query ?secret= is rejected (security audit P0-2).
# One secret per site — never reuse across domains.
# Generate: openssl rand -hex 32
INTERNAL_JOB_SECRET=
INTERNAL_ADMIN_DIR=.data/internal-admin
INTERNAL_ENHANCED_LIVE_DIR=.data/enhanced-live
INTERNAL_UPLOAD_DIR=.data/internal-uploads
INTERNAL_UPLOAD_MAX_FILE_BYTES=10485760

# --- Enhanced conversions (Pipedrive → Google Ads, Node) ---
# Same URLs as before: /enhanced/<file>.php (no PHP runtime).
# Auth: Authorization: Bearer <ENHANCED_RUN_SECRET>  (or x-enhanced-key)
# Query ?key= / ?secret= are rejected (security audit P0-2).
# Local example:
#   curl -H "Authorization: Bearer $ENHANCED_RUN_SECRET" http://127.0.0.1:5093/enhanced/job/?file=kinzahr.php
# Dated owner backfill example:
#   /enhanced/job/?file=kinzahr.php&start=YYYY-MM-DD&end=YYYY-MM-DD
# The 12-hour timer must not set DATE / FROM_DATE / TO_DATE; default window is last 2 days.
ENHANCED_RUN_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Optional short-lived token (job refreshes via refresh_token when needed):
# GOOGLE_ADS_ACCESS_TOKEN=
# Do NOT set these while hosting multiple brand scripts (each job has its own default):
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_CONVERSION_ACTION=

# --- Enhanced failure alerts (ops only; not lead-form mail) ---
# Emails ONLY on hard job failures (token/API/config/network). Ads partial row
# warnings (EXPIRED_EVENT etc.) stay HTTP 200 and do not email.
ENHANCED_ALERT_EMAIL=prabhjas.s@connectgroup.co
# Optional from override; otherwise FORM_FROM_EMAIL or SMTP_USER:
# ENHANCED_ALERT_FROM=noreply@kinzahr.com
# Needs SMTP to actually send (optional — if unset, failure is logged only):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# FORM_FROM_EMAIL=

# Do NOT set HOST or PORT here — systemd / fleet-local sets them (kinzahr = 5093).
# Use LF line endings only (CRLF breaks systemd EnvironmentFile=).
# Do NOT rely on FORM_NOTIFICATION_* / SMTP_* for lead notify — Pipedrive + file store.
