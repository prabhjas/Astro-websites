---
/**
 * Custom 404 for unknown / unprepared URLs.
 * Must return HTTP 404 (not 503) so crawlers drop dead links.
 */
export const prerender = false;

Astro.response.status = 404;
Astro.response.statusText = 'Not Found';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | Pittant</title>
    <meta
      name="description"
      content="The page you requested could not be found on pittant.com."
    />
    <meta name="robots" content="noindex, follow" />
    <link
      rel="icon"
      href="/wp-content/uploads/2023/06/Pittant-Logo.svg"
      type="image/svg+xml"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="/runtime-gtm.js" defer data-runtime-gtm="1"></script>
    <style>
      :root {
        --ink: #1a2332;
        --accent: #1b6ca8;
        --mist: #f0f5fa;
        --line: #d5e0ea;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Poppins, 'Segoe UI', sans-serif;
        color: var(--ink);
        background:
          radial-gradient(ellipse 80% 50% at 50% -10%, rgba(27, 108, 168, 0.12), transparent),
          linear-gradient(180deg, #ffffff 0%, var(--mist) 100%);
      }

      .wrap {
        width: min(40rem, calc(100% - 2.5rem));
        margin: 0 auto;
        padding: 3.5rem 0 4rem;
        text-align: center;
      }

      .logo {
        display: inline-block;
        margin-bottom: 2.5rem;
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--accent);
        text-decoration: none;
      }

      .logo img {
        display: block;
        width: min(180px, 50vw);
        height: auto;
        margin: 0 auto;
      }

      .code {
        display: inline-block;
        margin: 0 0 0.75rem;
        padding: 0.2rem 0.65rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        background: #fff;
      }

      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.75rem, 4vw, 2.35rem);
        line-height: 1.15;
        font-weight: 700;
      }

      p {
        margin: 0 auto 1.75rem;
        max-width: 28rem;
        font-size: 1.05rem;
        line-height: 1.55;
        color: #4a4a4a;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
      }

      .actions a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: 0.65rem 1.25rem;
        border-radius: 0.35rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }

      .actions a.primary {
        color: #fff;
        background: var(--accent);
      }

      .actions a.primary:hover {
        background: #145685;
      }

      .actions a.secondary {
        color: var(--ink);
        background: #fff;
        border: 1px solid var(--line);
      }

      .actions a.secondary:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <a class="logo" href="/" aria-label="Pittant home">
        <img
          src="/wp-content/uploads/2023/06/Pittant-Logo.svg"
          width="148"
          height="40"
          alt="Pittant"
          onerror="this.style.display='none'; this.parentElement.textContent='Pittant';"
        />
      </a>
      <div class="code">404</div>
      <h1>Page not found</h1>
      <p>
        The page you are looking for may have been moved, renamed, or no longer
        exists. Try one of the links below.
      </p>
      <div class="actions">
        <a class="primary" href="/">Go to homepage</a>
        <a class="secondary" href="/blog/">Browse blog</a>
        <a class="secondary" href="/contact-us/">Contact us</a>
      </div>
    </main>
  </body>
</html>
