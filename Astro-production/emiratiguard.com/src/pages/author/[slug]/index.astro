---
/**
 * Author archives reuse the /blog/ HTML shell (same header, footer, CSS, scripts
 * as homepage/blog) and inject author-specific posts into #site-content.
 */
import { authors } from "../../../lib/content";
import { serveAuthorArchive } from "../../../lib/author-archive-page";

export function getStaticPaths() {
  return authors.map((author) => ({
    params: { slug: author.slug },
  }));
}

const slug = String(Astro.params.slug || "");
return serveAuthorArchive(slug, 1);
---
