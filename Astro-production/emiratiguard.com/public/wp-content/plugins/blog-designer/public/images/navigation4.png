<div class="bdp_wrapper">						<div class="blog_template boxy-clean">
							<ul>
								<li class="blog_wrap bdp_blog_template three_column three_column_ipad one_column_tablet one_column_mobile bdp_blog_single_post_wrapp">
						<div class="post-meta">
