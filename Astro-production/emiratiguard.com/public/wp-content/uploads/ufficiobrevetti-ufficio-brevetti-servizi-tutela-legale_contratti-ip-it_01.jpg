<style id="wp-custom-css">
.cntct-form fieldset{
	display:none;
}


.page-id-8216 .footer_raj {
    display: none !important;
}

/* Multi Step Form css */
.form-main {
    background:#FFFEFC;
    padding:20px;
    border-radius:16px;
/*     height: 333px; */
   
}

.form-main label{
    color:#1F1A4B;
    font-family: Manrope;
    font-size: 22px;
    font-style: normal;
    font-weight: 700;
    line-height: 30.8px;
}

.form-main .next-btn,
.form-main .prev-btn,
.form-main input[type="submit"] {
  padding: 10px 22px;
  border: 1px solid #3D1457;
  opacity: 0.8;
  background: #3D1457;
  color: #fff;
  border-radius: 12px;
  margin-top: auto;
  align-self: flex-start; 
}

/* Arrange the radio buttons horizontally with spacing */
.wpcf7-form-control.wpcf7-radio {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
	padding-top: 24px;
}
.wpcf7-form-control .wpcf7-list-item {
  margin:0px;
}
/* Hide the native radio inputs */
.wpcf7-form-control.wpcf7-radio label.selected {
  border: 2px solid #3D1457;
}
.wpcf7-form-control input[type="radio"] {
  display: none;
}

/* Style the labels to look like buttons */
.wpcf7-form-control.wpcf7-radio label {
  padding: 8px 12px;
  background-color: #F4EBFC;
  border-radius: 8px;
  color: #1F1A4B;
  font-family: Manrope, sans-serif;
  font-size: 16px;
  font-weight: 400;
  line-height: 160%; /* 25.6px */
  cursor: pointer;
  transition: background-color 0.3s, color 0.3s;
}

/* Hover effect */
.wpcf7-form-control.wpcf7-radio label:hover {
 border: 2px solid #3D1457;
}

/* Style for the selected (checked) radio button */
.wpcf7-form-control.wpcf7-radio input[type="radio"]:checked + label {
  background-color: #3D1457;
  color: #fff;
}





.back-next-btn p {
    display: inline-flex;
    gap: 6px;
	    margin-top: 30px;
}
button.next-btn i {
    position: relative;
    left: 10px;
}

.back-next-btn .prev-btn{
    background:none;
    color:#3D1457
    border: 1px solid var(--Color-Scale-Grape-100, #3D1457);
}

.info-data p {
    display: inline-flex;
    gap: 6px;
}
input[type=text], input[type=email], input[type=tel]{
    border-radius: 8px;
    background: #FAF6FE;
    border:0px;
    padding: 13px 24px;

}

.step-count {
	position: absolute;
    right: 30px;
  font-size: 14px;
  font-weight: 400;
  color: #1F1A4B;
  line-height: 21px;

}

.next-btn:disabled {
/*   opacity: 0.5; */
  cursor: not-allowed;
	background: #644378;
}


.cf7-step.step-6 label {
    color: #6F3495;
}
.cf7-step.step-6 p {
    color:#1F1A4B;
    font-size:18px;
    margin:5px;
}
.cf7-step.step-6 div p {
    color:#1F1A4B;
    font-size:16px;
    font-weight:700;
}

.cf7-step.step-6 ul li p {
    font-size:14px;
    font-weight:400;
    margin:0px;
    
}

.cf7-step.step-6 .call-btn p{
    font-size:14px;
    font-weight:500;
     padding-top:10px;
}

.cf7-step.step-6 .call-btn p button{
    margin-top:10px;
    color:#fff;
    padding: 12px 24px;
    border-radius: 12px;
    border: 1px solid var(--Gradient-Coral-Grapes, #833AB4);
    background: var(--Gradient-Coral-Grapes, linear-gradient(135deg, #833AB4 0%, #F63C41 100%));
}


@media (max-width: 767px) {
    .step-count{
        position:unset;
    }
}

/* End */










.selected-flag {
    min-width: 100px !important;
}
.separate-dial-code input.wpcf7-validates-as-phonetext {
    padding-left:110px !important;
}

div#transaction_hide {
    display: none !important;
}
.heading-linear{
	background: var(--Gradient-Coral-Grapes, linear-gradient(135deg, #833AB4 0%, #F63C41 100%));
background-clip: text;
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
}

a{
	text-decoration:none !important;
}
.numbers h4.elementor-image-box-title {
    margin-top:-3px
}

.landing-banner .opt{
    display:none;
}
.bar label {
    line-height: 20px !important;
}
input[type="checkbox"] {
    margin: 5px;
}



.btn-linear a {
  display: inline-block;
  text-decoration: none;
  color: transparent; 
  background: linear-gradient(135deg, #833AB4, #F63C41);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-fill-color: transparent;
  border-radius: inherit; 
}


 .hover-heading h4.elementor-image-box-title a:hover{
    background: var(--Gradient-Coral-Grapes, linear-gradient(135deg, #833AB4 0%, #F63C41 100%));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.ct-num p {
    margin-bottom: 2px;
}

.blog-form input,
.blog-form select{
    padding: 12px 24px;
}

.blog-form textarea {
    height: 100px;
}




/* Media 767 */

@media only screen and (max-width: 767px) {
	.elementor-top-section{
    padding-top:40px !important;
}
	
.elementor-1494 .elementor-element.elementor-element-eee9449 {
    margin-top: 0px;
}	
	
}	
</style>
