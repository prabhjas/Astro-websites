---
/**
 * Multi-step Movey booking / quote wizard (design mockups steps 1–5).
 */
export const prerender = true;

const phoneDisplay = '+971 43 316 688';
const phoneTel = '+97143316688';
const wa = 'https://wa.me/97143316688';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Book a Move | Get a Quote | Movey</title>
    <meta
      name="description"
      content="Get an instant moving quote with Movey UAE. Tell us your locations, space needs, and preferred date — we’ll take it from there."
    />
    <link rel="canonical" href="https://movey.ae/booking/" />
    <link rel="icon" href="/wp-content/uploads/2023/08/cropped-Logo-color-32x32.png" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Anybody:wght@300;400;600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Anybody:wght@300;400;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <link rel="stylesheet" href="/css/movey-booking.css" />
    <script src="/runtime-gtm.js" defer data-runtime-gtm="1"></script>
  </head>
  <body>
    <div class="movey-booking" id="movey-booking">
      <header class="mb-header">
        <a class="mb-header__logo" href="/" aria-label="Movey home">
          <img src="/wp-content/uploads/2023/08/Logo-color.png" width="180" height="38" alt="Movey" />
        </a>
        <ul class="mb-header__nav">
          <li><a href="/about-us/">About us</a></li>
          <li><a class="is-active" href="/house-movers-in-dubai/">Moving</a></li>
          <li><a href="/movey-faqs/">Movey FAQ’s</a></li>
          <li><a href="/contact-us/">Contact us</a></li>
        </ul>
        <div class="mb-header__actions">
          <a class="mb-btn mb-btn--primary" href="/booking/">Book Now!</a>
          <a class="mb-btn mb-btn--ghost" href={wa} target="_blank" rel="noopener noreferrer">Whatsapp</a>
        </div>
      </header>

      <nav class="mb-steps" aria-label="Booking progress">
        <ol class="mb-steps__list">
          <li class="mb-steps__item is-active" data-mb-step="1">
            <span class="mb-steps__num" aria-hidden="true">1</span>
            <span class="mb-steps__label">Moving location</span>
          </li>
          <li class="mb-steps__item" data-mb-step="2">
            <span class="mb-steps__num" aria-hidden="true">2</span>
            <span class="mb-steps__label">Required space</span>
          </li>
          <li class="mb-steps__item" data-mb-step="3">
            <span class="mb-steps__num" aria-hidden="true">3</span>
            <span class="mb-steps__label">Moving date</span>
          </li>
          <li class="mb-steps__item" data-mb-step="4">
            <span class="mb-steps__num" aria-hidden="true">4</span>
            <span class="mb-steps__label">Get a Quote</span>
          </li>
        </ol>
        <div class="mb-steps__bar" aria-hidden="true">
          <div class="mb-steps__fill" data-mb-fill></div>
        </div>
      </nav>

      <div data-mb-success hidden>
        <div class="mb-success">
          <div class="mb-success__icon" aria-hidden="true">✓</div>
          <h1>Request Quote Sent</h1>
          <p>
            Thanks — your moving quote request is on its way to the Movey team. We’ll review your
            details and get back to you shortly by your preferred contact method.
          </p>
        </div>
      </div>

      <div class="mb-layout" data-mb-main>
        <main>
          <!-- Step 1 -->
          <section class="mb-panel" data-mb-panel="1">
            <p class="mb-kicker">Setup</p>
            <h1 class="mb-title">Moving location</h1>
            <div class="mb-field" data-field="phone">
              <label for="mb-phone">What is your phone number?<span class="mb-req">*</span></label>
              <div class="mb-phone" data-mb-phone-wrap>
                <button type="button" class="mb-phone__code" data-mb-country-btn aria-label="Select country">
                  <span data-mb-flag>🇦🇪</span>
                  <span data-mb-dial>+971</span>
                  <span class="mb-phone__caret" aria-hidden="true">▾</span>
                </button>
                <input id="mb-phone" name="phone" type="tel" inputmode="numeric" placeholder="50 123 4567" autocomplete="tel-national" data-mb-phone-input />
              </div>
              <p class="mb-field__error" data-mb-err hidden></p>
            </div>
            <div class="mb-field" data-field="from">
              <label for="mb-from">Where are you moving from?<span class="mb-req">*</span></label>
              <input id="mb-from" name="from" type="text" placeholder="Enter Address" autocomplete="street-address" required />
              <p class="mb-field__error" data-mb-err hidden></p>
              <p class="mb-hint"><a href="/contact-us/">Couldn't find your address?</a></p>
            </div>
            <div class="mb-field" data-field="to">
              <label for="mb-to">Where are you moving to?<span class="mb-req">*</span></label>
              <input id="mb-to" name="to" type="text" placeholder="Enter Address" autocomplete="street-address" required />
              <p class="mb-field__error" data-mb-err hidden></p>
              <p class="mb-hint"><a href="/contact-us/">Couldn't find your address?</a></p>
            </div>
            <div class="mb-nav mb-nav--end">
              <button type="button" class="mb-btn mb-btn--primary" data-mb-action="next">Next Step →</button>
            </div>
          </section>

          <!-- Step 2 -->
          <section class="mb-panel" data-mb-panel="2" hidden>
            <p class="mb-kicker">Quote</p>
            <h1 class="mb-title">How much space?</h1>
            <p class="mb-lead">
              Ease your worries and entrust the heavy lifting to Movey in Dubai. Enjoy our fast, reliable,
              and secure moving services. Seriously, moving has NEVER been this effortless and safe!
            </p>

            <h2 class="mb-subhead">What is your property?</h2>
            <div class="mb-cards" role="group" aria-label="Property type">
              <button type="button" class="mb-card is-selected" data-mb-select="property" data-value="Apartment">
                <span class="mb-card__check" aria-hidden="true"></span>
                <img class="mb-card__icon" src="/images/booking/icon-apartment.png" width="126" height="126" alt="" />
                <span class="mb-card__label">Apartment</span>
              </button>
              <button type="button" class="mb-card" data-mb-select="property" data-value="Townhouse">
                <span class="mb-card__check" aria-hidden="true"></span>
                <img class="mb-card__icon" src="/images/booking/icon-townhouse.png" width="126" height="126" alt="" />
                <span class="mb-card__label">TownHouse</span>
              </button>
              <button type="button" class="mb-card" data-mb-select="property" data-value="Villa">
                <span class="mb-card__check" aria-hidden="true"></span>
                <img class="mb-card__icon" src="/images/booking/icon-villa.png" width="126" height="126" alt="" />
                <span class="mb-card__label">Villa</span>
              </button>
            </div>

            <h2 class="mb-subhead">How many bedrooms do you have?</h2>
            <div class="mb-pills" role="group" aria-label="Bedrooms">
              {['1', '2', '3', '4', '+5'].map((n) => (
                <button
                  type="button"
                  class:list={['mb-pill', n === '2' && 'is-selected']}
                  data-mb-select="bedrooms"
                  data-value={n}
                >
                  {n}
                </button>
              ))}
            </div>

            <h2 class="mb-subhead">How furnished is your home?<span class="mb-req">*</span></h2>
            <div class="mb-cards" role="group" aria-label="Furnishing">
              <button type="button" class="mb-card is-selected" data-mb-select="furnished" data-value="Lightly (2 Adults)">
                <span class="mb-card__check" aria-hidden="true"></span>
                <img class="mb-card__icon" src="/images/booking/icon-furnished-light.png" width="126" height="126" alt="" />
                <span class="mb-card__label">Lightly</span>
                <span class="mb-card__hint">(2 Adults)</span>
              </button>
              <button type="button" class="mb-card" data-mb-select="furnished" data-value="Moderately (2 Adults + 1 Kid)">
                <span class="mb-card__check" aria-hidden="true"></span>
                <img class="mb-card__icon" src="/images/booking/icon-furnished-moderate.png" width="126" height="126" alt="" />
                <span class="mb-card__label">Moderately</span>
                <span class="mb-card__hint">(2 Adults + 1 Kid)</span>
              </button>
              <button type="button" class="mb-card" data-mb-select="furnished" data-value="Heavily (2 Adults + 3 Kids)">
                <span class="mb-card__check" aria-hidden="true"></span>
                <img class="mb-card__icon" src="/images/booking/icon-furnished-heavy.png" width="126" height="126" alt="" />
                <span class="mb-card__label">Heavily</span>
                <span class="mb-card__hint">(2 Adults + 3 Kids)</span>
              </button>
            </div>

            <div class="mb-nav">
              <button type="button" class="mb-btn mb-btn--outline" data-mb-action="back">← Back</button>
              <button type="button" class="mb-btn mb-btn--primary" data-mb-action="next">Next Step →</button>
            </div>
          </section>

          <!-- Step 3 trucks -->
          <section class="mb-panel" data-mb-panel="3" hidden>
            <p class="mb-kicker">Quote</p>
            <h1 class="mb-title">How much space?</h1>
            <p class="mb-lead">
              Don't worry, this is just an estimate! Once you complete your booking we will check to make
              sure it's accurate. Plus, you only pay for what you use!
            </p>
            <h2 class="mb-subhead">Estimated number of truckloads you need:<span class="mb-req">*</span></h2>
            <div class="mb-field" data-field="trucks">
            <div class="mb-truck-wrap">
              <div class="mb-truck-count">
                <button type="button" class="mb-truck-count__btn" data-mb-trucks-delta="-1" aria-label="Fewer trucks">−</button>
                <input id="mb-trucks" name="trucks" type="number" min="1" max="10" value="2" data-mb-trucks-input aria-label="Truckloads" />
                <button type="button" class="mb-truck-count__btn" data-mb-trucks-delta="1" aria-label="More trucks">+</button>
              </div>
              <img
                class="mb-truck"
                src="/images/booking/movey-truck.png"
                width="678"
                height="429"
                alt="Movey moving truck"
                loading="lazy"
              />
            </div>
            <p class="mb-field__error" data-mb-err hidden></p>
            </div>
            <div class="mb-nav">
              <button type="button" class="mb-btn mb-btn--outline" data-mb-action="back">← Back</button>
              <button type="button" class="mb-btn mb-btn--primary" data-mb-action="next">Next Step →</button>
            </div>
          </section>

          <!-- Step 4 date -->
          <section class="mb-panel" data-mb-panel="4" hidden>
            <p class="mb-kicker">Quote</p>
            <h1 class="mb-title">Your Quote</h1>
            <p class="mb-section-label">Moving details<span class="mb-req">*</span></p>
            <div class="mb-field" data-field="date">
            <div class="mb-calendar" aria-label="Moving date calendar">
              <div class="mb-calendar__head">
                <button type="button" data-mb-cal-nav="-1" aria-label="Previous month">‹</button>
                <span data-mb-cal-label></span>
                <button type="button" data-mb-cal-nav="1" aria-label="Next month">›</button>
              </div>
              <div class="mb-calendar__grid" data-mb-cal-grid></div>
            </div>
            <p class="mb-field__error" data-mb-err hidden></p>
            </div>
            <div class="mb-nav">
              <button type="button" class="mb-btn mb-btn--outline" data-mb-action="back">← Back</button>
              <button type="button" class="mb-btn mb-btn--primary" data-mb-action="next">Next Step →</button>
            </div>
          </section>

          <!-- Step 5 details -->
          <section class="mb-panel" data-mb-panel="5" hidden>
            <p class="mb-kicker">Quote</p>
            <h1 class="mb-title">Your Quote</h1>
            <p class="mb-section-label">Personal Details</p>
            <div class="mb-row-2">
              <div class="mb-field" data-field="firstName">
                <label for="mb-first">First Name<span class="mb-req">*</span></label>
                <input id="mb-first" name="firstName" type="text" placeholder="First Name" autocomplete="given-name" required />
                <p class="mb-field__error" data-mb-err hidden></p>
              </div>
              <div class="mb-field" data-field="lastName">
                <label for="mb-last">Last Name<span class="mb-req">*</span></label>
                <input id="mb-last" name="lastName" type="text" placeholder="Last Name" autocomplete="family-name" required />
                <p class="mb-field__error" data-mb-err hidden></p>
              </div>
            </div>
            <div class="mb-field" data-field="email">
              <label for="mb-email">Email<span class="mb-req">*</span></label>
              <input id="mb-email" name="email" type="email" placeholder="Email Address" autocomplete="email" required />
              <p class="mb-field__error" data-mb-err hidden></p>
            </div>
            <div class="mb-field" data-field="phone2">
              <label for="mb-phone-2">Phone Number<span class="mb-req">*</span></label>
              <div class="mb-phone" data-mb-phone-wrap>
                <button type="button" class="mb-phone__code" data-mb-country-btn aria-label="Select country">
                  <span data-mb-flag>🇦🇪</span>
                  <span data-mb-dial>+971</span>
                  <span class="mb-phone__caret" aria-hidden="true">▾</span>
                </button>
                <input id="mb-phone-2" name="phoneConfirm" type="tel" inputmode="numeric" placeholder="50 123 4567" data-mb-phone-mirror />
              </div>
              <p class="mb-field__error" data-mb-err hidden></p>
            </div>
            <div class="mb-field" data-field="contact">
              <span class="mb-subhead" style="display:block">Preferred contact method<span class="mb-req">*</span></span>
              <div class="mb-radios">
                <label><input type="radio" name="contactMethod" value="Phone" checked /> Phone</label>
                <label><input type="radio" name="contactMethod" value="Email" /> Email</label>
              </div>
              <p class="mb-field__error" data-mb-err hidden></p>
            </div>
            <p class="mb-submit-status" data-mb-submit-status hidden></p>
            <div class="mb-nav mb-nav--end">
              <button type="button" class="mb-btn mb-btn--outline" data-mb-action="back">← Back</button>
              <button type="button" class="mb-btn mb-btn--primary" data-mb-action="submit">Get Quotation ↓</button>
            </div>
          </section>

          <p class="mb-error" data-mb-error role="alert"></p>
        </main>

        <aside class="mb-summary" aria-label="Quote summary">
          <p class="mb-summary__kicker">Quote</p>
          <h2>Summary</h2>
          <ul class="mb-summary__list" data-mb-summary></ul>
          <div class="mb-support">
            <h3>Do you need Support?</h3>
            <div class="mb-support__actions">
              <a class="mb-btn mb-btn--primary" href={`tel:${phoneTel}`}>Call Now!</a>
              <a class="mb-btn mb-btn--ghost" href={wa} target="_blank" rel="noopener noreferrer">Whatsapp</a>
            </div>
          </div>
        </aside>
      </div>

      <footer class="mb-footer">
        <div class="mb-footer__logo">
          <img src="/wp-content/uploads/2023/08/Logo-color.png" width="200" height="42" alt="Movey" />
        </div>
        <div class="mb-footer__bar">
          <div>
            <a href="/privacy-policy/">Privacy Policy</a>
            <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
          </div>
          <div>© {year} Movey · Design by Connect Group</div>
        </div>
      </footer>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var input = document.querySelector('[data-mb-trucks-input]');
        if (!input) return;
        input.addEventListener('change', function () {
          var n = Math.max(1, Math.min(10, Number(input.value) || 1));
          input.value = String(n);
          // sync into wizard state via custom event consumed by movey-booking.js
          var btn = document.createElement('button');
          btn.setAttribute('data-mb-select', 'trucks');
          btn.setAttribute('data-value', String(n));
          btn.hidden = true;
          document.getElementById('movey-booking').appendChild(btn);
          btn.click();
          btn.remove();
        });
      });
    </script>
    <script src="/js/movey-booking.js" defer></script>
  </body>
</html>
