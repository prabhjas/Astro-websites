    const tableSection = document.querySelector(".scrollable_tablemob");

    if(!tableSection) return;

    const scrollBox = tableSection.querySelector(".elementor-widget-container");

    let isInside = false;

    const observer = new IntersectionObserver((entries)=>{
        entries.forEach(entry=>{
            isInside = entry.isIntersecting;
        });
    }, {
        threshold: 0.7
    });

    observer.observe(tableSection);

    window.addEventListener("wheel", function(e){

        if(!isInside) return;

        const maxScroll =
            scrollBox.scrollWidth - scrollBox.clientWidth;

        const current = scrollBox.scrollLeft;

        const canScrollRight = current < maxScroll;
        const canScrollLeft = current > 0;

        if(
            (e.deltaY > 0 && canScrollRight) ||
            (e.deltaY < 0 && canScrollLeft)
        ){
            e.preventDefault();
            scrollBox.scrollLeft += e.deltaY;
        }

    }, { passive:false });

});
