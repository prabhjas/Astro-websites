---
/**
 * Author archive page 1 — /author/{slug}/
 */
import { getAllAuthorSlugs, getAuthorPageData, serveAuthorArchive } from '../../lib/authors.ts';

export function getStaticPaths() {
  return getAllAuthorSlugs().map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const data = getAuthorPageData(slug, 1);

if (!data) {
  return new Response('Not found', { status: 404 });
}

return serveAuthorArchive(data);
---
