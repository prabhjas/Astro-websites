---
/**
 * UAE Company Setup / Business Setup — built from the CG v3.0 Figma design
 * (desktop node 5727:17489). Live URL: /uae-company-setup/
 * Shared chrome via BaseLayout (Header/Footer).
 * Assets in /public/uae-company-setup/. Styles scoped under .cgbs-.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPageSeo } from '../lib/seo';

const seo = loadPageSeo('uae-company-setup');

const img = '/uae-company-setup';
