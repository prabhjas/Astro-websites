    t: '9% corporate tax on qualifying income only',
    d: 'Corporate tax at 9% applies above AED 375,000 per year from June 2023. Businesses below AED 3,000,000 in revenue qualify for small business relief. Qualifying free zone income retains a 0% rate.',
  },
  {
    t: 'Company registered in days, not months',
    d: 'Free zone licences issued in 3 to 7 working days. IFZA zero-visa packages from AED 14,000. Mainland DED licences in 5 to 10 working days when documentation is complete on the first submission.',
  },
];

const routes = [
  {
    n: 'Option 01',
    name: 'Mainland',
    color: '#4051b5',
    body: 'For businesses that need to trade directly with UAE clients, bid on government contracts or operate from any physical location across the UAE. Licensed by DED or the relevant emirate authority.',
    href: '/uae-mainland-company-setup/',
    link: 'Learn about Mainland Setup →',
  },
  {
    n: 'Option 02',
    name: 'Free Zone',
    color: '#007c91',
    body: 'For businesses that operate internationally, want full foreign ownership and tax exemptions, and do not need to sell directly to UAE mainland consumers. Over 40 free zones covered by Connect Group.',
    href: '/uae-freezone-company-setup/',
    link: 'Learn about Free Zone Setup →',
  },
  {
    n: 'Option 03',
    name: 'Offshore',
    color: '#f2633f',
    body: 'For businesses that want to hold assets, open a UAE bank account, and trade internationally without operating physically inside the UAE. Available through JAFZA, RAK ICC, and Ajman offshore authorities.',
    href: '/uae-offshore-company-setup/',
    link: 'Learn about Offshore Setup →',
  },
];

const steps = [
  {
    n: '1',
    t: 'We confirm your activity and structure',
    d: 'We review your business model against the full DED and free zone activity list, confirm ownership eligibility under post-2021 FDI rules, and recommend the jurisdiction that fits your clients, your structure, and your visa requirements.',
  },
  {
    n: '2',
    t: 'We reserve your trade name',
    d: 'We check availability and reserve your preferred trade name with the relevant authority. This happens after initial approval is confirmed, so the name is secured before the licence application is submitted.',
  },
  {
    n: '3',
    t: 'We prepare and submit all documents',
    d: 'Memorandum of association, shareholder documentation, passport copies, application forms. We prepare the complete package and submit it correctly on the first attempt, which is the single biggest factor in keeping timelines on track.',
  },
  {
    n: '4',
    t: 'We secure your office or flexi-desk',
    d: 'Every UAE licence requires a valid registered address. We arrange your office, serviced workspace or flexi-desk through our network of approved UAE workspace providers, matched to your licence type and visa requirements.',
  },
  {
    n: '5',
    t: 'We obtain and verify your trade licence',
    d: 'We collect the issued licence from the authority and verify every detail against your original brief before delivery. Activity codes, ownership structure, and trade name are confirmed accurate before you receive the document.',
  },
  {
    n: '6',
    t: 'We open your visa file and bank account',
    d: 'Establishment card, MOHRE registration, and investor visa applications filed simultaneously. Bank account introductions made to partner institutions whose KYC criteria match your company profile, reducing rejection risk before you apply.',
  },
];

const testimonials = [
  {
    quote: 'I came to Connect Group having already wasted three weeks with another provider who got my activity codes wrong. Connect Group corrected the entire structure, resubmitted with the right documentation, and had my licence issued in six days. Everything was accurate on the first submission.',
    initials: 'JM',
    name: 'J. Mensah',
    role: 'Founder, Marketing Consultancy, Dubai',
  },
  {
    quote: 'Connect Group helped us hire and relocate a team of 15 within a month. We had the mainland licence, the visas and the payroll structure in place before anyone landed. Best execution team.',
    initials: 'RD',
    name: 'R. D.',
    role: 'Founder, Tech Start-up, Dubai',
  },
  {
    quote: 'We were entering the UAE from Singapore with no idea where to start. Connect Group walked us through mainland versus free zone, confirmed the right structure for our client base and handled every document. Three months in and we are fully operational.',
    initials: 'LT',
    name: 'L. Tan',
    role: 'Country Director, Tech Company, Dubai',
  },
];

const afterLicence = [
  {
    icon: `${img}/icons/pro-services.png`,
    title: 'PRO Services',
    body: 'Visa renewals, MOHRE filings and government liaison so no deadline is ever missed and no establishment card ever lapses.',
    href: '/pro-services/',
  },
  {
    icon: `${img}/icons/visa-immigration.png`,
    title: 'Visa and Immigration',
    body: "Investor visas, employee work permits, Emirates ID and dependent sponsorship, all processed through Connect Group's licensed PRO team.",
    href: '/visa-services/',
  },
  {
    icon: `${img}/icons/corporate-bank.png`,
    title: 'Corporate Bank Account',
    body: 'Introductions to UAE banking partners pre-screened against your company activity and shareholder profile, reducing rejection risk before you apply.',
    href: contact,
  },
  {
    icon: `${img}/icons/hr-payroll.svg`,
    title: 'HR, Payroll and Compliance',
    body: "WPS payroll, MOHRE labour contracts, employee onboarding and ongoing HR administration through Connect Group's workforce division.",
    href: '/hr-services/',
  },
];

const faqs = [
  {
    q: 'I do not know whether I need a mainland, free zone or offshore company. Can Connect Group help me decide?',
    a: '<p>Yes, and this is where most engagements start. Connect Group reviews your business activity, where your clients are based and what you need the company to do. From there, the right structure becomes clear. Mainland gives you full UAE market access. Free zone suits international trading with lower setup costs. Offshore works for holding, assets and privacy. You do not need to arrive with the answer. That is what Connect Group is for.</p>',
  },
  {
    q: 'How quickly can Connect Group get my UAE company set up?',
    a: '<p>Free zone licences are issued in 3 to 7 working days once documents are submitted correctly. Mainland DED licences take 5 to 10 working days. Offshore registration completes in 3 to 5 working days.</p><p>The timelines hold when the documentation is complete and accurate on first submission. That is what Connect Group prepares before anything is filed.</p>',
  },
  {
    q: 'What if my business activity needs approval from more than one authority?',
    a: '<p>Some regulated activities require approvals from sector authorities beyond the main licensing body. Healthcare needs DHA clearance. Education needs KHDA. Food activities need Dubai Municipality.</p><p>Connect Group identifies every required approval for your activity before filing and submits to all relevant authorities simultaneously where possible, which keeps timelines tight.</p>',
  },
  {
    q: 'How does Connect Group handle the cost? Is there a fixed package?',
    a: '<p>There is no fixed package because every setup is different. Your licence type, activity, emirate, office size and visa count all affect the cost. Connect Group builds a full itemised breakdown for your specific brief before anything is filed.</p><p>Government fees are passed through at cost. Your service fee is confirmed in writing. Nothing moves until you approve.</p>',
  },
  {
    q: 'What does Connect Group include after the licence is issued?',
    a: '<p>The licence opens the door. What comes next is the establishment card, MOHRE registration, investor visas, a bank account and corporate tax registration with the FTA. Connect Group manages all of these as part of the standard post-licence process. Most clients continue working with Connect Group for PRO services, visa renewals and HR support after setup is complete.</p>',
  },
  {
    q: 'Will I have one point of contact at Connect Group throughout the process?',
    a: '<p>Yes. One named specialist manages your file from the first conversation to the delivered licence. They coordinate every submission, follow up with every authority and keep you updated at each stage. You are not passed between departments. You always know who to call and they always know your file.</p>',
  },
  {
    q: 'Do I need to visit the UAE to set up my company with Connect Group?',
    a: '<p>Not always. Free zone and offshore setups can often be completed remotely with notarised documents. Mainland setups typically require physical presence for the MOA signing and bank account opening. Connect Group tells you exactly which steps need your presence before you book any travel. No unnecessary trips.</p>',
  },
];

const intel = [
  { src: `${img}/intel/intel-1.png`, t: 'Connect Group was born from a singular realization', d: 'The uncompromising standard securing your global legacy.' },
  { src: `${img}/intel/intel-2.png`, t: 'Connect Group was born from a singular realization', d: 'The uncompromising standard securing your global legacy.' },
  { src: `${img}/intel/intel-3.png`, t: 'Connect Group was born from a singular realization', d: 'The uncompromising standard securing your global legacy.' },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/wp-content/cache/min/1/wp-includes/css/dashicons.min.css?ver=1785312815" />
    <link rel="stylesheet" href="/wp-content/cache/min/1/wp-content/uploads/maxmegamenu/style.css?ver=1785312815" />
    <link rel="stylesheet" href="/wp-content/themes/essentials/inc/css/bootstrap.min.css?ver=3.2.17" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/frontend.min.css?ver=4.1.5" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-image.min.css?ver=4.1.5" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-heading.min.css?ver=4.1.5" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-icon-list.min.css?ver=4.1.5" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-spacer.min.css?ver=4.1.5" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-social-icons.min.css?ver=4.1.5" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/conditionals/apple-webkit.min.css?ver=4.1.5" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-icon-box.min.css?ver=4.1.5" />
    <link rel="stylesheet" href="/wp-content/cache/min/1/wp-content/uploads/wp-scss-cache/pixfort-core-style.css?ver=1785312815" />
    <link rel="stylesheet" href="/wp-content/plugins/pixfort-core/includes/assets/css/common/main.min.css?ver=3.2.17" />
    <link rel="stylesheet" href="/wp-content/plugins/pixfort-core/includes/assets/css/header.min.css?ver=3.2.17" />
    <link rel="stylesheet" href="/wp-content/cache/min/1/wp-content/uploads/elementor/google-fonts/css/plusjakartasans.css?ver=1785312815" />
    <link rel="stylesheet" href="/wp-content/plugins/elementor/assets/lib/swiper/v8/css/swiper.min.css" />
  </Fragment>

  <main class="cgbs">
    <section class="cgbs-hero">
      <div class="cgbs-wrap">
        <div class="cgbs-hero-copy">
          <p class="cgbs-eyebrow cgbs-eyebrow-light">UAE Company Setup</p>
          <h1>Your UAE company.<br />The right structure. From day one.</h1>
          <p class="cgbs-hero-routes">Mainland – Free Zone – Offshore</p>
          <p class="cgbs-hero-lead">
            Most setup mistakes happen before a single form is filed. Wrong jurisdiction, wrong
            activity code, wrong ownership structure. Connect Group has set up over 15,000
            businesses in the UAE by getting these three things right from the start.
          </p>
          <div class="cgbs-btn-row">
            <a class="cgbs-btn cgbs-btn-light" href={meet} target="_blank" rel="noopener">Start Your Company Setup</a>
            <a class="cgbs-btn cgbs-btn-outline" href="#cgbs-mistakes">Learn More</a>
          </div>
        </div>

        <div class="cgbs-brands">
          <h2>Our Specialist Brands</h2>
          <p>This service is delivered through our dedicated group subsidiaries, ensuring niche expertise at every stage.</p>
          <div class="cgbs-brand-row">
            {brands.map((b) => <img src={b.src} alt={b.alt} loading="lazy" />)}
          </div>
        </div>

        <div class="cgbs-stats">
          {stats.map((s) => (
            <div class="cgbs-stat">
              <div class="cgbs-stat-big">{s.big}</div>
              <div class="cgbs-stat-small">{s.small}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cgbs-trust" aria-label="Setup coverage">
      <div class="cgbs-wrap cgbs-trust-row">
        {trust.map((item) => (
          <div class="cgbs-trust-item">
            <strong>{item.t}</strong>
            <span>{item.d}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="cgbs-section cgbs-mistakes" id="cgbs-mistakes">
      <div class="cgbs-wrap cgbs-mistakes-grid">
        <div>
          <h2 class="cgbs-h2">Most businesses lose weeks to avoidable setup mistakes</h2>
          <p class="cgbs-lead">
            These are not edge cases. They are the calls Connect Group takes every week from
            businesses that set up without the right advice.
          </p>
          <blockquote class="cgbs-quote-card">
            “These are not rare cases. They are the calls we take every week.”
          </blockquote>
          <a class="cgbs-btn cgbs-btn-black" href={contact}>Speak to a Setup Specialist</a>
        </div>
        <div class="cgbs-mistake-cards">
          {mistakes.map((m) => (
            <article class="cgbs-card">
              <img class="cgbs-card-icon" src={m.icon} alt="" width="60" height="60" loading="lazy" />
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cgbs-section cgbs-why" id="cgbs-why">
      <div class="cgbs-wrap cgbs-why-grid">
        <div>
          <h2 class="cgbs-h2">Why the UAE? And why now?</h2>
          <p class="cgbs-lead">
            Six facts that explain why the UAE attracted over AED 170 billion in foreign direct
            investment in a single year and why that number is still rising.
          </p>
          <div class="cgbs-adv-list">
            {whyFacts.map((a) => (
              <details class="cgbs-adv-item" open>
                <summary>
                  {a.t}
                  <img src={`${img}/icons/chevron.svg`} alt="" width="32" height="32" />
                </summary>
                <p>{a.d}</p>
              </details>
            ))}
          </div>
        </div>
        <div class="cgbs-why-art">
          <img src={`${img}/why-uae.png`} alt="Why the UAE is a leading destination for company formation" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="cgbs-section cgbs-routes">
      <div class="cgbs-wrap">
        <h2 class="cgbs-h2 cgbs-center">Which setup route is right for you?</h2>
        <p class="cgbs-lead cgbs-center cgbs-maxw">
          Three structures. The right one depends on who your clients are, where they are based
          and what you plan to do with the company. Connect Group confirms the fit before
          anything is filed.
        </p>
        <div class="cgbs-route-grid">
          {routes.map((r) => (
            <article class="cgbs-route-card">
              <p class="cgbs-route-n" style={`color: ${r.color}`}>{r.n}</p>
              <h3>{r.name}</h3>
              <p>{r.body}</p>
              <a href={r.href} style={`color: ${r.color}`}>{r.link}</a>
            </article>
          ))}
        </div>
        <p class="cgbs-unsure">Not Sure Which Fits?</p>
        <div class="cgbs-center-btn" style="margin-top: 15px;">
          <a class="cgbs-btn cgbs-btn-black" href={contact}>Talk to a Specialist</a>
        </div>
      </div>
    </section>

    <section class="cgbs-process">
      <div class="cgbs-wrap">
        <h2 class="cgbs-h2 cgbs-center">How Connect Group sets up your company?</h2>
        <p class="cgbs-sub-light cgbs-center cgbs-maxw">
          Six steps. One point of contact. Your only job is to tell us what you want to build.
          Every filing, every submission, and every follow-up is Connect Group's responsibility
          from that point.
        </p>
        <div class="cgbs-steps">
          {steps.map((s) => (
            <div class="cgbs-step">
              <div class="cgbs-step-head">
                <span class="cgbs-step-n">{s.n}</span>
                <span class="cgbs-step-k">STEP</span>
              </div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
        <div class="cgbs-center-btn">
          <a class="cgbs-btn cgbs-btn-black cgbs-btn-pill" href={meet} target="_blank" rel="noopener">Start Your Setup Today</a>
        </div>
      </div>
    </section>

    <section class="cgbs-section cgbs-testi-section">
      <div class="cgbs-wrap">
        <p class="cgbs-eyebrow cgbs-eyebrow-slate cgbs-center">From the People Using It</p>
        <h2 class="cgbs-h2 cgbs-center">What our clients say</h2>
        <div class="cgbs-testi-slider">
          <div class="swiper cgbs-testi-swiper">
            <div class="swiper-wrapper">
              {testimonials.map((t) => (
                <div class="swiper-slide">
                  <article class="cgbs-testi">
                    <img class="cgbs-quote-icon" src={`${img}/icons/quote.svg`} alt="" width="17" height="16" />
                    <div class="cgbs-stars" aria-label="5 out of 5 stars">
                      {Array.from({ length: 5 }).map(() => (
                        <img src={`${img}/icons/star.svg`} alt="" width="24" height="24" />
                      ))}
                    </div>
                    <blockquote>{t.quote}</blockquote>
                    <div class="cgbs-testi-who">
                      <strong>{t.initials}</strong>
                      <div class="cgbs-testi-name">{t.name}</div>
                      <div class="cgbs-testi-role">{t.role}</div>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>
          <div class="cgbs-testi-nav" aria-hidden="false">
            <button class="cgbs-testi-prev" type="button" aria-label="Previous testimonial">
              <svg viewBox="0 0 1000 1000" aria-hidden="true"><path d="M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z"></path></svg>
            </button>
            <div class="cgbs-testi-dots"></div>
            <button class="cgbs-testi-next" type="button" aria-label="Next testimonial">
              <svg viewBox="0 0 1000 1000" aria-hidden="true"><path d="M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z"></path></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="cgbs-section cgbs-after">
      <div class="cgbs-wrap">
        <h2 class="cgbs-h2 cgbs-center">Everything you need after the licence. Still Connect Group.</h2>
        <p class="cgbs-lead cgbs-center cgbs-maxw">
          A trade licence opens the door. What you need next is the infrastructure to operate.
          Connect Group covers every function a UAE business needs to run compliantly from day one.
        </p>
        <div class="cgbs-after-grid">
          {afterLicence.map((c) => (
            <a class="cgbs-card cgbs-after-card" href={c.href}>
              <img class="cgbs-card-icon" src={c.icon} alt="" width="60" height="60" loading="lazy" />
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cgbs-section">
      <div class="cgbs-wrap">
        <p class="cgbs-eyebrow cgbs-eyebrow-teal">Common Questions</p>
        <h2 class="cgbs-h2">Frequently asked questions about Company Setup in UAE</h2>
        <p class="cgbs-lead">The questions every client asks before filing. Answered directly, without preamble.</p>
        <div class="cgbs-faq-list">
          {faqs.map((f, i) => (
            <details class="cgbs-faq" open={i === 0}>
              <summary>
                {f.q}
                <img src={`${img}/icons/faq-chevron.svg`} alt="" width="32" height="32" />
              </summary>
              <div class="cgbs-faq-a" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cgbs-section cgbs-finalcta-wrap">
      <div class="cgbs-wrap">
        <div class="cgbs-finalcta">
          <h2>Ready to set up the right way?</h2>
          <p>
            Tell Connect Group what you want to build and where your clients are. We confirm the
            jurisdiction, the activity codes, and the structure, then file everything correctly
            the first time. 15,000 businesses before you have done exactly this.
          </p>
          <a class="cgbs-btn cgbs-btn-black" href={contact}>Send My Setup Brief</a>
        </div>
      </div>
    </section>

    <section class="cgbs-section cgbs-intel">
      <div class="cgbs-wrap">
        <h2 class="cgbs-h2-sm">UAE Market Intel</h2>
        <p class="cgbs-intel-sub">Secrets to scaling with speed</p>
        <div class="cgbs-cards3">
          {intel.map((c) => (
            <a class="cgbs-intel-card" href="/insights/">
              <img src={c.src} alt="" loading="lazy" />
              <div class="cgbs-intel-body">
