  },
  {
    icon: `${img}/icons/special-purpose-vehicles.svg`,
    title: 'Special Purpose Vehicles',
    body: 'Create a separate legal entity around a specific asset, deal or liability. SPVs are widely used in real estate transactions, private equity and project finance where keeping one asset isolated from the rest of your structure matters.',
  },
  {
    icon: `${img}/icons/international-trading.svg`,
    title: 'International Trading',
    body: 'Invoice international clients, hold multi-currency accounts and manage cross-border transactions through a UAE-registered entity. No physical office in the UAE is required to operate this way.',
  },
];

const advantages = [
  {
    t: '0% Tax on Offshore Income',
    d: 'Offshore companies are exempt from UAE corporate tax. They cannot generate UAE-sourced income, so the 9% rate does not apply to them.',
  },
  {
    t: 'Shareholder Privacy',
    d: 'No public register of shareholders exists for UAE offshore entities. UBO disclosure is required to authorities only.',
  },
  {
    t: '100% Foreign Ownership',
    d: 'No local sponsor, no UAE partner, no equity sharing. Full ownership from day one under both RAK ICC and JAFZA frameworks.',
  },
  {
    t: 'UAE Banking Access',
    d: 'Both jurisdictions support UAE bank account opening with Emirates NBD, Mashreq and RAKBank, subject to KYC approval.',
  },
  {
    t: 'Dubai Property Ownership',
    d: "Both RAK ICC (since Emiri Decree No. 12 of 2024) and JAFZA can hold freehold property in Dubai's designated investment zones.",
  },
  {
    t: 'No Audit Requirement',
    d: 'RAK ICC offshore companies have no mandatory audit. That saves AED 5,000 to AED 15,000 annually versus an operating entity.',
  },
];

const jurisdictions = [
  {
    label: 'Jurisdiction 01',
    name: 'RAK ICC',
    rows: [
      ['Setup time', '3 to 5 working days'],
      ['Audit requirement', 'None'],
      ['Dubai property', 'Yes, since 2024'],
      ['Minimum directors', '1'],
      ['Minimum capital', 'None required'],
      ['Best for', 'Holding structures, IP ownership, wealth planning, SPVs and cost-conscious investors. 35 to 40% cheaper than JAFZA.'],
    ],
  },
  {
    label: 'Jurisdiction 02',
    name: 'JAFZA Offshore',
    rows: [
      ['Setup time', '5 to 7 working days'],
      ['Audit requirement', 'May apply'],
      ['Dubai property', 'Yes, long established'],
      ['Minimum directors', '1 (reduced in 2024)'],
      ['Minimum capital', 'Strongest of the two'],
      ['Best for', 'Businesses needing maximum banking strength, a Dubai address or structures where institutional partners require the JAFZA name.'],
    ],
  },
];

const steps = [
  {
    n: '1',
    t: 'It Starts With Your Objective',
    d: 'We understand what you want to achieve. From there, we recommend RAK ICC or JAFZA based on your purpose, banking profile and budget. The right jurisdiction is confirmed before anything is touched.',
  },
  {
    n: '2',
    t: 'Your Company Name Is Secured',
    d: 'Three name options go in simultaneously. Approval typically arrives within 24 hours. We flag naming restrictions upfront so nothing comes back rejected.',
  },
  {
    n: '3',
    t: 'Documents Prepared and Submitted',
    d: 'We prepare the full document set, notarised passport copies, proof of address, bank reference letters and beneficial owner declaration, and submit everything in one complete package. No back and forth, no missing items on first submission.',
  },
