  .uaeo-sub-blue { color: var(--uaeo-slate); font-size: 17px; margin: 0 auto 44px; max-width: 900px; }
  .uaeo-sub-light { color: rgba(255, 255, 255, 0.85); font-size: 17px; margin: 0 auto 48px; }
  .uaeo-eyebrow { font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 14px; }
