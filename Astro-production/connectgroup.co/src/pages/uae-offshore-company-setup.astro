  },
  {
    icon: `${img}/icons/ip-ownership.svg`,
    title: 'IP Ownership',
    body: 'Register trademarks, patents and software copyrights at the offshore entity level, then license them to your operating companies. Connect Group advises on the substance requirements that apply under current UAE tax rules.',
  },
  {
    icon: `${img}/icons/family-offices.svg`,
    title: 'Family Offices',
