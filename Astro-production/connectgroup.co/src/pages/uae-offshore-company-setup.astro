  .uaeo-btn-dark, .uaeo-btn-black { background: #121212; color: #fff; }

  /* HERO — desktop: the design's wave background (Figma 6089:17441 export, taller
     than the hero so the wave sits upper-right and flows down) + engraved cube icon.
     Tablet/mobile override background-image with the baked hero-bkg-*.webp below. */
  .uaeo-hero {
    position: relative; overflow: hidden;
    background: var(--uaeo-navy-deep) url('/uae-offshore/hero-wave-bg.webp') center top / cover no-repeat;
    /* header is position:absolute (~83px) over the hero — clear it + breathing room */
    color: #fff; padding: 120px 0 80px;
  }
  .uaeo-hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 30px; align-items: center; }
