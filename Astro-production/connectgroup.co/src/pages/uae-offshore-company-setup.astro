---
/**
 * UAE Offshore Company Setup — built from the CG v3.0 Figma design (node 5795:10756).
 * Uses the shared site chrome (BaseLayout → Header/Footer, same as /uae-mainland-company-setup/).
 * Page assets live in /public/uae-offshore/ (from the design's asset kit + Figma exports).
 * All styles are scoped under .uaeo- so nothing leaks into existing pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPageSeo } from '../lib/seo';

const seo = loadPageSeo('uae-offshore-company-setup');

const img = '/uae-offshore';
const contact = '/contact-us/';

