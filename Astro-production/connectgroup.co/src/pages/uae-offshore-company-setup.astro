<style>
  .uaeo {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    color: #1a1a1a;
    background: #fff; /* chrome/pixfort body bg is dark — keep our sections on white */
    line-height: 1.5;
    --uaeo-navy: #232a7c;
    --uaeo-navy-deep: #1c2166;
    --uaeo-slate: #4051b5;
    --uaeo-teal: #007c91;
    --uaeo-cream: #fff3dd;
    --uaeo-lavender: #d9dbfa;
    --uaeo-silver: #767676;
  }
  .uaeo * { box-sizing: border-box; }
  /* The chrome stack (pixfort/bootstrap) sets its own heading fonts — force the design font back. */
  .uaeo h1, .uaeo h2, .uaeo h3, .uaeo h4, .uaeo p, .uaeo a, .uaeo li, .uaeo dt, .uaeo dd,
  .uaeo blockquote, .uaeo summary, .uaeo div, .uaeo span, .uaeo strong {
