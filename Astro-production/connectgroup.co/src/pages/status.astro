<style>
  .status {
    font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    line-height: 1.55;
    color: #0f172a;
  }
  .status a {
    color: #1e3a8a;
  }
  h1 {
    font-family: "IBM Plex Serif", Georgia, serif;
    font-size: 1.85rem;
    margin: 0.5rem 0 0.75rem;
  }
  .lead {
    color: #475569;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 1.5rem 0;
  }
  th,
  td {
    border: 1px solid #e2e8f0;
    padding: 0.55rem 0.65rem;
    text-align: left;
  }
  th {
    background: #f8fafc;
  }
  .ok {
    color: #166534;
    font-weight: 600;
  }
  .wait {
    color: #9a3412;
    font-weight: 600;
  }
  pre {
    background: #0f172a;
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.85rem;
  }
  code {
    font-size: 0.88em;
  }
</style>
