---
/**
 * Migration checklist for demos and team sync.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPageSeo } from '../lib/seo';

const homeSeo = loadPageSeo('home');
const seo = {
  ...homeSeo,
  title: 'Migration status | Connect Group Astro',
  description: 'What is done in the WordPress → Astro migration and what remains.',
  canonical: 'https://connectgroup.co/status/',
  robots: 'noindex, follow',
