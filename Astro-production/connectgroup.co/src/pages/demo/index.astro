    line-height: 1.2;
    margin: 0 0 0.75rem;
    font-weight: 600;
  }
  .demo__lead {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0 0 2rem;
    max-width: 40rem;
  }
  .demo__grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr;
    margin-bottom: 2rem;
  }
  @media (min-width: 640px) {
    .demo__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .demo__card {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .demo__card:hover {
    border-color: #94a3b8;
  }
  .demo__card-kicker {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .demo__card strong {
    font-size: 1.05rem;
  }
  .demo__card span:last-child {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .demo__panel {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.25rem 1.35rem;
    margin-bottom: 1rem;
  }
  .demo__panel h2 {
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
  }
  .demo__panel ol {
    margin: 0;
    padding-left: 1.2rem;
  }
  .demo__panel li {
    margin-bottom: 0.45rem;
  }
  .demo__panel a {
    color: var(--accent);
  }
  .demo__code {
    margin: 0;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.45;
    background: #0f172a;
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 8px;
  }
  code {
    font-size: 0.88em;
    background: #f1f5f9;
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
</style>
