---
/**
 * Manager demo hub — walk through migration, SEO, and performance plan.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPageSeo } from '../../lib/seo';

const homeSeo = loadPageSeo('home');
const seo = {
  ...homeSeo,
  title: 'Astro migration demo | Connect Group',
  description:
    'Internal demo: WordPress/Elementor → static Astro, SEO workflow, and Core Web Vitals plan.',
  canonical: 'https://connectgroup.co/demo/',
  robots: 'noindex, follow',
};
---

