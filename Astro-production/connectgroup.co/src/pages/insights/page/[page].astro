---
/**
 * Insights pagination — Figma chrome for /insights/page/n/ SEO URLs.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsChromeHead from '../../../components/insights/InsightsChromeHead.astro';
import InsightsSharedStyles from '../../../components/insights/InsightsSharedStyles.astro';
import { loadPageSeo } from '../../../lib/seo';
import { ARCHIVE_POSTS_PER_PAGE } from '../../../lib/blog.ts';
import { getInsightCards, getTopicChips } from '../../../lib/insights.ts';
import { getInsightsTotalPages } from '../../../lib/archives.ts';

export function getStaticPaths() {
  const total = getInsightsTotalPages();
  const paths = [];
  for (let p = 2; p <= total; p++) {
    paths.push({ params: { page: String(p) } });
  }
  return paths;
}

const page = parseInt(Astro.params.page!, 10);
if (!page || page < 2) return new Response('Not found', { status: 404 });

const seoBase = loadPageSeo('insights');
const allCards = getInsightCards();
const totalPages = Math.max(1, Math.ceil(allCards.length / ARCHIVE_POSTS_PER_PAGE));
if (page > totalPages) return new Response('Not found', { status: 404 });

const start = (page - 1) * ARCHIVE_POSTS_PER_PAGE;
const pageCards = allCards.slice(start, start + ARCHIVE_POSTS_PER_PAGE);
const chips = getTopicChips(allCards).slice(0, 8);
const img = '/insights/img';

const seo = {
  ...seoBase,
  title: `Insights — Page ${page} | Connect Group`,
  canonical: `/insights/page/${page}/`,
};
---

<BaseLayout seo={seo} canonical={`/insights/page/${page}/`}>
  <Fragment slot="head">
    <InsightsChromeHead />
    <InsightsSharedStyles />
  </Fragment>

  <main class="ig">
    <section class="ig-hero">
      <div class="ig-hero__glow" aria-hidden="true">
        <picture>
          <source media="(max-width: 767px)" srcset={`${img}/hero-mobile.webp`} />
          <img src={`${img}/hero-desktop.webp`} alt="" width="1440" height="480" decoding="async" />
        </picture>
      </div>
      <div class="ig-wrap ig-hero__copy">
        <h1>Get Latest Updates &amp; Insights</h1>
        <p class="ig-hero__sub">Page {page} of {totalPages}</p>
      </div>
    </section>

    <div class="ig-sheet">
      <section class="ig-block">
        <div class="ig-wrap">
          <h2 class="ig-h2">Articles by topic</h2>
          <div class="ig-chips">
            {chips.map((chip, i) => (
              <a
                class:list={['ig-chip', i === 0 && 'is-on']}
                href={chip === 'All' ? '/insights/' : `/category/${chip.toLowerCase().replace(/\s+/g, '-')}/`}
              >
                {chip}
              </a>
            ))}
          </div>
          <div class="ig-grid">
            {pageCards.map((card) => (
              <a class="ig-card" href={card.href}>
                <div class="ig-card__visual">
                  <div class="ig-card__media">
                    <img
                      src={card.image || `${img}/blog-card.webp`}
                      alt={card.imageAlt}
                      width="420"
                      height="256"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="ig-card__glass">
                    <div class="ig-meta ig-meta--light">
                      <div class="ig-meta__left">
                        <span>{card.author}</span>
                        <span>{card.date}</span>
                      </div>
                      <span>{card.category}</span>
                    </div>
                  </div>
                </div>
                <div class="ig-card__text">
                  <h3>{card.title}</h3>
                  <p>{card.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
          <nav class="ig-more" aria-label="Pagination" style="gap:20px">
            {page > 2 ? <a class="ig-btn ig-btn--dark" href={`/insights/page/${page - 1}/`}>Previous</a> : <a class="ig-btn ig-btn--dark" href="/insights/">Previous</a>}
            <span style="align-self:center;font-weight:600">Page {page} / {totalPages}</span>
            {page < totalPages && <a class="ig-btn ig-btn--dark" href={`/insights/page/${page + 1}/`}>Next</a>}
          </nav>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* Reuse listing tokens — kept here so pagination route stays self-contained */
  html:has(.ig), body:has(.ig) { background: #060d1d !important; }
  .ig {
    --ig-ink:#1a1a1a; --ig-muted:#767676; --ig-soft:#fafafa; --ig-dark:#060d1d; --ig-line:#d1d1d1; --ig-r:24px; --ig-max:1300px;
    font-family:'Plus Jakarta Sans',system-ui,sans-serif; color:var(--ig-ink); background:var(--ig-dark);
  }
  .ig h1,.ig h2,.ig h3,.ig h4,.ig p,.ig li,.ig span,.ig a,.ig label,.ig button{
    font-family:'Plus Jakarta Sans',system-ui,sans-serif !important;
  }
  .ig-wrap { width:min(100% - 32px,var(--ig-max)); margin-inline:auto; }
  @media (min-width:1100px){ .ig-wrap{ width:min(100% - 140px,var(--ig-max)); } }
  .ig-hero{ position:relative; padding:40px 0 64px; color:#fff; overflow:hidden; }
  .ig-hero__glow{ position:absolute; inset:0; }
  .ig-hero__glow img{ width:100%; height:100%; object-fit:cover; }
  .ig-hero__copy{ position:relative; z-index:1; display:flex; flex-direction:column; gap:12px; }
  .ig-hero h1{ margin:0; font-size:clamp(2rem,5vw,3.5rem); font-weight:600; }
  .ig-hero__sub{ margin:0; opacity:.85; }
  .ig-sheet{ background:var(--ig-soft); border-radius:40px; overflow:hidden; padding-bottom:48px; }
  @media (min-width:1100px){ .ig-sheet{ border-radius:70px; padding-bottom:72px; } }
  .ig-block{ padding:40px 0 56px; }
  .ig-h2{ margin:0 0 28px; font-size:clamp(1.5rem,3vw,2rem); font-weight:600; }
  .ig-chips{ display:flex; flex-wrap:wrap; gap:12px; margin:0 0 28px; }
  .ig-chip{ display:inline-flex; border:1px solid var(--ig-line); background:#fff; color:var(--ig-muted); border-radius:8px; padding:8px; text-decoration:none; font-size:16px; }
  .ig-chip.is-on{ background:#121212; color:#fff; }
  .ig-grid{ display:grid; gap:20px; }
  @media (min-width:768px){ .ig-grid{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (min-width:1100px){ .ig-grid{ grid-template-columns:repeat(3,minmax(0,1fr)); } }
  .ig-card{ display:flex; flex-direction:column; gap:16px; text-decoration:none; color:inherit; }
  .ig-card__visual{ position:relative; }
  .ig-card__media{ position:relative; border-radius:24px; overflow:hidden; aspect-ratio:384/256; background:var(--ig-dark); border:0.5px solid rgba(0,0,0,.1); }
  .ig-card__media img,.ig-ph{ width:100%; height:100%; object-fit:cover; display:block; }
  .ig-ph{ background:linear-gradient(160deg,#0b1630,#243a6e); }
  .ig-card__glass{
    position:absolute; left:0; right:0; bottom:0; z-index:2; padding:16px;
    border-radius:0 0 24px 24px; border:0;
    border-top:1px solid rgba(255,255,255,.16);
    background:rgba(0,0,0,.20);
    backdrop-filter:blur(30px); -webkit-backdrop-filter:blur(30px);
    pointer-events:none; box-sizing:border-box;
  }
  .ig-card__glass .ig-meta{ padding:0; margin:0; background:transparent; border:0; backdrop-filter:none; }
  .ig-meta{ display:flex; justify-content:space-between; gap:12px; font-size:14px; }
  .ig-meta--light{ color:#fff; }
  .ig-meta__left{ display:flex; flex-direction:column; gap:2px; }
  .ig-card__text h3{ margin:0; font-size:1.125rem; font-weight:600; line-height:1.4; letter-spacing:-0.02em; }
  @media (min-width:1100px){ .ig-card__text h3{ font-size:1.25rem; } }
  .ig-card__text p{ margin:8px 0 0; color:var(--ig-muted); font-size:15px; line-height:1.6; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .ig-more{ display:flex; justify-content:center; flex-wrap:wrap; margin-top:36px; }
  .ig-btn{ display:inline-flex; align-items:center; justify-content:center; padding:12px 24px; border-radius:999px; font-weight:700; text-decoration:none; }
  .ig-btn--dark{ background:#121212; color:#fff; }
</style>
