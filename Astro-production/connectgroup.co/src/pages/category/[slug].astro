---
import { getAllCategorySlugs, getCategoryPageData, serveArchivePage } from '../../lib/archives.ts';

export function getStaticPaths() {
  return getAllCategorySlugs().map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const data = getCategoryPageData(slug, 1);
if (!data) return new Response('Not found', { status: 404 });
return serveArchivePage(data);
---
