---
/**
 * Dynamic blog post route — Figma v3 blog post chrome (BaseLayout).
 * Static pages in src/pages/*.astro take precedence over this route.
 */
import BlogPostPage from '../components/insights/BlogPostPage.astro';
import { getAllBlogSlugs, getBlogPost, getReservedSlugs } from '../lib/blog.ts';

export function getStaticPaths() {
  const reserved = getReservedSlugs();
  return getAllBlogSlugs()
    .filter((slug) => !reserved.has(slug))
    .map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const post = getBlogPost(slug);

if (!post) {
  return new Response('Not found', { status: 404 });
}
---

<BlogPostPage post={post} />
