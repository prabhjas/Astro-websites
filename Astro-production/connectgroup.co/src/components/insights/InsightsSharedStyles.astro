---
/**
 * Shared Figma v3 tokens + form/contact styles for Insights listing + blog posts.
 */
---
<style is:global>
  :root {
    --ig-ink: #1a1a1a;
    --ig-ink2: #121212;
    --ig-body: #313131;
    --ig-muted: #767676;
    --ig-soft: #fafafa;
    --ig-dark: #060d1d;
    --ig-dark2: #060c1e;
    --ig-line: #d1d1d1;
    --ig-teal: #4fb7c2;
    --ig-r: 24px;
    --ig-max: 1300px;
  }

  html:has(.ig),
  body:has(.ig),
  html:has(.bp),
  body:has(.bp) {
    background: #060d1d !important;
  }

  /* Override mirror-fixes html/body overflow-x:clip — that breaks sticky sidebar */
  html:has(.bp),
  html:has(.bp) body {
    overflow-x: visible !important;
  }

  /* Insights + posts: dark canvas + transparent overlay header (white logo readable on hero) */
  html:has(.ig),
  html:has(.ig) body,
  html:has(.bp),
  html:has(.bp) body {
    background: #060d1d !important;
    background-color: #060d1d !important;
  }
  html:has(.ig) header.elementor-location-header,
  html:has(.bp) header.elementor-location-header {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 100 !important;
    background: transparent !important;
    background-color: transparent !important;
  }
  html:has(.ig) .header-new,
  html:has(.bp) .header-new {
    background: transparent !important;
    background-color: transparent !important;
  }
  @media (max-width: 991px) {
    html:has(.ig) .header-new,
    html:has(.bp) .header-new {
      background: rgba(6, 13, 29, 0.4) !important;
      background-color: rgba(6, 13, 29, 0.4) !important;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  .ig-form {
    display: grid;
    gap: 16px;
    width: 100%;
    max-width: 768px;
  }

  /* Sticky sidebar lead form — Figma #060D1D, compact field spacing */
  .ig-form--sidebar {
    max-width: none;
    width: 100%;
    gap: 12px;
    padding: 24px;
    border-radius: 24px;
    background-color: #060d1d;
    background-image: url('/insights/img/contact-sidebar.jpg');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
  }
  .ig-form--sidebar .ig-form__intro {
    margin-bottom: 4px;
    display: grid;
    gap: 8px;
  }
  .ig-form--sidebar .ig-form__title {
    margin: 0 !important;
  }
  .ig-form--sidebar .ig-form__field {
    font-size: 12px;
    font-weight: 500;
    gap: 6px;
  }
  .ig-form--sidebar .ig-form__field input,
  .ig-form--sidebar .ig-form__field textarea {
    font-size: 14px;
    min-height: 40px;
    padding: 10px 12px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .ig-form--sidebar .ig-form__field textarea { min-height: 88px; }
  .ig-form--sidebar .ig-form__submit {
    width: 100%;
    height: 44px;
    margin-top: 4px;
  }

  .ig-form__title {
    margin: 0 0 8px !important;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
    font-size: 20px !important;
    font-weight: 500 !important;
    letter-spacing: -0.02em !important;
    line-height: 1.3 !important;
    color: #fff !important;
  }
  .ig-form--footer .ig-form__title {
    font-size: clamp(1.5rem, 3vw, 2rem) !important;
    font-weight: 600 !important;
  }
  .ig-form__subtitle {
    margin: 0;
    color: #d1d1d1;
    font-size: 14px;
    line-height: 1.5;
  }
  .ig-form--footer .ig-form__subtitle { font-size: 18px; }
  .ig-form__row {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .ig-form--footer .ig-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ig-form__field {
    display: grid;
    gap: 8px;
    font-size: 16px;
    font-weight: 400;
    color: #fff;
  }
  .ig-form__field input,
  .ig-form__field textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.2);
    color: #fff;
    padding: 12px;
    font: inherit;
    font-size: 16px;
    font-weight: 400;
    min-height: 48px;
  }
  .ig-form__field textarea { min-height: 100px; resize: vertical; }
  .ig-form__field input::placeholder,
  .ig-form__field textarea::placeholder { color: rgba(255, 255, 255, 0.6); }
  .ig-form__chips { border: 0; margin: 0; padding: 0; }
  .ig-form__chips legend { margin-bottom: 12px; padding: 0; }
  .ig-form__chips-title {
    display: block;
    color: #fff;
    font-size: 16px;
    line-height: 1.5;
  }
  .ig-form__chips-hint {
    display: block;
    margin-top: 4px;
    color: #d1d1d1;
    font-size: 14px;
    line-height: 1.5;
  }
  .ig-form__chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .ig-form__chip {
    appearance: none;
    border: 1px solid #fafafa;
    background: transparent;
    color: #fff;
    border-radius: 12px;
    padding: 8px;
    font: inherit;
    font-size: 16px;
    line-height: 1.5;
    cursor: pointer;
  }
  .ig-form__chip.is-active {
    background: var(--ig-teal);
    border-color: var(--ig-teal);
    color: #1a1a1a;
  }
  .ig-form__submit {
    appearance: none;
    border: 0;
    border-radius: 8px;
    background: #fff;
    color: #1a1a1a;
    font: inherit;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 24px;
    height: 48px;
    cursor: pointer;
    justify-self: start;
  }
  .ig-form__submit:disabled { opacity: 0.6; cursor: wait; }
  .ig-form__error {
    color: #ff8f8f;
    font-size: 12px;
    min-height: 0;
    font-weight: 400;
  }
  .ig-form__error:empty { display: none; }
  .ig-form__status { margin: 0; font-size: 13px; }
  .ig-form__status--success { color: #7dffc3; }
  .ig-form__status--error { color: #ff8f8f; }
  .ig-form__honeypot {
    position: absolute !important;
    left: -9999px !important;
    opacity: 0 !important;
    height: 0 !important;
    width: 0 !important;
  }
  .ig-form .intl-tel-input { width: 100%; }
</style>
