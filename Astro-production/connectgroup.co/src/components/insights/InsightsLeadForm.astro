---
/**
 * Figma v3 Insights / blog lead form — posts to /api/contact/.
 * variant: "footer" (listing/post contact) | "sidebar" (sticky post card)
 */
import { SERVICE_CHIPS } from '../../lib/insights.ts';

interface Props {
  formId?: string;
  formName?: string;
  variant?: 'footer' | 'sidebar';
  title?: string;
  subtitle?: string;
}

const {
  formId = 'insights-lead',
  formName = 'Connect Group Insights Lead Form',
  variant = 'footer',
  title = variant === 'sidebar' ? 'Start Your Journey With Us' : 'Start Your Journey With Us',
  subtitle =
    variant === 'sidebar'
      ? 'Let us know what you\'re looking for, and we\'ll help you take the next step.'
      : 'Let us know what you\'re looking for, and we\'ll help you take the next step.',
} = Astro.props;

const isSidebar = variant === 'sidebar';
---

<form
  id={formId}
  class:list={['ig-form', isSidebar ? 'ig-form--sidebar' : 'ig-form--footer']}
  method="post"
  action="/api/contact/"
  onsubmit="return false;"
  novalidate
  data-ig-lead-form
  data-form-name={formName}
>
  <input type="text" name="website" class="ig-form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="form_name" value={formName} />
  <input type="hidden" name="form_id" value={formId} />
  <input type="hidden" name="submission_id" value="" />
  <input type="hidden" name="page_url" value="" />
  <input type="hidden" name="referrer_url" value="" />
  <input type="hidden" name="initial_url" value="" />
  <input type="hidden" name="landing_page_url" value="" />
  <input type="hidden" name="submission_page_url" value="" />
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_term" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="gclid" value="" />
  <input type="hidden" name="gbraid" value="" />
  <input type="hidden" name="wbraid" value="" />
  <input type="hidden" name="fbclid" value="" />
  <input type="hidden" name="msclkid" value="" />
  <input type="hidden" name="campaign_id" value="" />
  <input type="hidden" name="adgroup_id" value="" />
  <input type="hidden" name="group_id" value="" />
  <input type="hidden" name="creative_id" value="" />
  <input type="hidden" name="keyword" value="" />
  <input type="hidden" name="matchtype" value="" />
  <input type="hidden" name="device" value="" />
  <input type="hidden" name="network" value="" />
  <input type="hidden" name="placement" value="" />
  <input type="hidden" name="target" value="" />
  <input type="hidden" name="target_id" value="" />
  <input type="hidden" name="adposition" value="" />
  <input type="hidden" name="loc_physical_ms" value="" />
  <input type="hidden" name="loc_interest_ms" value="" />
  <input type="hidden" name="gad_source" value="" />
  <input type="hidden" name="source" value="" />
  <input type="hidden" name="first_touch_payload" value="" />
  <input type="hidden" name="last_touch_payload" value="" />
  <input type="hidden" name="first_visit_at" value="" />
  <input type="hidden" name="latest_visit_at" value="" />
  <input type="hidden" name="submitted_at" value="" />
  <input type="hidden" name="services" value="" data-ig-services />

  <div class="ig-form__intro">
    <h2 class="ig-form__title">{title}</h2>
    <p class="ig-form__subtitle">{subtitle}</p>
  </div>

  <label class="ig-form__field">
    <span>Full name*</span>
    <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
    <span class="ig-form__error" data-error-for="name"></span>
  </label>

  {isSidebar ? (
    <>
      <label class="ig-form__field">
        <span>Email ID*</span>
        <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
        <span class="ig-form__error" data-error-for="email"></span>
      </label>
      <label class="ig-form__field">
        <span>Contact Number</span>
        <input type="tel" name="phone" class="cg-phone-input wpcf7-phonetext" autocomplete="tel" required placeholder="+971" />
        <input type="hidden" name="phone-country-code" value="" />
        <span class="ig-form__error" data-error-for="phone"></span>
      </label>
    </>
  ) : (
    <div class="ig-form__row">
      <label class="ig-form__field">
        <span>Email ID*</span>
        <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
        <span class="ig-form__error" data-error-for="email"></span>
      </label>
      <label class="ig-form__field">
        <span>Contact Number</span>
        <input type="tel" name="phone" class="cg-phone-input wpcf7-phonetext" autocomplete="tel" required placeholder="+971" />
        <input type="hidden" name="phone-country-code" value="" />
        <span class="ig-form__error" data-error-for="phone"></span>
      </label>
    </div>
  )}

  {!isSidebar && (
    <fieldset class="ig-form__chips">
      <legend>
        <span class="ig-form__chips-title">Let’s Personalize Your Experience</span>
        <span class="ig-form__chips-hint">You can select one or more options that apply to your needs.</span>
      </legend>
      <div class="ig-form__chip-row" data-ig-chip-row>
        {SERVICE_CHIPS.map((chip) => (
          <button type="button" class="ig-form__chip" data-chip={chip}>{chip}</button>
        ))}
      </div>
    </fieldset>
  )}

  <label class="ig-form__field">
    <span>{isSidebar ? 'Message (Optional)' : 'Message (Optional)'}</span>
    <textarea name="message" rows={isSidebar ? 3 : 4} placeholder="Type your message..."></textarea>
    <span class="ig-form__error" data-error-for="message"></span>
  </label>

  <button type="submit" class="ig-form__submit">Submit</button>
  <p class="ig-form__status" hidden></p>
</form>

<link
  rel="stylesheet"
  href="/wp-content/plugins/country-phone-field-contact-form-7/assets/css/intlTelInput.min.css"
/>
<script src="/wp-includes/js/jquery/jquery.min.js" defer></script>
<script
  src="/wp-content/plugins/country-phone-field-contact-form-7/assets/js/intlTelInput.min.js"
  defer
></script>
<script>
  import { captureAttribution, populateAttributionFields } from '../../lib/attribution/client';

  function initLeadForm(form) {
    if (!(form instanceof HTMLFormElement) || form.dataset.igLeadBound === '1') return;
    form.dataset.igLeadBound = '1';

    const formId = form.id || form.getAttribute('data-form-id') || '';
    const formName = form.getAttribute('data-form-name') || formId;
    const chipRow = form.querySelector('[data-ig-chip-row]');
    const servicesInput = form.querySelector('[data-ig-services]');
    let selected = [];
    const status = form.querySelector('.ig-form__status');
    const submitBtn = form.querySelector('[type="submit"]');
    let submitting = false;

    function setHidden(name, value) {
      const input = form.querySelector(`[name="${name}"]`);
      if (input instanceof HTMLInputElement) input.value = value || '';
    }

    function captureTracking() {
      const captured = captureAttribution(formId, formName);
      populateAttributionFields(form, captured.firstTouch, captured.lastTouch);
      setHidden('page_url', window.location.href);
      setHidden('submission_page_url', window.location.href);
      setHidden('referrer_url', document.referrer || '');
      if (!form.dataset.submissionId) {
        form.dataset.submissionId = crypto.randomUUID();
      }
      setHidden('submission_id', form.dataset.submissionId);
    }

    try {
      captureTracking();
    } catch (_) {}

    if (chipRow && servicesInput instanceof HTMLInputElement) {
      chipRow.addEventListener('click', (e) => {
        const btn = e.target instanceof Element ? e.target.closest('[data-chip]') : null;
        if (!btn) return;
        const value = btn.getAttribute('data-chip');
        if (!value) return;
        if (btn.classList.contains('is-active')) {
          btn.classList.remove('is-active');
          selected = selected.filter((v) => v !== value);
        } else {
          btn.classList.add('is-active');
          selected.push(value);
        }
        servicesInput.value = selected.join(', ');
      });
    }

    function stayOnForm() {
      if (status && 'scrollIntoView' in status) {
        status.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      } else {
        form.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (submitting) return;

      form.querySelectorAll('.ig-form__error').forEach((el) => {
        el.textContent = '';
      });
      if (status) {
        status.hidden = true;
        status.textContent = '';
        status.classList.remove('ig-form__status--error', 'ig-form__status--success');
      }

      const name = form.querySelector('[name="name"]');
      const email = form.querySelector('[name="email"]');
      const phone = form.querySelector('[name="phone"]');
      let ok = true;

      if (!(name instanceof HTMLInputElement) || !name.value.trim()) {
        const err = form.querySelector('[data-error-for="name"]');
        if (err) err.textContent = 'Name is required';
        ok = false;
      }
      if (
        !(email instanceof HTMLInputElement) ||
        !email.value.trim() ||
        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)
      ) {
        const err = form.querySelector('[data-error-for="email"]');
        if (err) err.textContent = 'Valid email is required';
        ok = false;
      }
      if (!(phone instanceof HTMLInputElement) || !phone.value.trim()) {
        const err = form.querySelector('[data-error-for="phone"]');
        if (err) err.textContent = 'Phone is required';
        ok = false;
      }
      if (!ok) return;

      const countryCodeInput = form.querySelector('[name="phone-country-code"]');
      const jq = window.jQuery;
      if (jq && phone instanceof HTMLInputElement && jq(phone).data('plugin_intlTelInput')) {
        try {
          const full = jq(phone).intlTelInput('getNumber');
          if (full) phone.value = full;
          const dial = jq(phone).intlTelInput('getSelectedCountryData');
          if (dial && countryCodeInput instanceof HTMLInputElement) {
            countryCodeInput.value = '+' + dial.dialCode;
          }
        } catch (_) {}
      }

      submitting = true;
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;

      try {
        captureTracking();
      } catch (_) {}
      setHidden('submitted_at', new Date().toISOString());

      const fd = new FormData(form);
      if (selected.length && !fd.get('message')) {
        fd.set('message', 'Interested in: ' + selected.join(', '));
      } else if (selected.length) {
        fd.set('message', String(fd.get('message') || '') + '\n\nServices: ' + selected.join(', '));
      }

      fetch('/api/contact/', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: fd,
        credentials: 'same-origin',
      })
        .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
        .then((result) => {
          if (!status) return;
          status.hidden = false;
          if (result.ok && result.data && result.data.success) {
            status.classList.add('ig-form__status--success');
            status.textContent = result.data.message || 'Thank you — we will be in touch shortly.';
            form.reset();
            selected = [];
            form.querySelectorAll('.ig-form__chip.is-active').forEach((b) => b.classList.remove('is-active'));
            if (servicesInput instanceof HTMLInputElement) servicesInput.value = '';
            form.dataset.submissionId = crypto.randomUUID();
            try {
              captureTracking();
            } catch (_) {}
            stayOnForm();
            return;
          }
          status.classList.add('ig-form__status--error');
          status.textContent =
            (result.data && result.data.message) ||
            'We could not submit your enquiry at the moment. Please try again shortly.';
          if (result.data && result.data.errors) {
            Object.keys(result.data.errors).forEach((key) => {
              const el = form.querySelector(`[data-error-for="${key}"]`);
              if (el) el.textContent = result.data.errors[key];
            });
          }
          stayOnForm();
        })
        .catch(() => {
          if (status) {
            status.hidden = false;
            status.classList.add('ig-form__status--error');
            status.textContent = 'We could not submit your enquiry at the moment. Please try again shortly.';
          }
          stayOnForm();
        })
        .finally(() => {
          submitting = false;
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        });
    });
  }

  function boot() {
    document.querySelectorAll('[data-ig-lead-form]').forEach((form) => initLeadForm(form));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
