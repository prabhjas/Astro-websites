---
/**
 * Blog post — CG v3.0 Figma (from-scratch rebuild)
 * Desktop 6748:19797 · Tablet 6762:3125 · Mobile 6762:3429.
 */
import { sanitizeCmsHtml } from '@connect/site-cms';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsightsChromeHead from './InsightsChromeHead.astro';
import InsightsSharedStyles from './InsightsSharedStyles.astro';
import InsightsLeadForm from './InsightsLeadForm.astro';
import {
  formatDate,
  getAllBlogPosts,
  getAuthorSlugFromPost,
  getPostExcerpt,
  type BlogPost,
} from '../../lib/blog.ts';
import { getAuthor } from '../../lib/authors.ts';
import { toInsightCard, displayAuthorName, normalizeTopicLabel } from '../../lib/insights.ts';
import type { PageSeo } from '../../lib/seo';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const img = '/insights/img';
const pageUrl = `https://connectgroup.co/${post.slug}/`;

const related = getAllBlogPosts()
  .filter((p) => p.slug !== post.slug)
  .filter((p) => {
    if (!post.categories.length) return true;
    const names = new Set(post.categories.map((c) => c.name));
    return p.categories.some((c) => names.has(c.name));
  })
  .slice(0, 3)
  .map((p) => {
    const card = toInsightCard(p);
    return { ...card, category: normalizeTopicLabel(card.category) };
  });

const category = post.categories[0];
const categoryLabel = category ? normalizeTopicLabel(category.name) : '';
const authorName = displayAuthorName(post.author?.name);
const authorSlug = getAuthorSlugFromPost(post);
const authorProfile = authorSlug ? getAuthor(authorSlug) : null;
const authorTitle = authorProfile?.title || '';
const authorBio =
  authorProfile?.bio ||
  'Connect Group insights on business setup, workforce solutions, and operating in the UAE — practical guidance from our specialist brands.';
const authorAvatar = authorProfile?.avatar?.src || '';
const contentHtml = sanitizeCmsHtml(post.contentHtml || '');
const dateLabel = (() => {
  try {
    return new Date(post.publishedAt).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return formatDate(post.publishedAt);
  }
})();
const crumbTopic = categoryLabel || 'Insights';

const seo: PageSeo = {
  title: post.metaTitle || `${post.title} | Connect Group`,
  description: post.metaDescription || post.description || getPostExcerpt(post, 160),
  canonical: `/${post.slug}/`,
  robots: post.robots || 'index, follow',
  og: {
    title: post.og?.title || post.title,
    description: post.og?.description || post.description,
    type: post.og?.type || 'article',
    image: post.og?.image || post.featuredImage?.src,
  },
  twitter: {
    card: post.twitter?.card || 'summary_large_image',
    title: post.twitter?.title || post.title,
    description: post.twitter?.description || post.description,
  },
  schema: {
    pageType: 'Article',
    organizationName: 'Connect Group',
    datePublished: post.publishedAt,
    dateModified: post.modifiedAt,
  },
};

const tocEntries = (post.toc || []).filter((e) => e.level === 2).slice(0, 10);
---

<BaseLayout seo={seo} canonical={`/${post.slug}/`}>
  <Fragment slot="head">
    <InsightsChromeHead />
    <InsightsSharedStyles />
  </Fragment>

  <main class="bp">
    <section class="bp-hero">
      <div class="bp-wrap">
        <nav class="bp-crumb" aria-label="Breadcrumb">
          <a href="/insights/">Insights</a>
          <span class="bp-crumb__sep">/</span>
          <span aria-current="page">{crumbTopic}</span>
        </nav>

        <h1>{post.title}</h1>

        <div class="bp-hero__bar">
          <div class="bp-share" aria-label="Share">
            <a
              class="bp-share__btn"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
            >
              <img src={`${img}/icon-linkedin.svg`} alt="" width="18" height="18" />
            </a>
            <a
              class="bp-share__btn"
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on Facebook"
            >
              <img src={`${img}/icon-facebook.svg`} alt="" width="18" height="18" />
            </a>
            <button type="button" class="bp-share__btn" data-copy-link aria-label="Copy link">
              <img src={`${img}/icon-link.svg`} alt="" width="18" height="18" />
            </button>
          </div>
          <time datetime={post.publishedAt}>{dateLabel}</time>
        </div>
      </div>
    </section>

    <div class="bp-sheet">
      <div class="bp-wrap bp-layout">
        <div class="bp-main">
          {post.featuredImage?.src && (
            <div class="bp-feature">
              <img
                src={post.featuredImage.src}
                alt={post.featuredImage.alt || post.title}
                width="1200"
                height="800"
                loading="eager"
                decoding="async"
              />
            </div>
          )}

          {tocEntries.length > 0 && (
            <nav class="bp-toc" aria-label="Table of contents">
              <p class="bp-toc__title">Table of Contents</p>
              <ol>
                {tocEntries.map((entry, idx) => (
                  <li>
                    <a href={`#${entry.id}`}>
                      <span>{String(idx + 1).padStart(2, '0')}</span>
                      <em>{entry.text}</em>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          <article class="bp-content" set:html={contentHtml} />

          <aside class="bp-author">
            {authorAvatar ? (
              <img
                class="bp-author__avatar"
                src={authorAvatar}
                alt={authorName}
                width="96"
                height="96"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="bp-avatar bp-avatar--lg" aria-hidden="true">{authorName.slice(0, 1)}</span>
            )}
            <div class="bp-author__body">
              <p class="bp-author__head">
                <strong>{authorName}</strong>
                {authorTitle && <span class="bp-author__role">{authorTitle}</span>}
              </p>
              <p class="bp-author__bio">{authorBio}</p>
            </div>
          </aside>

          <div class="bp-inline-form">
            <InsightsLeadForm
              formId={`blog-inline-${post.slug}`}
              formName="Connect Group Blog Inline Form"
              variant="sidebar"
            />
          </div>
        </div>

        <aside class="bp-aside">
          <div class="bp-aside__sticky">
            <InsightsLeadForm
              formId={`blog-sidebar-${post.slug}`}
              formName="Connect Group Blog Sidebar Form"
              variant="sidebar"
            />
          </div>
        </aside>
      </div>

      {related.length > 0 && (
        <section class="bp-related">
          <div class="bp-wrap">
            <p class="bp-related__kicker">More Insights</p>
            <h2>Related Articles</h2>
            <div class="bp-related__grid">
              {related.map((card) => (
                <a class="bp-related__card" href={card.href}>
                  <div class="bp-related__media">
                    <img
                      src={card.image || `${img}/blog-card.webp`}
                      alt={card.imageAlt}
                      width="400"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="bp-related__glass">
                      <div class="bp-related__meta bp-related__meta--on">
                        <div>
                          <span>{card.author}</span>
                          <span>{card.date}</span>
                        </div>
                        <span>{card.category}</span>
                      </div>
                    </div>
                  </div>
                  <h3>{card.title}</h3>
                  <p>{card.excerpt}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="bp-contact">
        <div class="bp-wrap">
          <InsightsLeadForm
            formId={`blog-footer-${post.slug}`}
            formName="Connect Group Blog Footer Form"
            variant="footer"
          />
        </div>
      </section>
    </div>
  </main>

  <script is:inline define:vars={{ pageUrl, postSlug: post.slug }}>
    (function () {
      function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '0';
          ta.style.left = '0';
          ta.style.width = '1px';
          ta.style.height = '1px';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          ta.setSelectionRange(0, text.length);
          try {
            var ok = document.execCommand('copy');
            document.body.removeChild(ta);
            if (ok) resolve();
            else reject(new Error('copy failed'));
          } catch (err) {
            document.body.removeChild(ta);
            reject(err);
          }
        });
      }

      function markCopied(btn) {
        if (!btn) return;
        var prev = btn.getAttribute('aria-label') || 'Copy link';
        btn.setAttribute('aria-label', 'Link copied');
        btn.classList.add('is-copied');
        window.setTimeout(function () {
          btn.setAttribute('aria-label', prev);
          btn.classList.remove('is-copied');
        }, 1800);
      }

      document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('[data-copy-link]') : null;
        if (!btn) return;
        e.preventDefault();
        var url = pageUrl || window.location.href;
        copyText(url)
          .then(function () { markCopied(btn); })
          .catch(function () {
            // Last resort: prompt so the user can still copy manually.
            window.prompt('Copy this link:', url);
          });
      });

      // Fire-and-forget view count for Featured ranking (deduped server-side via cookie).
      if (postSlug) {
        fetch('/api/blog/view/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: postSlug }),
          credentials: 'same-origin',
          keepalive: true,
        }).catch(function () {});
      }
    })();
  </script>
</BaseLayout>

<style is:global>
