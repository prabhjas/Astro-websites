[Unit]
Description=Connect Resources International Astro SSR server (Caddy reverse-proxies to this)
After=network.target

[Service]
Type=simple
User=site-connectresourcesint
Group=site-connectresourcesint
WorkingDirectory=/opt/Astro-production/connectresourcesint.com
EnvironmentFile=/opt/Astro-production/connectresourcesint.com/.env.prod
Environment=NODE_ENV=production
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=5098 /usr/bin/node ./dist/server/entry.mjs
Restart=always
RestartSec=5

MemoryMax=192M
MemoryHigh=160M
CPUQuota=40%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
UMask=0027
ReadWritePaths=/opt/Astro-production/connectresourcesint.com/.data

[Install]
WantedBy=multi-user.target
