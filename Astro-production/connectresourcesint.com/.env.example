# On the production host this file is SPLIT:
#   .env       → build-only (PUBLIC_SITE_URL), root:webdev 0644 — no secrets
#   .env.prod  → runtime secrets for systemd (root:site-* 0640) when APIs need them
# Local laptop: one gitignored .env is fine for fleet-local smoke.
#
# Stub site (no contact form / Pipedrive yet). Canonical origin:
PUBLIC_SITE_URL=https://www.connectresourcesint.com

LOG_LEVEL=info

# Optional when /api/internal mounts are added later:
# INTERNAL_JOB_SECRET=
# INTERNAL_ADMIN_DIR=.data/internal-admin

# Do NOT set HOST or PORT here — systemd / fleet-local sets them (connectresourcesint = 5098).
# Use LF line endings only (CRLF breaks systemd EnvironmentFile=).
# Do NOT rely on FORM_NOTIFICATION_* / SMTP_* for lead notify — Pipedrive + file store.
