# Public canonical website origin (no trailing slash).
PUBLIC_SITE_URL=https://cbss.example.com

# --- Lead storage (file-backed source of truth) ---
LEAD_STORE_DIR=.data/leads
LEAD_STORE_MAX_FILE_BYTES=10485760
PIPEDRIVE_MAX_RETRY_ATTEMPTS=5
PIPEDRIVE_REQUEST_TIMEOUT_MS=10000

# --- Internal lead operations dashboard ---
DASHBOARD_PATH=/internal/operations
DASHBOARD_SESSION_SECRET=change-me-to-a-long-random-string
DASHBOARD_SESSION_TTL_MINUTES=480
INTERNAL_JOB_SECRET=
INTERNAL_ADMIN_DIR=.data/internal-admin
INTERNAL_ENHANCED_LIVE_DIR=.data/enhanced-live
INTERNAL_UPLOAD_DIR=.data/internal-uploads
INTERNAL_UPLOAD_MAX_FILE_BYTES=10485760
# JSON array: [{"email":"ops@example.com","role":"super_admin","passwordHash":"scrypt$<salt>$<hash>"}]
# Roles: viewer | developer | seo | super_admin
DASHBOARD_USERS_JSON=

# --- Pipedrive (values match legacy CBSS submit-form.php) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=connectgroup2
PIPEDRIVE_OWNER_ID=13601147
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_LEAD_SOURCE_ID=270
PIPEDRIVE_PERSON_LABEL_IDS=5
PIPEDRIVE_PERSON_VISIBLE_TO=3

# --- Website / form identity ---
WEBSITE_ID=5248
WEBSITE_NAME=CBSS
FORM_SOURCE=270
FORM_NAME=CBSS Contact Form
LEAD_TITLE_PREFIX=AD CBSS

# --- Email notifications (comma-separated) ---
FORM_NOTIFICATION_EMAILS=lana@connectgroup.co
FORM_FROM_EMAIL=noreply@connectgroup.co
FORM_FROM_NAME=CBSS Form

# --- SMTP (required only when FORM_NOTIFICATION_EMAILS is set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Logging ---
LOG_LEVEL=info
