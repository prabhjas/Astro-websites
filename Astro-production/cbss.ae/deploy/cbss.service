[Unit]
Description=CBSS Astro SSR server (Caddy reverse-proxies to this)
After=network.target

[Service]
Type=simple
# Tier 1: dedicated user (create on host before enabling). Confirm with ops.
User=site-cbss
Group=site-cbss
WorkingDirectory=/opt/Astro-production/cbss.ae
EnvironmentFile=-/opt/Astro-production/cbss.ae/.env.prod
Environment=NODE_ENV=production
# HOST/PORT set here — not in .env.prod (fleet rule). Confirm PORT on host.
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=5081 /usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=5

# Tier 1 resource + sandbox (CONNECT-ASTRO-FLEET-STANDARD §6.2)
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Astro-production/cbss.ae/.data

[Install]
WantedBy=multi-user.target
