# /etc/caddy/sites.d/cbss.ae.caddy
# Prefer: import /etc/caddy/sites.d/*.caddy  (fleet standard §6.3)
# Validate before reload: caddy validate --config /etc/caddy/Caddyfile
# Confirm reverse_proxy PORT matches deploy/cbss.service (5081 placeholder).

cbss.ae, www.cbss.ae {
	encode gzip zstd
	reverse_proxy 127.0.0.1:5081
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/cbss.ae-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
