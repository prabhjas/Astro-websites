# cbss.ae -> 127.0.0.1:5081 (systemd: cbss.service)
#
# PRODUCTION STANDARD (single /etc/caddy/Caddyfile — see caddy/Caddyfile.production).
# This file is the site block to keep in sync with the live fleet Caddyfile.
#
# When deploying / adding this site on the server you MUST also:
#   1. Ensure the shared one-hop HTTP alt-host block lists http://www.cbss.ae
#      and redirects to https://cbss.ae{uri}
#   2. Match PUBLIC_SITE_URL=https://cbss.ae
#   3. Cloudflare SSL = Full (not Flexible); Full (strict) is intentionally deferred for this named internal CA.
#   4. sudo -u caddy caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Local laptop: do NOT run this Caddy block — use fleet-local on :5081 only.
# Docs: docs/CONNECT-CADDY-DEPLOYMENT.md

cbss.ae, www.cbss.ae {
	tls force_automate {
		issuer internal {
			ca astro_origin_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/cbss.ae/cbss.ae.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/cbss.ae/cbss.ae.key
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.cbss.ae/www.cbss.ae.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.cbss.ae/www.cbss.ae.key
	encode zstd gzip

	@noncanonical host www.cbss.ae
	redir @noncanonical https://cbss.ae{uri} permanent

	reverse_proxy 127.0.0.1:5081

	@static path_regexp static \.(css|js|woff|woff2|webp|jpg|jpeg|png|gif|svg|ico|avif|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/cbss.ae-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
