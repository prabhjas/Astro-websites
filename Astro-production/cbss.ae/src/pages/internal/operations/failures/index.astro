---
import InternalDashboardLayout from '../../../../layouts/InternalDashboardLayout.astro';
import { getServerEnv } from '../../../../env/server';
import { hasDashboardRole, isSeoOnlyRole } from '../../../../lib/auth/permissions';
import { readDashboardSession } from '../../../../lib/auth/session';
import { formatDateTime, getDeliveryStatusLabel, getLeadDisplayName } from '../../../../lib/leads/dashboard';
import { FileLeadStore } from '../../../../lib/leads/file-store';
import { applyInternalNoIndexHeaders } from '../../../../lib/security/internal-response';

export const prerender = false;

applyInternalNoIndexHeaders(Astro.response.headers);

const session = readDashboardSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/internal/operations/login');
}

if (isSeoOnlyRole(session)) {
  return Astro.redirect('/internal/operations/');
}

const env = getServerEnv();
const store = new FileLeadStore({ rootDir: env.leadStoreDir, maxFileBytes: env.leadStoreMaxFileBytes });
const submissions = (await store.listSubmissions()).filter((record) =>
  ['retry_scheduled', 'failed', 'dead_letter'].includes(record.deliveryStatus),
);
const canRetry = hasDashboardRole(session, 'developer');
---

<InternalDashboardLayout
  title="Operations Failures"
  active="failures"
  sessionEmail={session.email}
  sessionRole={session.role}
  csrfToken={session.csrf}
>
  <section class="panel">
    <h2>Failures and retries</h2>
    <p>Use this queue to retry temporary Pipedrive failures or inspect leads that now need manual review.</p>
    <table>
      <thead>
        <tr>
          <th>Lead</th>
          <th>Status</th>
          <th>Next retry</th>
          <th>Error</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {submissions.length ? (
          submissions.map((record) => (
            <tr>
              <td>
                <a href={`/internal/operations/leads/${record.publicId}/`}>
                  {getLeadDisplayName(record)}
                </a>
                <div class="subtle">{record.publicId}</div>
              </td>
              <td><span class={`pill ${record.deliveryStatus}`}>{getDeliveryStatusLabel(record.deliveryStatus)}</span></td>
              <td>{formatDateTime(record.nextRetryAt)}</td>
              <td>{record.lastErrorMessage || '-'}</td>
              <td>
                {canRetry ? (
                  <form method="post" action="/api/internal/retry-lead">
                    <input type="hidden" name="publicId" value={record.publicId} />
                    <input type="hidden" name="csrfToken" value={session.csrf} />
                    <button type="submit">Retry now</button>
                  </form>
                ) : (
                  <span class="subtle">Developer access required</span>
                )}
              </td>
            </tr>
          ))
        ) : (
          <tr>
            <td colspan="5">No failed or queued leads right now.</td>
          </tr>
        )}
      </tbody>
    </table>
  </section>
</InternalDashboardLayout>

<style>
  .panel {
    background: white;
    border-radius: 18px;
    padding: 1.25rem;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
  }
  h2, p { margin-top: 0; }
  p, .subtle { color: #64748b; }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th, td {
    text-align: left;
    padding: 0.8rem 0;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
  }
  button {
    border: 0;
    border-radius: 10px;
    background: #0f172a;
    color: white;
    font: inherit;
    padding: 0.7rem 0.85rem;
    cursor: pointer;
  }
  .pill {
    display: inline-flex;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
    background: #e2e8f0;
    color: #0f172a;
  }
  .pill.retry_scheduled { background: #fef3c7; color: #92400e; }
  .pill.failed, .pill.dead_letter { background: #fee2e2; color: #991b1b; }
</style>
