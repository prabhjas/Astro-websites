import Partners from '../components/sections/Partners.astro';
import MultiStepForm from '../components/sections/MultiStepForm.astro';
import Benefits from '../components/sections/Benefits.astro';
import Compliance from '../components/sections/Compliance.astro';
import Youtube from '../components/sections/Youtube.astro';
import SocialProof from '../components/sections/SocialProof.astro';
