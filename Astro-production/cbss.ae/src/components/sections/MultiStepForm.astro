---

<section id="sec-3">
      <div class="container">
        <div class="row">
          <div class="col-lg-4 col-md-12">
            <h2>Find the right structure for your business</h2>
            <p>Tell us a bit about your business — we’ll provide guidance on options and considerations for operating in Dubai.</p>
          </div>
          <div class="col-lg-8 col-md-12">
            <div class="form-main" id="multistepform">
              <div class="step-count">Step <span id="step-number">1</span> of 5 </div>
              <!-- ---------------- Step 1 ---------------- -->
              <div class="cf7-step step-1">
                <label>What industry are you in?</label>
                <div class="radio-group">
                  <label>
                    <input type="radio" name="business_type" value="IT/Software">IT / Software </label>
                  <label>
                    <input type="radio" name="business_type" value="Trading / Import-Export">Trading / Import-Export </label>
                  <label>
                    <input type="radio" name="business_type" value="Consulting / Freelance">Consulting / Freelance </label>
                  <label>
                    <input type="radio" name="business_type" value="Real Estate">Real Estate </label>
                  <label>
                    <input type="radio" name="business_type" value="Media & Marketing">Media & Marketing </label>
                  <label>
                    <input type="radio" name="business_type" value="Other">Other </label>
                </div>
                <div id="other-text-wrap" style="display: none;">
                  <input type="text" name="other_option" id="other-option" placeholder="Please specify" />
                  <span class="cbss-field-error" id="other-option-error" role="alert" aria-live="polite"></span>
                </div>
                <div class="back-next-btn">
                  <button type="button" class="next-btn">Next </button>
                </div>
              </div>
              <!-- ---------------- Step 2 ---------------- -->
              <div class="cf7-step step-2" style="display:none;">
                <label>Where do you want to operate?</label>
                <div class="radio-group">
                  <label>
                    <input type="radio" name="operating_area" value="Only in Dubai">Only in Dubai </label>
                  <label>
                    <input type="radio" name="operating_area" value="Across the UAE">Across the UAE </label>
                  <label>
                    <input type="radio" name="operating_area" value="Online (internationally)">Online (internationally) </label>
                  <label>
                    <input type="radio" name="operating_area" value="Not sure">Not sure </label>
                </div>
                <div class="back-next-btn">
                  <button type="button" class="prev-btn">Go Back</button>
                  <button type="button" class="next-btn">Next</button>
                </div>
              </div>
              <!-- ---------------- Step 3 ---------------- -->
              <div class="cf7-step step-3" style="display:none;">
                <label>Do you plan to move to Dubai?</label>
                <div class="radio-group">
                  <label>
                    <input type="radio" name="residency_visa" value="Yes, I want a residency visa">Yes, I want a residency visa </label>
                  <label>
                    <input type="radio" name="residency_visa" value="No, I’ll manage remotely">No, I’ll manage remotely </label>
                  <label>
                    <input type="radio" name="residency_visa" value="Maybe later">Maybe later </label>
                </div>
                <div class="back-next-btn">
                  <button type="button" class="prev-btn">Go Back</button>
                  <button type="button" class="next-btn">Next</button>
                </div>
              </div>
              <!-- ---------------- Step 4 ---------------- -->
              <div class="cf7-step step-4" style="display:none;">
                <label>Preferred setup type</label>
                <div class="radio-group">
                  <label>
                    <input type="radio" name="company_jurisdiction" value="Free Zone (low-cost, fast)">Free Zone (low-cost, fast) </label>
                  <label>
                    <input type="radio" name="company_jurisdiction" value="Mainland (more flexibility)">Mainland (more flexibility) </label>
                  <label>
                    <input type="radio" name="company_jurisdiction" value="Offshore (for global presence)">Offshore (for global presence) </label>
                  <label>
                    <input type="radio" name="company_jurisdiction" value="Not sure - guide me">Not sure – guide me </label>
                </div>
                <div class="back-next-btn">
                  <button type="button" class="prev-btn">Go Back</button>
                  <button type="button" class="next-btn">Next</button>
                </div>
              </div>
              <!-- ---------------- Step 5 ---------------- -->
              <div class="cf7-step step-5" style="display:none;">
                <label>Contact Information</label>
                <div class="multistep-form" style="padding-top: 24px;">
                  <form action="#" method="post" id="multistep-contact-form" novalidate>
                    <div class="row">
                      <div class="col-md-12">
                        <input type="text" id="form-name" name="name" placeholder="Full Name*" required autocomplete="name" />
                        <span class="cbss-field-error" id="form-name-error" role="alert" aria-live="polite"></span>
                      </div>
                      <div class="col-md-6">
                        <input type="email" id="form-email"  name="email" placeholder="Email *" required autocomplete="email" />
                        <span class="cbss-field-error" id="form-email-error" role="alert" aria-live="polite"></span>
                      </div>
                      <div class="col-md-6">
                        <input type="tel" id="form-contact-number" class="phone" name="contact_number" placeholder="Contact Number *" inputmode="numeric" pattern="[0-9]*" maxlength="15" required autocomplete="tel" />
                        <span class="cbss-field-error" id="form-contact-number-error" role="alert" aria-live="polite"></span>
                      </div>
                    </div>
                  </form>
                </div>
                <div class="cbss-form-status" id="multistep-form-status" role="status" aria-live="polite"></div>
                <div class="back-next-btn">
                  <button type="button" class="prev-btn">Go Back</button>
                  <button type="button" id="submit-multi-step-form" class="next-btn">Get My Setup Plan</button>
                </div>
              </div>
              <!-- ---------------- Step 6 ---------------- -->
              <div class="cf7-step step-6" style="display:none;">
                <label>Thank You! Your Plan Is On the Way.</label>
                <p>We’ve received your request and our consultants are reviewing your answers to prepare a tailored setup plan.</p>
                <div>
                  <span>Here’s What to Expect:</span>
                  <ul>
                    <li>You’ll receive a personalized business setup plan via email and WhatsApp within 1 business day</li>
                    <li>One of our Russian-speaking consultants may contact you for any clarifications</li>
                    <li>You can also reach out directly if you’re in a hurry</li>
                  </ul>
                </div>
                <div class="call-btn">
                  <p>Want to talk right away?</p>
                  <a href="https://connectgroup2.pipedrive.com/scheduler/X9PLw7U1/meeting-with-kate-williams?utm_source=LP&utm_term=cbss" class="btn btn-default book-btn">
                    <img src="/assets/images/call.svg" class="img-fluid" />Book a Free Call </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>