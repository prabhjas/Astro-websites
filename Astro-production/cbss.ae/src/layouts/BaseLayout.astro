---
interface Props {
  title?: string;
  description?: string;
}

import { licenceSchemaFragment } from '../lib/licence.ts';

const {
  title = 'CBSS',
  description = 'Expert business advisory for confident expansion in Dubai.',
} = Astro.props;

const siteOrigin = (Astro.site?.origin ?? 'https://cbss.ae').replace(/\/$/, '');

/**
 * Organization schema — the machine-readable half of the footer licence band.
 * legalName / identifier / hasCredential are what search engines and AI agents
 * actually read when judging whether a business is a real, licensed entity.
 * licenceSchemaFragment() returns {} while the licence record is incomplete.
 */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${siteOrigin}/#organization`,
  name: 'CBSS',
  ...licenceSchemaFragment(),
  url: siteOrigin,
  description,
  logo: `${siteOrigin}/assets/images/cbss-logo.png`,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'AE',
    addressRegion: 'Dubai',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United Arab Emirates',
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'Connect Group',
    url: 'https://connectgroup.co/',
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-74QG9D45EM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-74QG9D45EM');
    </script>
    <script async custom-element="amp-analytics" src="https://cdn.ampproject.org/v0/amp-analytics-0.1.js"></script>
    <amp-analytics config="https://www.googletagmanager.com/amp.json?id=GTM-WVPJJKC8&gtm.url=SOURCE_URL" data-credentials="include"></amp-analytics>

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      integrity="sha256-eZrrJcwDc/3uDhsdt61sL2oOBY362qM3lon1gyExkL0="
      crossorigin="anonymous"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/css/intlTelInput.css" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
