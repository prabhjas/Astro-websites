---
interface Props {
  title?: string;
  description?: string;
}

import { licenceSchemaFragment } from '../lib/licence.ts';

const {
  title = 'CBSS',
  description = 'Expert business advisory for confident expansion in Dubai.',
} = Astro.props;

const siteOrigin = (Astro.site?.origin ?? 'https://cbss.ae').replace(/\/$/, '');

/**
 * Organization schema — the machine-readable half of the footer licence band.
 * legalName / identifier / hasCredential are what search engines and AI agents
 * actually read when judging whether a business is a real, licensed entity.
 * licenceSchemaFragment() returns {} while the licence record is incomplete.
 */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${siteOrigin}/#organization`,
  name: 'CBSS',
  ...licenceSchemaFragment(),
  url: siteOrigin,
  description,
  logo: `${siteOrigin}/assets/images/cbss-logo.png`,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'AE',
    addressRegion: 'Dubai',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United Arab Emirates',
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'Connect Group',
    url: 'https://connectgroup.co/',
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined} />

    <!-- Open Graph / Twitter — SEO & AI crawler audit 2026-08-06 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CBSS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : siteOrigin} />
    <meta property="og:image" content={`${siteOrigin}/assets/images/cbss-logo.png`} />
    <meta property="og:locale" content="en_AE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}/assets/images/cbss-logo.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-74QG9D45EM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-74QG9D45EM');
    </script>
    <script async custom-element="amp-analytics" src="https://cdn.ampproject.org/v0/amp-analytics-0.1.js"></script>
    <amp-analytics config="https://www.googletagmanager.com/amp.json?id=GTM-WVPJJKC8&gtm.url=SOURCE_URL" data-credentials="include"></amp-analytics>

    <link rel="stylesheet" href="/assets/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link
      rel="stylesheet"
      href="/assets/vendor/font-awesome/css/font-awesome.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/vendor/owl-carousel/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="/assets/vendor/owl-carousel/assets/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/assets/vendor/intl-tel-input/css/intlTelInput.css" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
