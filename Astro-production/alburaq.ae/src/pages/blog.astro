---
/**
 * Blog / Insights index — Impreza us_grid mirror (src/legacy/blog.cleaned.html).
 * Pagination uses regular /blog/page/N/ links (not AJAX blog-list).
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { injectRuntimeGtmLoader } from '../lib/gtm/inject';
import { applySharedChrome } from '../lib/shared-chrome.js';
import { resolveSiteOrigin } from '../lib/seo/site-url';
import { buildInsightsCardHtml, getAllBlogPosts } from '../lib/blog.ts';
import * as cheerio from 'cheerio';

export const prerender = false;

const BLOG_INITIAL = 12;
const BLOG_PER_PAGE = 6;

function injectLatestBlogCards(html: string): string {
  const $ = cheerio.load(html);
  const loadmore = $('.ecs-posts').filter((_, el) =>
    String($(el).attr('data-settings') || '').includes('loadmore'),
  ).first();
  const grid = loadmore.length ? loadmore : $('.ecs-posts.elementor-posts-container').first();
  if (grid.length) {
    const posts = getAllBlogPosts();
    grid.html(posts.slice(0, BLOG_INITIAL).map(buildInsightsCardHtml).join('\n'));
  }
  return $.html();
}

function absolutizeBlogSeo(html: string): string {
  let origin = '';
  try {
    origin = resolveSiteOrigin();
  } catch {
    /* keep default */
  }
  const absolutePage = `${origin}/blog/`;
  let out = html;
  if (/rel=["']canonical["']/i.test(out)) {
    out = out.replace(
      /<link\s+rel=["']canonical["']\s+href=["'][^"']*["']\s*\/?>/i,
      `<link rel="canonical" href="${absolutePage}" />`,
    );
  }
  out = out.replace(
    /<meta\s+[^>]*property=["']og:url["'][^>]*>/gi,
    `<meta property="og:url" content="${absolutePage}" />`,
  );
  out = out.replace(
    /(<meta\s+(?:property|name)=["'](?:og:image|twitter:image)["']\s+content=["'])(\/[^"']+)(["'])/gi,
    `$1${origin}$2$3`,
  );
  return out;
}

function decorateBlogPage(html: string): string {
  let out = html;

  // Do NOT inject alburaq-blog-listing.js — live uses Impreza us_grid + /blog/page/N/.
  out = out.replace(
    /<script[^>]*id="custom-blog-listing-script-js"[^>]*><\/script>/i,
    '<!-- WP custom-blog-listing removed -->',
  );
  out = out.replace(
    /<script[^>]*src="[^"]*alburaq-blog-listing\.js[^"]*"[^>]*><\/script>/gi,
    '<!-- alburaq-blog-listing removed — Astro /api/blog/load-more -->',
  );

  out = out.replace(
    /<script[^>]*src="[^"]*ecs_ajax_pagination\.js[^"]*"[^>]*><\/script>/gi,
    '<!-- ecs_ajax_pagination removed (Astro /api/blog/load-more) -->',
  );
  out = out.replace(
    /<script[^>]*>\s*var\s+ecs_ajax_params\s*=[\s\S]*?<\/script>/gi,
    '<!-- ecs_ajax_params removed -->',
  );

  // Wire Astro Load More (replaces ECS admin-ajax /blog/?page=2).
  out = out.replace(
    /<nav([^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*)>/i,
    `<nav$1 data-cs-blog-load-more data-next-page="2" data-per-page="${BLOG_PER_PAGE}" data-offset="${BLOG_INITIAL}" data-loading-text="Loading...">`,
  );
  out = out.replace(
    /(<nav[^>]*ecs-load-more-button[\s\S]*?<a[^>]*href=")[^"]*(")/i,
    '$1javascript:void(0)$2',
  );

  if (!out.includes('blog-load-more.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/blog-load-more.js" defer></script>\n</body>`,
    );
  }

  if (!out.includes('astro-mirror-fixes.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/astro-mirror-fixes.js?v=20260807-ux5" defer></script>\n</body>`,
    );
  } else {
    out = out.replace(
      /\/js\/astro-mirror-fixes\.js(?:\?[^"']*)?/g,
      '/js/astro-mirror-fixes.js?v=20260807-ux5',
    );
  }

  if (!out.includes('cf-email-decode.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/cf-email-decode.js" defer></script>\n</body>`,
    );
  }

  // Active pagination styles match live us-nav-style_6 (teal inactive, light current).
  if (!out.includes('data-alburaq-blog-pagination-css')) {
    const css = `<style data-alburaq-blog-pagination-css="1">
.nav-links.custom.us-nav-style_6{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;align-items:center;margin:2rem 0 1rem;}
.nav-links.custom.us-nav-style_6 .page-numbers{
  display:inline-flex;align-items:center;justify-content:center;min-width:42px;height:42px;padding:0 12px;
  border-radius:8px;font-weight:600;text-decoration:none;border:1px solid transparent;cursor:pointer;pointer-events:auto!important;z-index:2;position:relative;
}
.nav-links.custom.us-nav-style_6 a.page-numbers{background:var(--color-content-primary,#00a88e);color:#fff!important;border-color:transparent;}
.nav-links.custom.us-nav-style_6 a.page-numbers:hover{filter:brightness(0.95);}
.nav-links.custom.us-nav-style_6 span.page-numbers.current{
  background:#fff;color:#1a1a1a!important;border:1px solid #d0d5dd;cursor:default;
}
.nav-links.custom.us-nav-style_6 span.page-numbers.dots{background:transparent;border:0;min-width:auto;color:#667085;}
.nav-links.custom.us-nav-style_6 a.prev.page-numbers,
.nav-links.custom.us-nav-style_6 a.next.page-numbers{background:var(--color-content-primary,#00a88e);color:#fff!important;}
</style>`;
    out = /<\/head>/i.test(out) ? out.replace(/<\/head>/i, `${css}\n</head>`) : css + out;
  }

  return out;
}

const cleanedPath = join(process.cwd(), 'src/legacy/blog.cleaned.html');
if (!existsSync(cleanedPath)) {
  return new Response('Blog page not prepared', { status: 404 });
}

let html = readFileSync(cleanedPath, 'utf8');
html = injectLatestBlogCards(html);
html = absolutizeBlogSeo(decorateBlogPage(injectRuntimeGtmLoader(applySharedChrome(html, 'blog'))));

return new Response(html, {
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    'Cache-Control': 'public, max-age=0',
  },
});
---
