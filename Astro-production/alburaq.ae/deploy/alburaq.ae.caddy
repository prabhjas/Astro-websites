# alburaq.ae -> 127.0.0.1:5120 (systemd: alburaq.service)
#
# PRODUCTION STANDARD (single /etc/caddy/Caddyfile — see caddy/Caddyfile.production).
# This file is the site block to keep in sync with the live fleet Caddyfile.
#
# When deploying / adding this site on the server you MUST also:
#   1. Ensure the shared one-hop HTTP alt-host block lists http://alburaq.ae
#      and redirects to https://alburaq.ae{uri}
#   2. Match PUBLIC_SITE_URL=https://alburaq.ae
#   3. Cloudflare SSL = Full (not Flexible; named CA astro_origin_2026 on origin — not Full strict until certs match)
#   4. sudo -u caddy caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Local laptop: do NOT run this Caddy block — use fleet-local on :5120 only.
# Docs: docs/CONNECT-CADDY-DEPLOYMENT.md

alburaq.ae, www.alburaq.ae {
	tls force_automate {
		issuer internal {
			ca astro_origin_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/alburaq.ae/alburaq.ae.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/alburaq.ae/alburaq.ae.key
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.alburaq.ae/www.alburaq.ae.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.alburaq.ae/www.alburaq.ae.key
	encode zstd gzip

	@noncanonical host www.alburaq.ae
	redir @noncanonical https://alburaq.ae{uri} permanent

	reverse_proxy 127.0.0.1:5120

	@static path_regexp static \.(css|js|woff|woff2|webp|jpg|jpeg|png|gif|svg|ico|avif|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/alburaq.ae-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
