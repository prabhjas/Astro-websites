---
/**
 * Blog index — Elementor ECS posts mirror (src/legacy/blog.cleaned.html).
 * "More Articles" uses /api/blog/load-more/ (Astro), not WP admin-ajax.
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { injectRuntimeGtmLoader } from '../lib/gtm/inject';
import { applySharedChrome } from '../lib/shared-chrome.js';
import { enrichMirrorSeoHtml } from '../lib/seo/enrich-mirror-meta';
import { resolveSiteOrigin } from '../lib/seo/site-url';
import { absolutizeMirrorSeoHtml } from '@connect/site-cms';
import { buildInsightsCardHtml, getAllBlogPosts } from '../lib/blog.ts';
import * as cheerio from 'cheerio';

export const prerender = false;

const INITIAL_CARDS = 15;

function injectLatestBlogCards(html: string): string {
  const $ = cheerio.load(html);
  const posts = getAllBlogPosts();

  const fillCard = ($card: ReturnType<typeof $>, post: (typeof posts)[0]) => {
    const postUrl = `/${post.slug}/`;
    const imgSrc = post.featuredImage?.src || '';
    const desc = String(post.description || '')
      .replace(/<[^>]+>/g, '')
      .slice(0, 180);
    const authorName = String(post.author?.name || '')
      .replace(/<[^>]+>/g, '')
      .trim();
    let dateDisplay = post.publishedAt;
    try {
      dateDisplay = new Date(post.publishedAt).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    } catch {
      /* keep iso */
    }
    $card.find('a[href]').attr('href', postUrl);
    $card.find('h2 a, h3 a').first().text(post.title);
    const $excerpt = $card.find('.elementor-widget-theme-post-excerpt p').first();
    if ($excerpt.length && desc) $excerpt.text(desc);
    if (authorName) $card.find('.elementor-post-info__item--type-author').first().text(authorName);
    $card.find('time').first().text(dateDisplay);
    if (imgSrc) {
      $card.find('style').each((_, el) => {
        const css = $(el).html() || '';
        if (/background-image/i.test(css)) {
          $(el).html(css.replace(/url\((['"]?)[^)'"]+\1\)/gi, `url("${imgSrc}")`));
        }
      });
    }
  };

  const featuredGrid = $('.elementor-element-43bded0 .ecs-posts').first();
  if (featuredGrid.length && posts[0]) {
    const art = featuredGrid.find('article').first();
    if (art.length) fillCard(art, posts[0]);
  }
  const recentGrid = $('.elementor-element-f9d7dad .ecs-posts').first();
  if (recentGrid.length) {
    recentGrid.find('article').each((i, el) => {
      if (posts[i]) fillCard($(el), posts[i]);
    });
  }

  const loadmore = $('.ecs-posts').filter((_, el) =>
    String($(el).attr('data-settings') || '').includes('loadmore'),
  ).first();
  const grid = loadmore.length ? loadmore : $('.ecs-posts.elementor-posts-container').last();
  if (grid.length) {
    grid.html(posts.slice(0, INITIAL_CARDS).map(buildInsightsCardHtml).join('\n'));
  }
  return $.html();
}

function absolutizeBlogSeo(html: string): string {
  let origin = 'https://emiratisationgate.org';
  try {
    origin = resolveSiteOrigin();
  } catch {
    /* keep default */
  }
  const absolutePage = `${origin}/blog/`;
  let out = html;
  if (/rel=["']canonical["']/i.test(out)) {
    out = out.replace(
      /<link\s+rel=["']canonical["']\s+href=["'][^"']*["']\s*\/?>/i,
      `<link rel="canonical" href="${absolutePage}" />`,
    );
  }
  out = out.replace(
    /<meta\s+[^>]*property=["']og:url["'][^>]*>/gi,
    `<meta property="og:url" content="${absolutePage}" />`,
  );
  out = out.replace(
    /(<meta\s+(?:property|name)=["'](?:og:image|twitter:image)["']\s+content=["'])(\/[^"']+)(["'])/gi,
    `$1${origin}$2$3`,
  );
  return out;
}

function decorateBlogPage(html: string): string {
  let out = html;

  out = out.replace(
    /<script[^>]*id="custom-blog-listing-script-js"[^>]*><\/script>/i,
    '<!-- WP custom-blog-listing removed -->',
  );
  out = out.replace(
    /<script[^>]*src="[^"]*emiratisationgate-blog-listing\.js[^"]*"[^>]*><\/script>/gi,
    '<!-- emiratisationgate-blog-listing removed -->',
  );

  // Strip ECS WP admin-ajax — conflicts with Astro /api/blog/load-more.
  out = out.replace(
    /<script[^>]*src="[^"]*ecs_ajax_pagination\.js[^"]*"[^>]*><\/script>/gi,
    '<!-- ecs_ajax_pagination removed (Astro /api/blog/load-more) -->',
  );
  out = out.replace(
    /<script[^>]*>\s*var\s+ecs_ajax_params\s*=[\s\S]*?<\/script>/gi,
    '<!-- ecs_ajax_params removed -->',
  );

  // WP nbcpf double-inits intlTelInput with Astro ensurePhoneCountryFields.
  out = out.replace(
    /<script[^>]*id=["']nbcpf-countryFlag-script-js-after["'][^>]*>[\s\S]*?<\/script>/gi,
    '<!-- nbcpf intlTelInput init removed (Astro ensurePhoneCountryFields) -->',
  );

  // Wire Astro More Articles (replaces ECS admin-ajax).
  out = out.replace(
    /<nav([^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*)>/i,
    '<nav$1 data-cs-blog-load-more data-next-page="2" data-per-page="15" data-offset="15" data-loading-text="Loading...">',
  );
  // Neutralize WP ajax href until our script binds.
  out = out.replace(
    /(<nav[^>]*ecs-load-more-button[\s\S]*?<a[^>]*href=")[^"]*(")/i,
    '$1javascript:void(0)$2',
  );

  if (!out.includes('blog-load-more.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/blog-load-more.js?v=20260806-author1" defer></script>\n</body>`,
    );
  } else {
    out = out.replace(
      /\/js\/blog-load-more\.js(?:\?[^"']*)?/g,
      '/js/blog-load-more.js?v=20260806-author1',
    );
  }

  if (!out.includes('astro-mirror-fixes.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/astro-mirror-fixes.js?v=20260806-flag4" defer></script>\n</body>`,
    );
  } else {
    out = out.replace(
      /\/js\/astro-mirror-fixes\.js(?:\?[^"']*)?/g,
      '/js/astro-mirror-fixes.js?v=20260806-flag4',
    );
  }

  if (!out.includes('cf-email-decode.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/cf-email-decode.js" defer></script>\n</body>`,
    );
  }

  return out;
}

const cleanedPath = join(process.cwd(), 'src/legacy/blog.cleaned.html');
if (!existsSync(cleanedPath)) {
  return new Response('Blog page not prepared', { status: 404 });
}

let html = readFileSync(cleanedPath, 'utf8');
html = decorateBlogPage(injectRuntimeGtmLoader(applySharedChrome(html, 'blog')));
html = injectLatestBlogCards(html);
html = absolutizeBlogSeo(html);
let siteOrigin = 'https://emiratisationgate.org';
try {
  siteOrigin = resolveSiteOrigin();
} catch {
  /* keep default */
}
html = absolutizeMirrorSeoHtml(html, { siteOrigin, path: '/blog/' });
html = enrichMirrorSeoHtml(html, `${siteOrigin}/blog/`);

return new Response(html, {
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    'Cache-Control': 'public, max-age=0',
  },
});
---
