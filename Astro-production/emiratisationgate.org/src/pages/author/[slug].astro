---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getAuthorPageData, serveAuthorArchive } from '../../lib/authors.ts';
import { getPostsByAuthorSlug, injectAuthorMirrorCards } from '../../lib/blog.ts';
import { serveLegacyPage } from '../../lib/legacy-page.js';
import { notFoundResponse } from '../../lib/not-found.js';

export const prerender = false;

const slug = Astro.params.slug!;
const data = getAuthorPageData(slug, 1);
const mirrorSlug = `author/${slug}`;
const mirror = join(process.cwd(), 'src/legacy', `${mirrorSlug}.cleaned.html`);
if (existsSync(mirror)) {
  const res = serveLegacyPage(mirrorSlug);
  const html = injectAuthorMirrorCards(await res.text(), getPostsByAuthorSlug(slug));
  return new Response(html, {
    status: res.status,
    headers: {
      'Content-Type': 'text/html; charset=utf-8',
      'Cache-Control': 'public, max-age=0',
    },
  });
}

if (!data) {
  return notFoundResponse();
}
return serveAuthorArchive(data);
---
