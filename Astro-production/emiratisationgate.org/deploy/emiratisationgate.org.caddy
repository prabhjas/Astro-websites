# emiratisationgate.org -> 127.0.0.1:5105 (systemd: emiratisationgate.service)
#
# PRODUCTION STANDARD (single /etc/caddy/Caddyfile — see caddy/Caddyfile.production).
# This file is the site block to keep in sync with the live fleet Caddyfile.
#
# When deploying / adding this site on the server you MUST also:
#   1. Ensure the shared one-hop HTTP alt-host block lists http://emiratisationgate.org
#      and redirects to https://emiratisationgate.org{uri}
#   2. Match PUBLIC_SITE_URL=https://emiratisationgate.org
#   3. Cloudflare SSL = Full (not Flexible); Full (strict) is intentionally deferred for this named internal CA.
#   4. sudo -u caddy caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Local laptop: do NOT run this Caddy block — use fleet-local on :5105 only.
# Docs: docs/CONNECT-CADDY-DEPLOYMENT.md

emiratisationgate.org, www.emiratisationgate.org {
	tls force_automate {
		issuer internal {
			ca astro_origin_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/emiratisationgate.org/emiratisationgate.org.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/emiratisationgate.org/emiratisationgate.org.key
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.emiratisationgate.org/www.emiratisationgate.org.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.emiratisationgate.org/www.emiratisationgate.org.key
	encode zstd gzip

	@noncanonical host www.emiratisationgate.org
	redir @noncanonical https://emiratisationgate.org{uri} permanent

	reverse_proxy 127.0.0.1:5105

	@static path_regexp static \.(css|js|woff|woff2|webp|jpg|jpeg|png|gif|svg|ico|avif|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/emiratisationgate.org-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
