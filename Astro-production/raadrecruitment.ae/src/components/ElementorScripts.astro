---
/**
 * jQuery + Astra + Elementor + Smart Slider + CF7 scripts for RAAD Recruitment.
 * Order mirrors live homepage (`src/data/live-js-order.json`).
 */
import liveJsOrder from "../data/live-js-order.json";

const skip = new Set([
  "/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js",
]);

const scripts = (liveJsOrder as string[]).filter((src) => !skip.has(src));

/** Smart Slider scripts must load after the _N2 bootstrap and before the per-page init. */
const smartSliderSrc = new Set([
  "/wp-content/plugins/smart-slider-3/Public/SmartSlider3/Application/Frontend/Assets/dist/n2.min.js",
  "/wp-content/plugins/smart-slider-3/Public/SmartSlider3/Application/Frontend/Assets/dist/smartslider-frontend.min.js",
  "/wp-content/plugins/smart-slider-3/Public/SmartSlider3/Slider/SliderType/Simple/Assets/dist/ss-simple.min.js",
  "/wp-content/plugins/smart-slider-3/Public/SmartSlider3/Widget/Bullet/Assets/dist/w-bullet.min.js",
  "/wp-content/plugins/smart-slider-3/Public/SmartSlider3/Widget/Arrow/ArrowImage/Assets/dist/w-arrow-image.min.js",
]);
const smartSliderScripts = scripts.filter((src) => smartSliderSrc.has(src));
const otherScripts = scripts.filter((src) => !smartSliderSrc.has(src));
---

{/* Smart Slider 3: live WP injects _N2 queue + SmartSliderSimple('n2-ss-*') inlines */}
{smartSliderScripts.map((src) => <script is:inline src={src} />)}
<script is:inline src="/scripts/smart-slider/init-home.js"></script>
{/* WP `wp_localize_script` for Astra — without this, frontend.js throws and the hamburger never binds */}
<script is:inline>
  window.astra = window.astra || {
    break_point: "921",
    isRtl: "",
    is_scroll_to_id: "1",
    is_scroll_to_top: "1",
    is_header_footer_builder_active: "1",
    responsive_cart_click: "flyout",
    is_dark_palette: "",
  };
</script>
{otherScripts.map((src) => <script is:inline src={src} />)}

<script is:inline src="/scripts/fix-content-image-srcset.js"></script>
<script is:inline src="/scripts/phone-flags.js"></script>
<script>
  import { captureAttribution, populateAttributionFields } from '../lib/attribution/client';

  function applyAttribution(form: HTMLFormElement) {
    const formId = form.id || form.getAttribute('name') || 'raadrecruitment-cf7';
    const named = form.querySelector('[name="form_name"]') as HTMLInputElement | null;
    const formName =
      named?.value || form.getAttribute('aria-label') || 'RAAD Recruitment Contact Form';
    const captured = captureAttribution(formId, formName);
    populateAttributionFields(form, captured.firstTouch, captured.lastTouch);
  }

  (window as Window & { __eorApplyAttribution?: (form: HTMLFormElement) => void }).__eorApplyAttribution =
    applyAttribution;

  document.addEventListener('DOMContentLoaded', () => {
    document
      .querySelectorAll<HTMLFormElement>(
        'form.wpcf7-form, form[data-sp-contact-form], form.cg-contact-form',
      )
      .forEach((form) => applyAttribution(form));
  });
</script>
<script is:inline src="/scripts/cf7-bridge.js"></script>
<script is:inline src="/js/astro-mirror-fixes.js"></script>
<script is:inline src="/scripts/blog-load-more.js"></script>
<script is:inline src="/scripts/accordion.js"></script>
