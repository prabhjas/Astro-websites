---
interface Props {
  items: { name: string; href?: string }[];
  /** Optional extra class on the nav (e.g. for page-chrome placement). */
  class?: string;
}

const { items, class: className = "" } = Astro.props;
const navClass = ["sp-breadcrumbs", className].filter(Boolean).join(" ");
---

<nav class={navClass} aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, i) => {
        const isCurrent = i === items.length - 1;
        return (
          <li>
            {!isCurrent && item.href ? (
              <a href={item.href}>{item.name}</a>
            ) : (
              <span aria-current="page">{item.name}</span>
            )}
            {!isCurrent ? <span class="sep" aria-hidden="true">/</span> : null}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .sep {
    opacity: 0.55;
  }
</style>
