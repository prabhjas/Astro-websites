---
import SEOHead from "../components/SEOHead.astro";
import ElementorHeader from "../components/ElementorHeader.astro";
import ElementorFooter from "../components/ElementorFooter.astro";
import ElementorScripts from "../components/ElementorScripts.astro";
import type { SeoInput } from "../lib/seo";
import type { SeoData } from "../lib/content";
import liveCssOrder from "../data/live-css-order.json";
import liveInlineCss from "../data/live-inline-css.json";
import smartSliderCss from "../data/smart-slider-css.json";
import { resolveInternalAdminDir } from "../env/server";
import "../styles/global.css";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
  currentPath?: string;
  /** Force header nav active item (e.g. "/blog/" on single posts) */
  menuActivePath?: string;
  bodyClass?: string;
}

const {
  seo = {},
  fallback,
  extraCss = [],
  currentPath = Astro.url.pathname,
  menuActivePath,
  bodyClass = "",
} = Astro.props;

/**
 * Live site = Astra + Elementor. Stylesheet order mirrors production homepage
 * (`src/data/live-css-order.json` via `scripts/sync-live-css-order.mjs`).
 */
const skipInline = new Set([
  "/css/live-inline/admin-bar-inline-css.css",
]);

const stylesheets = [
  ...new Set([
    ...(liveCssOrder as string[]),
    ...(liveInlineCss as string[]).filter((href) => !skipInline.has(href)),
    ...(smartSliderCss as string[]),
    ...extraCss,
    "/css/raadrecruitment-astra-fixes.css",
    "/css/raadrecruitment-mobile-nav.css",
  ]),
];

---

<!doctype html>
<html lang="en-AE">
  <head>
    <SEOHead seo={seo} fallback={fallback} extraCss={stylesheets} />
    <meta
      name="sp-contact-endpoint"
      content={import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/"}
    />
    <script is:inline define:vars={{ contactEndpoint: import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/" }}>
      window.__SP_CONTACT_ENDPOINT__ = contactEndpoint;
    </script>
    {/* Early _N2 queue so any mid-body slider markup can register before footer scripts */}
    <script is:inline src="/scripts/smart-slider/bootstrap.js"></script>
    <script src="/runtime-gtm.js" defer data-runtime-gtm="1"></script>
  </head>
  <body
    class:list={[
      "wp-custom-logo",
      "wp-embed-responsive",
      "wp-theme-astra",
      "wp-child-theme-astra-child-theme",
      "ast-desktop",
      "ast-plain-container",
      "ast-no-sidebar",
      "astra-4.13.1",
      "group-blog",
      "ast-inherit-site-logo-transparent",
      "ast-theme-transparent-header",
      "ast-hfb-header",
      "elementor-default",
      "elementor-kit-30",
      bodyClass,
    ]}
  >
    <div id="page" class="hfeed site">
      <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
      <ElementorHeader currentPath={currentPath} menuActivePath={menuActivePath} />
      <div id="content" class="site-content">
        <div class="ast-container">
          <div id="primary" class="content-area primary">
            <main id="main" class="site-main">
              <slot />
            </main>
          </div>
        </div>
      </div>
      <ElementorFooter />
    </div>
    <ElementorScripts />
  </body>
</html>
