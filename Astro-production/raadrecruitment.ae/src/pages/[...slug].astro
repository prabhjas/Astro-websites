---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConnectFzSinglePost from "../components/ConnectFzSinglePost.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {
  getPageByPath,
  getPublishedPostByPath,
  normalizePath,
  site,
  stripHtml,
} from "../lib/content";
import { injectBreadcrumbsHtml } from "../lib/inject-breadcrumbs";
import { renderBreadcrumbsHtml } from "../lib/render-breadcrumbs-html";
import { articleSchema, breadcrumbSchema } from "../lib/seo";
import { notFoundResponse } from "../lib/not-found";

export const prerender = false;

const slugParam = Astro.params.slug;
const slugPath = Array.isArray(slugParam) ? slugParam.join("/") : String(slugParam || "");
const path = normalizePath(`/${slugPath}`);

const page = getPageByPath(path);
const post = page ? null : getPublishedPostByPath(path);

if (!page && !post) {
  return notFoundResponse();
}

const entry = page || post!;
const rawHtml = (("bodyHtml" in entry && entry.bodyHtml) || entry.content) as string;

/** Service detail pages = footer / nav service links (not About, Contact, Blog, Home). */
const SERVICE_PATHS = new Set(
  (site.footerServices || []).map((s) => normalizePath(s.href)),
);
const isServicePage = !!page && SERVICE_PATHS.has(path);

const serviceLabel =
  (site.footerServices || []).find((s) => normalizePath(s.href) === path)?.label ||
  (page ? stripHtml(page.title) : "");
const pageTitle = page ? stripHtml(page.title) : "";
const postTitle = post ? stripHtml(post.title) : "";

/** Visible + schema: Home → Service */
const serviceCrumbs = isServicePage
  ? [
      { name: "Home", href: "/" },
      { name: serviceLabel },
    ]
  : [];

/** Visible + schema: Home → Blog → Post (listing is /blog/, not /insights/) */
const postCrumbs = post
  ? [
      { name: "Home", href: "/" },
      { name: "Blog", href: "/blog/" },
      { name: postTitle },
    ]
  : [];

/** Non-service pages keep schema-only crumbs (no visible trail required). */
const pageSchemaCrumbs = page
  ? isServicePage
    ? serviceCrumbs
    : [
        { name: "Home", href: "/" },
        { name: pageTitle },
      ]
  : [];

const seo = page
  ? {
      title: page.seo.title,
      description: page.seo.description,
      canonical: path,
      ogImage: page.seo.ogImage,
      schemas: [
        ...(page.seo.schemas || []),
        breadcrumbSchema(
          pageSchemaCrumbs.map((c) => ({ name: c.name, url: c.href || path })),
        ),
      ],
    }
  : {
      title: post!.seo.title || postTitle,
      description: post!.seo.description || stripHtml(post!.excerpt),
      canonical: path,
      ogImage: post!.seo.ogImage || post!.featuredImage,
      ogType: "article" as const,
      publishedTime: post!.date,
      modifiedTime: post!.modified,
      authorName: post!.authorName,
      schemas: [
        ...(post!.seo.schemas || []),
        breadcrumbSchema(postCrumbs.map((c) => ({ name: c.name, url: c.href || path }))),
        articleSchema(
          {
            title: postTitle,
            description: post!.seo.description || stripHtml(post!.excerpt),
            url: path,
            image: post!.featuredImage || post!.seo.ogImage,
            datePublished: post!.date,
            dateModified: post!.modified,
            authorName: post!.authorName,
          },
          Astro.url.origin,
        ),
      ],
    };

const isListingArchive =
  !!page &&
  (path.startsWith("/categories/") ||
    path.startsWith("/locations/") ||
    page.wpType === "mt_listing_archive");

/** Page/post CSS from content data only (Impreza - no Elementor kit CSS). */
const extraCss = page
  ? ([...(page.pageCss || [])].filter(Boolean) as string[])
  : ([...(post!.pageCss || [])].filter(Boolean) as string[]);

const postUsesElementor =
  !!post?.bodyHtml && /data-elementor-type=/.test(post.bodyHtml);

const pageBodyClass = page
  ? isListingArchive
    ? `archive tax-mt-listing-category term-${page.slug} page page-id-${page.id} taxonomy-listing-page`
    : `wp-singular page-template-default page page-id-${page.id} elementor-page elementor-page-${page.id}`
  : `wp-singular single single-post postid-${post!.id} post-${post!.id} post type-post status-publish elementor-page elementor-page-${post!.id}`;

/** Inject crumbs into Elementor HTML at the correct spot (not a standalone bar). */
const serviceCrumbHtml = isServicePage ? renderBreadcrumbsHtml(serviceCrumbs) : "";
const postCrumbHtml = post ? renderBreadcrumbsHtml(postCrumbs) : "";

const pageHtml =
  page && isServicePage
    ? injectBreadcrumbsHtml(rawHtml, serviceCrumbHtml, "service")
    : rawHtml;

const postHtml = post
  ? injectBreadcrumbsHtml(
      postUsesElementor ? post.bodyHtml || rawHtml : rawHtml,
      postCrumbHtml,
      "post",
      { postTitle },
    )
  : "";
---

<BaseLayout
  currentPath={path}
  bodyClass={pageBodyClass}
  fallback={entry.seo}
  extraCss={extraCss}
  seo={seo}
  menuActivePath={post ? "/blog/" : undefined}
>
  {
    page ? (
      <Fragment set:html={pageHtml} />
    ) : postUsesElementor ? (
      <Fragment set:html={postHtml} />
    ) : (
      <>
        <div class="sp-page-breadcrumbs sp-page-breadcrumbs--inline">
          <Breadcrumbs items={postCrumbs} />
        </div>
        <h1 class="sp-single-post-title">{postTitle}</h1>
        <ConnectFzSinglePost post={post!} html={rawHtml} />
      </>
    )
  }
</BaseLayout>
