---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageByPath, getPosts } from "../../lib/content";
import { INSIGHTS_GRID_PER_PAGE } from "../../lib/insights-archive";
import { breadcrumbSchema } from "../../lib/seo";
import { notFoundResponse } from "../../lib/not-found";

export const prerender = false;

/**
 * Live archive is Impreza `w-grid` + `.g-loadmore` (not Elementor ECS).
 * Featured top grid stays fixed; Load More belongs to Latest Articles (us_grid_2).
 */
const page = getPageByPath("/insights/");
if (!page) return notFoundResponse();

const totalPosts = getPosts().length;
let html = page.bodyHtml || page.content;

// Latest Articles = the w-grid immediately before `.g-loadmore` (not the featured top grid).
const loadMoreIndex = html.search(/<div class="g-loadmore\s*"/i);
const beforeLoadMore = loadMoreIndex >= 0 ? html.slice(0, loadMoreIndex) : html;
const gridIds = [...beforeLoadMore.matchAll(/id="(us_grid_\d+)"/g)].map((m) => m[1]);
const latestGridId = gridIds[gridIds.length - 1] || "us_grid_2";

const latestStart = html.indexOf(`id="${latestGridId}"`);
const latestChunk =
  latestStart >= 0 ? html.slice(latestStart, loadMoreIndex > latestStart ? loadMoreIndex : undefined) : html;
const initialCount = (latestChunk.match(/class="w-grid-item\b/g) || []).length;
const hasMore = totalPosts > initialCount;

html = html.replace(
  new RegExp(`(<div class="w-grid[^"]*"[^>]*id="${latestGridId}")`, "i"),
  `$1 data-sp-insights-grid="1"`,
);

html = html.replace(
  new RegExp(`(id="${latestGridId}"[\\s\\S]*?<div class="w-grid-list")`, "i"),
  `$1 data-sp-insights-list="1"`,
);

if (hasMore) {
  html = html.replace(
    /(<div class="g-loadmore\s*")/i,
    `$1 data-sp-insights-load-more="1" data-offset="${initialCount}" data-per-page="${INSIGHTS_GRID_PER_PAGE}"`,
  );
} else {
  html = html.replace(
    /<div class="g-loadmore[\s\S]*?<\/div>\s*(?=<div class="w-grid-json)/i,
    "",
  );
}

const extraCss = [
  ...(page.pageCss || []),
  page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
  "/wp-content/uploads/elementor/css/post-21423.css",
  "/wp-content/uploads/elementor/css/post-21574.css",
  "/css/insights-topic-cards.css",
];
---

<BaseLayout
  currentPath="/insights/"
  bodyClass={`page page-id-${page.id}`}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title || "Insights | RAAD Recruitment",
    description:
      page.seo.description ||
      "Manpower outsourcing insights and UAE workforce guides from RAAD Recruitment.",
    canonical: "/insights/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Insights", url: "/insights/" },
      ]),
    ],
  }}
>
  <Fragment set:html={html} />
</BaseLayout>
