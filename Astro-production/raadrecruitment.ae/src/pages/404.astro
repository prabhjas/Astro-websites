---
/**
 * Custom 404 for unknown / unprepared URLs.
 */
export const prerender = false;

Astro.response.status = 404;
Astro.response.statusText = "Not Found";
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | RAAD Recruitment</title>
    <meta
      name="description"
      content="The page you requested could not be found on RAAD Recruitment."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="stylesheet" href="/css/fonts-poppins.css" />
    <style>
      :root {
        --ng-ink: #0557CF;
        --ng-blue: #00C5F9;
        --ng-mist: #f5f8fc;
        --ng-line: #d7e0ec;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: Poppins, "Segoe UI", sans-serif;
        color: var(--ng-ink);
        background:
          radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0, 122, 194, 0.14), transparent),
          linear-gradient(180deg, #ffffff 0%, var(--ng-mist) 100%);
      }
      .wrap {
        width: min(40rem, calc(100% - 2.5rem));
        margin: 0 auto;
        padding: 3.5rem 0 4rem;
        text-align: center;
      }
      .logo {
        display: inline-block;
        margin-bottom: 2.5rem;
      }
      .logo img {
        display: block;
        width: min(220px, 55vw);
        height: auto;
      }
      .code {
        display: inline-block;
        margin: 0 0 0.75rem;
        padding: 0.2rem 0.65rem;
        border: 1px solid var(--ng-line);
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ng-blue);
        background: #fff;
      }
      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.75rem, 4vw, 2.35rem);
        line-height: 1.15;
        font-weight: 700;
      }
      p {
        margin: 0 auto 1.75rem;
        max-width: 28rem;
        font-size: 1.05rem;
        line-height: 1.55;
        color: #54657a;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
      }
      .actions a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: 0.65rem 1.25rem;
        border-radius: 0.35rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
      }
      .actions a.primary {
        color: #fff;
        background: var(--ng-blue);
      }
      .actions a.secondary {
        color: var(--ng-ink);
        background: #fff;
        border: 1px solid var(--ng-line);
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <a class="logo" href="/" aria-label="RAAD Recruitment home">
        <img
          src="/wp-content/uploads/2023/05/logo-NG-manpower.png"
          width="180"
          height="137"
          alt="RAAD Recruitment"
        />
      </a>
      <div class="code">404</div>
      <h1>Page not found</h1>
      <p>
        The page you are looking for may have been moved, renamed, or no longer
        exists. Try one of the links below.
      </p>
      <div class="actions">
        <a class="primary" href="/">Go to homepage</a>
        <a class="secondary" href="/insights/">Browse insights</a>
        <a class="secondary" href="/contact-us/">Contact us</a>
      </div>
    </main>
  </body>
</html>
