---
/**
 * Author directory — lists all authors from authors.json.
 * Individual archives live at /author/[slug]/.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  getAuthors,
  getPostsByAuthor,
  stripHtml,
} from "../../lib/content";
import { breadcrumbSchema } from "../../lib/seo";

export const prerender = false;

const DEFAULT_AVATAR =
  "https://secure.gravatar.com/avatar/?s=96&d=mm&r=g";

const listing = getAuthors()
  .map((author) => {
    const name = stripHtml(author.name).trim() || "Author";
    const path = author.path.endsWith("/") ? author.path : `${author.path}/`;
    const bio = stripHtml(author.description || "")
      .replace(/\s+/g, " ")
      .trim();
    const avatar = (author.avatar || "").trim() || DEFAULT_AVATAR;
    const postCount = getPostsByAuthor(author.id).length;
    return {
      id: author.id,
      slug: author.slug,
      name,
      path,
      bio,
      avatar,
      postCount,
    };
  })
  .sort(
    (a, b) =>
      b.postCount - a.postCount || a.name.localeCompare(b.name, undefined, { sensitivity: "base" }),
  );
---

<BaseLayout
  currentPath="/author/"
  bodyClass="archive author author-directory"
  seo={{
    title: "Authors | RAAD Recruitment",
    description:
      "Browse RAAD Recruitment authors and contributors. Read articles on recruitment, staffing, and HR in the UAE.",
    canonical: "/author/",
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog/" },
        { name: "Authors", url: "/author/" },
      ]),
    ],
  }}
  menuActivePath="/blog/"
>
  <section class="cfz-archive-hero">
    <div class="cfz-archive-hero__inner">
      <Breadcrumbs
        items={[
          { name: "Home", href: "/" },
          { name: "Blog", href: "/blog/" },
          { name: "Authors" },
        ]}
      />
      <h1>Authors</h1>
      <p class="cfz-archive-hero__bio">
        Meet the writers behind RAAD Recruitment insights on recruitment, staffing, and workforce solutions in the UAE.
      </p>
    </div>
  </section>

  <section class="cfz-archive-grid">
    <h2 class="cfz-archive-grid__heading">All authors</h2>
    {
      listing.length === 0 ? (
        <p>No authors found.</p>
      ) : (
        <ul class="cfz-author-dir">
          {
            listing.map((author) => (
              <li>
                <a class="cfz-author-dir__card" href={author.path}>
                  <span class="cfz-author-dir__avatar">
                    <img
                      src={author.avatar}
                      alt=""
                      width="72"
                      height="72"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="cfz-author-dir__body">
                    <span class="cfz-author-dir__name">{author.name}</span>
                    <span class="cfz-author-dir__count">
                      {author.postCount}{" "}
                      {author.postCount === 1 ? "article" : "articles"}
                    </span>
                    {author.bio ? (
                      <span class="cfz-author-dir__bio">{author.bio}</span>
                    ) : null}
                  </span>
                  <span class="cfz-author-dir__cta">View articles</span>
                </a>
              </li>
            ))
          }
        </ul>
      )
    }
  </section>
</BaseLayout>
