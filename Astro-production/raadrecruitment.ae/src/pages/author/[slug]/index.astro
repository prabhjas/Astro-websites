---
/**
 * Author archive — Elementor-861 blog cards + AJAX Load More
 * (reuses /api/blog/load-more + blog-load-more.js).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import {
  getAuthorBySlug,
  getPostsByAuthor,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
} from "../../../lib/content";
import { renderBlogCardsHtml } from "../../../lib/blog-card-html";
import { breadcrumbSchema } from "../../../lib/seo";
import { notFoundResponse } from "../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const author = getAuthorBySlug(slug);
if (!author) {
  return notFoundResponse();
}

const sorted = getPostsByAuthor(author.id);
const { items, hasNext } = paginate(sorted, 1, POSTS_PER_PAGE);
const cardsHtml = items.length ? renderBlogCardsHtml(items) : "";
const name = stripHtml(author.name);
const bio = stripHtml(author.description || "").replace(/\s+/g, " ").trim();
---

<BaseLayout
  currentPath={author.path}
  bodyClass={`archive author author-${author.slug} author-${author.id}`}
  seo={{
    title: `${name}, Author at RAAD Recruitment`,
    description: bio || `Articles by ${name} on RAAD Recruitment.`,
    canonical: author.path,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog/" },
        { name: "Authors", url: "/author/" },
        { name, url: author.path },
      ]),
    ],
  }}
  extraCss={["/wp-content/uploads/elementor/css/post-861.css"]}
  menuActivePath="/blog/"
>
  <section class="cfz-archive-hero">
    <div class="cfz-archive-hero__inner">
      <Breadcrumbs
        items={[
          { name: "Home", href: "/" },
          { name: "Blog", href: "/blog/" },
          { name: "Authors", href: "/author/" },
          { name },
        ]}
      />
      <h1>{name}</h1>
      {bio ? <p class="cfz-archive-hero__bio">{bio}</p> : null}
    </div>
  </section>

  <section class="cfz-archive-grid">
    <h2 class="cfz-archive-grid__heading">Posts by {name}</h2>
    {
      items.length ? (
        <>
          <div
            class="elementor-grid elementor-posts-container elementor-grid-3"
            data-sp-author-grid
            set:html={cardsHtml}
          />
          {
            hasNext ? (
              <div
                class="cfz-archive-load-more"
                data-sp-author-load-more
                data-author-slug={author.slug}
                data-per-page={String(POSTS_PER_PAGE)}
              >
                <button type="button" class="cfz-archive-load-more__btn">
                  Load More
                </button>
              </div>
            ) : null
          }
        </>
      ) : (
        <p>No posts by this author yet.</p>
      )
    }
  </section>
</BaseLayout>
