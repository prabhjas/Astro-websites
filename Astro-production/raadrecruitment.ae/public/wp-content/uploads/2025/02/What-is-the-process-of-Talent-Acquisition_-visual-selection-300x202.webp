	width:100% !important;
}



#overlay {
  position: fixed; 
  display:none;
  width: 100%; 
  height: 100%;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5); 
  z-index: 99; 
  cursor: pointer; 
}

:not(#\20):not(#\20):not(#\20).buttonizer-group-0-0-1{
