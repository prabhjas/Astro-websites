# connectbusinesscenter.com → 127.0.0.1:5116 (systemd: connectbusinesscenter.service)
#
# PRODUCTION STANDARD (single /etc/caddy/Caddyfile — see caddy/Caddyfile.production).
# This file is the site block to keep in sync with the live fleet Caddyfile.
#
# When deploying / adding this site on the server you MUST also:
#   1. Ensure the shared one-hop HTTP alt-host block lists http://www.connectbusinesscenter.com
#      and redirects to https://connectbusinesscenter.com{uri}
#   2. Match PUBLIC_SITE_URL=https://connectbusinesscenter.com
#   3. Cloudflare SSL = Full (not Flexible / not Full strict with tls internal)
#   4. sudo -u caddy caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Local laptop: do NOT run this Caddy block — use fleet-local on :5116 only.
# Docs: docs/CONNECT-CADDY-DEPLOYMENT.md

connectbusinesscenter.com, www.connectbusinesscenter.com {
	tls internal
	encode zstd gzip

	@noncanonical host www.connectbusinesscenter.com
	redir @noncanonical https://connectbusinesscenter.com{uri} permanent

	reverse_proxy 127.0.0.1:5116

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https:; frame-src 'self' https:; worker-src 'self' blob:"
	}
	log {
		output file /var/log/caddy/connectbusinesscenter.com-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
