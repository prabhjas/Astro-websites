---
interface Props {
  items: { name: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="sp-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {item.href && i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
          {i < items.length - 1 ? <span class="sep">/</span> : null}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .sep {
    opacity: 0.5;
    margin-left: 0.2rem;
  }
</style>
