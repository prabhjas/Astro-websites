---
import { formatDate, stripHtml, type PostEntry } from "../lib/content";

interface Props {
  post: PostEntry;
  /** First above-the-fold card: load its image eagerly + high priority (LCP). */
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
const excerpt = stripHtml(post.excerpt || post.content).slice(0, 140);
---

<article class="sp-post-card">
  <a href={post.path} class="sp-post-card__media">
    {
      post.featuredImage ? (
        <img
          src={post.featuredImage}
          alt={stripHtml(post.title)}
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : undefined}
          decoding={priority ? "sync" : "async"}
          width="640"
          height="400"
        />
      ) : (
        <div style="width:100%;height:100%;background:#1f1f1f"></div>
      )
    }
  </a>
  <div class="sp-post-card__body">
    <div class="sp-post-card__meta">{formatDate(post.date)}</div>
    <h3 class="sp-post-card__title">
      <a href={post.path} set:html={post.title} />
    </h3>
    {excerpt && <p class="sp-post-card__excerpt">{excerpt}…</p>}
  </div>
</article>
