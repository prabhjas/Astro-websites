---
import { resolveSeo, organizationSchema, type SeoInput } from "../lib/seo";
import { site, type SeoData } from "../lib/content";
// Self-hosted Mukta/Poppins/Spline Sans @font-face (latin + latin-ext). Inlined so the
// fonts define immediately at first paint with no second-origin request. Regenerate with
// scratchpad/fetch-fonts.mjs. Poppins (the site --font-family + LCP font) is also preloaded.
import selfHostedFonts from "../data/self-hosted-fonts.css?raw";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
  ogLocale?: string;
  /** Load extraCss + web fonts non-render-blocking (only when complete critical CSS is inlined). */
  asyncCss?: boolean;
  /** LCP preload link descriptors for this route (from cwv-manifest). */
  heroPreloads?: Array<Record<string, string>>;
}

const {
  seo = {},
  fallback,
  extraCss = [],
  ogLocale = "en_US",
  asyncCss = false,
  heroPreloads = [],
} = Astro.props;
const meta = resolveSeo(seo, fallback);

// Arabic /ar/ clones still need Noto Sans Arabic (not self-hosted here).
const arabicFontHref =
  "https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&display=swap";

const schemas = [organizationSchema(), ...meta.schemas];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<meta name="robots" content={meta.robots} />
<link rel="canonical" href={meta.canonical} />

<meta property="og:locale" content={ogLocale} />
<meta property="og:type" content={meta.ogType} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:site_name" content={meta.siteName} />
<meta property="og:image" content={meta.ogImage} />
<meta property="og:image:secure_url" content={meta.ogImage} />
<meta property="og:image:alt" content={meta.title} />

{meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}
{meta.modifiedTime && <meta property="article:modified_time" content={meta.modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.ogImage} />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
<link rel="icon" type="image/png" href={site.favicon192} sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon.ico" />

{
  /* Preload Poppins (the site --font-family + heading/LCP font), latin subset, the three
     weights used above the fold. Self-hosted + preloaded → the LCP heading paints in-brand
     at first paint with no swap reflow (kills the residual mobile font CLS, speeds LCP). */
  <>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Poppins-400-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Poppins-600-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Poppins-700-latin.woff2" crossorigin />
  </>
}
{/* Self-hosted @font-face (Mukta/Poppins/Spline Sans) inlined — no external font request. */}
<style is:inline set:html={selfHostedFonts}></style>
{
  /* Route LCP preloads (hero image / poster) from cwv-manifest — background/JS-driven
     images are discovered late, so hint them high-priority when we have a critical set. */
  heroPreloads.map((p) => <link rel="preload" {...p} />)
}
{ogLocale === "ar_AE" && (
  <>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={arabicFontHref} />
  </>
)}

{
  asyncCss ? (
    <>
      {/*
        Per-viewport CSS delivery (critical CSS is generated for the MOBILE fold):
        - Mobile: full CSS non-blocking (media="print" → all onload) — fast FCP, inline
          critical covers the mobile fold so no shift.
        - Desktop (≥1025px): a second render-blocking <link> — the mobile critical doesn't
          cover the desktop fold, so desktop must have full CSS before paint (no CLS).
          Same URL → served from cache, no double download.
        - <noscript>: plain blocking links when JS is off.
      */}
      {extraCss.map((href) => (
        <link rel="stylesheet" href={href} media="print" onload="this.media='all';this.onload=null;" />
      ))}
      {extraCss.map((href) => (
        <link rel="stylesheet" href={href} media="(min-width: 1025px)" />
      ))}
      <noscript set:html={extraCss.map((h) => `<link rel="stylesheet" href="${h}">`).join("")} />
    </>
  ) : (
    extraCss.map((href) => <link rel="stylesheet" href={href} />)
  )
}

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
