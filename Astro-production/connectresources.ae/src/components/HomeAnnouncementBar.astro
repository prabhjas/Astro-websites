---
/**
 * Homepage-only security advisory strip (above fixed header).
 * Scroll hide/show is handled by /scripts/home-announcement-bar.js
 */
---

<div class="cr-home-announcement-wrap" id="cr-home-announcement-wrap">
  <aside
    id="cr-home-announcement"
    class="cr-home-announcement"
    role="note"
    aria-label="Security advisory"
  >
    <p class="cr-home-announcement__text">
      Security Advisory: Fraudulent activity reported involving unauthorized parties
      requesting payment on behalf of Connect Resources. Connect Resources does not solicit payment from
      candidates or employees. Verify sender email addresses are from
      <a class="cr-home-announcement__domain" href="mailto:info@connectresources.ae">@connectresources.ae</a>
      or
      <a class="cr-home-announcement__domain" href="mailto:info@connectgroup.co">@connectgroup.co</a>
    </p>
  </aside>
</div>
