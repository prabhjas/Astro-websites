---
import { sanitizeMirrorHtml } from "@connect/site-cms";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PostCard from "../components/PostCard.astro";
import {
  getCategories,
  getPageByPath,
  getPublishedPostByPath,
  getRelatedPosts,
  formatDate,
  stripHtml,
  normalizePath,
  smartSliderCssForHtml,
  isArabicPath,
} from "../lib/content";
import {
  extractPressReleaseArticleHtml,
  isPressReleasePost,
  PRESS_LISTING_PATH,
  rebuildPressListingHtml,
} from "../lib/press";
import { articleSchema, breadcrumbSchema } from "../lib/seo";
import {
  isNoIndexNoFollowPath,
  NOINDEX_NOFOLLOW_ROBOTS,
} from "../lib/seo/sitemap-config";
import { notFoundResponse } from "../lib/not-found";

export const prerender = false;

const slugParam = Astro.params.slug;
const slugPath = Array.isArray(slugParam) ? slugParam.join("/") : String(slugParam || "");
const path = normalizePath(`/${slugPath}`);

const page = getPageByPath(path);
const post = page ? null : getPublishedPostByPath(path);

if (!page && !post) {
  return notFoundResponse();
}

const entry = page || post!;
const isPressRelease = Boolean(post && isPressReleasePost(post));
// Elementor/exported bodies are trusted mirrors — hygiene only (not sanitizeCmsHtml).
let html = sanitizeMirrorHtml((("bodyHtml" in entry && entry.bodyHtml) || entry.content || "") as string);

if (page && path === PRESS_LISTING_PATH) {
  html = rebuildPressListingHtml(html);
}

if (isPressRelease) {
  html = extractPressReleaseArticleHtml(html);
}

/** Astro sanitizes `<button>` in set:html; Impreza load-more needs a clickable control. */
if (page && path === "/insights/") {
  html = html.replace(
    /<button class="w-btn us-btn-style_1">\s*<span class="w-btn-label">Load More<\/span>\s*<\/button>/gi,
    '<a href="#" class="w-btn us-btn-style_1" role="button"><span class="w-btn-label">Load More</span></a>',
  );
}
const catNames = post ? getCategories().filter((c) => post.categories.includes(c.id)) : [];

const pageCrumbs = page
  ? [
      { name: "Home", href: "/" },
      { name: stripHtml(page.title), href: undefined as string | undefined },
    ]
  : [];

const related = post
  ? getRelatedPosts(post, 3).filter((p) =>
      isPressRelease ? isPressReleasePost(p) : !isPressReleasePost(p),
    )
  : [];
// Fall back if type-filtered related is empty
const relatedFinal =
  post && related.length === 0 ? getRelatedPosts(post, 3) : related;

const postCrumbs = post
  ? isPressRelease
    ? [
        { name: "Home", href: "/" },
        { name: "Press", href: PRESS_LISTING_PATH },
        { name: stripHtml(post.title) },
      ]
    : [
        { name: "Home", href: "/" },
        { name: "Blog", href: "/blog/" },
        { name: stripHtml(post.title) },
      ]
  : [];

const lpNoIndex = isNoIndexNoFollowPath(path);
/** Prefer canonical post.path so legacy /press-release/{slug}/ does not become the SEO URL. */
const postCanonical = post ? normalizePath(post.path || path) : path;

const seo = page
  ? {
      title: page.seo.title,
      description: page.seo.description,
      canonical: path,
      ogImage: page.seo.ogImage,
      ...(lpNoIndex ? { robots: NOINDEX_NOFOLLOW_ROBOTS } : {}),
      schemas: [
        ...(page.seo.schemas || []),
        breadcrumbSchema(pageCrumbs.map((c) => ({ name: c.name, url: c.href || path }))),
      ],
    }
  : {
      title: post!.seo.title || stripHtml(post!.title),
      description: post!.seo.description || stripHtml(post!.excerpt),
      canonical: postCanonical,
      ogImage: post!.seo.ogImage || post!.featuredImage,
      ogType: "article" as const,
      publishedTime: post!.date,
      modifiedTime: post!.modified,
      authorName: post!.authorName,
      schemas: [
        ...(post!.seo.schemas || []),
        breadcrumbSchema(postCrumbs.map((c) => ({ name: c.name, url: c.href || postCanonical }))),
        articleSchema({
          title: stripHtml(post!.title),
          description: post!.seo.description || stripHtml(post!.excerpt),
          url: postCanonical,
          image: post!.featuredImage || post!.seo.ogImage,
          datePublished: post!.date,
          dateModified: post!.modified,
          authorName: post!.authorName,
        }),
      ],
    };

const isElementorPage = /data-elementor-type=["']wp-page["']/.test(html);
/** Live WP uses Elementor Canvas for some LPs (own header/footer, no theme chrome). */
const isElementorCanvas =
  path === "/lp-page-cr/" ||
  String((entry as { template?: string }).template || "").includes("elementor_canvas");
const entryElementorCss = (entry as { elementorCss?: string }).elementorCss;

const extraCss = [
  ...smartSliderCssForHtml(html),
  ...((entry.pageCss as string[] | undefined) || []).filter((href) => href !== "/css/impreza-global.css"),
  ...(entryElementorCss ? [entryElementorCss] : []),
];

const hasMainShell = /id=["']page-content["']/.test(html);
const isImprezaShell = hasMainShell || /class=["'][^"']*l-section/.test(html);
/** Elementor pages must not be wrapped in Impreza .l-section (breaks full-bleed layouts). */
const renderRawHtml = !isPressRelease && (isImprezaShell || isElementorPage);
/** Press releases always use the shared blog/post article template. */
const useBlogPostTemplate = Boolean(post && (isPressRelease || !renderRawHtml));

const bodyClass = page
  ? isElementorCanvas
    ? `wp-singular page-template page-template-elementor_canvas page page-id-${page.id} elementor-default elementor-template-canvas elementor-kit-873 elementor-page elementor-page-${page.id} wp-theme-Impreza wp-child-theme-Impreza-child`
    : isElementorPage
      ? `page wp-singular page-template-default page-id-${page.id} elementor-default elementor-kit-873 elementor-page elementor-page-${page.id} wp-theme-Impreza wp-child-theme-Impreza-child l-body header_hor links_underline`
      : `page wp-singular page-template-default page-id-${page.id} wp-theme-Impreza wp-child-theme-Impreza-child l-body header_hor links_underline wpb-js-composer vc_responsive`
  : `single single-${post!.type || "post"} postid-${post!.id} wp-theme-Impreza wp-child-theme-Impreza-child l-body header_hor links_underline`;

const arabic = isArabicPath(path);
const menuActivePath = post
  ? isPressRelease
    ? PRESS_LISTING_PATH
    : "/blog/"
  : undefined;
---

<BaseLayout
  currentPath={path}
  bodyClass={bodyClass}
  fallback={entry.seo}
  extraCss={extraCss}
  seo={seo}
  menuActivePath={menuActivePath}
  loadElementor={isElementorPage}
  hideSiteChrome={isElementorCanvas}
  htmlLang={arabic ? "ar" : "en-AE"}
  htmlDir={arabic ? "rtl" : "ltr"}
  ogLocale={arabic ? "ar_AE" : "en_US"}
>
  {
    renderRawHtml && !useBlogPostTemplate ? (
      <Fragment set:html={html} />
    ) : page ? (
      <main id="page-content" class="l-main">
        <section class="l-section">
          <div class="l-section-h i-cf">
            <Fragment set:html={html} />
          </div>
        </section>
      </main>
    ) : (
      <main id="page-content" class="l-main">
        <article class="l-section">
          <div class="l-section-h i-cf">
            <Breadcrumbs items={postCrumbs} />
            <h1 set:html={post!.title} />
            <div class="sp-article__meta">
              <time datetime={post!.date}>{formatDate(post!.date)}</time>
              {post!.authorName && (
                <>
                  {" "}
                  · <a href={`/author/${post!.authorSlug}/`}>{post!.authorName}</a>
                </>
              )}
              {catNames.length > 0 && (
                <>
                  {" "}
                  ·{" "}
                  {catNames.map((c, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={c.path}>{c.name}</a>
                    </>
                  ))}
                </>
              )}
            </div>
            <div class="w-blog-post-body" set:html={html} />
            {
              relatedFinal.length > 0 && (
                <section class="sp-related" style="margin-top:2rem">
                  <h2>Related</h2>
                  <div class="sp-blog-grid">
                    {relatedFinal.map((r) => (
                      <PostCard post={r} />
                    ))}
                  </div>
                </section>
              )
            }
          </div>
        </article>
      </main>
    )
  }
</BaseLayout>
