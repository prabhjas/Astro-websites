---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageByPath, smartSliderCssForHtml } from "../lib/content";
import { breadcrumbSchema } from "../lib/seo";

export const prerender = false;

const page = getPageByPath("/");
if (!page) throw new Error("Home page missing from content data");

const html = page.bodyHtml || page.content;
const extraCss = [
  "/css/impreza-home-design.css",
  ...smartSliderCssForHtml(html),
  ...(page.pageCss || []).filter((href) => href !== "/css/impreza-global.css"),
];
---

<BaseLayout
  currentPath="/"
  bodyClass={`home wp-singular page-template-default page page-id-${page.id} wp-theme-Impreza wp-child-theme-Impreza-child l-body Impreza_8.40.1 header_hor links_underline rounded_none headerinpos_top state_default wpb-js-composer vc_responsive`}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title,
    description: page.seo.description,
    canonical: "/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema([{ name: "Home", url: "/" }]),
    ],
  }}
>
  <Fragment set:html={html} />
</BaseLayout>
