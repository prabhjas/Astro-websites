---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getBlogPosts, paginate, POSTS_PER_PAGE } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/seo";

export const prerender = false;

const sorted = [...getBlogPosts()].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const { items, page, totalPages } = paginate(sorted, 1, POSTS_PER_PAGE);
---

<BaseLayout
  currentPath="/blog/"
  menuActivePath="/blog/"
  bodyClass="archive blog l-body"
  seo={{
    title: "Blog | Connect Resources",
    description: "Insights on EOR, PEO, staffing, payroll and HR in Dubai and the UAE.",
    canonical: "/blog/",
    schemas: [breadcrumbSchema([{ name: "Home", url: "/" }, { name: "Blog", url: "/blog/" }])],
  }}
>
  <main id="page-content" class="l-main">
    <section class="l-section height_small">
      <div class="l-section-h i-cf">
        <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Blog" }]} />
        <h1>Blog</h1>
        <p>Guides and insights from Connect Resources.</p>
      </div>
    </section>
    <section class="l-section">
      <div class="l-section-h i-cf">
        <div class="sp-blog-grid">
          {items.map((post) => <PostCard post={post} />)}
        </div>
        <Pagination basePath="/blog/" page={page} totalPages={totalPages} />
      </div>
    </section>
  </main>
</BaseLayout>
