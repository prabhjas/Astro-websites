---
import SEOHead from "../components/SEOHead.astro";
import ElementorHeader from "../components/ElementorHeader.astro";
import ElementorFooter from "../components/ElementorFooter.astro";
import LicenceStrip from "../components/LicenceStrip.astro";
import { licence } from "../lib/licence";
import ElementorScripts from "../components/ElementorScripts.astro";
import FloatContacts from "../components/FloatContacts.astro";
import type { SeoInput } from "../lib/seo";
import type { SeoData } from "../lib/content";
import liveCssOrder from "../data/live-css-order.json";
import { resolveInternalAdminDir } from "../env/server";
import { readGlobalGtmConfig, sanitiseGtmSnippet } from "../lib/gtm/store";
import "../styles/global.css";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
  currentPath?: string;
  /** Force header nav active item (e.g. "/blog/" on single posts) */
  menuActivePath?: string;
  bodyClass?: string;
}

const {
  seo = {},
  fallback,
  extraCss = [],
  currentPath = Astro.url.pathname,
  menuActivePath,
  bodyClass = "",
} = Astro.props;

/** Prefer live homepage stylesheet order (Impreza + plugins). */
const liveOrder = (liveCssOrder as string[]) || [];
const baseCss =
  liveOrder.length > 0
    ? liveOrder
    : [
        "/wp-content/themes/Impreza/css/style.min.css",
        "/wp-content/themes/Impreza-child/style.css",
      ];

const stylesheets = [
  ...new Set([
    ...baseCss,
    ...extraCss,
    "/css/migration-overrides.css",
  ]),
];

/** Dashboard Global GTM — SSR into HTML so it appears in View Source */
let gtmHead = "";
let gtmBody = "";
let gtmFooter = "";
try {
  const gtm = await readGlobalGtmConfig(resolveInternalAdminDir());
  gtmHead = sanitiseGtmSnippet(gtm?.headScript || "");
  gtmBody = sanitiseGtmSnippet(gtm?.bodyHtml || "");
  gtmFooter = sanitiseGtmSnippet(gtm?.footerScript || "");
} catch {
  /* keep public pages resilient */
}
const hasGtm = Boolean(gtmHead || gtmBody || gtmFooter);
---

<!doctype html>
<html lang="en-AE">
  <head>
    <SEOHead seo={seo} fallback={fallback} extraCss={stylesheets} />
    <meta
      name="sp-contact-endpoint"
      content={import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/"}
    />
    <script is:inline define:vars={{ contactEndpoint: import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/" }}>
      window.__SP_CONTACT_ENDPOINT__ = contactEndpoint;
    </script>
    {gtmHead ? <Fragment set:html={gtmHead} /> : null}
    {hasGtm ? <meta name="sp-gtm-ssr" content="1" /> : null}
    {!hasGtm ? (
      <script src="/runtime-gtm.js" defer data-runtime-gtm="1"></script>
    ) : (
      <script is:inline>
        window.__runtimeGtmLoaded = true;
        window.dataLayer = window.dataLayer || [];
      </script>
    )}
    {/* Marquee inline calls run mid-body; load definition in head like live WP */}
    <script is:inline src="/wp-content/plugins/marquee-image-crawler/js/marquee-image-crawler.js"></script>
  </head>
  <body class={bodyClass || "l-body wp-theme-Impreza wp-child-theme-Impreza-child"}>
    {gtmBody ? <Fragment set:html={gtmBody} /> : null}
    <a class="skip-link screen-reader-text" href="#page-content">Skip to content</a>
    <div class="l-canvas type_wide">
      <ElementorHeader currentPath={currentPath} menuActivePath={menuActivePath} />
      <slot />
      <ElementorFooter />
    </div>
    {licence.number ? <LicenceStrip /> : null}
    <FloatContacts />
    <ElementorScripts />
    {gtmFooter ? <Fragment set:html={gtmFooter} /> : null}
  </body>
</html>
