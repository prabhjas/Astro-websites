				<div class="elementor-widget-container">
					<div class="section-title t_center">
                 
                        <h5>//Employer of Record Solutions</h5>
                				
				 				
				  
                       <h4 style="font-size: 40px;
font-style: normal;
font-weight: 800;
line-height: 120%;">Best Services for Your Core EOR Needs<span></span></h4>
                				<div class="bar-main">
					<div class="bar bar-big"></div>
				</div>
				
                				

				
			</div>				</div>
