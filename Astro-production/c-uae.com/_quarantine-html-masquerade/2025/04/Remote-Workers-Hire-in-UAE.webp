				<div class="elementor-widget-container">
									<p><img fetchpriority="high" decoding="async" class="aligncenter wp-image-23254 size-full" src="https://eormiddleast.com/wp-content/uploads/2024/04/Hero-section-image-1.png?_t=1732774678" alt="Hero-section-image" width="550" height="563" srcset="https://eormiddleast.com/wp-content/uploads/2024/04/Hero-section-image-1.png 550w, https://eormiddleast.com/wp-content/uploads/2024/04/Hero-section-image-1-293x300.png 293w, https://eormiddleast.com/wp-content/uploads/2024/04/Hero-section-image-1-147x150.png 147w" sizes="(max-width: 550px) 100vw, 550px" /></p>								</div>
