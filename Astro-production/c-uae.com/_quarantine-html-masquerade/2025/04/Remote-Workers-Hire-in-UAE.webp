				<section class="elementor-section elementor-top-section elementor-element elementor-element-07cc8a6 elementor-section-full_width elementor-section-height-default elementor-section-height-default" data-id="07cc8a6" data-element_type="section" data-e-type="section" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
