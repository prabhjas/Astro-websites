/*  new css */
.top-info {
    display:flex;
    align-items:center;
    margin-top:25px;
    margin-bottom:15px;
}

.top-info .author{
    border-radius: 4px;
    background: rgba(245, 107, 1, 0.20);
    padding: 4px 8px;
    color:  #2E282A;
    font-family: Nunito;
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
    line-height: 21px;
    letter-spacing: 0.28px;
    margin-right:20px;
}

.top-info .date{
    color: #2E282A;
    font-family: Nunito;
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
    line-height:21px;
    letter-spacing: 0.28px;
}

.post-grid h3{
    color: #18191F;
    font-family: Nunito;
    font-size: 24px;
    font-style: normal;
    font-weight: 600;
    line-height: 30px;
		display: -webkit-box;
	  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-grid p{
    color: #2E282A;
    font-family: Nunito;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 26px;
    letter-spacing: 0.32px;
	display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-grid a{
    color: #F56B01;
    font-family: Nunito;
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    line-height: 26px;
    letter-spacing: 0.32px;
}

.post-grid a i{
    position:relative;
    left:5px;
    top:1.5px;
    font-size:18px;
}

.loop-wrap {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 40px;
	margin-top: 20px;
}

button.btn:hover{
    color:#fff;
    background:#3d2f1f;
}

.btn:focus {
    outline: 0;
    box-shadow: unset !important; 
}

.post-slider h3,
.post-slider p{   
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.single-post h1{
    font-size:36px;
	  margin-bottom:10px;
}

.single-post h2{
    font-size:30px;
	  margin-bottom:10px;
}

.single-post h3{
    font-size:28px;
	  margin-bottom:10px;
}	

.single-guides h1 {
    font-size: 36px;
	    font-family: "Libre Franklin", sans-serif !important;
    font-weight: 600;
}

/* Media 767 */

@media only screen and (max-width: 767px) {
	
body,html{
	overflow-x:hidden;
}	
	
.post-grid h3{
    font-size: 20px;
}
	
.loop-wrap {
    grid-template-columns: repeat(1,1fr);
}
.single-post h1{
    font-size:28px;
	  margin-bottom:10px;
}

.single-post h2{
    font-size:26px;
	  margin-bottom:10px;
}

.single-post h3{
    font-size:24px;
	  margin-bottom:10px;
}	
}


/* Media 768 to 991  */

@media only screen and (min-width: 768px) and (max-width: 991px)  {
.post-grid h3{
    font-size: 18px;
}

.top-info .author {
    font-size: 12px;
    margin-right: 10px;
}

.top-info .date {
    font-size: 12px;
}
.single-post h1{
    font-size:28px;
	  margin-bottom:10px;
}

.single-post h2{
    font-size:26px;
	  margin-bottom:10px;
}

.single-post h3{
    font-size:24px;
	  margin-bottom:10px;
}	
}
