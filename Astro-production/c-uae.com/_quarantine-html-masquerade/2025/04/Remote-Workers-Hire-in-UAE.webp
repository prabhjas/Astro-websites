.single-post {
  font-family: 'Poppins', sans-serif !important;
  color: #000000 !important;
}

.single-post p {
  font-size: 17px !important;
  line-height: 1.6;
color: #000000 !important;
}

.single-post h6 {
  font-size: 20px !important;
}

.single-post h5 {
  font-size: 24px !important;
}

.single-post h4 {
  font-size: 27px !important; 
}

.single-post h3 {
  font-size: 30px !important;
}

.single-post h2 {
  font-size: 36px !important;
}

.single-post h1 {
  font-size: 48px !important;
}

.single-post h1, h2, h3, h4, h5, h6 {
    margin-block-start: 0.5rem;
    margin-block-end: 1rem;
    font-weight: 500;
    line-height: 1.2;
    font-family: "Libre Franklin", sans-serif !important;
}

.single-post ul{
    padding-left:30px;
		color:#000
}


.selected-flag {
    min-width: 100px !important;
}
.separate-dial-code input.wpcf7-validates-as-phonetext {
    padding-left:110px !important;
}


.elementor-sticky--active {
    z-index: 999;
}
@media screen and (min-width: 768px) and (max-width: 2560px){

.menu-item.menu-item-6445 ul.sub-menu {
    margin-top: -250px !important;
}
}
/**feature box hover color change for h3*/
.style-two.feature-box:hover .feature-box-title h3
{
	color:#fff !important;
}

.icon-box-content .title p {
    font-size: 20px;
    font-weight: 700;
}
.icon-box.style-five:hover .icon i.fas:before {
    color: #ffffff !important;
    background: #ef6737;
}
.icon-box.style-five .icon i.fas:before {
    color: #ef6737 !important;
 
    font-size: 35px !important;
}
/**end*/


@media only screen and (min-width: 768px) and (max-width: 2560px){
.scroll_r{
    position: sticky;
    top: 0;
    align-self: flex-start;
}
}
@media only screen and (min-width: 300px) and (max-width: 767px){
.scroll_r {
    position: unset !important;
}
}

.mean-bar:before {
    content: "EOR Middle East" !important;
text-transform: initial !important;
}
.social_icons {
    margin: 0px !important;
    padding: 0px !important;
}

.footer-menu ul .social_icons.menu-item a {
   
    margin-left: 10px !important;
}
.trp_nav_area {
   
    background-color: white !important;
    
}

/** pricing table **/
.iconb img.alignnone {
    margin: 0.4em 1.6em 0.6em 0 !important;
}
.iconb {
    margin: 0px !important;
}


@media only screen and (max-width: 767px){
	.desktop_banner{
		display:none;
	}
}

.column_pra .service-box.service-style-four {
    height: 350px;
}
