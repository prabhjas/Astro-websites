---
import { sanitizeMirrorHtml } from '@connect/site-cms';
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PostCard from "../components/PostCard.astro";
import {
  getCategories,
  getPageByPath,
  getPublishedPostByPath,
  getRelatedPosts,
  formatDate,
  stripHtml,
  normalizePath,
} from "../lib/content";
import { injectCanonicalCf7Forms } from "../lib/cf7-main-form";
import { articleSchema, breadcrumbSchema } from "../lib/seo";
import { preparePageFaqSchema } from "../lib/faq-schema";
import { notFoundResponse } from "../lib/not-found";

export const prerender = false;

const slugParam = Astro.params.slug;
const slugPath = Array.isArray(slugParam) ? slugParam.join("/") : String(slugParam || "");
const path = normalizePath(`/${slugPath}`);

const page = getPageByPath(path);
const post = page ? null : getPublishedPostByPath(path);

if (!page && !post) {
  return notFoundResponse();
}

const FAQ_EXCLUDE_SELECTORS: Record<string, string[]> = {
  "/document-clearing-servcies-uae/": [
    ".elementor-element-5043478",
    ".elementor-element-c534661",
    ".elementor-element-685810e",
  ],
};

const entry = page || post!;
const rawHtml = ("bodyHtml" in entry && entry.bodyHtml) || entry.content || "";
const sanitizedHtml = sanitizeMirrorHtml(injectCanonicalCf7Forms(rawHtml, {
  path,
  variant: post ? "blog" : path.includes("contact") ? "contact" : "contact",
}));
const { html, schemas: faqSchemas } = preparePageFaqSchema(
  sanitizedHtml,
  entry.seo.schemas || [],
  FAQ_EXCLUDE_SELECTORS[path] ? { excludeSelectors: FAQ_EXCLUDE_SELECTORS[path] } : {},
);
const catNames = post ? getCategories().filter((c) => post.categories.includes(c.id)) : [];

const pageCrumbs = page
  ? (() => {
      const crumbs = [
        { name: "Home", href: "/" },
        { name: stripHtml(page.title), href: undefined as string | undefined },
      ];
      const parts = path.replace(/^\/|\/$/g, "").split("/").filter(Boolean);
      if (parts.length >= 2) {
        crumbs.splice(1, 0, {
          name: parts[0].replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
          href: `/${parts[0]}/`,
        });
      }
      return crumbs;
    })()
  : [];

const related = post ? getRelatedPosts(post, 3) : [];
const postCrumbs = post
  ? [
      { name: "Home", href: "/" },
      { name: "Insights", href: "/insights/" },
      { name: stripHtml(post.title) },
    ]
  : [];

/** Page-specific robots overrides (meta only; keep sitemap in sync via seo.robots). */
const PAGE_ROBOTS: Record<string, { noindex?: boolean; nofollow?: boolean }> = {
  "/business-setup-dubai/": { noindex: true, nofollow: true },
};

const seo = page
  ? {
      title: page.seo.title,
      description: page.seo.description,
      canonical: path,
      ogImage: page.seo.ogImage,
      schemas: [
        ...faqSchemas,
        breadcrumbSchema(pageCrumbs.map((c) => ({ name: c.name, url: c.href || path }))),
      ],
      ...(PAGE_ROBOTS[path] || {}),
    }
  : {
      title: post!.seo.title || stripHtml(post!.title),
      description: post!.seo.description || stripHtml(post!.excerpt),
      canonical: path,
      ogImage: post!.seo.ogImage || post!.featuredImage,
      ogType: "article" as const,
      publishedTime: post!.date,
      modifiedTime: post!.modified,
      authorName: post!.authorName,
      schemas: [
        ...faqSchemas,
        breadcrumbSchema(postCrumbs.map((c) => ({ name: c.name, url: c.href || path }))),
        articleSchema(
          {
            title: stripHtml(post!.title),
            description: post!.seo.description || stripHtml(post!.excerpt),
            url: path,
            image: post!.featuredImage || post!.seo.ogImage,
            datePublished: post!.date,
            dateModified: post!.modified,
            authorName: post!.authorName,
          },
          Astro.url.origin,
        ),
      ],
    };

const extraCss = page
  ? [
      ...(page.pageCss || []),
      page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
    ]
  : [
      ...(post!.pageCss || []),
      "/wp-content/uploads/elementor/css/post-1544.css",
      post!.elementorCss || `/wp-content/uploads/elementor/css/post-${post!.id}.css`,
      "/wp-content/plugins/elementor-pro/assets/css/widget-post-info.min.css",
      "/wp-content/plugins/elementor-pro/assets/css/widget-share-buttons.min.css",
      "/wp-content/plugins/elementor/assets/css/widget-divider.min.css",
    ];

const postUsesElementor =
  !!post?.bodyHtml && /data-elementor-type=/.test(post.bodyHtml);
const postElementorId =
  post?.bodyHtml?.match(/data-elementor-id="(\d+)"/)?.[1] ||
  "1544";
---

<BaseLayout
  currentPath={path}
  bodyClass={
    page
      ? `page page-id-${page.id} elementor-page elementor-page-${page.id}`
      : postUsesElementor
        ? `single single-post postid-${post!.id} post post-id-${post!.id} elementor-page elementor-page-${postElementorId}`
        : `single single-post postid-${post!.id} post post-id-${post!.id}`
  }
  fallback={entry.seo}
  extraCss={extraCss}
  seo={seo}
  menuActivePath={post ? "/insights/" : undefined}
>
  {
    page ? (
      <div class="sp-page-content" set:html={html} />
    ) : postUsesElementor ? (
      <div class="sp-page-content" set:html={html} />
    ) : (
      <article class="sp-article sp-container">
        <header class="sp-article__header">
          <Breadcrumbs items={postCrumbs} />
          <h1 set:html={post!.title} />
          <div class="sp-article__meta">
            <time datetime={post!.date}>{formatDate(post!.date)}</time>
            {post!.authorName && (
              <>
                {" "}
                · <a href={`/author/${post!.authorSlug}/`}>{post!.authorName}</a>
              </>
            )}
            {catNames.length > 0 && (
              <>
                {" "}
                ·{" "}
                {catNames.map((c, i) => (
                  <>
                    {i > 0 ? ", " : ""}
                    <a href={c.path}>{c.name}</a>
                  </>
                ))}
              </>
            )}
          </div>
        </header>
        {post!.featuredImage && (
          <figure style="margin: 0 0 1.75rem">
            <img
              src={post!.featuredImage}
              alt={stripHtml(post!.title)}
              width="1200"
              height="675"
              loading="eager"
            />
          </figure>
        )}
        <div class="sp-article__content" set:html={html} />
        {related.length > 0 && (
          <section class="sp-related">
            <h2>Related Posts</h2>
            <div class="sp-blog-grid">
              {related.map((p) => (
                <PostCard post={p} />
              ))}
            </div>
          </section>
        )}
      </article>
    )
  }
</BaseLayout>
