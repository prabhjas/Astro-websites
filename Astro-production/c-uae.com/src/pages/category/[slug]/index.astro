---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  BLOG_LOAD_MORE_PER_PAGE,
  renderBlogCardsHtml,
} from "../../../lib/blog-card-html";
import {
  getCategories,
  getCategoryBySlug,
  getPageByPath,
  getPostsByCategory,
  stripHtml,
} from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/seo";
import { notFoundResponse } from "../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const category = getCategoryBySlug(slug);
if (!category) {
  return notFoundResponse();
}

/**
 * Live category archives use Elementor archive 1536 — near-twin of insights page 1504
 * (same hero / CTA / category dropdown / ECS loop-1514 cards / load more).
 */
const insightsPage = getPageByPath("/insights/");
if (!insightsPage) throw new Error("Insights page missing");

const sorted = getPostsByCategory(category.id).sort(
  (a, b) => +new Date(b.date) - +new Date(a.date),
);
const initialItems = Math.min(BLOG_LOAD_MORE_PER_PAGE, sorted.length);
const cards = renderBlogCardsHtml(sorted.slice(0, initialItems));
const hasMore = sorted.length > initialItems;
const catName = stripHtml(category.name);

let html = insightsPage.bodyHtml || insightsPage.content || "";

/** Swap ECS grid cards for this category's posts. */
html = html.replace(
  /(<div[^>]*class="[^"]*ecs-posts[^"]*"[^>]*>)([\s\S]*?)(<\/div>\s*<nav[^>]*class="[^"]*ecs-load-more-button)/i,
  (_full, open, _inner, closeStart) => `${open}\n${cards}\n\t\t\t\t\t${closeStart}`,
);

if (hasMore) {
  html = html.replace(
    /<nav([^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*)>/i,
    `<nav$1 data-sp-blog-load-more="1" data-next-page="2" data-per-page="${BLOG_LOAD_MORE_PER_PAGE}" data-offset="${initialItems}" data-category-id="${category.id}">`,
  );
  html = html.replace(
    /(<a href=")\/(?:blog|insights)\/\?page=2(" class="elementor-button-link elementor-button)/i,
    `$1${category.path}?page=2$2`,
  );
} else {
  html = html.replace(/<nav[^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*>[\s\S]*?<\/nav>/i, "");
}

let ecsSeen = 0;
const ecsMatches = html.match(/<div[^>]*class="[^"]*ecs-posts[^"]*"[^>]*>/gi) || [];
const gridIndex = ecsMatches.length;
html = html.replace(/<div([^>]*class="[^"]*ecs-posts[^"]*"[^>]*)>/gi, (full, attrs) => {
  ecsSeen += 1;
  if (ecsSeen === gridIndex && !/data-sp-blog-grid/.test(attrs)) {
    return `<div${attrs} data-sp-blog-grid="1">`;
  }
  return full;
});

/** Hero title: "Our {Category} Insights" (live business-setup uses this pattern). */
const safeTitle = catName
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;");
html = html.replace(
  /(<h1 class="elementor-heading-title elementor-size-default">)[\s\S]*?(<\/h1>)/i,
  `$1Our ${safeTitle} Insights$2`,
);

const catOptions = getCategories()
  .filter((c) => {
    const posts = getPostsByCategory(c.id);
    return posts.length > 0 || c.id === category.id;
  })
  .filter((c) => !/^!/.test(c.name || "") && c.slug !== "bez-rubriki" && c.slug !== "public")
  .filter((c) => !/%/.test(c.slug || ""))
  .sort((a, b) => stripHtml(a.name).localeCompare(stripHtml(b.name)));

const catSelectInner = [
  `<option value="-1">Select Category</option>`,
  ...catOptions.map((c) => {
    const name = stripHtml(c.name).replace(/&/g, "&amp;").replace(/</g, "&lt;");
    const path = (c.path || `/category/${c.slug}/`).replace(/"/g, "");
    const selected = c.id === category.id ? " selected" : "";
    return `<option class="level-0" value="${c.id}" data-path="${path}"${selected}>${name}</option>`;
  }),
].join("\n\t");

html = html.replace(
  /(<select\s+name=['"]cat['"]\s+id=['"]cat['"]\s+class=['"]postform['"]\s*>)[\s\S]*?(<\/select>)/i,
  `$1\n\t${catSelectInner}\n$2`,
);

html = html.replace(
  /(<form class="elementor-search-form"[^>]*action=")[^"]*(")/i,
  `$1/search/$2`,
);

const extraCss = [
  ...(insightsPage.pageCss || []),
  insightsPage.elementorCss || `/wp-content/uploads/elementor/css/post-${insightsPage.id}.css`,
  "/wp-content/uploads/elementor/css/post-1514.css",
  "/css/insights-category.css",
];
---

<BaseLayout
  currentPath={category.path}
  menuActivePath="/insights/"
  bodyClass={`archive category category-${category.slug} category-${category.id} elementor-page elementor-page-${insightsPage.id}`}
  extraCss={extraCss}
  seo={{
    title: `${catName} Archives | C-UAE`,
    description:
      category.description ||
      `Articles in ${catName} from Connect UAE — business setup and company formation insights.`,
    canonical: category.path,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Insights", url: "/insights/" },
        { name: catName, url: category.path },
      ]),
    ],
  }}
>
  <div class="sp-page-content" set:html={html} />
</BaseLayout>
