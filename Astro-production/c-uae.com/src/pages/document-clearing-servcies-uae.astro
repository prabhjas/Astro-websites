---
/**
 * Document Clearing Services UAE — restyled to the C-UAE Figma revamp
 * (file QlpDyvJhnb6KdlEmhI91d1, node 1864:9564). Existing copy and images
 * are unchanged; layout/type/color match the Corporate Bank Account system.
 */
import { sanitizeMirrorHtml } from "@connect/site-cms";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageByPath } from "../lib/content";
import { injectCanonicalCf7Forms } from "../lib/cf7-main-form";
import { breadcrumbSchema } from "../lib/seo";
import { notFoundResponse } from "../lib/not-found";

export const prerender = false;

const path = "/document-clearing-servcies-uae/";
const page = getPageByPath(path);
if (!page) return notFoundResponse();

const rawHtml = ("bodyHtml" in page && page.bodyHtml) || page.content || "";
const html = sanitizeMirrorHtml(
  injectCanonicalCf7Forms(rawHtml, { path, variant: "contact" }),
);

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Document Clearing Services UAE", href: undefined as string | undefined },
];
---

<BaseLayout
  currentPath={path}
  bodyClass={`page page-id-${page.id} elementor-page elementor-page-${page.id} dcs-figma`}
  fallback={page.seo}
  extraCss={[
    ...(page.pageCss || []).filter((href) => !href.includes("post-534.css")),
    "/css/document-clearing-figma.css",
  ]}
  seo={{
    title: page.seo.title,
    description: page.seo.description,
    canonical: path,
    ogImage: page.seo.ogImage,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: c.href || path }))),
    ],
  }}
>
  <div class="sp-page-content dcs-page" set:html={html} />
</BaseLayout>
