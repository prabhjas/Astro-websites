# freelancerdxb.com -> 127.0.0.1:5109 (systemd: freelancerdxb.service)
#
# PRODUCTION STANDARD (single /etc/caddy/Caddyfile — see caddy/Caddyfile.production).
# This file is the site block to keep in sync with the live fleet Caddyfile.
#
# When deploying / adding this site on the server you MUST also:
#   1. Ensure the shared one-hop HTTP alt-host block lists http://www.freelancerdxb.com
#      and redirects to https://freelancerdxb.com{uri}
#   2. Match PUBLIC_SITE_URL=https://freelancerdxb.com
#   3. Cloudflare SSL = Full (not Flexible / not Full strict with tls internal)
#   4. sudo -u caddy caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Local laptop: do NOT run this Caddy block — use fleet-local on :5109 only.
# Docs: docs/CONNECT-CADDY-DEPLOYMENT.md

freelancerdxb.com, www.freelancerdxb.com {
	tls internal
	encode zstd gzip

	@noncanonical host www.freelancerdxb.com
	redir @noncanonical https://freelancerdxb.com{uri} permanent

	reverse_proxy 127.0.0.1:5109

	@static path_regexp static \.(css|js|woff|woff2|webp|jpg|jpeg|png|gif|svg|ico|avif|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/freelancerdxb.com-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
