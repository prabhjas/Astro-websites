---
/**
 * Connect Zone single post layout — mirrors live WP template
 * (breadcrumbs + title + 2-col content / Request a Quote sidebar + author footer).
 */
import type { PostEntry } from "../lib/content";
import {
  decodeHtmlEntities,
  estimateReadingMinutes,
  formatInsightsDate,
  getAuthorById,
  getAuthorBySlug,
  stripHtml,
} from "../lib/content";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const title = decodeHtmlEntities(stripHtml(post.title));
const path = post.path;
const shareUrl = path.startsWith("http") ? path : path;
const readingMins = estimateReadingMinutes(post.content || "");
const dateLabel = formatInsightsDate(post.date);
const author =
  (post.authorSlug ? getAuthorBySlug(post.authorSlug) : undefined) ||
  (post.author ? getAuthorById(post.author) : undefined);
const authorLabel =
  (post.authorName || "").trim() ||
  (author?.name || "").trim() ||
  "Connect Zone";
const authorSlug = (post.authorSlug || author?.slug || "").trim();
const authorHref =
  authorSlug && !/^\d+$/.test(authorSlug) ? `/author/${authorSlug}/` : undefined;
const rawAvatar = (author?.avatar || "").trim();
const avatarIsLogo =
  !rawAvatar ||
  /white-logo|CONNECT-ZONE-LOGO|logo\.png|logo\.svg|favicon/i.test(rawAvatar);
const authorAvatar = avatarIsLogo
  ? "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Ccircle cx='64' cy='64' r='64' fill='%23e8e8e8'/%3E%3Ccircle cx='64' cy='48' r='22' fill='%23fff'/%3E%3Cpath d='M24 112c10-28 28-40 40-40s30 12 40 40' fill='%23fff'/%3E%3C/svg%3E"
  : rawAvatar;
const featured = post.featuredImage || "";
const contentHtml = post.content || "";
---

<div class="single_page_wrapper cz-single-post">
  <div class="breadcrumbs">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/insights/">Insights</a></li>
      <li>{title}</li>
    </ul>
  </div>

  <section id="single_page_detail_content">
    <div class="main_content_single">
      <article>
        <div class="single_title">
          <h1>{title}</h1>
        </div>

        <div class="single_post-meta cz-single-post__top-meta">
          <div class="post_meta_wrap">
            by
            <span>
              {
                authorHref ? (
                  <a href={authorHref}>{authorLabel}</a>
                ) : (
                  authorLabel
                )
              }
            </span>
            <div class="date">
              {dateLabel} <span>.</span> {readingMins} min read
            </div>
          </div>
        </div>

        {
          featured && (
            <div class="single_post_image">
              <img
                src={featured}
                alt={title}
                class="img-responsive"
                width="1500"
                height="844"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }

        <div class="main_content_single_page" set:html={contentHtml} />

        <div class="footer_meta">
          <div class="single_post-meta">
            <div class="post_meta_wrap">
              <div class="blog_avatar_img">
                {
                  authorHref ? (
                    <a href={authorHref}>
                      <img
                        alt={authorLabel}
                        src={authorAvatar}
                        class="avatar avatar-128 photo"
                        height="128"
                        width="128"
                        decoding="async"
                        loading="lazy"
                      />
                    </a>
                  ) : (
                    <img
                      alt={authorLabel}
                      src={authorAvatar}
                      class="avatar avatar-128 photo"
                      height="128"
                      width="128"
                      decoding="async"
                      loading="lazy"
                    />
                  )
                }
              </div>
              <span>
                {
                  authorHref ? (
                    <a style="color:#06031b !important;" href={authorHref}>
                      {authorLabel}
                    </a>
                  ) : (
                    <span style="color:#06031b !important;">{authorLabel}</span>
                  )
                }
              </span>
            </div>
            <div class="share_post_Wrap">
              <div class="social-share">
                <span>Share this post</span>
                <a href={shareUrl} target="_blank" rel="noopener noreferrer" aria-label="Copy link"
                  ><i class="fas fa-link"></i></a
                >
                <a
                  href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Share on Facebook"><i class="fab fa-facebook"></i></a
                >
                <a
                  href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Share on X"><i class="fab fa-twitter"></i></a
                >
                <a
                  href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Share on LinkedIn"><i class="fab fa-linkedin"></i></a
                >
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

        <div class="sidebararea">
      <div class="stickyform">
        <div class="stickyform__inner">
        <h2>Request a Quote</h2>
        <div class="wpcf7" id="wpcf7-f7511-o1" lang="en-US" dir="ltr" data-wpcf7-id="7511">
          <div class="screen-reader-response">
            <p role="status" aria-live="polite" aria-atomic="true"></p>
            <ul></ul>
          </div>
          <form
            action={`${path}#wpcf7-f7511-o1`}
            method="post"
            class="wpcf7-form init"
            aria-label="Contact form"
            novalidate
            data-status="init"
          >
            <fieldset class="hidden-fields-container">
              <input type="hidden" name="_wpcf7" value="7511" />
              <input type="hidden" name="form_name" value="Request a Quote" />
              <input type="hidden" name="form_id" value="7511" />
            </fieldset>
            <p>
              <span class="wpcf7-form-control-wrap" data-name="your-name">
                <input
                  size="40"
                  maxlength="400"
                  class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required"
                  aria-required="true"
                  placeholder="Your full name"
                  value=""
                  type="text"
                  name="your-name"
                  required
                  autocomplete="name"
                />
              </span>
            </p>
            <p>
              <span class="wpcf7-form-control-wrap" data-name="your-email">
                <input
                  size="40"
                  maxlength="400"
                  class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email"
                  aria-required="true"
                  placeholder="Your email"
                  value=""
                  type="email"
                  name="your-email"
                  required
                  autocomplete="email"
                />
              </span>
            </p>
            <p>
              <span class="wpcf7-form-control-wrap" data-name="phonetext-257">
                <input
                  size="40"
                  class="wpcf7-form-control wpcf7-phonetext wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-phonetext"
                  data-numberonly="true"
                  aria-required="true"
                  placeholder="Your phone *"
                  value=""
                  type="text"
                  name="phonetext-257"
                  required
                  autocomplete="tel"
                />
                <input
                  type="hidden"
                  name="phonetext-257-country-code"
                  class="wpcf7-phonetext-country-code"
                />
              </span>
            </p>
            <div style="display:none;" class="gclid_tag" id="transaction_hide">
              <p>
                <span class="wpcf7-form-control-wrap" data-name="gclid">
                  <textarea
                    cols="40"
                    rows="2"
                    maxlength="2000"
                    class="wpcf7-form-control wpcf7-textarea"
                    id="testgclid"
                    placeholder="No Tag"
                    name="gclid"></textarea>
                </span>
              </p>
            </div>
            <div style="display:none;" class="gclid_tag">
              <p>
                <span class="wpcf7-form-control-wrap" data-name="initial_url">
                  <textarea
                    cols="40"
                    rows="2"
                    maxlength="2000"
                    class="wpcf7-form-control wpcf7-textarea"
                    id="initial_url"
                    placeholder="No URL"
                    name="initial_url"></textarea>
                </span>
              </p>
            </div>
            <p>
              <span class="wpcf7-form-control-wrap" data-name="your-message">
                <textarea
                  cols="40"
                  rows="6"
                  maxlength="2000"
                  class="wpcf7-form-control wpcf7-textarea wpcf7-validates-as-required"
                  aria-required="true"
                  placeholder="Your message"
                  name="your-message"
                  required></textarea>
              </span>
            </p>
            <p>
              <input
                class="wpcf7-form-control wpcf7-submit has-spinner"
                type="submit"
                value="Contact Us"
              />
            </p>
            <div class="wpcf7-response-output" aria-hidden="true"></div>
          </form>
        </div>
        </div>
      </div>
    </div>
  </section>
</div>
