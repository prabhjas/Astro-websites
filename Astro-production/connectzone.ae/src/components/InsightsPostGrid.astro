---
/**
 * Insights listing card + pagination helpers (live Connect Zone markup).
 */
import type { PostEntry } from "../lib/content";
import {
  decodeHtmlEntities,
  estimateReadingMinutes,
  formatInsightsDate,
  stripHtml,
  truncateText,
} from "../lib/content";

interface Props {
  posts: PostEntry[];
  page: number;
  totalPages: number;
  basePath?: string;
}

const { posts, page, totalPages, basePath = "/insights/" } = Astro.props;

function pageHref(n: number) {
  if (n <= 1) return basePath;
  return `${basePath}page/${n}/`;
}

function paginationItems(current: number, total: number) {
  if (total <= 1) return [] as (number | "dots")[];
  const items: (number | "dots")[] = [];
  const push = (v: number | "dots") => {
    if (items[items.length - 1] !== v) items.push(v);
  };
  push(1);
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);
  if (start > 2) push("dots");
  for (let i = start; i <= end; i++) push(i);
  if (end < total - 1) push("dots");
  if (total > 1) push(total);
  return items;
}

const pages = paginationItems(page, totalPages);
---

<div class="blog_post_wrapper">
  {
    posts.map((post) => {
      const title = truncateText(post.title, 58);
      const excerpt = truncateText(post.excerpt || post.content || "", 90);
      const mins = estimateReadingMinutes(post.content || post.excerpt || "");
      const date = formatInsightsDate(post.date);
      return (
        <article class="blogpost">
          <div class="blog_image">
            <a href={post.path}>
              {post.featuredImage ? (
                <img decoding="async" src={post.featuredImage} alt={decodeHtmlEntities(stripHtml(post.title))} />
              ) : null}
            </a>
          </div>
          <div class="post_meta">
            {date} <span>.</span> {mins} min read
          </div>
          <div class="post_title">
            <h2>{title}</h2>
          </div>
          <div class="the_content_wrapper">
            <p>{excerpt}</p>
          </div>
          <div class="post_url">
            <a href={post.path}>
              Read More <span>&gt;</span>
            </a>
          </div>
        </article>
      );
    })
  }
</div>

{
  totalPages > 1 && (
    <div class="pagination">
      {pages.map((item) =>
        item === "dots" ? (
          <span class="page-numbers dots">&hellip;</span>
        ) : item === page ? (
          <span aria-current="page" class="page-numbers current">
            {item}
          </span>
        ) : (
          <a class="page-numbers" href={pageHref(item)}>
            {item}
          </a>
        ),
      )}
      {page < totalPages && (
        <a class="next page-numbers" href={pageHref(page + 1)}>
          Next &raquo;
        </a>
      )}
    </div>
  )
}
