---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import {
  getCategoryBySlug,
  getPostsByCategory,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
} from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/seo";
import { notFoundResponse } from "../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const category = getCategoryBySlug(slug);
if (!category) {
  return notFoundResponse();
}
const sorted = getPostsByCategory(category.id);
const { items, page, totalPages } = paginate(sorted, 1, POSTS_PER_PAGE);
---

<BaseLayout
  currentPath={category.path}
  seo={{
    title: `${stripHtml(category.name)} Archives | Connect Zone`,
    description: category.description || `Articles in ${category.name} from Connect Zone.`,
    canonical: category.path,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog/" },
        { name: category.name, url: category.path },
      ]),
    ],
  }}
>
  <section class="sp-archive-hero">
    <div class="sp-container">
      <Breadcrumbs
        items={[
          { name: "Home", href: "/" },
          { name: "Blog", href: "/blog/" },
          { name: category.name },
        ]}
      />
      <h1 set:html={category.name} />
      {category.description && <p set:html={category.description} />}
    </div>
  </section>
  <section class="sp-container" style="padding: 1rem 0 4rem">
    {
      items.length ? (
        <div class="sp-blog-grid">
          {items.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p>No posts in this category yet.</p>
      )
    }
    <Pagination page={page} totalPages={totalPages} basePath={category.path} />
  </section>
</BaseLayout>
