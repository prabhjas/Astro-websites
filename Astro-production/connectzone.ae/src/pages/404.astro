---
/**
 * Custom 404 for unknown / unprepared URLs.
 * Must return HTTP 404 (not 503) so crawlers drop dead links and visitors
 * never see internal prepare:page instructions.
 */
export const prerender = false;

Astro.response.status = 404;
Astro.response.statusText = 'Not Found';
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | S&amp;P Heavy Machinery Rental</title>
    <meta
      name="description"
      content="The page you requested could not be found on S&amp;P Heavy Machinery Rental."
    />
    <meta name="robots" content="noindex, follow" />
    <link
      rel="icon"
      href="/wp-content/uploads/2026/01/output-onlinepngtools-Picsart-BackgroundChanger-150x150.png"
      sizes="32x32"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="/runtime-gtm.js" defer data-runtime-gtm="1"></script>
    <style>
      :root {
        --sp-ink: #111111;
        --sp-accent: #df790d;
        --sp-yellow: #ffdd04;
        --sp-mist: #f5f5f5;
        --sp-line: #e0e0e0;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Montserrat, 'Segoe UI', sans-serif;
        color: var(--sp-ink);
        background:
          radial-gradient(ellipse 80% 50% at 50% -10%, rgba(223, 121, 13, 0.14), transparent),
          linear-gradient(180deg, #ffffff 0%, var(--sp-mist) 100%);
      }

      .wrap {
        width: min(40rem, calc(100% - 2.5rem));
        margin: 0 auto;
        padding: 3.5rem 0 4rem;
        text-align: center;
      }

      .logo {
        display: inline-block;
        margin-bottom: 2.5rem;
      }

      .logo img {
        display: block;
        width: min(220px, 55vw);
        height: auto;
      }

      .code {
        display: inline-block;
        margin: 0 0 0.75rem;
        padding: 0.2rem 0.65rem;
        border: 1px solid var(--sp-line);
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--sp-accent);
        background: #fff;
      }

      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.75rem, 4vw, 2.35rem);
        line-height: 1.15;
        font-weight: 700;
      }

      p {
        margin: 0 auto 1.75rem;
        max-width: 28rem;
        font-size: 1.05rem;
        line-height: 1.55;
        color: #54595f;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
      }

      .actions a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: 0.65rem 1.25rem;
        border-radius: 0.35rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }

      .actions a.primary {
        color: #111;
        background: var(--sp-yellow);
      }

      .actions a.primary:hover {
        background: #e6c700;
      }

      .actions a.secondary {
        color: var(--sp-ink);
        background: #fff;
        border: 1px solid var(--sp-line);
      }

      .actions a.secondary:hover {
        border-color: var(--sp-accent);
        color: var(--sp-accent);
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <a class="logo" href="/" aria-label="S&amp;P Heavy Machinery Rental home">
        <img
          src="/wp-content/uploads/2022/02/white-logo.png"
          width="300"
          height="94"
          alt="S&amp;P Heavy Machinery Rental"
        />
      </a>
      <div class="code">404</div>
      <h1>Page not found</h1>
      <p>
        The page you are looking for may have been moved, renamed, or no longer
        exists. Try one of the links below.
      </p>
      <div class="actions">
        <a class="primary" href="/">Go to homepage</a>
        <a class="secondary" href="/blog/">Browse blog</a>
        <a class="secondary" href="/contact/">Contact us</a>
      </div>
    </main>
  </body>
</html>
