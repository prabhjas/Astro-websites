---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InsightsPostGrid from "../../../components/InsightsPostGrid.astro";
import {
  getPageByPath,
  getPosts,
  getCategories,
  paginate,
  POSTS_PER_PAGE,
} from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/seo";
import { notFoundResponse } from "../../../lib/not-found";

export const prerender = false;

const pageEntry = getPageByPath("/insights/");
const requested = Number(Astro.params.page || "1");
if (!Number.isFinite(requested) || requested < 2) {
  return Astro.redirect("/insights/", 301);
}

const categorySlug = (Astro.url.searchParams.get("category") || "").trim();
const categories = getCategories();
const category = categorySlug
  ? categories.find((c) => c.slug === categorySlug)
  : undefined;

let sorted = [...getPosts()].sort((a, b) => +new Date(b.date) - +new Date(a.date));
if (category) {
  sorted = sorted.filter((p) => p.categories.includes(category.id));
}

const { items, page: pageNum, totalPages } = paginate(
  sorted,
  requested,
  POSTS_PER_PAGE || 9,
);

if (requested > totalPages) {
  return notFoundResponse();
}

const rawHtml = pageEntry?.bodyHtml || "";
const styleEnd = rawHtml.indexOf("</style>");
const styleBlock = styleEnd >= 0 ? rawHtml.slice(0, styleEnd + "</style>".length) : "";
const afterStyle = styleEnd >= 0 ? rawHtml.slice(styleEnd + "</style>".length) : rawHtml;

const filterIdx = afterStyle.indexOf('<div class="blogpostsearchfilterwrapper">');
const beforeFilter = filterIdx >= 0 ? afterStyle.slice(0, filterIdx) : afterStyle;
const filterStart = filterIdx >= 0 ? filterIdx : 0;
const gridIdx = afterStyle.indexOf('<div class="blog_post_wrapper">');
let filterHtml =
  gridIdx > filterStart
    ? afterStyle.slice(filterStart, gridIdx)
    : afterStyle.slice(filterStart);

const scriptIdx = afterStyle.indexOf("categoryFilterForm");
let afterListing = "";
if (scriptIdx >= 0) {
  const scriptEnd = afterStyle.indexOf("</script>", scriptIdx);
  afterListing = scriptEnd >= 0 ? afterStyle.slice(scriptEnd + "</script>".length) : "";
}

if (categorySlug) {
  filterHtml = filterHtml.replace(
    new RegExp(`(<option value="${categorySlug}")`, "i"),
    `$1 selected`,
  );
}

const extraCss = [
  ...(pageEntry?.pageCss || []),
  pageEntry?.elementorCss || "/wp-content/uploads/elementor/css/post-8475.css",
  "/css/page-design/insights.css",
];

const canonical =
  category
    ? `/insights/page/${pageNum}/?category=${encodeURIComponent(categorySlug)}`
    : `/insights/page/${pageNum}/`;
---

<BaseLayout
  currentPath={canonical}
  menuActivePath="/insights/"
  bodyClass={
    pageEntry
      ? `page page-id-${pageEntry.id} jupiterx-site elementor-page elementor-page-${pageEntry.id}`
      : "archive blog jupiterx-site"
  }
  fallback={pageEntry?.seo}
  extraCss={extraCss}
  seo={{
    title: pageEntry?.seo?.title || "Insights | Connect Zone",
    description: pageEntry?.seo?.description || "Business setup insights for the UAE.",
    canonical,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Insights", url: "/insights/" },
        { name: `Page ${pageNum}`, url: canonical },
      ]),
    ],
  }}
>
  <Fragment set:html={styleBlock} />
  <Fragment set:html={beforeFilter} />
  <Fragment set:html={filterHtml} />
  <InsightsPostGrid posts={items} page={pageNum} totalPages={totalPages} />
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const categoryFilterForm = document.getElementById("categoryFilterForm");
      const categorySelect = document.getElementById("categorySelect");
      if (!categoryFilterForm || !categorySelect) return;
      categoryFilterForm.addEventListener("submit", function (event) {
        event.preventDefault();
        const selectedCategory = categorySelect.value;
        if (selectedCategory === "") {
          window.location.href = "/insights/";
        } else {
          window.location.href = "/insights/?category=" + encodeURIComponent(selectedCategory);
        }
      });
    });
  </script>
  <Fragment set:html={afterListing} />
</BaseLayout>
