---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostCard from "../../../../components/PostCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import {
  getAuthorBySlug,
  getPostsByAuthor,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
} from "../../../../lib/content";
import { breadcrumbSchema } from "../../../../lib/seo";
import { notFoundResponse } from "../../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const pageNum = Math.max(1, Number(Astro.params.page || 1));
const author = getAuthorBySlug(slug);
if (!author) return notFoundResponse();

const sorted = getPostsByAuthor(author.id);
const { items, page, totalPages } = paginate(sorted, pageNum, POSTS_PER_PAGE || 9);
if (pageNum > totalPages && totalPages > 0) return notFoundResponse();

const displayName = stripHtml(author.name);
const role = String(author.role || "").trim();
const bio = stripHtml(author.description || "");
const canonical =
  page <= 1 ? author.path : `${author.path.replace(/\/$/, "")}/page/${page}/`;
---

<BaseLayout
  currentPath={canonical}
  menuActivePath="/insights/"
  bodyClass={`archive author author-${author.slug} author-${author.id} jupiterx-site`}
  seo={{
    title: `${displayName}, Author at Connect Zone`,
    description: bio || `Articles by ${displayName} on Connect Zone.`,
    canonical,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Insights", url: "/insights/" },
        { name: displayName, url: author.path },
      ]),
    ],
  }}
>
  <main id="jupiterx-main" class="jupiterx-main cz-author-archive">
    <div class="cz-author-archive__inner">
      <header class="cz-author-archive__header">
        {
          author.avatar ? (
            <img
              class="cz-author-archive__avatar"
              src={author.avatar}
              alt={displayName}
              width="160"
              height="160"
              loading="eager"
            />
          ) : null
        }
        <div class="cz-author-archive__intro">
          <h1 class="cz-author-archive__name">{displayName}</h1>
          {role ? <p class="cz-author-archive__role">{role}</p> : null}
          {bio ? <p class="cz-author-archive__bio">{bio}</p> : null}
        </div>
      </header>

      <section class="cz-author-archive__posts">
        <h2 class="cz-author-archive__posts-title">Post by {displayName}</h2>
        {
          items.length ? (
            <div class="cz-author-archive__grid sp-blog-grid">
              {items.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <p>No posts by this author yet.</p>
          )
        }
        <Pagination page={page} totalPages={totalPages} basePath={author.path} />
      </section>
    </div>
  </main>
</BaseLayout>
