---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageByPath } from "../lib/content";
import { breadcrumbSchema } from "../lib/seo";

export const prerender = false;

const page = getPageByPath("/");
if (!page) throw new Error("Home page missing from content data");

const html = page.bodyHtml || page.content;
const extraCss = [
  ...(page.pageCss || []).filter(
    (href) =>
      !href.toLowerCase().includes("impreza") &&
      !href.includes("/css/page-design/"),
  ),
  "/wp-content/uploads/elementor/css/post-10536.css",
  "/wp-content/uploads/elementor/css/post-5828.css",
  "/wp-content/uploads/elementor/css/post-12.css",
];
---

<BaseLayout
  currentPath="/"
  bodyClass={`home page page-id-${page.id} jupiterx-site elementor-default elementor-page elementor-page-${page.id}`}
  extraCss={[...new Set(extraCss)]}
  fallback={page.seo}
  seo={{
    title: page.seo.title,
    description: page.seo.description,
    canonical: "/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema([{ name: "Home", url: "/" }]),
    ],
  }}
>
  <Fragment set:html={html} />
</BaseLayout>
