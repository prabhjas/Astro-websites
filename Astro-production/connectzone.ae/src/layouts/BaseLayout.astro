---
import SEOHead from "../components/SEOHead.astro";
import ElementorHeader from "../components/ElementorHeader.astro";
import ElementorFooter from "../components/ElementorFooter.astro";
import ElementorScripts from "../components/ElementorScripts.astro";
import FloatContacts from "../components/FloatContacts.astro";
import type { SeoInput } from "../lib/seo";
import type { SeoData } from "../lib/content";
import liveCssOrder from "../data/live-css-order.json";
import { resolveInternalAdminDir } from "../env/server";
import { resolveEffectiveGtmConfig } from "../lib/gtm/store";
import "../styles/global.css";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
  currentPath?: string;
  menuActivePath?: string;
  bodyClass?: string;
}

const {
  seo = {},
  fallback,
  extraCss = [],
  currentPath = Astro.url.pathname,
  menuActivePath,
  bodyClass = "",
} = Astro.props;

const chromeCss = [
  "/wp-content/uploads/jupiterx/compiler/jupiterx/style.css",
  "/wp-content/uploads/jupiterx/compiler/jupiterx-elements-dynamic-styles/style.css",
  "/wp-content/uploads/elementor/css/post-5828.css",
  "/wp-content/uploads/elementor/css/post-12.css",
  "/wp-content/plugins/jet-elements/assets/css/addons/jet-slider.css",
  "/wp-content/plugins/elementor/assets/lib/swiper/v8/css/swiper.min.css",
];

const baseCss = (liveCssOrder as string[]).length
  ? (liveCssOrder as string[])
  : [
      "/wp-content/themes/jupiterx/lib/assets/dist/css/frontend.min.css",
      "/wp-content/themes/jupiterx-child/style.css",
    ];

const stylesheets = [
  ...new Set([
    ...baseCss,
    ...chromeCss,
    ...extraCss,
    // Live WP Additional CSS is concatenated into migration-overrides.css
    "/css/migration-overrides.css",
  ]),
];

let gtmHead = "";
let gtmBody = "";
let gtmFooter = "";
try {
  const gtm = await resolveEffectiveGtmConfig(resolveInternalAdminDir());
  gtmHead = gtm.headScript;
  gtmBody = gtm.bodyHtml;
  gtmFooter = gtm.footerScript;
} catch {
  /* keep public pages resilient */
}
const hasGtm = Boolean(gtmHead || gtmBody || gtmFooter);
---

<!doctype html>
<html lang="en-AE">
  <head>
    <SEOHead seo={seo} fallback={fallback} extraCss={stylesheets} />
    <meta
      name="sp-contact-endpoint"
      content={import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/"}
    />
    <script
      is:inline
      define:vars={{ contactEndpoint: import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/" }}
    >
      window.__SP_CONTACT_ENDPOINT__ = contactEndpoint;
    </script>
    {gtmHead ? <Fragment set:html={gtmHead} /> : null}
    {hasGtm ? <meta name="sp-gtm-ssr" content="1" /> : null}
    {!hasGtm ? (
      <script src="/runtime-gtm.js" defer data-runtime-gtm="1"></script>
    ) : (
      <script is:inline>
        window.__runtimeGtmLoaded = true;
        window.dataLayer = window.dataLayer || [];
      </script>
    )}
    {
      import.meta.env.PUBLIC_GA4_ID ? (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_ID}`}
          ></script>
          <script
            is:inline
            define:vars={{
              ga4Id: import.meta.env.PUBLIC_GA4_ID,
              uaId: "UA-159934309-6",
            }}
          >
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', ga4Id);
            gtag('config', uaId);
          </script>
        </>
      ) : null
    }
    <script is:inline>
      (function (h, o, t, j, a, r) {
        h.hj =
          h.hj ||
          function () {
            (h.hj.q = h.hj.q || []).push(arguments);
          };
        h._hjSettings = { hjid: 3535116, hjsv: 6 };
        a = o.getElementsByTagName("head")[0];
        r = o.createElement("script");
        r.async = 1;
        r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
        a.appendChild(r);
      })(window, document, "https://static.hotjar.com/c/hotjar-", ".js?sv=");
    </script>
  </head>
  <body class={bodyClass || "jupiterx-site l-body"}>
    {gtmBody ? <Fragment set:html={gtmBody} /> : null}
    <a class="skip-link screen-reader-text" href="#page-content">Skip to content</a>
    <div class="l-canvas type_wide">
      <ElementorHeader currentPath={currentPath} menuActivePath={menuActivePath} />
      <slot />
      <ElementorFooter />
    </div>
    <FloatContacts />
    <ElementorScripts />
    {gtmFooter ? <Fragment set:html={gtmFooter} /> : null}
  </body>
</html>
