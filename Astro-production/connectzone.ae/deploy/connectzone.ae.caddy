# /etc/caddy/sites.d/connectzone.ae.caddy
# Behind Cloudflare: explicit http:// + https:// + tls internal (no bare auto-HTTPS).
# Origin SSL mode must be Full (not Full strict) — origin uses tls internal.
# Cloudflare DNS must point apex (+ www) at this host before traffic reaches Astro.
# Validate before reload: caddy validate --config /etc/caddy/Caddyfile

http://connectzone.ae, http://www.connectzone.ae, https://connectzone.ae, https://www.connectzone.ae {
	tls internal
	encode gzip zstd
	reverse_proxy 127.0.0.1:5101
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/connectzone.ae-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
