---
/**
 * Keep /blog/N/ as an alias of Insights pagination (live URL is /insights/).
 */
export const prerender = false;

const page = Number(Astro.params.page || '1');
if (!Number.isFinite(page) || page < 2) {
  return Astro.redirect('/insights/');
}
return Astro.redirect(`/insights/${page}/`);
---
