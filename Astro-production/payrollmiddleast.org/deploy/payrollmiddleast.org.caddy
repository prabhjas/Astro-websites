# payrollmiddleast.org -> 127.0.0.1:5110 (systemd: payrollmiddleast.service)
#
# PRODUCTION STANDARD (single /etc/caddy/Caddyfile — see caddy/Caddyfile.production).
# This file is the site block to keep in sync with the live fleet Caddyfile.
#
# When deploying / adding this site on the server you MUST also:
#   1. Ensure the shared one-hop HTTP alt-host block lists http://payrollmiddleast.org
#      and redirects to https://www.payrollmiddleast.org{uri}
#   2. Match PUBLIC_SITE_URL=https://www.payrollmiddleast.org
#   3. Cloudflare SSL = Full (not Flexible); Full (strict) is intentionally deferred for this named internal CA.
#   4. sudo -u caddy caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Local laptop: do NOT run this Caddy block — use fleet-local on :5110 only.
# Docs: docs/CONNECT-CADDY-DEPLOYMENT.md

payrollmiddleast.org, www.payrollmiddleast.org {
	tls force_automate {
		issuer internal {
			ca payroll_origin_isolated_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/payroll_origin_isolated_2026/payrollmiddleast.org/payrollmiddleast.org.crt /var/lib/caddy/.local/share/caddy/certificates/payroll_origin_isolated_2026/payrollmiddleast.org/payrollmiddleast.org.key
	tls /var/lib/caddy/.local/share/caddy/certificates/payroll_origin_isolated_2026/www.payrollmiddleast.org/www.payrollmiddleast.org.crt /var/lib/caddy/.local/share/caddy/certificates/payroll_origin_isolated_2026/www.payrollmiddleast.org/www.payrollmiddleast.org.key
	encode zstd gzip

	# Live WP canonical is www
	@noncanonical host payrollmiddleast.org
	redir @noncanonical https://www.payrollmiddleast.org{uri} permanent

	reverse_proxy 127.0.0.1:5110

	@static path_regexp static \.(css|js|woff|woff2|webp|jpg|jpeg|png|gif|svg|ico|avif|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/payrollmiddleast.org-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
