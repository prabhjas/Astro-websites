[Unit]
Description=Payroll Middle East Astro SSR server (Caddy reverse-proxies to this)
After=network.target

[Service]
Type=simple
# Tier 1: create on host before enabling (see docs/server-ops-only.md).
User=site-payrollmiddleast
Group=site-payrollmiddleast
WorkingDirectory=/opt/Astro-production/payrollmiddleast.org
# REQUIRED — no leading "-". Missing .env.prod must fail the unit (do not boot without secrets).
EnvironmentFile=/opt/Astro-production/payrollmiddleast.org/.env.prod
Environment=NODE_ENV=production
# HOST/PORT in unit only — not in .env.prod
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=5110 /usr/bin/node ./dist/server/entry.mjs
Restart=always
RestartSec=5

MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Astro-production/payrollmiddleast.org/.data

[Install]
WantedBy=multi-user.target
