---
import { getCategoryPageData, serveArchivePage } from '../../lib/archives.ts';
import { getAllCategorySlugs } from '../../lib/blog.ts';

export const prerender = false;

const slug = Astro.params.slug!;
const data = getCategoryPageData(slug, 1);
if (!data) {
  return new Response('Not found', { status: 404 });
}
return serveArchivePage(data);
---
