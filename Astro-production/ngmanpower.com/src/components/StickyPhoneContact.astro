---
/**
 * Sticky hover phone contact — all single posts.
 * Icon-only by default; panel slides out on hover (fine pointer).
 */
const phoneDisplay = "+971 43316688";
const phoneTel = "+97143316688";
---

<aside class="ng-sticky-phone" aria-label="Quick phone contact">
  <a class="ng-sticky-phone__inner" href={`tel:${phoneTel}`}>
    <span class="ng-sticky-phone__panel">
      <span class="ng-sticky-phone__label">
        Questions? <strong>Contact us!</strong>
      </span>
      <span class="ng-sticky-phone__number">{phoneDisplay}</span>
    </span>
    <span class="ng-sticky-phone__btn" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" focusable="false">
        <path
          d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"
          fill="#ffffff"></path>
      </svg>
    </span>
  </a>
</aside>
