---
import SEOHead from "../components/SEOHead.astro";
import ElementorHeader from "../components/ElementorHeader.astro";
import ElementorFooter from "../components/ElementorFooter.astro";
import ElementorScripts from "../components/ElementorScripts.astro";
import FloatContacts from "../components/FloatContacts.astro";
import type { SeoInput } from "../lib/seo";
import type { SeoData } from "../lib/content";
import liveCssOrder from "../data/live-css-order.json";
import { resolveInternalAdminDir } from "../env/server";
import { resolveEffectiveGtmConfig } from "../lib/gtm/store";
import "../styles/global.css";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
  currentPath?: string;
  /** Force header nav active item (e.g. "/blog/" on single posts) */
  menuActivePath?: string;
  bodyClass?: string;
}

const {
  seo = {},
  fallback,
  extraCss = [],
  currentPath = Astro.url.pathname,
  menuActivePath,
  bodyClass = "",
} = Astro.props;

/**
 * NG Manpower uses Impreza theme. Load live stylesheet order from
 * live-css-order.json, then ensure CF7 phone CSS remains available.
 */
const globalCss = [
  "/wp-content/plugins/contact-form-7/includes/css/styles.css",
  "/wp-content/plugins/country-phone-field-contact-form-7/assets/css/intlTelInput.min.css",
  "/wp-content/plugins/country-phone-field-contact-form-7/assets/css/countrySelect.min.css",
];

const baseCss = [
  ...(liveCssOrder as string[]),
  ...globalCss.filter((href) => !(liveCssOrder as string[]).includes(href)),
];

const stylesheets = [
  ...new Set([
    ...baseCss,
    ...extraCss,
    "/css/wp-custom.css",
    "/css/wp-global-styles.css",
    "/css/wp-carousel-free-inline.css",
    "/css/migration-overrides.css",
    "/css/ngmanpower-mobile-nav.css",
  ]),
];

/** Dashboard / env GTM — SSR into HTML so it appears in View Source */
let gtmHead = "";
let gtmBody = "";
let gtmFooter = "";
try {
  const gtm = await resolveEffectiveGtmConfig(resolveInternalAdminDir());
  gtmHead = gtm.headScript || "";
  gtmBody = gtm.bodyHtml || "";
  gtmFooter = gtm.footerScript || "";
} catch {
  /* keep public pages resilient */
}
const hasGtm = Boolean(gtmHead || gtmBody || gtmFooter);
---

<!doctype html>
<html lang="en-AE">
  <head>
    <SEOHead seo={seo} fallback={fallback} extraCss={stylesheets} />
    <meta
      name="sp-contact-endpoint"
      content={import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/"}
    />
    <script is:inline define:vars={{ contactEndpoint: import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/" }}>
      window.__SP_CONTACT_ENDPOINT__ = contactEndpoint;
    </script>
    {gtmHead ? <Fragment set:html={gtmHead} /> : null}
    {hasGtm ? <meta name="sp-gtm-ssr" content="1" /> : null}
    {!hasGtm ? (
      <script src="/runtime-gtm.js" defer data-runtime-gtm="1"></script>
    ) : (
      <script is:inline>
        window.__runtimeGtmLoaded = true;
        window.dataLayer = window.dataLayer || [];
      </script>
    )}
  </head>
  <body
    class:list={[
      "wp-custom-logo",
      "l-body",
      "wp-theme-Impreza",
      "wp-child-theme-Impreza-child",
      "header_hor",
      "header_top_show",
      "btn_hov_slide",
      bodyClass,
    ]}
  >
    {gtmBody ? <Fragment set:html={gtmBody} /> : null}
    <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
    <ElementorHeader currentPath={currentPath} menuActivePath={menuActivePath} />
    <main id="content" class="site-main">
      <div class="page-content">
        <slot />
      </div>
    </main>
    <ElementorFooter />
    <FloatContacts />
    <ElementorScripts />
    {gtmFooter ? <Fragment set:html={gtmFooter} /> : null}
  </body>
</html>
