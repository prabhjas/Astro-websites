---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageByPath, getPosts } from "../../lib/content";
import { INSIGHTS_GRID_PER_PAGE } from "../../lib/insights-archive";
import { breadcrumbSchema } from "../../lib/seo";
import { notFoundResponse } from "../../lib/not-found";

export const prerender = false;

/**
 * Live archive is Impreza `w-grid` + `.g-loadmore` (not Elementor ECS).
 * Keep existing cards; wire Load More to append the next unused posts.
 */
const page = getPageByPath("/insights/");
if (!page) return notFoundResponse();

const totalPosts = getPosts().length;
let html = page.bodyHtml || page.content;

const initialCount = (html.match(/class="w-grid-item\b/g) || []).length;
const hasMore = totalPosts > initialCount;

html = html.replace(
  /(<div class="w-grid-list")/i,
  `$1 data-sp-insights-list="1"`,
);

html = html.replace(
  /(<div class="w-grid[^"]*"[^>]*id="us_grid_1")/i,
  `$1 data-sp-insights-grid="1"`,
);

if (hasMore) {
  html = html.replace(
    /(<div class="g-loadmore\s*")/i,
    `$1 data-sp-insights-load-more="1" data-offset="${initialCount}" data-per-page="${INSIGHTS_GRID_PER_PAGE}"`,
  );
} else {
  html = html.replace(
    /<div class="g-loadmore[\s\S]*?<\/div>\s*(?=<div class="w-grid-json)/i,
    "",
  );
}

const extraCss = [
  ...(page.pageCss || []),
  page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
  "/wp-content/uploads/elementor/css/post-21423.css",
  "/wp-content/uploads/elementor/css/post-21574.css",
  "/css/insights-topic-cards.css",
];
---

<BaseLayout
  currentPath="/insights/"
  bodyClass={`page page-id-${page.id}`}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title || "Insights | NG Manpower",
    description:
      page.seo.description ||
      "Manpower outsourcing insights and UAE workforce guides from NG Manpower.",
    canonical: "/insights/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Insights", url: "/insights/" },
      ]),
    ],
  }}
>
  <Fragment set:html={html} />
</BaseLayout>
