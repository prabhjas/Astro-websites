---
/**
 * Author archive — Elementor template 33086
 * (hero + optional avatar/bio + LinkedIn + “Post By …” + 3-col shortcode grid).
 * Paths are driven by author slug: /author/[author-slug]/
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getAuthors,
  getPostsByAuthor,
  stripHtml,
} from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/seo";

export function getStaticPaths() {
  // One archive per author who has at least one published article.
  return getAuthors()
    .map((author) => ({ author, posts: getPostsByAuthor(author.id) }))
    .filter(({ posts }) => posts.length > 0)
    .map(({ author }) => ({
      params: { slug: author.slug },
      props: { author },
    }));
}

const { author } = Astro.props;
const posts = getPostsByAuthor(author.id);
const name = stripHtml(author.name);
const bio = (author.description || "").replace(/\r\n/g, " ").replace(/\s+/g, " ").trim();

/** Live shows a round avatar only for authors with an uploaded photo (not Gravatar). */
function resolveAvatar(raw: string | undefined): string {
  const src = (raw || "").replace(/^https?:\/\/ngmanpower\.com/, "").trim();
  if (!src || /gravatar\.com/i.test(src)) return "";
  // Prefer a larger local size when only thumbnails exist in public/
  return src
    .replace(/-96x96\./, "-300x300.")
    .replace(/-150x150\./, "-300x300.")
    .replace(/\?.*$/, "");
}

const avatarSrc = resolveAvatar(author.avatar);
const showAvatar = Boolean(avatarSrc);
const showBio = Boolean(bio);

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

/** Insights-style cards: featured image (banner baked in) + title only. */
const cardsHtml = posts
  .map((post) => {
    const title = stripHtml(post.title);
    const href = post.path.endsWith("/") ? post.path : `${post.path}/`;
    const img = (post.featuredImage || "").replace(/^https?:\/\/ngmanpower\.com/, "");
    const imgHtml = img
      ? `<img src="${escapeHtml(img)}" alt="${escapeHtml(title)}" loading="lazy" decoding="async" width="800" height="450">`
      : `<div class="ng-author-card__placeholder" aria-hidden="true"></div>`;
    return `<article class="main-post filter main-profile ng-author-card">
  <a class="ng-author-card__link" href="${escapeHtml(href)}">
    <div class="ng-author-card__media">${imgHtml}</div>
    <h3 class="ng-author-card__title">${escapeHtml(title)}</h3>
  </a>
</article>`;
  })
  .join("\n");
---

<BaseLayout
  currentPath={author.path}
  bodyClass={`archive author author-${author.slug} author-${author.id} elementor-page-33086 elementor-template-full-width`}
  seo={{
    title: `${name}, Author at NG Manpower`,
    description: bio || `Articles by ${name}.`,
    canonical: author.path,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Authors", url: "/author/" },
        { name, url: author.path },
      ]),
    ],
  }}
  extraCss={[
    "/wp-content/plugins/elementor/assets/css/widget-heading.min.css",
    "/wp-content/plugins/elementor/assets/css/widget-image.min.css",
    "/wp-content/plugins/elementor/assets/lib/font-awesome/css/brands.min.css",
    "/wp-content/uploads/elementor/css/post-33086.css",
    "/css/cfz-author-archive.css",
  ]}
  menuActivePath="/insights/"
>
  <div
    data-elementor-type="archive"
    data-elementor-id="33086"
    class={`elementor elementor-33086 elementor-location-archive author-${author.slug}`}
    data-elementor-post-type="elementor_library"
  >
    <section
      class="elementor-section elementor-top-section elementor-element elementor-element-2f808f6 elementor-section-boxed elementor-section-height-default"
      data-id="2f808f6"
      data-element_type="section"
      data-settings='{"background_background":"classic"}'
    >
      <div class="elementor-container elementor-column-gap-default">
        <div
          class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-9f91b2f"
          data-id="9f91b2f"
          data-element_type="column"
        >
          <div class="elementor-widget-wrap elementor-element-populated">
            <div
              class="elementor-element elementor-element-b363d20 elementor-widget elementor-widget-heading"
              data-id="b363d20"
              data-element_type="widget"
              data-widget_type="heading.default"
            >
              <div class="elementor-widget-container">
                <h1 class="elementor-heading-title elementor-size-default">{name}</h1>
              </div>
            </div>
            {
              showBio && (
                <div
                  class="elementor-element elementor-element-fadcc7a elementor-widget elementor-widget-heading"
                  data-id="fadcc7a"
                  data-element_type="widget"
                  data-widget_type="heading.default"
                >
                  <div class="elementor-widget-container">
                    <p class="elementor-heading-title elementor-size-default">{bio}</p>
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="elementor-section elementor-top-section elementor-element elementor-element-9923ffb elementor-section-boxed elementor-section-height-default"
      data-id="9923ffb"
      data-element_type="section"
    >
      <div class="elementor-container elementor-column-gap-default">
        <div
          class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-6fc8b09"
          data-id="6fc8b09"
          data-element_type="column"
        >
          <div class="elementor-widget-wrap elementor-element-populated">
            {
              showAvatar && (
                <div
                  class="elementor-element elementor-element-344f358 elementor-widget elementor-widget-image"
                  data-id="344f358"
                  data-element_type="widget"
                  data-widget_type="image.default"
                >
                  <div class="elementor-widget-container">
                    <img src={avatarSrc} alt={name} loading="lazy" />
                  </div>
                </div>
              )
            }
            <div
              class="elementor-element elementor-element-4b214f8 elementor-view-default elementor-widget elementor-widget-icon"
              data-id="4b214f8"
              data-element_type="widget"
              data-widget_type="icon.default"
            >
              <div class="elementor-widget-container">
                <div class="elementor-icon-wrapper">
                  <div class="elementor-icon">
                    <i aria-hidden="true" class="fab fa-linkedin" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="elementor-section elementor-top-section elementor-element elementor-element-0bd910d elementor-section-boxed elementor-section-height-default"
      data-id="0bd910d"
      data-element_type="section"
    >
      <div class="elementor-container elementor-column-gap-default">
        <div
          class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-0efddac"
          data-id="0efddac"
          data-element_type="column"
        >
          <div class="elementor-widget-wrap elementor-element-populated">
            <div
              class="elementor-element elementor-element-d570478 elementor-widget elementor-widget-heading"
              data-id="d570478"
              data-element_type="widget"
              data-widget_type="heading.default"
            >
              <div class="elementor-widget-container">
                <h2 class="elementor-heading-title elementor-size-default">Post By {name}</h2>
              </div>
            </div>
            <div
              class="elementor-element elementor-element-121f319 elementor-widget elementor-widget-shortcode"
              data-id="121f319"
              data-element_type="widget"
              data-widget_type="shortcode.default"
            >
              <div class="elementor-widget-container">
                <div class="elementor-shortcode">
                  {
                    posts.length ? (
                      <>
                        <div class="filter-post" set:html={cardsHtml} />
                        <div class="btn-load load-btn">
                          <a href="#" id="loadMore">Load More</a>
                        </div>
                      </>
                    ) : (
                      <p>No posts by this author yet.</p>
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      var loadMore = document.getElementById("loadMore");
      var posts = Array.prototype.slice.call(document.querySelectorAll(".main-post"));
      if (!loadMore) return;
      loadMore.style.display = "none";
      if (posts.length > 9) {
        posts.forEach(function (el, i) {
          el.style.display = i < 9 ? "block" : "none";
        });
        loadMore.style.display = "inline-block";
      } else {
        posts.forEach(function (el) {
          el.style.display = "block";
        });
      }
      loadMore.addEventListener("click", function (e) {
        e.preventDefault();
        var hidden = posts.filter(function (el) {
          return el.style.display === "none";
        });
        hidden.slice(0, 3).forEach(function (el) {
          el.style.display = "block";
        });
        if (
          posts.filter(function (el) {
            return el.style.display === "none";
          }).length === 0
        ) {
          loadMore.style.display = "none";
          loadMore.classList.add("noContent");
        }
      });
    });
  </script>
</BaseLayout>
