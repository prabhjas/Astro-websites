---
import { site } from "../lib/content";

const phoneTel = String(site.phoneTel || "").trim();
const whatsappUrl = String(site.whatsappUrl || "").trim();
const showPhone = Boolean(phoneTel && phoneTel !== "+" && phoneTel.length > 4);
const showWhatsapp = Boolean(whatsappUrl && /wa\.me\//i.test(whatsappUrl));
---

{
  (showPhone || showWhatsapp) && (
    <div class="sp-float-contacts" aria-label="Quick contact">
      {
        showPhone && (
          <a class="phone" href={`tel:${phoneTel}`} aria-label={`Call ${site.phone || phoneTel}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"
                fill="currentColor"></path>
            </svg>
          </a>
        )
      }
      {
        showWhatsapp && (
          <a
            class="whatsapp"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.5 3.5A11 11 0 0 0 3.1 17.3L2 22l4.8-1.1A11 11 0 1 0 20.5 3.5zM12 20.2a9.1 9.1 0 0 1-4.6-1.3l-.3-.2-2.9.7.7-2.8-.2-.3A9.2 9.2 0 1 1 12 20.2zm5.3-6.9c-.3-.1-1.7-.8-2-.9s-.5-.2-.7.1-.8.9-1 1-.4.2-.7.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.5-.6c.1-.2.1-.3 0-.5l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1.1 2.8 1.2 3 .2.3 2.1 3.3a13.4 13.4 0 0 0 3.7 2.5c1.4.5 1.9.4 2.6.4s1.3-.5 1.5-1 .2-1 .1-1.1-.3-.2-.6-.3z"
              ></path>
            </svg>
          </a>
        )
      }
    </div>
  )
}
