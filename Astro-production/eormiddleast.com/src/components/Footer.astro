---
import { site } from "../lib/content";

const year = new Date().getFullYear();
---

<footer class="sp-footer">
  <div class="sp-footer__grid sp-container">
    <div>
      <h3>Services</h3>
      <ul>
        {
          site.footerServices.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>Quick links</h3>
      <ul>
        {
          site.footerQuickLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>Contact</h3>
      <ul>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a href={`tel:${site.phoneTel}`}>{site.phone}</a>
        </li>
        <li>
          <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </li>
      </ul>
      <div class="sp-footer__social" aria-label="Social">
        <span>Facebook</span>
        <span>LinkedIn</span>
        <span>Instagram</span>
      </div>
    </div>
    <div class="sp-footer__brand">
      <a href="/">
        <img src={site.logo} alt={site.name} width="160" height="48" loading="lazy" />
      </a>
      <p>Reliable generator and heavy machinery rental across the United Arab Emirates.</p>
    </div>
  </div>
  <div class="sp-footer__bottom">
    <div class="sp-container">
      <p>© {year} {site.name}. All rights reserved.</p>
      <a href="#">Privacy Settings</a>
    </div>
  </div>
</footer>

<style>
  .sp-footer {
    background: #050505;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 3.5rem;
    color: #d7d7d7;
  }

  .sp-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    padding-bottom: 2.5rem;
  }

  .sp-footer h3 {
    font-family: var(--sp-font-display);
    letter-spacing: 0.05em;
    font-size: 1.4rem;
    color: #fff;
    margin: 0 0 1rem;
  }

  .sp-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sp-footer li + li {
    margin-top: 0.55rem;
  }

  .sp-footer a:hover {
    color: var(--sp-yellow);
  }

  .sp-footer__brand p {
    margin: 1rem 0 0;
    color: #bdbdbd;
    max-width: 28ch;
  }

  .sp-footer__social {
    display: flex;
    gap: 0.85rem;
    margin-top: 1rem;
    color: #9f9f9f;
    font-size: 0.85rem;
  }

  .sp-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1rem 0;
    font-size: 0.85rem;
  }

  .sp-footer__bottom .sp-container {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .sp-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .sp-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
