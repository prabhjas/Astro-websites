---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  BLOG_LOAD_MORE_PER_PAGE,
  INSIGHTS_FEATURED_COUNT,
  INSIGHTS_LATEST_COUNT,
  renderBlogCardsHtml,
  renderInsightsFeaturedCardsHtml,
  replaceEcsPostsInner,
} from "../../lib/blog-card-html";
import { getPageByPath, getPosts } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/seo";

export const prerender = false;

/**
 * Live archive is /insights/ (Elementor). Keep chrome; rebuild post grids from live data.
 * Featured (left) = newest; Latest (right) = next 2 only — no overlap with featured.
 */
const page = getPageByPath("/insights/");
if (!page) throw new Error("Insights page missing");

const sorted = [...getPosts()].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const featured = sorted.slice(0, INSIGHTS_FEATURED_COUNT);
const latest = sorted.slice(INSIGHTS_FEATURED_COUNT, INSIGHTS_FEATURED_COUNT + INSIGHTS_LATEST_COUNT);
const initialShown = featured.length + latest.length;
const hasMore = sorted.length > initialShown;

let html = page.bodyHtml || page.content;

html = replaceEcsPostsInner(html, 1, renderInsightsFeaturedCardsHtml(featured));
html = replaceEcsPostsInner(html, 2, renderBlogCardsHtml(latest));

if (hasMore) {
  html = html.replace(
    /<nav([^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*)>/i,
    `<nav$1 data-sp-blog-load-more="1" data-next-page="2" data-per-page="${BLOG_LOAD_MORE_PER_PAGE}" data-offset="${initialShown}">`,
  );
  html = html.replace(
    /(<a href=")\/(?:blog|insights)\/\?page=2(" class="elementor-button-link elementor-button)/i,
    `$1/insights/$2`,
  );
} else {
  html = html.replace(/<nav[^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*>[\s\S]*?<\/nav>/i, "");
}

let ecsSeen = 0;
html = html.replace(
  /<div([^>]*class="[^"]*ecs-posts[^"]*"[^>]*)>/gi,
  (full, attrs) => {
    ecsSeen += 1;
    if (ecsSeen === 2 && !/data-sp-blog-grid/.test(attrs)) {
      return `<div${attrs} data-sp-blog-grid="1">`;
    }
    return full;
  },
);

const extraCss = [
  ...(page.pageCss || []),
  page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
  "/wp-content/uploads/elementor/css/post-21423.css",
  "/wp-content/uploads/elementor/css/post-21574.css",
  "/css/insights-topic-cards.css",
];
---

<BaseLayout
  currentPath="/insights/"
  bodyClass={`page page-id-${page.id} elementor-page-${page.id}`}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title || "Insights | EOR Middle East",
    description:
      page.seo.description ||
      "EOR, PEO, payroll and HR insights across the Middle East.",
    canonical: "/insights/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Insights", url: "/insights/" },
      ]),
    ],
  }}
>
  <div class="sp-page-content" set:html={html} />
  <script is:inline src="/scripts/blog-load-more.js"></script>
</BaseLayout>
