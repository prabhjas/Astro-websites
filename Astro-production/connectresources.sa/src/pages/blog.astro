---
/**
 * Blog / Insights index — mirror live Elementor page (src/legacy/blog.cleaned.html).
 * Load More uses /api/blog/load-more (WP admin-ajax is not available on Astro).
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { injectRuntimeGtmLoader } from '../lib/gtm/inject';
import { applySharedChrome } from '../lib/shared-chrome.js';
import { injectBlogGridImageStyles } from '../lib/blog-grid-images.ts';

export const prerender = false;

const INITIAL_CARDS = 12; // ECS f2c45fb grid renders 12 vertical (template 124) cards in static HTML
const PER_PAGE = 6; // matches live ECS load-more page size

function decorateBlogLoadMore(html: string): string {
  let out = injectBlogGridImageStyles(html);

  // Mark ECS load-more nav for our client script
  out = out.replace(
    /<nav([^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*)>/i,
    `<nav$1 data-cs-blog-load-more="1" data-next-page="2" data-per-page="${PER_PAGE}" data-offset="${INITIAL_CARDS}" data-loading-text="Loading...">`,
  );

  // Point button away from /blog/?page=2 full navigation
  out = out.replace(
    /(<nav[^>]*ecs-load-more-button[^>]*>[\s\S]*?<a[^>]*href=")[^"]*(")/i,
    '$1javascript:void(0)$2',
  );

  if (!out.includes('blog-load-more.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/blog-load-more.js" defer></script>\n</body>`,
    );
  }

  if (!out.includes('astro-mirror-fixes.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/astro-mirror-fixes.js" defer></script>\n</body>`,
    );
  }

  if (!out.includes('cf-email-decode.js')) {
    out = out.replace(
      /<\/body>/i,
      `<script src="/js/cf-email-decode.js" defer></script>\n</body>`,
    );
  }

  return out;
}

const cleanedPath = join(process.cwd(), 'src/legacy/blog.cleaned.html');
if (!existsSync(cleanedPath)) {
  return new Response('Blog page not prepared', { status: 404 });
}

let html = readFileSync(cleanedPath, 'utf8');
html = decorateBlogLoadMore(injectRuntimeGtmLoader(applySharedChrome(html, 'blog')));

return new Response(html, {
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    'Cache-Control': 'public, max-age=0',
  },
});
---
