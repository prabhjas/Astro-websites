---
/**
 * Blog / Insights index — same pattern as kpmpro: SSR inject JSON posts into the
 * Elementor shell (src/legacy/blog.cleaned.html). New posts appear automatically
 * when added under src/content/blog/blog/*.json (newest publishedAt first).
 * Load More → /api/blog/load-more.
 */
import { getBlogPageData, serveArchivePage } from '../lib/archives.ts';

export const prerender = false;

return serveArchivePage(getBlogPageData(1));
