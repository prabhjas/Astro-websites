# On the production host this file is SPLIT:
#   .env       → build-only (PUBLIC_SITE_URL), root:webdev 0644 — no secrets
#   .env.prod  → runtime secrets for systemd (root:site-* 0640) — REQUIRED (no EnvironmentFile=-)
# Local laptop: one gitignored .env with secrets is fine for fleet-local smoke.
#
# Public canonical website origin (no trailing slash required).
# Used by astro.config `site` and Rank Math–style robots/sitemap absolute URLs.
# This is a public origin only — never put secrets in PUBLIC_* variables.
PUBLIC_SITE_URL=https://emiratisationgateway.com

# --- Lead storage (file-backed source of truth) ---
LEAD_STORE_DIR=.data/leads
LEAD_STORE_MAX_FILE_BYTES=10485760
PIPEDRIVE_MAX_RETRY_ATTEMPTS=5
PIPEDRIVE_REQUEST_TIMEOUT_MS=10000

# --- Pipedrive (required for POST /api/contact) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
# Alias supported: PIPEDRIVE_API_URL=
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_LEAD_SOURCE_ID=270
PIPEDRIVE_PERSON_LABEL_IDS=
PIPEDRIVE_PERSON_VISIBLE_TO=3

# Optional Pipedrive custom field hashes — defaults live in src/env/server.ts (fieldKeys).
# Uncomment only to override for this domain. Commented ≠ disabled.
# PIPEDRIVE_FIELD_MESSAGE=3a108ee6cdcaad880546876dd524bfa9aa686da7
# PIPEDRIVE_FIELD_SOURCE=296a2c3746355d2b33b7ff392bd038199eaf9665
# PIPEDRIVE_FIELD_WEBSITE=af2182f3f2ee03a51c7dcfd898951a268787343c
# PIPEDRIVE_FIELD_LEAD_SUBMITTED_ON=1b6c5556b8f2796d4a87d842248152f78384ac37
# PIPEDRIVE_FIELD_USER_LANDED_ON=da1c7e07576ae835e0cf337b831ab2db59d64707

# --- Website / form identity ---
# WEBSITE_ID must match a Pipedrive Lead "Website" enum option id
# (Emiratization getaway = 5062 in connectgroup2).
WEBSITE_ID=5062
WEBSITE_NAME=Emiratisation Gateway
FORM_SOURCE=270
FORM_NAME=Emiratisation Gateway Contact Form
LEAD_TITLE_PREFIX=Emiratisation Gateway

LOG_LEVEL=info

# --- Analytics (interim until FLOW dashboard) ---
# Do NOT hardcode GTM/gtag in HTML mirrors. /runtime-gtm.js loads these at runtime.
# Priority: FLOW .data/internal-admin/gtm.json → GTM_*_SCRIPT snippets → IDs below.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=          # GA4 measurement ID(s), comma-separated OK
# Optional full snippets (when set, used instead of ID helpers):
# GTM_HEAD_SCRIPT=
# GTM_BODY_HTML=
# GTM_FOOTER_SCRIPT=

# --- Internal machine API (central FLOW / CMS / cron) ---
# Per-site dashboard UI removed. Auth:
#   Authorization: Bearer <INTERNAL_JOB_SECRET>
# Also accepts: x-internal-job-secret header or ?secret= (cron).
# One secret per site — never reuse across domains.
# Generate: openssl rand -hex 32
INTERNAL_JOB_SECRET=
INTERNAL_ADMIN_DIR=.data/internal-admin
INTERNAL_ENHANCED_LIVE_DIR=.data/enhanced-live
INTERNAL_UPLOAD_DIR=.data/internal-uploads
INTERNAL_UPLOAD_MAX_FILE_BYTES=10485760

# Do NOT set HOST or PORT here — systemd / fleet-local sets them (emiratisationgateway = 5106).
# Use LF line endings only (CRLF breaks systemd EnvironmentFile=).
# Do NOT rely on FORM_NOTIFICATION_* / SMTP_* for lead notify — Pipedrive + file store.
