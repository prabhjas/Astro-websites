---
import TaxonomyArchive from "../../../components/TaxonomyArchive.astro";
import {
  getCategoryBySlug,
  getPostsByCategory,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
} from "../../../lib/content";
import { notFoundResponse } from "../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const category = getCategoryBySlug(slug);
if (!category) {
  return notFoundResponse();
}
const sorted = getPostsByCategory(category.id);
const { items, page, totalPages } = paginate(sorted, 1, POSTS_PER_PAGE);
const name = stripHtml(category.name);
---

<TaxonomyArchive
  currentPath={category.path}
  title={`${name} Archives | Iberia EOR`}
  description={category.description || `Articles in ${category.name} from Iberia EOR.`}
  canonical={category.path}
  headingHtml={category.name}
  descriptionHtml={category.description || undefined}
  crumbs={[
    { name: "Home", href: "/" },
    { name: "Blog", href: "/blog/" },
    { name: category.name },
  ]}
  schemaCrumbs={[
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
    { name: category.name, url: category.path },
  ]}
  items={items}
  page={page}
  totalPages={totalPages}
  basePath={category.path}
  emptyMessage="No posts in this category yet."
/>
