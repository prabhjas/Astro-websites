---
export const prerender = false;
import AuthorArchive from "../../../components/AuthorArchive.astro";
import {
  INSIGHTS_POSTS_PER_PAGE,
  renderInsightsCardsHtml,
} from "../../../lib/blog-card-html";
import {
  getAuthorBySlug,
  getPostsByAuthor,
  paginate,
  stripHtml,
} from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/seo";
import { notFoundResponse } from "../../../lib/not-found";

const slug = String(Astro.params.slug || "");
const author = getAuthorBySlug(slug);
if (!author) {
  return notFoundResponse();
}

const sorted = getPostsByAuthor(author.id);
const { items, page, totalPages } = paginate(sorted, 1, INSIGHTS_POSTS_PER_PAGE);
const name = stripHtml(author.name);
const bio = stripHtml(author.description || "").trim();
const cardsHtml = items.length ? renderInsightsCardsHtml(items) : "";
---

<AuthorArchive
  author={author}
  name={name}
  bio={bio}
  items={items}
  cardsHtml={cardsHtml}
  page={page}
  totalPages={totalPages}
  canonical={author.path}
  title={`Author: ${name} | Iberia EOR`}
  bodyClass={`archive author author-page author-${author.slug} author-${author.id} elementor-default elementor-page elementor-page-author`}
  schemas={[
    breadcrumbSchema([
      { name: "Home", url: "/" },
      { name, url: author.path },
    ]),
  ]}
/>
