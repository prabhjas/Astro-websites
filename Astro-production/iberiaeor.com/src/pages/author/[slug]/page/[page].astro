---
export const prerender = false;
import AuthorArchive from "../../../../components/AuthorArchive.astro";
import {
  INSIGHTS_POSTS_PER_PAGE,
  renderInsightsCardsHtml,
} from "../../../../lib/blog-card-html";
import {
  getAuthorBySlug,
  getPostsByAuthor,
  paginate,
  stripHtml,
} from "../../../../lib/content";
import { breadcrumbSchema } from "../../../../lib/seo";
import { notFoundResponse } from "../../../../lib/not-found";

const slug = String(Astro.params.slug || "");
const author = getAuthorBySlug(slug);
if (!author) {
  return notFoundResponse();
}

const pageNum = Number(Astro.params.page || "2");
const sorted = getPostsByAuthor(author.id);
const { items, page, totalPages } = paginate(sorted, pageNum, INSIGHTS_POSTS_PER_PAGE);
if (pageNum < 2 || pageNum > totalPages) {
  return Astro.redirect(author.path, 301);
}

const name = stripHtml(author.name);
const bio = stripHtml(author.description || "").trim();
const cardsHtml = items.length ? renderInsightsCardsHtml(items) : "";
const pageCanonical = `${author.path.replace(/\/$/, "")}/page/${page}/`;
---

<AuthorArchive
  author={author}
  name={name}
  bio={bio}
  items={items}
  cardsHtml={cardsHtml}
  page={page}
  totalPages={totalPages}
  canonical={pageCanonical}
  title={`Author: ${name} - Page ${page} | Iberia EOR`}
  bodyClass={`archive author author-page author-${author.slug} author-${author.id} elementor-default elementor-page elementor-page-author paged`}
  schemas={[
    breadcrumbSchema([
      { name: "Home", url: "/" },
      { name, url: author.path },
      { name: `Page ${page}`, url: pageCanonical },
    ]),
  ]}
/>
