---
export const prerender = false;
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AuthorHero from "../../../../components/AuthorHero.astro";
import Pagination from "../../../../components/Pagination.astro";
import {
  INSIGHTS_POSTS_PER_PAGE,
  renderInsightsCardsHtml,
} from "../../../../lib/blog-card-html";
import {
  getAuthorBySlug,
  getPostsByAuthor,
  paginate,
  stripHtml,
} from "../../../../lib/content";
import { breadcrumbSchema } from "../../../../lib/seo";
import { notFoundResponse } from "../../../../lib/not-found";

const slug = String(Astro.params.slug || "");
const author = getAuthorBySlug(slug);
if (!author) {
  return notFoundResponse();
}

const pageNum = Number(Astro.params.page || "2");
const sorted = getPostsByAuthor(author.id);
const { items, page, totalPages } = paginate(sorted, pageNum, INSIGHTS_POSTS_PER_PAGE);
if (pageNum < 2 || pageNum > totalPages) {
  return Astro.redirect(author.path, 301);
}

const name = stripHtml(author.name);
const bio = stripHtml(author.description || "").trim();
const cardsHtml = items.length ? renderInsightsCardsHtml(items) : "";
---

<BaseLayout
  currentPath={author.path}
  bodyClass={`archive author author-page author-${author.slug} author-${author.id} elementor-default elementor-page elementor-page-author paged`}
  extraCss={[
    "/wp-content/uploads/elementor/css/post-213.css",
    "/css/author-page.css",
  ]}
  seo={{
    title: `Author: ${name} — Page ${page} | Iberia EOR`,
    description: bio || `Articles by ${name}.`,
    canonical: `${author.path.replace(/\/$/, "")}/page/${page}/`,
    ogImage: author.avatar || undefined,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name, url: author.path },
        { name: `Page ${page}`, url: `${author.path.replace(/\/$/, "")}/page/${page}/` },
      ]),
    ],
  }}
>
  <AuthorHero author={author} />

  <section class="author-page-articles">
    <div class="author-page-articles__inner">
      <h2 class="author-page-articles__title">Articles By {name}</h2>
      {
        items.length ? (
          <div
            class="ecs-posts elementor-posts-container elementor-posts elementor-grid elementor-posts--skin-custom"
            data-sp-author-grid="1"
            set:html={cardsHtml}
          />
        ) : (
          <p class="author-page-empty">No posts by this author.</p>
        )
      }
      <Pagination page={page} totalPages={totalPages} basePath={author.path} />
    </div>
  </section>
</BaseLayout>
