---
import TaxonomyArchive from "../../../components/TaxonomyArchive.astro";
import {
  getTagBySlug,
  getPostsByTag,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
} from "../../../lib/content";
import { notFoundResponse } from "../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const tag = getTagBySlug(slug);
if (!tag) {
  return notFoundResponse();
}
const sorted = getPostsByTag(tag.id);
const { items, page, totalPages } = paginate(sorted, 1, POSTS_PER_PAGE);
const name = stripHtml(tag.name);
---

<TaxonomyArchive
  currentPath={tag.path}
  title={`Tag: ${name} | Iberia EOR`}
  description={tag.description || `Posts tagged ${tag.name}.`}
  canonical={tag.path}
  headingHtml={tag.name}
  crumbs={[
    { name: "Home", href: "/" },
    { name: "Blog", href: "/blog/" },
    { name: tag.name },
  ]}
  schemaCrumbs={[
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
    { name: tag.name, url: tag.path },
  ]}
  items={items}
  page={page}
  totalPages={totalPages}
  basePath={tag.path}
  emptyMessage="No posts with this tag."
/>
