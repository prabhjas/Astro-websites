{
  "name": "iberiaworkforce-astro",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Iberia Work Force \u2014 Astro site",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "astro dev --port 5083 --host",
    "build": "astro build && node ./scripts/patch-entry-lead-safe-slash.mjs",
    "preview": "astro preview --port 5083 --host",
    "start": "node ./dist/server/entry.mjs",
    "test": "node --import tsx --test tests/contact-form.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "nodemailer": "catalog:",
    "sharp": "0.35.3",
    "tailwindcss": "catalog:",
    "yaml": "catalog:",
    "@connect/site-cms": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
