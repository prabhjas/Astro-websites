# ── Pipedrive lead capture for the contact forms (POST /api/lead) ──────────────
# Create a token in Pipedrive: Settings → Personal preferences → API.
PIPEDRIVE_API_TOKEN=your_pipedrive_api_token_here

# Optional overrides. Fill these in with the Iberia Workforce Pipedrive account IDs.
# PIPEDRIVE_OWNER_ID=0
# PIPEDRIVE_VISIBLE_TO=3
# PIPEDRIVE_LEAD_TITLE=Website lead — iberiaworkforce.com
