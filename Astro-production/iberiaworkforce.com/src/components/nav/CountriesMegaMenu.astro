---
import type { ImageMetadata } from "astro";
import flagSpain from "../../assets/flags/flag-spain.svg";
import flagGermany from "../../assets/flags/flag-germany.svg";
import flagItaly from "../../assets/flags/flag-italy.svg";
import flagPoland from "../../assets/flags/flag-poland.svg";
import flagPortugal from "../../assets/flags/flag-portugal.svg";
import MegaPanel from "./MegaPanel.astro";
import { getUi } from "../../i18n/copy";
import { getCountryNav } from "../../lib/service-nav";

const { lang, t } = getUi(Astro.url.pathname);

const flags: Record<string, ImageMetadata> = {
  spain: flagSpain,
  germany: flagGermany,
  italy: flagItaly,
  poland: flagPoland,
  portugal: flagPortugal,
};

const groups = (await getCountryNav(lang)).map((country) => ({
  slug: country.slug,
  label: country.label,
  mark: flags[country.slug],
  items: country.services,
}));
---

<MegaPanel
  id="countries-menu"
  triggerId="countries-menu-trigger"
  railLabel={t.nav.countriesRail}
  comingSoon={t.nav.comingSoon}
  groups={groups}
/>
