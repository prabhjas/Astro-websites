---
/**
 * The shell both header menus are drawn in.
 *
 * Services and Countries are the same object read from two directions, so they
 * are one set of decisions rather than two files drifting apart: this component
 * owns the material, the type scale, the states and the motion, and each menu
 * supplies only its groups.
 *
 * Three things carry the design:
 *
 * - A sheet on the page gutters, so both menus take the same width and moving
 *   between them shifts nothing. `scripts/mega-menu.ts` writes
 *   `transform-origin` from the trigger's own centre, so it still scales out of
 *   the button that opened it. The destinations run two across only from `xl`:
 *   between 1024 and 1280 the columns are too narrow for a description and the
 *   pair wrapped with the pending label orphaned below the name.
 * - The rail has no fill at any state. Selection is ink, weight, the mark
 *   coming up to full colour, and the hairline segment travelling down the
 *   divider to point at the chosen row.
 * - Colour does one job per column: the destination rows are the only things
 *   that take a wash, and it is a navy tint rather than a flat pale fill,
 *   because the sheet underneath is translucent and a fixed `navy-50`
 *   disappeared into it.
 *
 * No eyebrow over the list, deliberately: the rail already names what is being
 * shown, and "SERVICES IN SPAIN" over a list of services in Spain is a caption
 * for a picture of itself.
 */
import { Image } from "astro:assets";
import chevronRight from "../../assets/icons/chevron-right.svg";
import Icon from "../ui/Icon.astro";

export interface MegaItem {
  label: string;
  description?: string;
  href: string;
  /** Pending pages render as muted, unclickable rows rather than 404 links. */
  available: boolean;
}

export interface MegaGroup {
  slug: string;
  label: string;
  /** Optional mark beside the rail label. Desaturated until the row is active. */
  mark?: ImageMetadata;
  /**
   * A first destination set apart above the rest — the category hub on the
   * Services menu. Countries have no equivalent, so they leave it out.
   */
  lead?: MegaItem;
  items: MegaItem[];
}

interface Props {
  id: string;
  triggerId: string;
  /** Names the rail for assistive tech: "Countries", "Service categories". */
  railLabel: string;
  comingSoon?: string;
  groups: MegaGroup[];
}

const { id, triggerId, railLabel, comingSoon = "Coming Soon", groups } = Astro.props;
---

<div
  id={id}
  data-menu-trigger-id={triggerId}
  class="mega-panel absolute inset-x-0 top-full hidden pt-2 pb-6"
>
  <div class="section-shell">
    <div class="mega-surface">
      <div
        class="grid grid-cols-[15rem_minmax(0,1fr)] p-4 xl:grid-cols-[17.5rem_minmax(0,1fr)]"
      >
      <!-- Rail -->
        <div class="relative pr-6">
        <span
          class="mega-divider absolute inset-y-1 right-0 w-px"
          aria-hidden="true"></span>
        <span
          data-menu-marker
          class="mega-marker absolute top-0 right-[-0.5px] w-0.5 rounded-full bg-text-link opacity-0"
          aria-hidden="true"></span>

        <ul role="tablist" aria-orientation="vertical" aria-label={railLabel}>
          {
            groups.map((group, i) => (
              <li>
                {/* Desaturating the inactive marks is what turns five national
                    flags from a row of stickers into a quiet column — and
                    gives the active one somewhere to arrive. The hairline
                    keeps the white half of Poland off the sheet. */}
                <button
                  type="button"
                  role="tab"
                  id={`${id}-tab-${group.slug}`}
                  aria-controls={`${id}-pane-${group.slug}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  data-menu-tab={group.slug}
                  class="group flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-h4 font-medium tracking-[-0.01em] whitespace-nowrap text-text-tertiary transition-colors duration-200 ease-out hover:text-text-secondary aria-selected:font-semibold aria-selected:text-text-primary"
                >
                  {group.mark && (
                    <Image
                      src={group.mark}
                      alt=""
                      width={18}
                      height={18}
                      class="size-[18px] shrink-0 rounded-[2px] opacity-45 ring-1 ring-navy/10 ring-inset grayscale transition-[filter,opacity] duration-300 ease-out group-aria-selected:opacity-100 group-aria-selected:grayscale-0"
                    />
                  )}
                  {group.label}
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Panes -->
        <div data-menu-panes class="pl-8">
        {
          groups.map((group, i) => (
            <div
              role="tabpanel"
              id={`${id}-pane-${group.slug}`}
              aria-labelledby={`${id}-tab-${group.slug}`}
              data-menu-pane={group.slug}
              hidden={i !== 0}
              tabindex={-1}
            >
              {group.lead &&
                (group.lead.available ? (
                  <a
                    href={group.lead.href}
                    class="group/lead mb-2 -ml-3 flex w-fit items-center gap-2 rounded-[10px] px-3 py-2.5 transition-colors duration-200 ease-out hover:bg-navy/[0.055]"
                  >
                    <span class="text-h5 text-text-primary">
                      {group.lead.label}
                    </span>
                    <Icon
                      src={chevronRight}
                      size={16}
                      tone="current"
                      class="text-text-link transition-transform duration-200 ease-out group-hover/lead:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover/lead:translate-x-0"
                    />
                  </a>
                ) : (
                  <span
                    class="mb-2 -ml-3 flex w-fit items-baseline gap-2.5 px-3 py-2.5"
                    aria-disabled="true"
                  >
                    <span class="text-h5 text-text-tertiary">
                      {group.lead.label}
                    </span>
                    <span class="text-micro text-text-tertiary">
                      {comingSoon}
                    </span>
                  </span>
                ))}

              <ul class="grid gap-x-6 xl:grid-cols-2">
                {group.items.map((item) =>
                  item.available ? (
                    <li>
                      <a
                        href={item.href}
                        class="block rounded-[10px] px-3 py-2.5 transition-colors duration-200 ease-out hover:bg-navy/[0.055]"
                      >
                        <span class="block text-body font-medium text-text-primary">
                          {item.label}
                        </span>
                        {item.description && (
                          <span class="mt-0.5 block text-body-sm text-text-secondary">
                            {item.description}
                          </span>
                        )}
                      </a>
                    </li>
                  ) : (
                    <li>
                      <span class="block px-3 py-2.5" aria-disabled="true">
                        <span class="flex flex-wrap items-baseline gap-2.5">
                          <span class="text-body font-medium text-text-tertiary">
                            {item.label}
                          </span>
                          <span class="text-micro text-text-tertiary">
                            {comingSoon}
                          </span>
                        </span>
                        {item.description && (
                          <span class="mt-0.5 block text-body-sm text-text-tertiary">
                            {item.description}
                          </span>
                        )}
                      </span>
                    </li>
                  ),
                )}
              </ul>
            </div>
          ))
        }
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initMegaMenu } from "../../scripts/mega-menu";

  document
    .querySelectorAll<HTMLElement>(".mega-panel[data-menu-trigger-id]")
    .forEach((panel) => initMegaMenu(panel.dataset.menuTriggerId!, panel.id));
</script>
