---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import chevronDown from "../../assets/icons/chevron-down.svg";
import flagSpain from "../../assets/flags/flag-spain.svg";
import flagGermany from "../../assets/flags/flag-germany.svg";
import flagItaly from "../../assets/flags/flag-italy.svg";
import flagPoland from "../../assets/flags/flag-poland.svg";
import flagPortugal from "../../assets/flags/flag-portugal.svg";
import Icon from "../ui/Icon.astro";
import { getUi } from "../../i18n/copy";
import { getCountryNav } from "../../lib/service-nav";

interface Props {
  /** Highlights "Countries" when the current page is a country page. */
  active?: boolean;
}

const { active = false } = Astro.props;
const { lang, t } = getUi(Astro.url.pathname);

const flags: Record<string, ImageMetadata> = {
  spain: flagSpain,
  germany: flagGermany,
  italy: flagItaly,
  poland: flagPoland,
  portugal: flagPortugal,
};

const countries = await getCountryNav(lang);
---

<details class="disclosure nav-disclosure group/countries">
  <summary
    class:list={[
      "flex cursor-pointer list-none items-center justify-between py-3 text-body font-medium",
      active ? "text-text-primary" : "text-text-secondary",
    ]}
  >
    {t.nav.countries}
    <Icon
      src={chevronDown}
      size={20}
      tone="current"
      class="transition-transform duration-200 group-open/countries:rotate-180"
    />
  </summary>

  <ul class="mb-2 flex flex-col border-l border-border-subtle pl-3">
    {
      countries.map((country) => (
        <li>
          <details class="disclosure nav-disclosure group/country">
            <summary class="flex cursor-pointer list-none items-center justify-between py-2.5 text-body-sm font-medium text-text-primary">
              <span class="flex items-center gap-2.5">
                {flags[country.slug] && (
                  <Image
                    src={flags[country.slug]}
                    alt=""
                    width={20}
                    height={20}
                    class="size-5 shrink-0 rounded-[3px] ring-1 ring-navy/10 ring-inset"
                  />
                )}
                {country.label}
              </span>
              <Icon
                src={chevronDown}
                size={16}
                tone="current"
                class="text-text-secondary transition-transform duration-200 group-open/country:rotate-180"
              />
            </summary>

            <ul class="flex flex-col pb-2 pl-3">
              {country.services.map((service) => (
                <li>
                  {service.available ? (
                    <a
                      href={service.href}
                      class="block py-2.5 text-body-sm text-text-secondary"
                    >
                      {service.label}
                    </a>
                  ) : (
                    <span
                      class="flex items-center gap-2 py-2.5 text-body-sm text-text-tertiary"
                      aria-disabled="true"
                    >
                      {service.label}
                      <span class="text-micro text-text-tertiary">{t.nav.comingSoon}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .nav-disclosure > summary::-webkit-details-marker {
    display: none;
  }
</style>
