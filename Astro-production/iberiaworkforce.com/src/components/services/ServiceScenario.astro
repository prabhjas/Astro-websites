---
/**
 * "Why this matters": the claim, its paragraph and a button hold the left
 * column, with a white card on the cream band holding a single worked example —
 * an eyebrow, the story in H2-scale type, and the lesson behind a terracotta
 * rule.
 *
 * A grid rather than a flex row, because the button does not travel with the
 * copy: on desktop it sits under the paragraph, and on both narrow frames it
 * moves to the *bottom of the section*, after the card. That is placement, and
 * source order cannot express it.
 *
 * Deliberately not `intro.quote`, which is a claim the company makes about
 * itself set as a pull quote in the brand's colours. This is a story about the
 * reader going wrong — hence white rather than navy, and hence the rule under
 * it carrying the lesson rather than a punchline.
 */
import type { CollectionEntry } from "astro:content";
import Button from "../ui/Button.astro";

type Props = NonNullable<CollectionEntry<"services">["data"]["scenario"]>;

const { heading, body, cta, example } = Astro.props;
---

<section class="bg-bg-page py-20 lg:py-30" aria-labelledby="scenario-heading">
  {/*
    `476px + 48 + 1fr` is the desktop geometry. The `1fr` second row keeps the
    button directly under the paragraph rather than floating down the empty
    half of its column: the card spans both rows and is much the taller side,
    so an `auto` row would share its spare height out between the two.
  */}
  <div
    class="section-shell flex flex-col items-start gap-10 lg:grid lg:grid-cols-[476px_1fr] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-12 lg:gap-y-10"
  >
    <div
      class="flex flex-col items-start gap-4 lg:col-start-1 lg:row-start-1"
      data-reveal
    >
      <h2 id="scenario-heading" class="text-h1 text-balance text-text-primary">
        {heading}
      </h2>
      <p class="text-body-lg text-text-secondary">{body}</p>
    </div>

    <figure
      class="flex w-full flex-col items-start gap-6 rounded-xl bg-bg-surface p-5 md:p-10 lg:col-start-2 lg:row-span-2 lg:row-start-1"
      data-reveal
      style="--reveal-i:1"
    >
      <figcaption class="text-h4 text-text-primary">{example.eyebrow}</figcaption>
      {/*
        Set at H2 and in the *regular* weight the frames draw — this is a
        quotation being read, not a heading being announced, and the section
        already has its heading beside it.
      */}
      <blockquote class="text-h2 font-normal text-balance text-text-secondary">
        {example.quote}
      </blockquote>
      <p
        class="border-l-4 border-terracotta pl-6 text-h4 font-normal text-text-tertiary"
      >
        {example.lesson}
      </p>
    </figure>

    {
      cta && (
        /* Wrapped rather than annotated directly: Button declares its props, so
           `data-reveal` on the component itself would be dropped. */
        <div
          class="w-full sm:w-auto lg:col-start-1 lg:row-start-2 lg:self-start lg:justify-self-start"
          data-reveal
          style="--reveal-i:2"
        >
          <Button
            variant="primary"
            size="lg"
            href={cta.href}
            class="w-full sm:w-auto"
          >
            {cta.label}
          </Button>
        </div>
      )
    }
  </div>
</section>
