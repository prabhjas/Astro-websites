---
/**
 * The service *category hub* template — one of the two shapes every service
 * page takes (see the IA in CLAUDE.md). Every section is optional and driven
 * entirely by the content file, so the remaining four hubs need only their own
 * YAML, not their own component.
 */
import type { CollectionEntry } from "astro:content";
import ServiceHero from "./ServiceHero.astro";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceDefinition from "./ServiceDefinition.astro";
import ServiceScenario from "./ServiceScenario.astro";
import ServiceDifferentiator from "./ServiceDifferentiator.astro";
import ServiceWhyItMatters from "./ServiceWhyItMatters.astro";
import ServiceWhyChoose from "./ServiceWhyChoose.astro";
import ServiceSteps from "./ServiceSteps.astro";
import ServiceIncluded from "./ServiceIncluded.astro";
import ServiceCountries from "./ServiceCountries.astro";
import ServiceFaq from "./ServiceFaq.astro";
import ServiceClosing from "./ServiceClosing.astro";

interface Props {
  data: CollectionEntry<"services">["data"];
}

const { data } = Astro.props;
---

<ServiceHero {...data.hero} />
{data.intro && <ServiceIntro {...data.intro} />}
{data.definition && <ServiceDefinition {...data.definition} />}
{data.scenario && <ServiceScenario {...data.scenario} />}
{data.differentiator && <ServiceDifferentiator {...data.differentiator} />}
{data.whyItMatters && <ServiceWhyItMatters {...data.whyItMatters} />}
{data.whyChoose && <ServiceWhyChoose {...data.whyChoose} />}
{data.howItWorks && <ServiceSteps {...data.howItWorks} />}
{data.included && <ServiceIncluded {...data.included} />}
{data.countries && <ServiceCountries {...data.countries} />}
{data.faq && <ServiceFaq {...data.faq} />}
{data.closing && <ServiceClosing {...data.closing} />}
