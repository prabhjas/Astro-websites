---
import { type Lang } from '../i18n/config';
import { dict } from '../i18n/content';
import { services } from '../data/services';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dict(lang);
const f = d.contact.form;
const field = 'mt-1 w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-sm text-ink placeholder-muted/70 focus:border-brand-500 focus:ring-2 focus:ring-brand-200';
const label = 'block text-sm font-medium text-ink';
---
<form id="lead-form" class="space-y-4" novalidate>
  <input type="hidden" name="lang" value={lang} />
  <!-- Honeypot: hidden from humans; bots fill it and we drop the submission. -->
  <div class="hidden" aria-hidden="true">
    <label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class={label} for="name">{f.name} *</label>
      <input class={field} id="name" name="name" type="text" required autocomplete="name" />
    </div>
    <div>
      <label class={label} for="company">{f.company}</label>
      <input class={field} id="company" name="company" type="text" autocomplete="organization" />
    </div>
    <div>
      <label class={label} for="email">{f.email} *</label>
      <input class={field} id="email" name="email" type="email" autocomplete="email" />
    </div>
    <div>
      <label class={label} for="phone">{f.phone}</label>
      <input class={field} id="phone" name="phone" type="tel" autocomplete="tel" />
    </div>
  </div>

  <div>
    <label class={label} for="service">{f.service}</label>
    <select class={field} id="service" name="service">
      <option value="">{f.servicePlaceholder}</option>
      {services.map((s) => <option value={s[lang].navName}>{s[lang].navName}</option>)}
      <option value="general">{f.serviceGeneral}</option>
    </select>
  </div>

  <div>
    <label class={label} for="message">{f.message}</label>
    <textarea class={field} id="message" name="message" rows="4"></textarea>
  </div>

  <p class="text-xs text-muted">{f.consent}</p>

  <button type="submit" class="btn-primary w-full sm:w-auto">
    <span data-label>{f.submit}</span>
  </button>

  <p id="form-msg" class="hidden text-sm" role="status" aria-live="polite"></p>
</form>

<script is:inline define:vars={{ strings: { submit: f.submit, sending: f.sending, success: f.success, error: f.error, required: f.required } }}>
  const form = document.getElementById('lead-form');
  const msg = document.getElementById('form-msg');
  const btn = form.querySelector('button[type="submit"]');
  const btnLabel = btn.querySelector('[data-label]');

  const show = (text, ok) => {
    msg.textContent = text;
    msg.className = 'text-sm ' + (ok ? 'text-green-700' : 'text-red-600');
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    if (!data.name || (!data.email && !data.phone)) { show(strings.required, false); return; }

    btn.disabled = true;
    btnLabel.textContent = strings.sending;
    msg.className = 'hidden';
    // Help routing/attribution in the CRM.
    data.landed_url = location.href;

    try {
      // Live Caddy currently proxies /api/lead only (full reverse-proxy pending Tier 1).
      const res = await fetch('/api/lead/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json().catch(() => ({}));
      if (res.ok && (out.success || out.ok)) {
        form.reset();
        show(strings.success, true);
      } else {
        show(out.message || out.error || strings.error, false);
      }
    } catch {
      show(strings.error, false);
    } finally {
      btn.disabled = false;
      btnLabel.textContent = strings.submit;
    }
  });
</script>
