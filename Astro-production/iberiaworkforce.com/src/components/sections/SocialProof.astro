---
import { Image } from "astro:assets";
import avatarDenis from "../../assets/avatars/avatar-denis-slavska.png";
import avatarJahan from "../../assets/avatars/avatar-jahan-melad.png";
import avatarJim from "../../assets/avatars/avatar-jim-halpert.png";
import { getUi } from "../../i18n/copy";
import CarouselControls from "../ui/CarouselControls.astro";

const { t } = getUi(Astro.url.pathname);
const s = t.social;

const avatars = [avatarDenis, avatarJahan, avatarJim];
const names = ["Sarah Chen", "Marcus Okonkwo", "Elena Rodriguez"];
const companies = ["TechScale", "GrowthCo", "EuroTech"];

const testimonials = s.quotes.map((quote, i) => ({
  avatar: avatars[i]!,
  company: companies[i]!,
  name: names[i]!,
  ...quote,
}));
---

<section
  id="clients"
  class="bg-bg-muted py-20 lg:py-30"
  aria-labelledby="social-proof-heading"
>
  <div class="section-shell flex flex-col items-start gap-16">
    <header
      class="flex w-full flex-col items-center gap-3 text-center"
      data-reveal
    >
      <p
        class="text-caption font-medium tracking-[0.26px] whitespace-nowrap text-text-link"
      >
        {s.eyebrow}
      </p>
      <h2
        id="social-proof-heading"
        class="text-h2 text-text-primary"
      >
        {s.heading}
      </h2>
    </header>

    <ul
      id="testimonials-carousel"
      class="carousel self-stretch lg:grid lg:grid-cols-3 lg:gap-6"
      tabindex="0"
      role="group"
      aria-label={s.aria}
    >
      {
        testimonials.map((testimonial, i) => (
          <li
            class="carousel-item card-lift flex flex-col items-start justify-between rounded-xl border border-border-subtle bg-bg-surface p-6 lg:min-h-[440px] lg:p-8"
            data-reveal
            style={`--reveal-i:${i}`}
          >
            <figure class="flex h-full w-full flex-col items-start justify-between gap-6">
              <div class="flex w-full items-center justify-between">
                <Image
                  src={testimonial.avatar}
                  alt={testimonial.name}
                  width={48}
                  height={48}
                  class="size-12 rounded-full object-cover"
                  loading="lazy"
                />
                <span class="rounded-full bg-bg-muted px-2.5 py-1.5 text-caption font-medium tracking-[0.26px] whitespace-nowrap text-text-secondary">
                  {testimonial.company}
                </span>
              </div>

              <span
                class="text-[56px] leading-none font-semibold text-text-link"
                aria-hidden="true"
              >
                &ldquo;
              </span>

              <blockquote class="text-h4 text-text-primary">
                {testimonial.quote}
              </blockquote>

              <figcaption class="flex w-full flex-col items-start gap-1">
                {/* No `whitespace-nowrap`: roles like "Project Manager,
                    BuildWave" overflow a narrow card. */}
                <span class="text-body text-text-primary">
                  {testimonial.name}
                </span>
                <span class="text-caption font-medium text-text-secondary">
                  {testimonial.role}
                </span>
                <span class="text-caption font-medium text-text-secondary">
                  {testimonial.location}
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <CarouselControls
      for="testimonials-carousel"
      count={testimonials.length}
      class="w-full text-text-primary"
    />
  </div>
</section>
