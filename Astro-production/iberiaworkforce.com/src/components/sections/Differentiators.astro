---
import { Image } from "astro:assets";
import contourTexture from "../../assets/images/contour-texture.webp";
import { getUi } from "../../i18n/copy";

const { t } = getUi(Astro.url.pathname);
const d = t.differentiators;
---

{/*
  Deliberately no `overflow-hidden` on this section: an overflow ancestor
  becomes the sticky heading's scrollport, and because the section does not
  itself scroll, the heading would never pin. The background image is
  `inset-0 size-full object-cover`, so it no longer overflows and needs no
  clipping.
*/}
<section
  id="about"
  class="relative isolate bg-text-primary py-20 lg:py-30"
  aria-labelledby="differentiators-heading"
>
  <Image
    src={contourTexture}
    alt=""
    widths={[720, 1440, 2880]}
    sizes="100vw"
    class="pointer-events-none absolute inset-0 -z-10 size-full object-cover"
    loading="lazy"
  />

  <div
    class="section-shell flex flex-col items-start justify-between gap-12 lg:flex-row lg:gap-20"
  >
    {/*
      `self-start` stops the heading stretching to the row height, which is what
      lets `sticky` engage. The section is its own containing block, so the
      heading travels with the list and releases at the section's bottom edge.
      top-24 clears the 72px sticky navbar.
    */}
    <h2
      id="differentiators-heading"
      class="text-display text-text-inverse lg:sticky lg:top-24 lg:w-[520px] lg:shrink-0 lg:self-start"
    >
      {d.headingBefore}<span class="text-terracotta">{d.headingBrand}</span>{d.headingAfter}
    </h2>

    <dl class="flex w-full flex-col items-start lg:w-[628px] lg:shrink-0">
      {
        d.items.map((item, i) => (
          <div
            class="flex w-full flex-col items-start gap-5 border-b border-text-secondary py-8"
            data-reveal
            style={`--reveal-i:${i}`}
          >
            <dt class="text-h3 text-text-inverse">{item.title}</dt>
            <dd class="text-body text-text-inverse opacity-80">
              {item.description}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
