---
import Logo from './Logo.astro';
import { localize, altPath, type Lang } from '../i18n/config';
import { dict } from '../i18n/content';
import { services } from '../data/services';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dict(lang);
const path = Astro.url.pathname;
const other: Lang = lang === 'en' ? 'es' : 'en';
const otherHref = altPath(path, lang, other);

const nav = [
  { label: d.nav.services, href: localize(lang, '/services') },
  { label: d.nav.about, href: localize(lang, '/about') },
  { label: d.nav.contact, href: localize(lang, '/contact') },
];

const isActive = (href: string) => path === href || (href !== localize(lang, '/') && path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <Logo lang={lang} />

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      <div class="group relative">
        <a href={localize(lang, '/services')}
           class:list={["flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-ink hover:text-brand-600", isActive(localize(lang,'/services')) && 'text-brand-600']}>
          {d.nav.services}
          <svg class="h-4 w-4 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </a>
        <div class="invisible absolute left-0 top-full w-72 pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="rounded-xl border border-line bg-white p-2 shadow-card">
            {services.map((s) => (
              <a href={localize(lang, `/services/${s.slug}`)} class="block rounded-lg px-3 py-2 text-sm text-ink hover:bg-brand-50">
                {s[lang].navName}
              </a>
            ))}
          </div>
        </div>
      </div>
      {nav.slice(1).map((item) => (
        <a href={item.href} class:list={["rounded-md px-3 py-2 text-sm font-medium text-ink hover:text-brand-600", isActive(item.href) && 'text-brand-600']}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={otherHref} class="hidden rounded-md px-2.5 py-1.5 text-sm font-semibold text-muted ring-1 ring-line hover:text-brand-600 sm:inline-flex" aria-label={`Switch to ${other.toUpperCase()}`}>
        {other.toUpperCase()}
      </a>
      <a href={localize(lang, '/contact')} class="hidden btn-primary lg:inline-flex">{d.nav.cta}</a>

      <!-- Mobile toggle -->
      <button id="menu-btn" class="grid h-10 w-10 place-items-center rounded-md text-ink ring-1 ring-line lg:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="container-x flex flex-col gap-1 py-4" aria-label="Mobile">
      <a href={localize(lang, '/')} class="rounded-md px-3 py-2.5 text-sm font-medium text-ink hover:bg-brand-50">{d.nav.home}</a>
      <span class="px-3 pt-2 text-xs font-semibold uppercase tracking-wide text-muted">{d.nav.services}</span>
      {services.map((s) => (
        <a href={localize(lang, `/services/${s.slug}`)} class="rounded-md px-3 py-2 text-sm text-ink hover:bg-brand-50">{s[lang].navName}</a>
      ))}
      <a href={localize(lang, '/about')} class="rounded-md px-3 py-2.5 text-sm font-medium text-ink hover:bg-brand-50">{d.nav.about}</a>
      <a href={localize(lang, '/contact')} class="rounded-md px-3 py-2.5 text-sm font-medium text-ink hover:bg-brand-50">{d.nav.contact}</a>
      <div class="mt-3 flex items-center gap-3">
        <a href={localize(lang, '/contact')} class="btn-primary flex-1">{d.nav.cta}</a>
        <a href={otherHref} class="btn-ghost">{other.toUpperCase()}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
