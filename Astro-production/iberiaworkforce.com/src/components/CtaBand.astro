---
import { localize, type Lang } from '../i18n/config';
import { dict } from '../i18n/content';
interface Props { lang: Lang; title?: string; text?: string }
const { lang, title, text } = Astro.props;
const d = dict(lang);
---
<section class="container-x">
  <div class="relative overflow-hidden rounded-2xl bg-brand-800 px-6 py-14 text-center sm:px-12">
    <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-accent/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 -left-10 h-56 w-56 rounded-full bg-brand-400/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-2xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">{title ?? d.home.ctaTitle}</h2>
      <p class="mt-3 text-white/80">{text ?? d.home.ctaText}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={localize(lang, '/contact')} class="btn-primary">{d.home.heroPrimary}</a>
        <a href={localize(lang, '/services')} class="btn-light">{d.common.allServices}</a>
      </div>
    </div>
  </div>
</section>
