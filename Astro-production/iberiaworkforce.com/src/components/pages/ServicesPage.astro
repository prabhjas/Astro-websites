---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import ServiceIcon from '../ServiceIcon.astro';
import { localize, type Lang } from '../../i18n/config';
import { dict } from '../../i18n/content';
import { services } from '../../data/services';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dict(lang);
const s = d.services;
---
<Base lang={lang} title={s.metaTitle} description={s.metaDescription}>
  <section class="bg-brand-900 text-white">
    <div class="container-x py-16 lg:py-20">
      <p class="eyebrow text-accent-light">{s.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold text-white sm:text-5xl">{s.title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">{s.lead}</p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {services.map((svc) => (
        <a href={localize(lang, `/services/${svc.slug}`)} class="group flex gap-5 rounded-xl border border-line bg-white p-6 shadow-card transition hover:-translate-y-1 hover:border-brand-200">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700 transition group-hover:bg-brand-800 group-hover:text-white">
            <ServiceIcon name={svc.icon} class="h-6 w-6" />
          </span>
          <div>
            <h2 class="text-lg font-semibold text-brand-800">{svc[lang].name}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{svc[lang].short}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-accent-dark">
              {d.common.learnMore}
              <svg class="h-4 w-4 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <div class="pb-4"><CtaBand lang={lang} /></div>
</Base>
