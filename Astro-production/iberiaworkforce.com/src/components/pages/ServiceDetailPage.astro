---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import ServiceIcon from '../ServiceIcon.astro';
import { localize, type Lang } from '../../i18n/config';
import { dict } from '../../i18n/content';
import { services, type Service } from '../../data/services';
import { company } from '../../data/company';

interface Props { lang: Lang; service: Service }
const { lang, service } = Astro.props;
const d = dict(lang);
const c = service[lang];
const related = services.filter((s) => s.slug !== service.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.name,
  serviceType: c.navName,
  provider: { '@type': 'Organization', name: company.legalName, url: company.url },
  areaServed: { '@type': 'Country', name: 'Spain' },
  description: c.metaDescription,
};
---
<Base lang={lang} title={c.metaTitle} description={c.metaDescription} jsonLd={jsonLd}>
  <section class="bg-brand-900 text-white">
    <div class="container-x py-16 lg:py-20">
      <nav class="mb-6 flex items-center gap-2 text-sm text-white/60" aria-label="Breadcrumb">
        <a href={localize(lang, '/services')} class="hover:text-white">{d.services.eyebrow}</a>
        <span>/</span>
        <span class="text-white/90">{c.navName}</span>
      </nav>
      <div class="flex items-start gap-5">
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-xl bg-white/10 text-accent-light ring-1 ring-white/15">
          <ServiceIcon name={service.icon} class="h-7 w-7" />
        </span>
        <div>
          <h1 class="text-3xl font-bold text-white sm:text-4xl">{c.name}</h1>
          <p class="mt-3 max-w-2xl text-lg text-white/80">{c.hero}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container-x grid gap-12 py-16 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="prose prose-slate max-w-none prose-headings:text-brand-800">
        {c.intro.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-10 rounded-xl border border-line bg-brand-50/50 p-6">
        <h2 class="text-xl font-semibold text-brand-800">{c.includesTitle}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {c.includes.map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-ink">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="prose prose-slate mt-10 max-w-none prose-headings:text-brand-800">
        <h2>{c.whyTitle}</h2>
        {c.why.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="lg:col-span-1">
      <div class="sticky top-24 space-y-6">
        <div class="rounded-xl border border-line bg-white p-6 shadow-card">
          <h3 class="text-lg font-semibold text-brand-800">{d.common.talkToUs}</h3>
          <p class="mt-2 text-sm text-muted">{d.contact.lead}</p>
          <a href={localize(lang, '/contact')} class="btn-primary mt-4 w-full">{d.nav.cta}</a>
          <a href={`mailto:${company.email}`} class="mt-3 block text-center text-sm font-medium text-brand-600 hover:underline">{company.email}</a>
        </div>
        <div class="rounded-xl border border-line bg-white p-6">
          <h3 class="text-sm font-semibold text-brand-800">{d.services.eyebrow}</h3>
          <ul class="mt-3 space-y-1">
            {related.map((r) => (
              <li>
                <a href={localize(lang, `/services/${r.slug}`)} class="flex items-center gap-2 rounded-md px-2 py-2 text-sm text-ink hover:bg-brand-50">
                  <ServiceIcon name={r.icon} class="h-4 w-4 text-brand-500" />
                  {r[lang].navName}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </aside>
  </div>

  <div class="pb-4"><CtaBand lang={lang} /></div>
</Base>
