---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { type Lang } from '../../i18n/config';
import { dict } from '../../i18n/content';
import { company } from '../../data/company';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dict(lang);
const a = d.about;
---
<Base lang={lang} title={a.metaTitle} description={a.metaDescription}>
  <section class="bg-brand-900 text-white">
    <div class="container-x py-16 lg:py-20">
      <p class="eyebrow text-accent-light">{a.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold text-white sm:text-5xl">{a.title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">{a.lead}</p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="prose prose-slate max-w-none prose-headings:text-brand-800">
          {a.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <aside class="lg:col-span-1">
        <div class="rounded-xl border border-accent/30 bg-accent/5 p-6">
          <div class="flex items-center gap-2 text-accent-dark">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            <h2 class="text-lg font-semibold">{a.credentialTitle}</h2>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink">{a.credentialText}</p>
          <p class="mt-4 text-sm font-medium text-brand-800">{company.legalName}</p>
        </div>
      </aside>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-bold text-brand-800">{a.valuesTitle}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {a.values.map((v) => (
          <div class="rounded-xl border border-line bg-white p-6 shadow-card">
            <h3 class="text-base font-semibold text-brand-800">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="pb-4"><CtaBand lang={lang} /></div>
</Base>
