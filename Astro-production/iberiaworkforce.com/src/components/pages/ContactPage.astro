---
import Base from '../../layouts/Base.astro';
import ContactForm from '../ContactForm.astro';
import { type Lang } from '../../i18n/config';
import { dict } from '../../i18n/content';
import { company } from '../../data/company';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dict(lang);
const c = d.contact;
const waText = lang === 'es' ? 'Hola, me gustaría más información sobre sus servicios.' : 'Hi, I would like more information about your services.';
const waHref = `https://wa.me/${company.whatsapp}?text=${encodeURIComponent(waText)}`;
---
<Base lang={lang} title={c.metaTitle} description={c.metaDescription}>
  <section class="bg-brand-900 text-white">
    <div class="container-x py-16 lg:py-20">
      <p class="eyebrow text-accent-light">{c.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold text-white sm:text-5xl">{c.title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">{c.lead}</p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <div class="rounded-2xl border border-line bg-white p-6 shadow-card sm:p-8">
          <ContactForm lang={lang} />
        </div>
      </div>

      <aside class="lg:col-span-2">
        <h2 class="text-lg font-semibold text-brand-800">{c.infoTitle}</h2>
        <ul class="mt-5 space-y-5 text-sm">
          <li class="flex items-start gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            </span>
            <span><span class="block text-xs font-semibold uppercase tracking-wide text-muted">{c.emailLabel}</span><a href={`mailto:${company.email}`} class="text-brand-700 hover:underline">{company.email}</a></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <span><span class="block text-xs font-semibold uppercase tracking-wide text-muted">{c.phoneLabel}</span><a href={`tel:${company.phoneHref}`} class="text-brand-700 hover:underline">{company.phone}</a></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span><span class="block text-xs font-semibold uppercase tracking-wide text-muted">{c.locationLabel}</span>{company.addressCity}, {company.addressCountry}</span>
          </li>
        </ul>

        <a href={waHref} target="_blank" rel="noopener" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#25D366] px-5 py-3 text-sm font-semibold text-white hover:brightness-95">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.01c-.24.68-1.42 1.32-1.95 1.36-.5.05-.5.4-3.15-.66-2.66-1.05-4.32-3.77-4.45-3.94-.13-.17-1.06-1.41-1.06-2.69 0-1.28.67-1.91.91-2.17.24-.26.53-.33.7-.33.17 0 .35 0 .5.01.16.01.38-.06.59.45.24.58.81 2 .88 2.14.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.29.38-.42.51-.14.14-.28.29-.12.57.16.28.72 1.18 1.54 1.91 1.06.95 1.96 1.24 2.24 1.38.28.14.44.12.6-.07.17-.19.7-.81.89-1.09.19-.28.37-.23.63-.14.26.1 1.64.77 1.92.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>
          {c.whatsappLabel}
        </a>
      </aside>
    </div>
  </section>
</Base>
