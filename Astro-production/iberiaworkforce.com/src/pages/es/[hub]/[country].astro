---
/**
 * Spanish country service pages — `/es/employer-of-record/spain/`, etc.
 */
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import CountryTemplate from "../../../components/services/CountryTemplate.astro";
import { localizeHrefs } from "../../../i18n/locale";
import { heroLcpSrc } from "../../../lib/lcp";
import { faqPage, organization, pageUrl, service } from "../../../lib/schema";

export async function getStaticPaths() {
  const entries = await getCollection("servicesEs");
  return entries
    .filter((entry) => entry.data.type === "country")
    .map((entry) => {
      const [hub, country] = entry.id.split("/");
      return {
        params: { hub, country },
        props: { entry },
      };
    })
    .filter((path) => path.params.hub && path.params.country);
}

const { entry } = Astro.props;
const data = localizeHrefs(entry.data, "es");
const { seo, faq } = data;
const url = pageUrl(entry.id, "es");
const lcpImage = await heroLcpSrc(entry.data.hero.image);

const schema = [
  organization(url, seo.schema.address),
  service({
    url,
    name: seo.schema.serviceName,
    serviceType: seo.schema.serviceType,
    areaServed: seo.schema.areaServed,
    areaType: "Country",
    description: seo.description,
  }),
  ...(faq?.items.length ? [faqPage(url, faq.items)] : []),
];
---

<Layout title={seo.title} description={seo.description} schema={schema} lcpImage={lcpImage}>
  <CountryTemplate data={data} />
</Layout>
