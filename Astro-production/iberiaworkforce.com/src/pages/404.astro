---
/**
 * Not found.
 *
 * Without this file Astro ships its own default 404, which carries no brand at
 * all — the go-live checklist calls that out specifically, because a peer's or
 * a framework's 404 on a live domain reads as a broken deployment.
 *
 * Deliberately plain: no photograph, no shader, no reveal. Someone reaching
 * this page is looking for a way out of it, and the navbar and footer the
 * layout already supplies are that way out. It carries `noindex` because a 404
 * that renders 200-shaped HTML is exactly what a soft-404 is.
 */
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { getUi } from "../i18n/copy";
import { withLocale } from "../i18n/locale";

export const prerender = false;

const { lang, t } = getUi(Astro.url.pathname);
const n = t.notFound;

Astro.response.status = 404;
Astro.response.statusText = "Not Found";
---

<Layout title={n.title} description={n.description} noindex>
  <section
    class="flex min-h-[60vh] items-center bg-bg-page py-24 lg:py-32"
    aria-labelledby="not-found-heading"
  >
    <div class="section-shell flex flex-col items-start gap-6">
      <p class="text-caption font-medium tracking-[0.26px] text-text-link">
        {n.eyebrow}
      </p>
      <h1 id="not-found-heading" class="text-h1 text-balance text-text-primary">
        {n.heading}
      </h1>
      <p class="max-w-[628px] text-body text-text-secondary">
        {n.body}
      </p>
      <div class="mt-2 flex flex-col gap-4 sm:flex-row">
        <Button href={withLocale("/", lang)}>{n.home}</Button>
        <Button href={withLocale("/contact", lang)} variant="secondary-on-light">
          {n.contact}
        </Button>
      </div>
    </div>
  </section>
</Layout>
