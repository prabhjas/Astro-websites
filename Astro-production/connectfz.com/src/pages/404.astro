---
/**
 * Custom 404 for unknown / unprepared URLs.
 */
export const prerender = false;

Astro.response.status = 404;
Astro.response.statusText = "Not Found";
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | Connect FZ</title>
    <meta
      name="description"
      content="The page you requested could not be found on Connect FZ."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/wp-content/uploads/2023/10/cropped-Favicon-Connectfz-32x32.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2023/10/cropped-Favicon-Connectfz-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2023/10/cropped-Favicon-Connectfz-180x180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --cfz-ink: #02224f;
        --cfz-blue: #007ac2;
        --cfz-mist: #f5f8fc;
        --cfz-line: #d7e0ec;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: Poppins, "Segoe UI", sans-serif;
        color: var(--cfz-ink);
        background:
          radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0, 122, 194, 0.14), transparent),
          linear-gradient(180deg, #ffffff 0%, var(--cfz-mist) 100%);
      }
      .wrap {
        width: min(40rem, calc(100% - 2.5rem));
        margin: 0 auto;
        padding: 3.5rem 0 4rem;
        text-align: center;
      }
      .logo {
        display: inline-block;
        margin-bottom: 2.5rem;
      }
      .logo img {
        display: block;
        width: min(220px, 55vw);
        height: auto;
      }
      .code {
        display: inline-block;
        margin: 0 0 0.75rem;
        padding: 0.2rem 0.65rem;
        border: 1px solid var(--cfz-line);
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--cfz-blue);
        background: #fff;
      }
      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.75rem, 4vw, 2.35rem);
        line-height: 1.15;
        font-weight: 700;
      }
      p {
        margin: 0 auto 1.75rem;
        max-width: 28rem;
        font-size: 1.05rem;
        line-height: 1.55;
        color: #54657a;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
      }
      .actions a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: 0.65rem 1.25rem;
        border-radius: 0.35rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
      }
      .actions a.primary {
        color: #fff;
        background: var(--cfz-blue);
      }
      .actions a.secondary {
        color: var(--cfz-ink);
        background: #fff;
        border: 1px solid var(--cfz-line);
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <a class="logo" href="/" aria-label="Connect FZ home">
        <img
          src="/wp-content/uploads/2020/10/Connect-FZ-logo.png"
          width="300"
          height="45"
          alt="Connect FZ"
        />
      </a>
      <div class="code">404</div>
      <h1>Page not found</h1>
      <p>
        The page you are looking for may have been moved, renamed, or no longer
        exists. Try one of the links below.
      </p>
      <div class="actions">
        <a class="primary" href="/">Go to homepage</a>
        <a class="secondary" href="/insights/">Browse insights</a>
        <a class="secondary" href="/contact/">Contact us</a>
      </div>
    </main>
  </body>
</html>
