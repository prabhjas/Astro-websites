---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageByPath, getPostsSortedByDate, paginate } from "../../lib/content";
import {
  INSIGHTS_PER_PAGE,
  buildInsightsArchiveHtml,
} from "../../lib/insights-archive";
import { breadcrumbSchema } from "../../lib/seo";
import { notFoundResponse } from "../../lib/not-found";

export const prerender = false;

/**
 * Live archive is /insights/ (Elementor). Keep markup; inject newest posts for page 1.
 */
const page = getPageByPath("/insights/");
if (!page) return notFoundResponse();

const sorted = getPostsSortedByDate();
const { items, page: pageNum, totalPages } = paginate(sorted, 1, INSIGHTS_PER_PAGE);

let html = buildInsightsArchiveHtml(
  page.bodyHtml || page.content,
  pageNum,
  items,
  totalPages,
);

const extraCss = [
  ...(page.pageCss || []),
  page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
  // Live WP insights also loads loop/template CSS post-20028 (not ghost post-21423/21574).
  "/wp-content/uploads/elementor/css/post-20028.css",
  "/css/insights-topic-cards.css",
];
---

<BaseLayout
  currentPath="/insights/"
  bodyClass={`page page-id-${page.id} elementor-page-${page.id}`}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title || "Insights | Connect FZ",
    description:
      page.seo.description ||
      "EOR, PEO, payroll and HR insights across the Middle East.",
    canonical: "/insights/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Insights", url: "/insights/" },
      ]),
    ],
  }}
>
  <div class="sp-page-content" set:html={html} />
</BaseLayout>
