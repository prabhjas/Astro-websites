---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageByPath } from "../lib/content";
import { breadcrumbSchema } from "../lib/seo";
import { dedupeFaqSchema } from "../lib/faq-schema";

export const prerender = false;

const page = getPageByPath("/");
if (!page) throw new Error("Home page missing from content data");

const { html, schemas: dedupedSchemas } = dedupeFaqSchema(
  page.bodyHtml || page.content,
  page.seo.schemas || [],
);
const extraCss = [
  ...(page.pageCss || []),
  page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
];
const bodyClass = `home page page-id-${page.id} elementor-page elementor-page-${page.id}`;
---

<BaseLayout
  currentPath="/"
  bodyClass={bodyClass}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title,
    description: page.seo.description,
    canonical: "/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...dedupedSchemas,
      breadcrumbSchema([{ name: "Home", url: "/" }]),
    ],
  }}
>
  <div class="sp-page-content" set:html={html} />
</BaseLayout>
