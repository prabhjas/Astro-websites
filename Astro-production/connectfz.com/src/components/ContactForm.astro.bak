---
import { site } from "../lib/content";

interface Props {
  formId?: string;
}

const { formId = "form" } = Astro.props;
---

<form
  class="sp-form"
  id={formId}
  method="POST"
  action={import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/"}
  data-sp-contact-form
  data-form-type="contact"
>
  <div class="sp-form__row">
    <label>
      First Name*
      <input type="text" name="first-name" required autocomplete="given-name" />
    </label>
    <label>
      Last Name*
      <input type="text" name="last-name" required autocomplete="family-name" />
    </label>
  </div>
  <div class="sp-form__row">
    <label>
      Email*
      <input type="email" name="your-email" required autocomplete="email" />
    </label>
    <label>
      Phone Number
      <input type="tel" name="phonetext-597" autocomplete="tel" />
    </label>
  </div>
  <label>
    Message (optional)
    <textarea name="your-message" rows="5"></textarea>
  </label>

  <!-- Ad attribution fields (parity with CF7) -->
  <input type="hidden" name="gclid" value="" />
  <input type="hidden" name="initial_url" value="" data-sp-initial-url />
  <input type="hidden" name="campaign_id" value="" />
  <input type="hidden" name="adgroup_id" value="" />
  <input type="hidden" name="creative_id" value="" />
  <input type="hidden" name="keyword" value="" />
  <input type="hidden" name="matchtype" value="" />
  <input type="hidden" name="device" value="" />
  <input type="hidden" name="network" value="" />
  <input type="hidden" name="placement" value="" />
  <input type="hidden" name="target_id" value="" />
  <input type="hidden" name="adposition" value="" />
  <input type="hidden" name="loc_interest_ms" value="" />
  <input type="hidden" name="loc_physical_ms" value="" />
  <input type="hidden" name="countrytext-787" value="AE" />

  <button type="submit">Get in Touch</button>
  <p class="sp-form__status" data-sp-form-status role="status" aria-live="polite"></p>
  <p class="sp-form__hint">
    Or call <a href={`tel:${site.phoneTel}`}>{site.phone}</a> /
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>
</form>

<script>
  const params = new URLSearchParams(window.location.search);
  const form = document.querySelector("[data-sp-contact-form]");
  const status = document.querySelector("[data-sp-form-status]");
  const initial = document.querySelector("[data-sp-initial-url]");

  if (initial instanceof HTMLInputElement) {
    initial.value = window.location.href;
  }

  const map = [
    "gclid",
    "campaign_id",
    "adgroup_id",
    "creative_id",
    "keyword",
    "matchtype",
    "device",
    "network",
    "placement",
    "target_id",
    "adposition",
    "loc_interest_ms",
    "loc_physical_ms",
  ];
  for (const key of map) {
    const el = form?.querySelector(`[name="${key}"]`);
    if (el instanceof HTMLInputElement && params.has(key)) el.value = params.get(key) || "";
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    if (status) {
      status.textContent = "Sending…";
      status.setAttribute("data-state", "");
    }

    const fd = new FormData(form);
    if (!fd.get("formType")) fd.set("formType", form.getAttribute("data-form-type") || "contact");
    if (!fd.get("pageUrl")) fd.set("pageUrl", window.location.href);

    try {
      const endpoint = form.getAttribute("action") || "/api/contact/";
      const res = await fetch(endpoint, {
        method: "POST",
        body: fd,
        headers: { Accept: "application/json" },
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.ok === false) {
        throw new Error(data.error || "Unable to send message");
      }
      form.reset();
      if (status) {
        status.textContent = "Thank you! We will contact you shortly.";
        status.setAttribute("data-state", "ok");
      }
    } catch (err) {
      if (status) {
        status.textContent = err instanceof Error ? err.message : "Something went wrong.";
        status.setAttribute("data-state", "err");
      }
    }
  });
</script>

<style>
  .sp-form__hint {
    color: #bdbdbd;
    font-size: 0.9rem;
    margin: 0;
  }

  .sp-form__hint a {
    color: var(--sp-yellow);
  }
</style>
