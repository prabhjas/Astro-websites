# On the production host this file is SPLIT:
#   .env       → build-only (PUBLIC_SITE_URL), root:webdev 0644 — no secrets
#   .env.prod  → runtime secrets for systemd (root:site-* 0640) — REQUIRED (no EnvironmentFile=-)
# Local laptop: one gitignored .env with secrets is fine for fleet-local smoke.
#
# Public canonical website origin (no trailing slash required).
PUBLIC_SITE_URL=https://www.evolutionmiddleast.com

# --- Lead storage (file-backed source of truth) ---
LEAD_STORE_DIR=.data/leads
LEAD_STORE_MAX_FILE_BYTES=10485760
PIPEDRIVE_MAX_RETRY_ATTEMPTS=5
PIPEDRIVE_REQUEST_TIMEOUT_MS=10000

# --- Pipedrive (required for POST /api/contact) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_LEAD_SOURCE_ID=
PIPEDRIVE_PERSON_LABEL_IDS=5
PIPEDRIVE_PERSON_VISIBLE_TO=3

# --- Website / form identity ---
WEBSITE_ID=5060
WEBSITE_NAME=Evolution Middle East
FORM_SOURCE=
FORM_NAME=Evolution Middle East Contact Form
LEAD_TITLE_PREFIX=AD Evolution Middle East

LOG_LEVEL=info

# --- Internal machine API (central CMS / cron) ---
# Per-site dashboard UI removed. Auth:
#   Authorization: Bearer <INTERNAL_JOB_SECRET>
# Also accepts: x-internal-job-secret header or ?secret= (cron).
INTERNAL_JOB_SECRET=
INTERNAL_ADMIN_DIR=.data/internal-admin
INTERNAL_ENHANCED_LIVE_DIR=.data/enhanced-live
INTERNAL_UPLOAD_DIR=.data/internal-uploads
INTERNAL_UPLOAD_MAX_FILE_BYTES=10485760

# HOST/PORT: set by deployment/systemd per site — do not put them in shared env files.
# Use LF line endings only (CRLF breaks systemd EnvironmentFile=).
