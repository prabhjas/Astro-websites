---
import { getServerEnv } from '../../../env/server';
import { isSeoOnlyRole } from '../../../lib/auth/permissions';
import { dashboardAuthEnabled } from '../../../lib/auth/users';
import { readDashboardSession } from '../../../lib/auth/session';
import { applyInternalNoIndexHeaders } from '../../../lib/security/internal-response';

export const prerender = false;

applyInternalNoIndexHeaders(Astro.response.headers);

const env = getServerEnv();
const session = readDashboardSession(Astro.cookies);
if (session) {
  return Astro.redirect(
    isSeoOnlyRole(session) ? '/internal/operations/seo/' : '/internal/operations/',
  );
}

const enabled = dashboardAuthEnabled();
const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Operations Login</title>
  </head>
  <body>
    <main class="login">
      <section class="card">
        <p class="eyebrow">Evolution Middle East</p>
        <h1>Operations</h1>
        {!enabled ? (
          <>
            <p>Dashboard access is disabled until `DASHBOARD_SESSION_SECRET` and `DASHBOARD_USERS_JSON` are configured.</p>
            <p class="hint">Default path: <code>{env.dashboardPath}</code></p>
          </>
        ) : (
          <form method="post" action="/api/internal/login">
            <label>
              Email
              <input type="email" name="email" autocomplete="username" required />
            </label>
            <label>
              Password
              <input type="password" name="password" autocomplete="current-password" required />
            </label>
            {error && <p class="error">Invalid email or password.</p>}
            <button type="submit">Sign in</button>
          </form>
        )}
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #e2e8f0, #f8fafc);
    font-family: Inter, "Segoe UI", system-ui, sans-serif;
    color: #0f172a;
  }
  .card {
    width: min(420px, calc(100vw - 2rem));
    background: white;
    border-radius: 18px;
    padding: 2rem;
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.12);
  }
  .eyebrow,
  .hint {
    color: #475569;
  }
  .eyebrow,
  h1,
  p {
    margin-top: 0;
  }
  form {
    display: grid;
    gap: 1rem;
  }
  label {
    display: grid;
    gap: 0.45rem;
    font-size: 0.95rem;
  }
  input {
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 0.8rem 0.9rem;
    font: inherit;
  }
  button {
    border: 0;
    background: #0f172a;
    color: white;
    border-radius: 10px;
    padding: 0.85rem 1rem;
    font: inherit;
    cursor: pointer;
  }
  .error {
    color: #b91c1c;
    margin: 0;
  }
</style>
