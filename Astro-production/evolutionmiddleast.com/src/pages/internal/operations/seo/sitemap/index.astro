---
import InternalDashboardLayout from '../../../../../layouts/InternalDashboardLayout.astro';
import { getServerEnv } from '../../../../../env/server';
import { canManageSeo } from '../../../../../lib/auth/permissions';
import { readDashboardSession } from '../../../../../lib/auth/session';
import { formatDateTime } from '../../../../../lib/leads/dashboard';
import { buildSitemapDataset } from '../../../../../lib/seo/sitemap-data';
import {
  pathFromSitemapUrl,
  readSitemapOverrides,
  SITEMAP_CHANGEFREQ_VALUES,
} from '../../../../../lib/seo/sitemap-overrides-store';
import { applyInternalNoIndexHeaders } from '../../../../../lib/security/internal-response';

export const prerender = false;

applyInternalNoIndexHeaders(Astro.response.headers);

const session = readDashboardSession(Astro.cookies);
if (!session) return Astro.redirect('/internal/operations/login');

const env = getServerEnv();
const overrides = await readSitemapOverrides(env.internalAdminDir);
const dataset = buildSitemapDataset({
  env: process.env,
  astroSite: Astro.site ?? undefined,
  trustRequestHost: false,
  adminDir: env.internalAdminDir,
});

const allRows = [...dataset.pages, ...dataset.posts].map((entry) => {
  const path = pathFromSitemapUrl(entry.url, dataset.siteOrigin) || entry.url;
  const override = overrides.entries[path];
  return {
    path,
    url: entry.url,
    type: entry.type,
    lastmod: entry.lastmod || '',
    priority: entry.priority,
    changefreq: entry.changefreq || '',
    hasOverride: Boolean(override),
  };
});

const q = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const pageSize = 25;
const filtered = allRows.filter((row) =>
  !q || row.path.toLowerCase().includes(q) || row.url.toLowerCase().includes(q) || row.type.includes(q),
);
const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
const currentPage = Math.min(page, totalPages);
const paged = filtered.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const canEdit = canManageSeo(session);
const overrideCount = Object.keys(overrides.entries).length;
---

<InternalDashboardLayout
  title="Sitemap"
  active="seo"
  sessionEmail={session.email}
  sessionRole={session.role}
  csrfToken={session.csrf}
>
  <section class="panel">
    <div class="head-row">
      <div>
        <h2>Sitemap URLs</h2>
        <p>URLs are discovered automatically from published pages and posts. Set custom <code>priority</code> and <code>changefreq</code> here — live sitemap endpoints pick them up immediately.</p>
        <p class="subtle">
          Public:
          <a href="/sitemap_index.xml" target="_blank" rel="noreferrer">/sitemap_index.xml</a>
          · {allRows.length} URLs · {overrideCount} overrides
          · Last override update: {overrides.updatedAt ? `${formatDateTime(overrides.updatedAt)} by ${overrides.updatedBy}` : 'None yet'}
        </p>
      </div>
      <form method="get" class="search-row">
        <input type="search" name="q" value={q} placeholder="Search path or type" />
        <button type="submit">Search</button>
      </form>
    </div>
  </section>

  <section class="panel">
    <h3>Add / update override</h3>
    {canEdit ? (
      <form method="post" action="/api/internal/seo/sitemap/save" class="edit-grid">
        <input type="hidden" name="csrfToken" value={session.csrf} />
        <input type="hidden" name="q" value={q} />
        <input type="hidden" name="page" value={String(currentPage)} />
        <input type="text" name="path" placeholder="/about-us/" required />
        <input type="number" name="priority" min="0" max="1" step="0.1" placeholder="0.9" />
        <select name="changefreq">
          <option value="">changefreq (optional)</option>
          {SITEMAP_CHANGEFREQ_VALUES.map((value) => (
            <option value={value}>{value}</option>
          ))}
        </select>
        <button type="submit">Save override</button>
      </form>
    ) : (
      <p class="subtle">Only SEO users and super admins can edit sitemap overrides.</p>
    )}
  </section>

  <section class="panel">
    <div class="table-head">
      <h3>Discovered URLs</h3>
      <p class="subtle">{filtered.length} shown {q ? `matching "${q}"` : ''}</p>
    </div>
    <table>
      <thead>
        <tr>
          <th>Path</th>
          <th>Type</th>
          <th>Priority</th>
          <th>Changefreq</th>
          <th>Lastmod</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {paged.length ? paged.map((row) => (
          <tr class={row.hasOverride ? 'override' : undefined}>
            <td>
              <a href={row.url} target="_blank" rel="noreferrer">{row.path}</a>
              {row.hasOverride ? <span class="badge">custom</span> : null}
            </td>
            <td>{row.type}</td>
            {canEdit ? (
              <td colspan="4">
                <form method="post" action="/api/internal/seo/sitemap/save" class="inline-form">
                  <input type="hidden" name="csrfToken" value={session.csrf} />
                  <input type="hidden" name="path" value={row.path} />
                  <input type="hidden" name="q" value={q} />
                  <input type="hidden" name="page" value={String(currentPage)} />
                  <input type="number" name="priority" min="0" max="1" step="0.1" value={row.priority ?? ''} placeholder="priority" />
                  <select name="changefreq">
                    <option value="">changefreq</option>
                    {SITEMAP_CHANGEFREQ_VALUES.map((value) => (
                      <option value={value} selected={row.changefreq === value}>{value}</option>
                    ))}
                  </select>
                  <span class="lastmod">{row.lastmod ? formatDateTime(row.lastmod) : '—'}</span>
                  <button type="submit">Update</button>
                  {row.hasOverride ? (
                    <button type="submit" class="danger" formaction="/api/internal/seo/sitemap/delete">Clear</button>
                  ) : null}
                </form>
              </td>
            ) : (
              <>
                <td>{row.priority ?? '—'}</td>
                <td>{row.changefreq || '—'}</td>
                <td>{row.lastmod ? formatDateTime(row.lastmod) : '—'}</td>
                <td class="subtle">—</td>
              </>
            )}
          </tr>
        )) : (
          <tr><td colspan="6">No sitemap URLs match this filter.</td></tr>
        )}
      </tbody>
    </table>
    {totalPages > 1 && (
      <div class="pager">
        {currentPage > 1 && (
          <a href={`?q=${encodeURIComponent(q)}&page=${currentPage - 1}`}>Previous</a>
        )}
        <span>Page {currentPage} / {totalPages}</span>
        {currentPage < totalPages && (
          <a href={`?q=${encodeURIComponent(q)}&page=${currentPage + 1}`}>Next</a>
        )}
      </div>
    )}
  </section>
</InternalDashboardLayout>

<style>
  .panel { background: white; border-radius: 18px; padding: 1.25rem; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08); margin-bottom: 1rem; }
  h2, h3, p { margin-top: 0; }
  .subtle { color: #64748b; }
  .head-row, .table-head, .pager { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
  .search-row, .edit-grid, .inline-form { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
  input, select, button, textarea { font: inherit; }
  input, select { border: 1px solid #cbd5e1; border-radius: 10px; padding: 0.55rem 0.7rem; }
  button { border: 0; border-radius: 10px; background: #0f172a; color: white; padding: 0.55rem 0.9rem; cursor: pointer; }
  button.danger { background: #991b1b; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.7rem 0.4rem; border-bottom: 1px solid #e2e8f0; vertical-align: middle; font-size: 0.92rem; }
  tr.override td { background: #f8fafc; }
  .badge { display: inline-block; margin-left: 0.4rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; color: #0f172a; background: #e2e8f0; border-radius: 999px; padding: 0.15rem 0.45rem; }
  .lastmod { color: #64748b; font-size: 0.85rem; min-width: 9rem; }
  a { color: #0f172a; }
  .inline-form input[type="number"] { width: 5.5rem; }
</style>
