---
import InternalDashboardLayout from '../../../../layouts/InternalDashboardLayout.astro';
import { canManageSeo } from '../../../../lib/auth/permissions';
import { readDashboardSession } from '../../../../lib/auth/session';
import { applyInternalNoIndexHeaders } from '../../../../lib/security/internal-response';

export const prerender = false;

applyInternalNoIndexHeaders(Astro.response.headers);

const session = readDashboardSession(Astro.cookies);
if (!session) return Astro.redirect('/internal/operations/login');

const canEdit = canManageSeo(session);
---

<InternalDashboardLayout
  title="SEO controls"
  active="seo"
  sessionEmail={session.email}
  sessionRole={session.role}
  csrfToken={session.csrf}
>
  <section class="panel">
    <h2>SEO controls</h2>
    <p>Manage live robots.txt, llm.txt, and per-URL sitemap priority/changefreq without redeploying static SEO files.</p>
    {!canEdit && <p class="subtle">Viewers can inspect current values; only SEO users and super admins can publish changes.</p>}
    <div class="cards">
      <a class="card" href="/internal/operations/seo/robots/">
        <h3>robots.txt</h3>
        <p>Edit Allow/Disallow rules and the sitemap reference served at <code>/robots.txt</code>.</p>
      </a>
      <a class="card" href="/internal/operations/seo/llm/">
        <h3>llms.txt</h3>
        <p>Auto-generate AI crawler guidance from live sitemap pages/posts (or publish a full custom override).</p>
      </a>
      <a class="card" href="/internal/operations/seo/sitemap/">
        <h3>Sitemap</h3>
        <p>Review dynamically discovered URLs and set custom priority / changefreq values.</p>
      </a>
    </div>
  </section>
</InternalDashboardLayout>

<style>
  .panel { background: white; border-radius: 18px; padding: 1.25rem; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08); }
  h2, h3, p { margin-top: 0; }
  .subtle { color: #64748b; }
  .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-top: 1.25rem; }
  .card { display: block; text-decoration: none; color: inherit; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1rem; background: #f8fafc; }
  .card:hover { border-color: #94a3b8; background: white; }
  code { font-size: 0.9em; }
</style>
