---
import InternalDashboardLayout from '../../../../../layouts/InternalDashboardLayout.astro';
import { getServerEnv } from '../../../../../env/server';
import { canManageSeo } from '../../../../../lib/auth/permissions';
import { readDashboardSession } from '../../../../../lib/auth/session';
import { formatDateTime } from '../../../../../lib/leads/dashboard';
import { readLlmsConfig } from '../../../../../lib/seo/llms-config-store';
import { generateLlmsTxt } from '../../../../../lib/seo/llms-generator';
import { readManagedTextFile } from '../../../../../lib/seo/text-files-store';
import { applyInternalNoIndexHeaders } from '../../../../../lib/security/internal-response';

export const prerender = false;

applyInternalNoIndexHeaders(Astro.response.headers);

const session = readDashboardSession(Astro.cookies);
if (!session) return Astro.redirect('/internal/operations/login');

const env = getServerEnv();
const config = await readLlmsConfig(env.internalAdminDir);
const storedOverride = await readManagedTextFile(env.internalAdminDir, 'llm');
const autoPreview = generateLlmsTxt({
  config: { ...config, mode: 'auto' },
  adminDir: env.internalAdminDir,
  env: process.env,
  astroSite: Astro.site ?? undefined,
  trustRequestHost: false,
});
const canEdit = canManageSeo(session);
---

<InternalDashboardLayout
  title="llms.txt"
  active="seo"
  sessionEmail={session.email}
  sessionRole={session.role}
  csrfToken={session.csrf}
>
  <section class="panel">
    <h2>llms.txt</h2>
    <p>
      Served live at <a href="/llms.txt" target="_blank" rel="noreferrer">/llms.txt</a>
      and <a href="/llm.txt" target="_blank" rel="noreferrer">/llm.txt</a>.
      In <strong>auto</strong> mode it rebuilds from the same published pages/posts as the sitemap (grouped like the SEO seed file). Switch to <strong>override</strong> only when you need a fully custom body.
    </p>
    <p class="subtle">
      Mode: {config.mode}
      · Last config update: {config.updatedAt ? `${formatDateTime(config.updatedAt)} by ${config.updatedBy}` : 'Using defaults'}
      · Auto preview length: {autoPreview.length.toLocaleString()} chars
    </p>
  </section>

  {canEdit ? (
    <section class="panel">
      <form method="post" action="/api/internal/seo/llms/save" class="stack">
        <input type="hidden" name="csrfToken" value={session.csrf} />
        <label>
          Mode
          <select name="mode">
            <option value="auto" selected={config.mode === 'auto'}>Auto-generate from live sitemap pages/posts</option>
            <option value="override" selected={config.mode === 'override'}>Full custom override (static body)</option>
          </select>
        </label>
        <label>
          Site title (H1)
          <input type="text" name="siteTitle" value={config.siteTitle} required />
        </label>
        <label>
          Summary (blockquote)
          <textarea name="summary" rows="4">{config.summary}</textarea>
        </label>
        <label>
          Extra details paragraph
          <textarea name="details" rows="4">{config.details}</textarea>
        </label>
        <label>
          Section order (one group heading per line)
          <textarea name="groupOrder" rows="10">{config.groupOrder.join('\n')}</textarea>
        </label>
        <label>
          Recent blog posts to list
          <input type="number" name="postsCount" min="0" max="100" value={config.postsCount} />
        </label>
        <label>
          Blog note
          <textarea name="blogNote" rows="3">{config.blogNote}</textarea>
        </label>
        <label>
          Optional Markdown section
          <textarea name="optionalMarkdown" rows="4" placeholder="## Optional links…">{config.optionalMarkdown}</textarea>
        </label>
        <label>
          Full custom body (used only when mode = override)
          <textarea name="content" rows="16" placeholder="Paste a full llms.txt body to force a static override">{storedOverride?.content || ''}</textarea>
        </label>
        <button type="submit">Save llms.txt settings</button>
      </form>
    </section>
  ) : (
    <section class="panel">
      <p class="subtle">Only SEO users and super admins can change llms.txt settings.</p>
    </section>
  )}

  <section class="panel">
    <h3>Live auto preview</h3>
    <pre class="preview">{autoPreview}</pre>
  </section>
</InternalDashboardLayout>

<style>
  .panel { background: white; border-radius: 18px; padding: 1.25rem; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08); margin-bottom: 1rem; }
  h2, h3, p { margin-top: 0; }
  .subtle { color: #64748b; }
  .stack { display: grid; gap: 1rem; }
  label { display: grid; gap: 0.4rem; }
  input, select, textarea { width: 100%; font: inherit; border: 1px solid #cbd5e1; border-radius: 12px; padding: 0.7rem 0.85rem; }
  textarea, .preview { font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre-wrap; }
  .preview { border: 1px solid #e2e8f0; border-radius: 12px; padding: 0.9rem; background: #f8fafc; max-height: 32rem; overflow: auto; }
  button { border: 0; border-radius: 10px; background: #0f172a; color: white; padding: 0.8rem 1rem; font: inherit; cursor: pointer; width: fit-content; }
  a { color: #0f172a; }
</style>
