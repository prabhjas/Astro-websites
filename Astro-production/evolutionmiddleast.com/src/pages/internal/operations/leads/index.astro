---
import InternalDashboardLayout from '../../../../layouts/InternalDashboardLayout.astro';
import { getServerEnv } from '../../../../env/server';
import { readDashboardSession } from '../../../../lib/auth/session';
import { isSeoOnlyRole } from '../../../../lib/auth/permissions';
import { FileLeadStore } from '../../../../lib/leads/file-store';
import {
  formatDateTime,
  getDeliveryStatusLabel,
  getLeadDisplayName,
  getLeadSecondaryDetail,
  matchesLeadQuery,
} from '../../../../lib/leads/dashboard';
import { applyInternalNoIndexHeaders } from '../../../../lib/security/internal-response';

export const prerender = false;

applyInternalNoIndexHeaders(Astro.response.headers);

const session = readDashboardSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/internal/operations/login');
}

if (isSeoOnlyRole(session)) {
  return Astro.redirect('/internal/operations/seo/');
}

const q = Astro.url.searchParams.get('q') || '';
const env = getServerEnv();
const store = new FileLeadStore({ rootDir: env.leadStoreDir, maxFileBytes: env.leadStoreMaxFileBytes });
const submissions = (await store.listSubmissions()).filter((record) => matchesLeadQuery(record, q));
---

<InternalDashboardLayout
  title="Operations Leads"
  active="leads"
  sessionEmail={session.email}
  sessionRole={session.role}
  csrfToken={session.csrf}
>
  <section class="panel">
    <div class="toolbar">
      <div>
        <h2>Leads</h2>
        <p>Search submissions, inspect attribution, and export the current filtered view.</p>
      </div>
      <form class="search">
        <input type="search" name="q" value={q} placeholder="Search by name, email, company, campaign..." />
        <button type="submit">Search</button>
      </form>
    </div>

    <p class="export">
      <a href={`/api/internal/export-leads${q ? `?q=${encodeURIComponent(q)}` : ''}`}>Export CSV</a>
      ·
      <a href={`/api/internal/export-leads?format=json${q ? `&q=${encodeURIComponent(q)}` : ''}`}>Export JSON</a>
    </p>

    <table>
      <thead>
        <tr>
          <th>Submitted</th>
          <th>Lead</th>
          <th>Campaign</th>
          <th>Status</th>
          <th>Attempts</th>
        </tr>
      </thead>
      <tbody>
        {submissions.length ? (
          submissions.map((record) => (
            <tr>
              <td>{formatDateTime(record.createdAt)}</td>
              <td>
                <a href={`/internal/operations/leads/${record.publicId}/`}>
                  {getLeadDisplayName(record)}
                </a>
                <div class="subtle">{getLeadSecondaryDetail(record)}</div>
              </td>
              <td>{record.utmCampaign || record.campaignId || '-'}</td>
              <td><span class={`pill ${record.deliveryStatus}`}>{getDeliveryStatusLabel(record.deliveryStatus)}</span></td>
              <td>{record.deliveryAttemptCount}</td>
            </tr>
          ))
        ) : (
          <tr>
            <td colspan="5">No leads matched this filter.</td>
          </tr>
        )}
      </tbody>
    </table>
  </section>
</InternalDashboardLayout>

<style>
  .panel {
    background: white;
    border-radius: 18px;
    padding: 1.25rem;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
  }
  .toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
  }
  h2, p {
    margin-top: 0;
  }
  p { color: #475569; }
  .search {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  input, button {
    font: inherit;
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
  }
  input {
    min-width: 320px;
    border: 1px solid #cbd5e1;
  }
  button {
    border: 0;
    background: #0f172a;
    color: white;
  }
  .export {
    margin: 1rem 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th, td {
    text-align: left;
    padding: 0.8rem 0;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
  }
  .subtle {
    color: #64748b;
    font-size: 0.92rem;
  }
  .pill {
    display: inline-flex;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
    background: #e2e8f0;
    color: #0f172a;
  }
  .pill.delivered { background: #dcfce7; color: #166534; }
  .pill.retry_scheduled { background: #fef3c7; color: #92400e; }
  .pill.failed, .pill.dead_letter { background: #fee2e2; color: #991b1b; }
</style>
