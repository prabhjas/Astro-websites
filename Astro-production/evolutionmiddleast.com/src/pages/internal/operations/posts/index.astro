---
import InternalDashboardLayout from '../../../../layouts/InternalDashboardLayout.astro';
import { readDashboardSession } from '../../../../lib/auth/session';
import { hasDashboardRole, isSeoOnlyRole } from '../../../../lib/auth/permissions';
import { applyInternalNoIndexHeaders } from '../../../../lib/security/internal-response';
import { listAllPosts, type PostStatus } from '../../../../lib/internal-posts/store';

export const prerender = false;

applyInternalNoIndexHeaders(Astro.response.headers);

const session = readDashboardSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/internal/operations/login');
}

if (isSeoOnlyRole(session)) {
  return Astro.redirect('/internal/operations/seo/');
}

const canEdit = hasDashboardRole(session, 'developer');

const q = Astro.url.searchParams.get('q') || '';
const statusTab = Astro.url.searchParams.get('status') || 'all';

const posts = listAllPosts();

function statusOf(post: any): PostStatus {
  if (post.status === 'trash') return 'trash';
  if (post.status === 'draft') return 'draft';
  return 'published';
}

function safeSlug(text: string): string {
  return (text || '')
    .toLowerCase()
    .trim()
    .replace(/['"]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function matches(post: any): boolean {
  const hay = `${post.title || ''} ${post.slug || ''}`.toLowerCase();
  return q ? hay.includes(q.toLowerCase()) : true;
}

const baseForCounts = posts.filter((p) => matches(p));
const allCount = baseForCounts.filter((p) => statusOf(p) !== 'trash').length;
const publishedCount = baseForCounts.filter((p) => statusOf(p) === 'published').length;
const draftCount = baseForCounts.filter((p) => statusOf(p) === 'draft').length;
const trashCount = baseForCounts.filter((p) => statusOf(p) === 'trash').length;

const currentStatusFiltered = baseForCounts.filter((p) => {
  if (statusTab === 'all') return statusOf(p) !== 'trash';
  if (statusTab === 'published') return statusOf(p) === 'published';
  if (statusTab === 'draft') return statusOf(p) === 'draft';
  if (statusTab === 'trash') return statusOf(p) === 'trash';
  return true;
});

const filtered = currentStatusFiltered.sort(
  (a, b) => new Date(b.publishedAt || 0).getTime() - new Date(a.publishedAt || 0).getTime(),
);

function extractCategory(post: any): { name: string; slug: string } {
  const cat = post.categories?.[0];
  const name = cat?.name || 'Uncategorized';
  const slug = cat?.slug || safeSlug(cat?.name || '');
  return { name, slug: slug || 'uncategorized' };
}

function extractTags(post: any): Array<{ name: string; slug: string }> {
  const tagList = post.tags || [];
  const out: Array<{ name: string; slug: string }> = [];
  for (const t of tagList) {
    const name = t?.name || '';
    const slug = t?.slug || safeSlug(name);
    if (!slug) continue;
    out.push({ name, slug });
  }
  return out;
}

// Category/Tag filtering UI removed from Posts list page.

const currentParams = new URLSearchParams(Astro.url.searchParams);
function makeHref(next: Record<string, string>): string {
  const p = new URLSearchParams(currentParams);
  for (const [k, v] of Object.entries(next)) {
    if (!v) p.delete(k);
    else p.set(k, v);
  }
  const qs = p.toString();
  return `/internal/operations/posts/${qs ? `?${qs}` : ''}`;
}

function formatDate(iso: string): string {
  if (!iso) return '-';
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
}
---

<InternalDashboardLayout
  title="Lead Operations Posts"
  active="posts"
  sessionEmail={session.email}
  sessionRole={session.role}
  csrfToken={session.csrf}
>
  <section class="panel">
    <div class="toolbar">
      <div>
        <h2>Posts</h2>
        <p>Manage blog posts stored in <code>src/content/blog/*.json</code>.</p>
      </div>

      <div class="top-actions">
        <a class="btn primary" href="/internal/operations/posts/new/">Add New Post</a>
      </div>
    </div>

    <div class="tabs" role="tablist" aria-label="Post filters">
      <a class={`tab ${statusTab === 'all' ? 'active' : ''}`} href={makeHref({ status: 'all' })}>
        All ({allCount})
      </a>
      <a class={`tab ${statusTab === 'published' ? 'active' : ''}`} href={makeHref({ status: 'published' })}>
        Published ({publishedCount})
      </a>
      <a class={`tab ${statusTab === 'draft' ? 'active' : ''}`} href={makeHref({ status: 'draft' })}>
        Draft ({draftCount})
      </a>
      <a class={`tab ${statusTab === 'trash' ? 'active' : ''}`} href={makeHref({ status: 'trash' })}>
        Trash ({trashCount})
      </a>
    </div>

    <form class="search" method="get" action="/internal/operations/posts/">
      <input type="search" name="q" value={q} placeholder="Search by title or slug..." />
      <input type="hidden" name="status" value={statusTab} />
      <button type="submit">Search</button>
      <a class="btn subtle" href={makeHref({ q: '' })} title="Clear search">Clear</a>
    </form>

    <div class="pageGrid">
      <div class="tableWrap">
        <table>
          <thead>
            <tr>
              <th style="width:64px;">Select</th>
              <th style="width:96px;">Featured</th>
              <th>Title</th>
              <th>Slug</th>
              <th>Category</th>
              <th>Tags</th>
              <th style="width:150px;">Publish Date</th>
              <th style="width:130px;">Status</th>
              <th style="width:260px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {filtered.length ? (
              filtered.map((p) => {
                const st = statusOf(p);
                const cat = extractCategory(p);
                const tagNames = extractTags(p).map((x) => x.name).filter(Boolean).slice(0, 3);

                return (
                  <tr>
                    <td>
                      <input type="checkbox" aria-label={`Select ${p.title}`} />
                    </td>
                    <td>
                      {p.featuredImage?.src ? (
                        <img class="thumb" src={p.featuredImage.src} alt={p.featuredImage.alt || 'Featured image'} />
                      ) : (
                        <span class="muted">-</span>
                      )}
                    </td>
                    <td>
                      <a class="link" href={`/internal/operations/posts/${p.slug}/`}>{p.title}</a>
                    </td>
                    <td><code class="code">{p.slug}</code></td>
                    <td>{cat.name || '-'}</td>
                    <td>{tagNames.length ? tagNames.join(', ') : '-'}</td>
                    <td>{formatDate(p.publishedAt)}</td>
                    <td>
                      <span class={`pill ${st === 'draft' ? 'draft' : st === 'trash' ? 'trash' : 'published'}`}>{st}</span>
                    </td>
                    <td class="actions">
                      <a class="btn" href={`/internal/operations/posts/${p.slug}/`}>Edit</a>
                      {canEdit ? (
                        st === 'trash' ? (
                          <>
                            <form method="post" action="/api/internal/posts/delete">
                              <input type="hidden" name="csrfToken" value={session.csrf} />
                              <input type="hidden" name="slug" value={p.slug} />
                              <input type="hidden" name="mode" value="restore" />
                              <button type="submit" class="btn">Restore</button>
                            </form>
                            <form
                              method="post"
                              action="/api/internal/posts/delete"
                              onsubmit="return confirm('Delete permanently? This cannot be undone.');"
                            >
                              <input type="hidden" name="csrfToken" value={session.csrf} />
                              <input type="hidden" name="slug" value={p.slug} />
                              <input type="hidden" name="mode" value="permanent" />
                              <button type="submit" class="btn danger">Delete Permanently</button>
                            </form>
                          </>
                        ) : (
                          <form
                            method="post"
                            action="/api/internal/posts/delete"
                            onsubmit="return confirm('Move this post to Trash?');"
                          >
                            <input type="hidden" name="csrfToken" value={session.csrf} />
                            <input type="hidden" name="slug" value={p.slug} />
                            <input type="hidden" name="mode" value="trash" />
                            <button type="submit" class="btn danger">Move to Trash</button>
                          </form>
                        )
                      ) : (
                        <span class="muted">Read-only</span>
                      )}
                    </td>
                  </tr>
                );
              })
            ) : (
              <tr>
                <td colspan="9" class="empty">No posts matched.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</InternalDashboardLayout>

<style>
  .panel {
    background: white;
    border-radius: 18px;
    padding: 1.25rem;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
  }
  .toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }
  h2, p {
    margin: 0;
  }
  p { color: #475569; }
  .top-actions { display: flex; gap: 0.75rem; align-items: center; }
  .tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    margin: 0.75rem 0 1rem;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.75rem;
    border-radius: 12px;
    border: 1px solid #cbd5e1;
    background: white;
    color: #0f172a;
    text-decoration: none;
    font-weight: 800;
    font-size: 13px;
  }
  .tab.active {
    background: #0f172a;
    border-color: #0f172a;
    color: white;
  }

  .search { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: end; margin-bottom: 1rem; }
  input, select, button {
    font: inherit;
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
  }
  input, select { border: 1px solid #cbd5e1; }
  button {
    border: 0;
    background: #0f172a;
    color: white;
    cursor: pointer;
  }
  table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  th, td {
    text-align: left;
    padding: 0.8rem 0.2rem;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
  }
  .muted { color: #94a3b8; }
  .empty { text-align: center; color: #64748b; padding: 1.25rem 0; }
  .thumb {
    width: 56px;
    height: 40px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
  }
  .link { color: #23369b; text-decoration: none; font-weight: 600; }
  .link:hover { text-decoration: underline; }
  .code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
  .pill {
    display: inline-flex;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid transparent;
  }
  .pill.draft { background: #fff7ed; color: #9a3412; border-color: #fdba74; }
  .pill.published { background: #ecfdf5; color: #047857; border-color: #34d399; }
  .pill.trash { background: #fef2f2; color: #991b1b; border-color: #fca5a5; }
  .actions { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .actions form { margin: 0; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    background: white;
    color: #0f172a;
    text-decoration: none;
    cursor: pointer;
    font-weight: 600;
    font-size: 13px;
  }
  .btn.primary {
    border: 1px solid #0f172a;
    background: #0f172a;
    color: white;
  }
  .btn.danger {
    border-color: #fecaca;
    background: #fee2e2;
    color: #991b1b;
  }

  .pageGrid {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 1rem;
    align-items: start;
  }
  .taxonomy {
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 0.9rem;
    background: #fff;
    position: sticky;
    top: 1rem;
  }
  .taxSection { margin-bottom: 1rem; }
  .taxTitle {
    font-weight: 900;
    font-size: 13px;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }
  .taxItem {
    display: block;
    color: #0f172a;
    text-decoration: none;
    padding: 0.45rem 0.55rem;
    border-radius: 12px;
    border: 1px solid transparent;
    font-weight: 700;
    font-size: 13px;
    margin-bottom: 0.25rem;
  }
  .taxItem:hover { background: #f8fafc; border-color: #e2e8f0; }
  .taxItem.active { background: #0f172a; color: white; border-color: #0f172a; }
  .taxMuted { color: #94a3b8; font-size: 13px; padding: 0.35rem 0.55rem; }
  .tableWrap { min-width: 0; }
  .tableWrap { grid-column: 1 / -1; }
  .subtle {
    background: white !important;
    border: 1px solid #cbd5e1 !important;
    color: #0f172a !important;
    cursor: pointer;
    text-decoration: none;
    padding: 0.75rem 0.9rem;
  }
  @media (max-width: 1024px) {
    .pageGrid { grid-template-columns: 1fr; }
    .taxonomy { position: static; }
  }
</style>

