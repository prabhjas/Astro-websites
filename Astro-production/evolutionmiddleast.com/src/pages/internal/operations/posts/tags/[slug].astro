---
import InternalDashboardLayout from '../../../../../layouts/InternalDashboardLayout.astro';
import { readDashboardSession } from '../../../../../lib/auth/session';
import { hasDashboardRole, isSeoOnlyRole } from '../../../../../lib/auth/permissions';
import { applyInternalNoIndexHeaders } from '../../../../../lib/security/internal-response';
import { getTagTermBySlug } from '../../../../../lib/internal-posts/taxonomy-store';

export const prerender = false;

applyInternalNoIndexHeaders(Astro.response.headers);

const session = readDashboardSession(Astro.cookies);
if (!session) return Astro.redirect('/internal/operations/login');

if (isSeoOnlyRole(session)) {
  return Astro.redirect('/internal/operations/seo/');
}
if (!hasDashboardRole(session, 'developer')) return Astro.redirect('/internal/operations/');

const slugParam = String(Astro.params.slug || '').trim();
const term = slugParam ? getTagTermBySlug(slugParam) : null;
if (!term) return new Response('Not found', { status: 404 });
---

<InternalDashboardLayout
  title={`Edit Tag: ${term.name}`}
  active="posts-tags"
  sessionEmail={session.email}
  sessionRole={session.role}
  csrfToken={session.csrf}
>
  <section class="panel">
    <div class="head">
      <h2>Edit Tag</h2>
      <p><code>{term.slug}</code>{term.status === 'trash' ? ' (in Trash)' : ''}</p>
    </div>

    <form id="tag-form" method="post" action="/api/internal/posts/tags/save">
      <input type="hidden" name="csrfToken" value={session.csrf} />
      <input type="hidden" name="originalSlug" value={term.slug} />

      <div class="grid">
        <div class="left">
          <div class="field">
            <label for="tag-name">Tag Name *</label>
            <input id="tag-name" name="name" type="text" required value={term.name} />
          </div>
          <div class="field">
            <label for="tag-slug">Slug *</label>
            <input id="tag-slug" name="slug" type="text" required value={term.slug} />
          </div>
        </div>
      </div>

      <div class="actionsBar">
        <button type="submit" class="btn primary">Save</button>
        <a class="btn" href="/internal/operations/posts/tags/">Back</a>
      </div>
    </form>
  </section>

  <script>
    (function () {
      var nameInput = document.getElementById('tag-name');
      var slugInput = document.getElementById('tag-slug');
      // On edit pages, never auto-update the slug from the name.
      // The slug should only change if the user manually edits it.
      var slugTouched = true;
    })();
  </script>

  <style>
    .panel {
      background: white;
      border-radius: 18px;
      padding: 1.25rem;
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
    }
    .head { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-bottom: 1rem; }
    .grid { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: start; }
    .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 0.95rem; }
    label { font-weight: 700; font-size: 13px; color: #0f172a; }
    input, textarea {
      font: inherit;
      border-radius: 10px;
      padding: 0.75rem 0.9rem;
      border: 1px solid #cbd5e1;
    }
    .actionsBar { display: flex; gap: 0.75rem; margin-top: 0.5rem; flex-wrap: wrap; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.6rem 0.85rem;
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      background: white;
      color: #0f172a;
      text-decoration: none;
      cursor: pointer;
      font-weight: 800;
      font-size: 13px;
    }
    .btn.primary { background: #0f172a; border-color: #0f172a; color: white; }
  </style>
</InternalDashboardLayout>

