[Unit]
Description=Evolution Middle East Astro SSR server (Caddy reverse-proxies to this)
After=network.target

[Service]
Type=simple
# Tier 1: dedicated user (create on host before enabling). Until then, do not
# ship this file over the live unit without ops review — live may still be root.
User=site-evolutionmiddleast
Group=site-evolutionmiddleast
WorkingDirectory=/opt/Astro-production/evolutionmiddleast.com
EnvironmentFile=-/opt/Astro-production/evolutionmiddleast.com/.env.prod
Environment=NODE_ENV=production
# HOST/PORT set here — not in .env.prod (fleet rule)
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=5080 /usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=5

# Tier 1 resource + sandbox (CONNECT-ASTRO-FLEET-STANDARD §6.2)
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Astro-production/evolutionmiddleast.com/.data
# If LEAD_STORE_DIR / INTERNAL_* dirs live under /var/..., add them here too.

[Install]
WantedBy=multi-user.target
