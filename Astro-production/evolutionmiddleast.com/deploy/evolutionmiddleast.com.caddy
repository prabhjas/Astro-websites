# /etc/caddy/sites.d/evolutionmiddleast.com.caddy
# Behind Cloudflare: do NOT use bare hostnames (auto-HTTPS 301 :80→:443 loops with
# Flexible SSL). Explicit http:// + https:// + tls internal matches live Evolution/CBSS.
# Validate before reload: caddy validate --config /etc/caddy/Caddyfile

http://evolutionmiddleast.com, http://www.evolutionmiddleast.com, https://evolutionmiddleast.com, https://www.evolutionmiddleast.com {
	tls internal
	encode gzip zstd
	reverse_proxy 127.0.0.1:5080
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/evolutionmiddleast.com-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
