# /etc/caddy/sites.d/evolutionmiddleast.com.caddy
# Prefer: import /etc/caddy/sites.d/*.caddy  (fleet standard)
# Validate before reload: caddy validate --config /etc/caddy/Caddyfile

evolutionmiddleast.com, www.evolutionmiddleast.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:5080
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/evolutionmiddleast.com-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
