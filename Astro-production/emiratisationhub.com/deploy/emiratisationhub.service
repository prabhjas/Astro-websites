[Unit]
Description=Emiratisation Hub (emiratisationhub.com) Astro SSR server
After=network.target

[Service]
Type=simple
User=site-emiratisationhub
Group=site-emiratisationhub
WorkingDirectory=/opt/Astro-production/emiratisationhub.com
# REQUIRED — no leading "-". Missing .env.prod must fail the unit.
EnvironmentFile=/opt/Astro-production/emiratisationhub.com/.env.prod
Environment=NODE_ENV=production
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=5107 /usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=5

MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Astro-production/emiratisationhub.com/.data

[Install]
WantedBy=multi-user.target
