# emiratisationhub.com -> 127.0.0.1:5107 (systemd: emiratisationhub.service)
#
# PRODUCTION STANDARD (single /etc/caddy/Caddyfile — see caddy/Caddyfile.production).
# This file is the site block to keep in sync with the live fleet Caddyfile.
#
# When deploying / adding this site on the server you MUST also:
#   1. Ensure the shared one-hop HTTP alt-host block lists http://www.emiratisationhub.com
#      and redirects to https://emiratisationhub.com{uri}
#   2. Match PUBLIC_SITE_URL=https://emiratisationhub.com
#   3. Cloudflare SSL = Full (not Flexible; named CA astro_origin_2026 on origin — not Full strict until certs match)
#   4. sudo -u caddy caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Local laptop: do NOT run this Caddy block — use fleet-local on :5107 only.
# Docs: docs/CONNECT-CADDY-DEPLOYMENT.md

emiratisationhub.com, www.emiratisationhub.com {
	tls force_automate {
		issuer internal {
			ca astro_origin_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/emiratisationhub.com/emiratisationhub.com.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/emiratisationhub.com/emiratisationhub.com.key
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.emiratisationhub.com/www.emiratisationhub.com.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.emiratisationhub.com/www.emiratisationhub.com.key
	encode zstd gzip

	@noncanonical host www.emiratisationhub.com
	redir @noncanonical https://emiratisationhub.com{uri} permanent

	reverse_proxy 127.0.0.1:5107

	@static path_regexp static \.(css|js|woff|woff2|webp|jpg|jpeg|png|gif|svg|ico|avif|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/emiratisationhub.com-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
