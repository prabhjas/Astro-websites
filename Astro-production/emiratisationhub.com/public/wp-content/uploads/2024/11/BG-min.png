<style id="wp-custom-css">
 .intl-tel-input.allow-dropdown .flag-container:hover .selected-flag {
        background: none !important;
    }

.green{
	color:#57820C;
}
.yellow{
	color:#FFB534;
}

.blue{
	color:#5265EB;
}
.grey{
	color:#D9D9D9;
}


#contact-formnew label{
	 width:100%;
}

#contact-formnew input {
     padding: 17px 21px;
    border-radius: 100px;
    border: 1px solid #D9D9D9;
    margin-bottom:16px !important;
}


#contact-formnew input.wpcf7-phonetext{
    padding-left:110px;
}
.intl-tel-input.separate-dial-code .selected-flag{
	background:unset !important;
}

#contact-formnew .intl-tel-input .selected-flag {
    top: -7px;
    left: 10px;
}

#contact-formnew textarea{
    border-radius: 32px;
    padding: 17px 21px;
    border: 1px solid #D9D9D9;
    height:87px;
	  resize:none;
}
#contact-formnew .btn-submit p {
    height: 40px;
}
#contact-formnew input[type=submit]{
   width:100%;
   padding:17px;
	 border: 1px solid #D9D9D9;
}

#contact-formnew input[type=submit]:hover {
    background: #121212;
    color: #fff;
}

.faq-sec .elementor-accordion-item {
    border:0px;
    margin-bottom:16px;
}

.faq-sec .elementor-accordion-item .elementor-tab-title {
    border-radius: 100px ;
}

.faq-sec  .elementor-accordion .elementor-tab-content{
    border-top:0px;    
} 

.contact-info ul li .elementor-icon-list-icon i {
  
    padding:15px;
    width:50px;
    height:50px;
    background:#fff;
    border-radius:100px;
    
    
}
.contact-info ul li .elementor-icon-list-icon i{
    font-size:20px;
    
}

.green-box .elementor-widget-container {
    min-height: 360px;
}

.radius-left-col .elementor-widget-wrap{
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
}

.radius-right-col .elementor-widget-wrap{
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
}

.cta-counter .elementor-counter .elementor-counter-title {
    text-align: left;
	margin-top: 5px;
}

.cta-counter span.elementor-counter-number-prefix {
    display: none;
}


/* blog styling */
.main-post{
    display: grid;
    grid-template-columns:40% 58%;
    gap: 20px;
    margin-bottom:20px;
}

.post-img{
    position:relative
}

.post-img img{
     border-radius:24px;
}

span.cat-name {
    color:#fff;
    font-family: Poppins;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: 20.5px; 
    padding: 4px 10px;
    border-radius: 6px;
    background:#57820C;
    position:absolute;
    left: 24px;
    top: 24px;
}

.post-ct .metas span{
    color: #4A4A4A;
    font-family: Poppins;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 20.5px; 
}

.post-ct h3{
    color: #121212;
    font-family: Poppins;
    font-size: 40px;
    font-style: normal;
    font-weight: 600;
    line-height: 44px; 
    letter-spacing: -0.6px;
    text-transform: capitalize;
		  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-ct p{
    color: #4A4A4A;
    font-family: Poppins;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
	  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}


.top-wrap{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:50px;
}

.top-wrap h2{
    color: #121212;
    font-family: Poppins;
    font-size: 40px;
    font-style: normal;
    font-weight: 600;
    line-height: 44px; 
    letter-spacing: -0.6px;
    text-transform: capitalize;
}

.catbutton  button {
    color:#4A4A4A;
    text-align: center;
    font-family: Poppins;
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
    line-height: 20.5px; 
    border-radius: 100px;
    border: 1px solid #D9D9D9;
    padding: 12px 24px;
    background:#fff;
    margin-left:10px;
  	margin-bottom:10px;
}

.catbutton  button:hover {
    background:#121212;
    color:#fff;
    border: 1px solid #D9D9D9;
    
}

.blog-right h2{
     display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden; 
}

.blog-sec h2 {
    color: #121212;
    font-family: Poppins;
    font-size: 40px;
    font-style: normal;
    font-weight: 600;
    line-height: 44px; 
    letter-spacing: -0.6px;
    text-transform: capitalize;
}

a.elementor-item:hover {
    color: #57820c !important;
}

.slidebox{
    min-height:580px;
}

.home .slidebox{
    min-height:680px;
}

.auth-box .elementor-widget-wrap{
    margin:15px;
	  box-shadow: 0px 49.127px 98.254px 0px rgba(0, 0, 0, 0.04);
}





/* Media Query */

/* 992 to 1024 */

@media only screen and (min-width: 992px) and (max-width: 1024px)  {
.green-box .elementor-widget-container {
    min-height: 410px ;
}
	
.blog-sec h2  {
    font-size: 32px;
    line-height: 30px; 
}

.blog-sec h3  {
    font-size: 28px;
    line-height: 26px; 
}	
	
#contact-formnew input {
    padding: 10px 21px;
    margin-bottom: 10px !important;
}


#contact-formnew textarea {
    height: 75px;
}

#contact-formnew input[type=submit] {
    padding: 10px;
}	
	
}

/* 768 to 991 */

@media only screen and (min-width: 768px) and (max-width: 991px)  {
.green-box .elementor-widget-container {
    min-height: 470px;
}
	
.catbutton button {
    font-size: 12px;
    line-height: 20.5px;
    padding: 10px 18px;
    margin-left: 4px;
    margin-bottom: 10px;
}	
	
.top-wrap h2 {
    font-size: 35px;
    line-height: 36px;	
}
	
.post-ct h3 {
    font-size: 28px;
    line-height: 35px;
	}
	
.blog-sec h2  {
    font-size: 30px;
    line-height: 35px; 
}

.blog-sec h3  {
    font-size: 26px;
    line-height: 28px; 
}	
	
#contact-formnew input {
    padding: 10px 21px;
    margin-bottom: 10px !important;
}


#contact-formnew textarea {
    height: 75px;
}

#contact-formnew input[type=submit] {
    padding: 10px;
}	
	
}



/* Media 767 */
@media only screen and (max-width: 767px) {
	.cta-counter{
    background:#121212;
    background-image:unset !important;
}
.cta-counter .elementor-counter .elementor-counter-title {
    text-align: center;
	margin-top: 5px;
}

.cta-counter span.elementor-counter-number-prefix {
    display: unset;
}
	
.cta-one	{
    background:#121212;
    background-image:unset !important;
}
	
.radius-left-col .elementor-widget-wrap{
    border-radius:0px;
}

.radius-right-col .elementor-widget-wrap{
     border-radius:0px;
}	
	
.green-box .elementor-widget-container {
    height: auto;
}
		
.banner-form{
    background:#57820c;
}

.bg-img1{
     background-image:unset !important;
}	

.experts-contact{
    position: unset !important;
}	
	
.contact-info{
  position:unset !important;	
}	
	
.main-post {
    display: block;
	    margin-bottom: 40px; 
}

.top-wrap {
    display: block;
    margin-bottom: 30px;
}

.catbutton button {
    font-size: 12px;
    padding: 10px 18px;
    margin-left: 0px;
    margin-bottom: 10px;
}	
	
.top-wrap h2{
  font-size:32px;	
}	
	
.post-ct h3 {
    font-size: 22px;
    font-style: normal;
    font-weight: 600;
	  line-height: 28px;
}	
	
.blog-sec h2  {
    font-size: 24px;
    font-weight: 600;
    line-height: 28px; 
}

.blog-sec h3  {
    font-size: 22px;
    font-weight: 600;
    line-height: 26px; 
}	
	
}



