# On the production host this file is SPLIT:
#   .env       → build-only (PUBLIC_SITE_URL), root:webdev 0644 — no secrets
#   .env.prod  → runtime secrets for systemd (root:site-* 0640) — REQUIRED (no EnvironmentFile=-)
# Local laptop: one gitignored .env with secrets is fine for fleet-local smoke.
#
# Public canonical website origin (no trailing slash required).
# Used by astro.config `site` and Rank Math–style robots/sitemap absolute URLs.
# This is a public origin only — never put secrets in PUBLIC_* variables.
PUBLIC_SITE_URL=https://emiratisationhub.com

# --- Lead storage (file-backed source of truth) ---
LEAD_STORE_DIR=.data/leads
LEAD_STORE_MAX_FILE_BYTES=10485760
PIPEDRIVE_MAX_RETRY_ATTEMPTS=5
PIPEDRIVE_REQUEST_TIMEOUT_MS=10000

# --- Pipedrive (required for POST /api/contact) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
# Alias supported: PIPEDRIVE_API_URL=
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_LEAD_SOURCE_ID=
PIPEDRIVE_PERSON_LABEL_IDS=5
PIPEDRIVE_PERSON_VISIBLE_TO=3

# --- Website / form identity ---
WEBSITE_ID=
WEBSITE_NAME=Emiratisation Hub
FORM_SOURCE=
FORM_NAME=Emiratisation Hub Contact Form
LEAD_TITLE_PREFIX=AD Emiratisation Hub

LOG_LEVEL=info

# --- Analytics (interim until FLOW dashboard) ---
# FLOW-saved .data/internal-admin/gtm.json wins when present.
# Use GTM and/or GA4 — both can be set; loader injects via /runtime-gtm.js
PUBLIC_GTM_ID=          # GTM-AAAA or GTM-AAAA,GTM-BBBB
PUBLIC_GA4_ID=G-7B6EW1N2SB        # G-XXXX or G-XXXX,G-YYYY

# --- Internal machine API (central FLOW / CMS / cron) ---
# Per-site dashboard UI removed. Auth:
#   Authorization: Bearer <INTERNAL_JOB_SECRET>
# Also accepts: x-internal-job-secret header. Query ?secret= is rejected (security audit P0-2).
# One secret per site — never reuse across domains.
# Generate unique secret: openssl rand -hex 32   (NEVER share across domains)
INTERNAL_JOB_SECRET=
INTERNAL_ADMIN_DIR=.data/internal-admin
INTERNAL_ENHANCED_LIVE_DIR=.data/enhanced-live
INTERNAL_UPLOAD_DIR=.data/internal-uploads
INTERNAL_UPLOAD_MAX_FILE_BYTES=10485760

# Do NOT set HOST or PORT here — systemd / fleet-local sets them.
# Use LF line endings only (CRLF breaks systemd EnvironmentFile=).
