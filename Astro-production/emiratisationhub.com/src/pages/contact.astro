---
/**
 * Contact page — emiratisationhub.com
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const seo = {
  title: 'Contact Us | Emiratisation Hub',
  description:
    'Get in touch with Emiratisation Hub. Our advisors are ready to help you meet your Emiratisation targets.',
  robots: 'index, follow',
  og: {
    type: 'website',
  },
  schema: {
    organizationName: 'Emiratisation Hub',
    pageType: 'ContactPage',
  },
};
---

<BaseLayout seo={seo}>
  <section class="contact-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Reach out to our team and we'll be in touch within one business day.</p>
    </div>
  </section>

  <section class="contact-body section">
    <div class="container container--narrow">
      <ContactForm formName="Emiratisation Hub Contact Form" />
    </div>
  </section>
</BaseLayout>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, -apple-system, sans-serif; color: #111; }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .container--narrow { max-width: 720px; }
  .section { padding: 4rem 0; }

  .contact-hero {
    background: #004225;
    color: #fff;
    padding: 4rem 0;
    text-align: center;
  }
  .contact-hero h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); margin: 0 0 .75rem; }
  .contact-hero p { opacity: .85; font-size: 1.0625rem; margin: 0; }
</style>
