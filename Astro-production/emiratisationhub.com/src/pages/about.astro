---
/**
 * About page — emiratisationhub.com
 * Placeholder — replace with final content.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'About Us | Emiratisation Hub',
  description:
    'Learn about Emiratisation Hub — our mission to support UAE businesses in building a strong national workforce.',
  robots: 'index, follow',
  schema: {
    organizationName: 'Emiratisation Hub',
    pageType: 'AboutPage',
  },
};
---

<BaseLayout seo={seo}>
  <section class="about-hero">
    <div class="container">
      <h1>About Emiratisation Hub</h1>
    </div>
  </section>

  <section class="about-body section">
    <div class="container container--narrow">
      <p>
        Emiratisation Hub is a dedicated platform supporting UAE businesses in achieving their
        nationalisation targets. We combine deep expertise in Emirati recruitment, regulatory
        compliance, and workforce strategy to help companies build sustainable national teams.
      </p>
      <p>
        Our advisors work across all sectors and company sizes — from SMEs navigating their
        first Emiratisation quota to large enterprises optimising their existing programmes.
      </p>
      <a href="/contact/" class="btn">Get in Touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, -apple-system, sans-serif; color: #111; }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .container--narrow { max-width: 720px; }
  .section { padding: 4rem 0; }

  .about-hero { background: #004225; color: #fff; padding: 4rem 0; text-align: center; }
  .about-hero h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); margin: 0; }

  .about-body p { font-size: 1.0625rem; line-height: 1.75; color: #374151; margin: 0 0 1.5rem; }

  .btn {
    display: inline-block;
    padding: .75rem 2rem;
    background: #004225;
    color: #fff;
    border-radius: .375rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    margin-top: .5rem;
  }
  .btn:hover { background: #005e34; }
</style>
