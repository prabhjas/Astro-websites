---
import { getAuthorProfileData, serveAuthorProfile } from '../../lib/authors.ts';
import { notFoundResponse } from '../../lib/not-found.js';

export const prerender = false;

const slug = Astro.params.slug!;
const data = getAuthorProfileData(slug);
if (!data) {
  return notFoundResponse();
}
return serveAuthorProfile(data);
---
