---
/**
 * Site footer — emiratisationhub.com
 * Greenfield placeholder. Replace with branded design once assets arrive.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>&copy; {year} Emiratisation Hub. All rights reserved.</p>
    <nav aria-label="Footer navigation">
      <a href="/contact/">Contact</a>
      <a href="/privacy-policy/">Privacy Policy</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: #1a1a1a;
    color: rgba(255,255,255,.7);
    padding: 2rem 1.5rem;
    margin-top: auto;
  }
  .site-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: .875rem;
  }
  .site-footer__inner p { margin: 0; }
  .site-footer nav { display: flex; gap: 1.5rem; }
  .site-footer a { color: rgba(255,255,255,.6); text-decoration: none; }
  .site-footer a:hover { color: #fff; }
</style>
