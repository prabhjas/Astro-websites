---
/**
 * Site header — emiratisationhub.com
 * Greenfield placeholder. Replace with branded design once assets arrive.
 */
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Emiratisation Hub home">
      <strong>Emiratisation Hub</strong>
    </a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #004225;
    color: #fff;
    padding: 0 1.5rem;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0,0,0,.15);
  }
  .site-header__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 2rem;
  }
  .site-header__logo {
    color: #fff;
    text-decoration: none;
    font-size: 1.125rem;
    letter-spacing: -.01em;
  }
  .site-header__nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    color: rgba(255,255,255,.85);
    text-decoration: none;
    font-size: .9375rem;
    transition: color .15s;
  }
  .site-header__nav a:hover { color: #fff; }
</style>
