---
/**
 * Shared contact form with intl-tel-input (flags + IP-based country dial code).
 * Submits to /api/contact (server-side Pipedrive + email notifications).
 * Attribution fields are populated client-side from localStorage / URL params.
 */
interface Props {
  formId?: string;
  formName?: string;
}

const { formId = 'contact-lead', formName = 'Emiratisation Hub Contact Form' } = Astro.props;
---

<form id={formId} data-form-id={formId} data-form-name={formName} class="cg-contact-form" method="post" action="/api/contact/" novalidate>
  <!-- Honeypot — bots fill this; real users don't see it -->
  <input type="text" name="website" class="cg-contact-form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="form_name" value={formName} />
  <input type="hidden" name="form_id" value={formId} />
  <input type="hidden" name="submission_id" value="" />
  <input type="hidden" name="page_url" value="" />
  <input type="hidden" name="referrer_url" value="" />
  <input type="hidden" name="initial_url" value="" />
  <input type="hidden" name="landing_page_url" value="" />
  <input type="hidden" name="submission_page_url" value="" />
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_term" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="gclid" value="" />
  <input type="hidden" name="gbraid" value="" />
  <input type="hidden" name="wbraid" value="" />
  <input type="hidden" name="fbclid" value="" />
  <input type="hidden" name="msclkid" value="" />
  <input type="hidden" name="campaign_id" value="" />
  <input type="hidden" name="adgroup_id" value="" />
  <input type="hidden" name="group_id" value="" />
  <input type="hidden" name="creative_id" value="" />
  <input type="hidden" name="keyword" value="" />
  <input type="hidden" name="matchtype" value="" />
  <input type="hidden" name="device" value="" />
  <input type="hidden" name="network" value="" />
  <input type="hidden" name="placement" value="" />
  <input type="hidden" name="target" value="" />
  <input type="hidden" name="target_id" value="" />
  <input type="hidden" name="adposition" value="" />
  <input type="hidden" name="loc_physical_ms" value="" />
  <input type="hidden" name="loc_interest_ms" value="" />
  <input type="hidden" name="gad_source" value="" />
  <input type="hidden" name="source" value="" />
  <input type="hidden" name="first_touch_payload" value="" />
  <input type="hidden" name="last_touch_payload" value="" />
  <input type="hidden" name="first_visit_at" value="" />
  <input type="hidden" name="latest_visit_at" value="" />
  <input type="hidden" name="submitted_at" value="" />

  <div class="cg-contact-form__fields">
    <label class="cg-contact-form__label">
      <span>Full Name <span aria-hidden="true">*</span></span>
      <input type="text" name="name" required autocomplete="name" placeholder="Your full name" />
      <span class="cg-contact-form__error" data-error-for="name"></span>
    </label>

    <label class="cg-contact-form__label">
      <span>Email Address <span aria-hidden="true">*</span></span>
      <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
      <span class="cg-contact-form__error" data-error-for="email"></span>
    </label>

    <label class="cg-contact-form__label">
      <span>Phone Number <span aria-hidden="true">*</span></span>
      <input
        type="tel"
        name="phone"
        class="cg-phone-input"
        autocomplete="tel"
        required
        placeholder="+971 50 000 0000"
      />
      <input type="hidden" name="phone-country-code" value="" />
      <span class="cg-contact-form__error" data-error-for="phone"></span>
    </label>

    <label class="cg-contact-form__label cg-contact-form__label--full">
      <span>Message</span>
      <textarea name="message" rows="4" placeholder="How can we help you?"></textarea>
      <span class="cg-contact-form__error" data-error-for="message"></span>
    </label>
  </div>

  <button type="submit" class="cg-contact-form__submit">Send Message</button>
  <p class="cg-contact-form__status" hidden aria-live="polite"></p>
</form>

<style>
  .cg-contact-form__honeypot { display: none !important; }

  .cg-contact-form__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .cg-contact-form__label {
    display: flex;
    flex-direction: column;
    gap: .375rem;
    font-size: .9375rem;
    font-weight: 500;
    color: #111;
  }
  .cg-contact-form__label--full { grid-column: 1 / -1; }

  .cg-contact-form input[type="text"],
  .cg-contact-form input[type="email"],
  .cg-contact-form input[type="tel"],
  .cg-contact-form textarea {
    width: 100%;
    padding: .625rem .875rem;
    border: 1.5px solid #d1d5db;
    border-radius: .375rem;
    font-size: 1rem;
    font-family: inherit;
    outline: none;
    transition: border-color .15s;
    background: #fff;
  }
  .cg-contact-form input:focus,
  .cg-contact-form textarea:focus { border-color: #004225; }

  .cg-contact-form__error {
    font-size: .8125rem;
    color: #dc2626;
    min-height: 1rem;
  }

  .cg-contact-form__submit {
    margin-top: 1.25rem;
    padding: .75rem 2rem;
    background: #004225;
    color: #fff;
    border: none;
    border-radius: .375rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s;
  }
  .cg-contact-form__submit:hover { background: #005e34; }
  .cg-contact-form__submit:disabled { opacity: .6; cursor: not-allowed; }

  .cg-contact-form__status {
    margin-top: .75rem;
    font-size: .9375rem;
    font-weight: 500;
  }
  .cg-contact-form__status[data-ok="true"] { color: #15803d; }
  .cg-contact-form__status[data-ok="false"] { color: #dc2626; }

  @media (max-width: 600px) {
    .cg-contact-form__fields { grid-template-columns: 1fr; }
    .cg-contact-form__label--full { grid-column: 1; }
  }
</style>

<script>
  import { captureAttribution, populateAttributionFields } from '../lib/attribution/client';

  function wireForm(form: HTMLFormElement) {
    const formId   = form.dataset.formId   || form.id;
    const formName = form.dataset.formName || 'Emiratisation Hub Contact Form';

    function setHidden(name: string, value: string) {
      let el = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      if (!el) {
        el = document.createElement('input');
        el.type = 'hidden';
        el.name = name;
        form.appendChild(el);
      }
      el.value = value || '';
    }

    function captureTracking() {
      const { firstTouch, lastTouch } = captureAttribution(formId, formName);
      populateAttributionFields(form, firstTouch, lastTouch);
      if (!form.dataset.submissionId) {
        form.dataset.submissionId =
          typeof crypto !== 'undefined' && crypto.randomUUID
            ? crypto.randomUUID()
            : Math.random().toString(36).slice(2) + Date.now().toString(36);
      }
      setHidden('submission_id', form.dataset.submissionId);
      setHidden('submitted_at', new Date().toISOString());
      setHidden('form_name', formName);
      setHidden('form_id', formId);
    }

    captureTracking();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      captureTracking(); // refresh attribution at submit time

      const btn    = form.querySelector<HTMLButtonElement>('[type="submit"]');
      const status = form.querySelector<HTMLElement>('.cg-contact-form__status');

      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      if (status) { status.hidden = true; status.removeAttribute('data-ok'); }
      form.querySelectorAll<HTMLElement>('.cg-contact-form__error').forEach(el => { el.textContent = ''; });

      const data: Record<string, string> = {};
      for (const [k, v] of new FormData(form)) data[k] = String(v);

      try {
        const res  = await fetch('/api/contact/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({})) as Record<string, unknown>;

        if (res.ok) {
          if (status) {
            status.textContent = String(json.message || 'Thank you! We will be in touch shortly.');
            status.dataset.ok  = 'true';
            status.hidden      = false;
          }
          form.reset();
          form.dataset.submissionId = '';
        } else {
          if (json.errors && typeof json.errors === 'object') {
            for (const [field, msg] of Object.entries(json.errors as Record<string, string>)) {
              const errEl = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
              if (errEl) errEl.textContent = msg;
            }
          }
          if (status) {
            status.textContent = String(json.message || 'Something went wrong. Please try again.');
            status.dataset.ok  = 'false';
            status.hidden      = false;
          }
        }
      } catch {
        if (status) {
          status.textContent = 'Network error. Please check your connection and try again.';
          status.dataset.ok  = 'false';
          status.hidden      = false;
        }
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'Send Message'; }
      }
    });
  }

  // Wire all forms on this page (handles multiple instances)
  document.querySelectorAll<HTMLFormElement>('form.cg-contact-form').forEach(wireForm);
</script>
