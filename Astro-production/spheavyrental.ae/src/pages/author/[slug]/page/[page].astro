---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostCard from "../../../../components/PostCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import {
  getAuthorBySlug,
  getAuthors,
  getPostsByAuthor,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
} from "../../../../lib/content";
import { breadcrumbSchema } from "../../../../lib/seo";
import { notFoundResponse } from "../../../../lib/not-found";

export function getStaticPaths() {
  const paths: { params: { slug: string; page: string } }[] = [];

  for (const author of getAuthors()) {
    const total = getPostsByAuthor(author.id).length;
    const totalPages = Math.max(1, Math.ceil(total / POSTS_PER_PAGE));
    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({
        params: { slug: author.slug, page: String(page) },
      });
    }
  }

  return paths;
}

function displayName(raw: string) {
  const name = stripHtml(raw).trim();
  let base = name.includes("@") ? name.split("@")[0] || name : name;
  base = base.replace(/[._-]+/g, " ").trim();
  return base.replace(/\b\w/g, (c) => c.toUpperCase());
}

const slug = String(Astro.params.slug || "");
const pageNum = Math.max(1, Number(Astro.params.page) || 1);
const author = getAuthorBySlug(slug);
if (!author) {
  return notFoundResponse();
}

const name = displayName(author.name);
const sorted = getPostsByAuthor(author.id);
const { items, page, totalPages } = paginate(sorted, pageNum, POSTS_PER_PAGE);
if (pageNum > totalPages && totalPages > 0) {
  return notFoundResponse();
}

const canonical = pageNum <= 1 ? author.path : `${author.path}page/${pageNum}/`;
---

<BaseLayout
  currentPath={author.path}
  menuActivePath="/blog/"
  bodyClass="sp-archive-page sp-authors-page sp-author-single"
  seo={{
    title: `Author: ${name} — Page ${page} | SP Heavy Rental`,
    description: author.description || `Articles by ${name} on S&P Heavy Machinery Rental.`,
    canonical,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Authors", url: "/author/" },
        { name: name, url: author.path },
        { name: `Page ${page}`, url: canonical },
      ]),
    ],
  }}
>
  <section class="sp-authors-hero" aria-label={name}>
    <div class="sp-authors-hero__media" aria-hidden="true">
      <picture>
        <source
          srcset="/wp-content/uploads/authors/authors-hero.webp"
          type="image/webp"
        />
        <img
          class="sp-authors-hero__img"
          src="/wp-content/uploads/authors/authors-hero.jpg"
          alt=""
          width="1920"
          height="424"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <span class="sp-authors-hero__overlay"></span>
    </div>
    <div class="sp-authors-hero__inner sp-container">
      <h1 class="sp-authors-hero__title">{name}</h1>
    </div>
  </section>

  <section class="sp-archive-body sp-authors-body sp-author-single__body">
    <div class="sp-container">
      {
        items.length ? (
          <>
            <div class="sp-blog-grid sp-blog-grid--author">
              {items.map((post) => (
                <PostCard post={post} variant="author" />
              ))}
            </div>
            <Pagination page={page} totalPages={totalPages} basePath={author.path} />
          </>
        ) : (
          <div class="sp-archive-empty-panel">
            <p class="sp-archive-empty">No posts on this page.</p>
            <a class="sp-archive-empty__cta" href={author.path}>Back to author</a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
