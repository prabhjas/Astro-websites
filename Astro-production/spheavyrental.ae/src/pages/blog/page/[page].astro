---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { posts, paginate, POSTS_PER_PAGE } from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/seo";

export function getStaticPaths() {
  const sorted = [...posts].sort((a, b) => +new Date(b.date) - +new Date(a.date));
  const totalPages = Math.max(1, Math.ceil(sorted.length / POSTS_PER_PAGE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return { params: { page: String(page) }, props: { pageNum: page } };
  });
}

const { pageNum } = Astro.props as { pageNum: number };
const sorted = [...posts].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const { items, page, totalPages } = paginate(sorted, pageNum, POSTS_PER_PAGE);
---

<BaseLayout
  currentPath="/blog/"
  seo={{
    title: `Blog — Page ${page} | SP Heavy Rental`,
    description: "Heavy equipment rental guides and tips for projects across the UAE.",
    canonical: `/blog/page/${page}/`,
    schemas: [breadcrumbSchema([{ name: "Home", url: "/" }, { name: "Blog", url: "/blog/" }])],
  }}
>
  <section class="sp-archive-hero">
    <div class="sp-container">
      <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Blog", href: "/blog/" }, { name: `Page ${page}` }]} />
      <h1>Blog</h1>
      <p>Page {page} of {totalPages}</p>
    </div>
  </section>
  <section class="sp-container" style="padding: 1rem 0 4rem">
    <div class="sp-blog-grid">
      {items.map((post) => <PostCard post={post} />)}
    </div>
    <Pagination page={page} totalPages={totalPages} basePath="/blog/" />
  </section>
</BaseLayout>
