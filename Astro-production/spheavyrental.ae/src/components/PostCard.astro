---
import {
  formatDate,
  getCategoryById,
  stripHtml,
  type PostEntry,
} from "../lib/content";

interface Props {
  post: PostEntry;
  /** Figma author-detail card layout */
  variant?: "default" | "author";
}

const { post, variant = "default" } = Astro.props;
const excerpt = stripHtml(post.excerpt || post.content).slice(0, 140);
const titleText = stripHtml(post.title);
const category = post.categories
  .map((id) => getCategoryById(id))
  .find((c) => c && c.slug !== "uncategorized" && c.slug !== "category");
const isAuthor = variant === "author";
---

<article class:list={["sp-post-card", isAuthor && "sp-post-card--author"]}>
  <a href={post.path} class="sp-post-card__media">
    {
      post.featuredImage ? (
        <img
          src={post.featuredImage}
          alt={titleText}
          loading="lazy"
          width="640"
          height="400"
        />
      ) : (
        <div class="sp-post-card__media-fallback" aria-hidden="true"></div>
      )
    }
    {
      isAuthor && (
        <span class="sp-post-card__brand" aria-hidden="true">
          <img
            src="/wp-content/uploads/2025/06/logo@2x.webp"
            alt=""
            width="48"
            height="31"
          />
        </span>
      )
    }
  </a>
  <div class="sp-post-card__body">
    {
      isAuthor ? (
        category ? (
          <div class="sp-post-card__cat">
            <span class="sp-post-card__cat-mark" aria-hidden="true"></span>
            <span class="sp-post-card__cat-name">{category.name}</span>
          </div>
        ) : null
      ) : (
        <div class="sp-post-card__meta">{formatDate(post.date)}</div>
      )
    }
    <h3 class="sp-post-card__title">
      <a href={post.path} set:html={post.title} />
    </h3>
    {excerpt && <p class="sp-post-card__excerpt">{excerpt}…</p>}
    {
      isAuthor && (
        <a class="sp-post-card__more" href={post.path}>
          Read more <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>
