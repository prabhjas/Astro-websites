---
import SEOHead from "../components/SEOHead.astro";
import ElementorHeader from "../components/ElementorHeader.astro";
import ElementorFooter from "../components/ElementorFooter.astro";
import LicenceStrip from "../components/LicenceStrip.astro";
import ElementorPopups from "../components/ElementorPopups.astro";
import ElementorScripts from "../components/ElementorScripts.astro";
import type { SeoInput } from "../lib/seo";
import type { SeoData } from "../lib/content";
import liveCssOrder from "../data/live-css-order.json";
import inlineHeadCss from "../data/inline-head.css?raw";
import inlineHeadCssAr from "../data/inline-head.ar.css?raw";
import cwvManifest from "../data/cwv-manifest.json";
// All per-route critical CSS, loaded at build. Server-side only (never shipped to client).
const criticalCssMap = import.meta.glob("../data/critical/*.css", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
import { resolveInternalAdminDir } from "../env/server";
import "../styles/global.css";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
  currentPath?: string;
  /** Force header nav active item (e.g. "/blog/" on single posts) */
  menuActivePath?: string;
  bodyClass?: string;
  /** WPML language — drives <html lang/dir> and EN vs AR header/footer */
  lang?: "en" | "ar";
  /** Page owns <main> (Hello Elementor author archive layout). */
  rawMain?: boolean;
}

const {
  seo = {},
  fallback,
  extraCss = [],
  currentPath = Astro.url.pathname,
  menuActivePath,
  bodyClass = "",
  lang = currentPath.startsWith("/ar/") || currentPath === "/ar" ? "ar" : "en",
  rawMain = false,
} = Astro.props;

const isRtl = lang === "ar";
const htmlLang = isRtl ? "ar" : "en-AE";

/**
 * Inline <head> CSS mirrored from the live site (wp-custom-css / Customizer,
 * global-styles + Elementor global colours, custom @font-face, WP Rocket used-CSS).
 * These define the CSS variables + custom rules that the linked post-*.css files
 * reference — accordion/FAQ open gradient, counter hover, sticky-bar gradient,
 * footer colours all live here. Injected after the linked stylesheets so it wins.
 */
const headInlineCss = isRtl ? inlineHeadCssAr : inlineHeadCss;

/*
 * Route-specific COMPLETE critical CSS (penthouse-generated, mobile above-the-fold).
 * When a route has one, inline it and load the full stylesheet set non-blocking
 * (asyncCss) so first paint isn't gated by the WP/Elementor CSS. Routes without a
 * generated critical set keep the safe render-blocking path (no FOUC/CLS risk).
 * Regenerate with scratchpad critcss/generate-critical.mjs after CSS changes.
 */
const normalizedPath = currentPath.replace(/\/+$/, "") || "/";
const cwvRoute = isRtl
  ? undefined
  : (
      cwvManifest.routes as Record<
        string,
        { slug: string; hero?: Array<Record<string, string>> }
      >
    )[normalizedPath];
const routeCriticalCss =
  cwvRoute && criticalCssMap[`../data/critical/${cwvRoute.slug}.css`];
const asyncCss = Boolean(routeCriticalCss);
const heroPreloads = (asyncCss && cwvRoute?.hero) || [];

/**
 * Stylesheet set = exact live-homepage order (live-css-order.json, captured by
 * scripts/extract-connecthr.mjs) + this page's Elementor CSS (extraCss) + local
 * migration helpers. Data-driven so it tracks Connect HR's real WP kit/plugins.
 */
const bundled = new Set(liveCssOrder as string[]);
const stylesheets = [
  ...new Set([
    // Single render-blocking bundle of the 71 live-order sheets (scripts/build-css-head-bundle.mjs)
    // — cuts request count without FOUC. Re-run that script if live-css-order.json changes.
    "/css/_head-bundle.css",
    // Page-specific Elementor CSS not already in the shared bundle.
    ...extraCss.filter((h) => !bundled.has(h)),
    "/css/wp-custom.css",
    "/css/elementor-bg-fallback.css",
    "/css/migration-overrides.css",
    "/css/menu-no-hash.css",
  ]),
];

---

<!doctype html>
<html lang={htmlLang} dir={isRtl ? "rtl" : "ltr"}>
  <head>
    <SEOHead
      seo={seo}
      fallback={fallback}
      extraCss={stylesheets}
      asyncCss={asyncCss}
      heroPreloads={heroPreloads}
      currentPath={currentPath}
    />
    <style is:inline set:html={routeCriticalCss ?? headInlineCss}></style>
    <meta
      name="sp-contact-endpoint"
      content={import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/"}
    />
    <script is:inline define:vars={{ contactEndpoint: import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/" }}>
      window.__SP_CONTACT_ENDPOINT__ = contactEndpoint;
    </script>
    <script src="/runtime-gtm-v2.js" defer data-runtime-gtm="1"></script>
  </head>
  <body
    class:list={[
      "wp-custom-logo",
      "elementor-default",
      "elementor-kit-9",
      "elementor-page",
      isRtl && "rtl",
      bodyClass,
    ]}
  >
    <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
    <ElementorHeader currentPath={currentPath} menuActivePath={menuActivePath} lang={lang} />
    {
      rawMain ? (
        <slot />
      ) : (
        <main id="content" class="site-main">
          <div class="page-content">
            <slot />
          </div>
        </main>
      )
    }
    <ElementorFooter lang={lang} />
    <LicenceStrip />
    <ElementorPopups />
    <ElementorScripts />
      <script src="/js/menu-no-hash.js" defer></script>
  </body>
</html>
