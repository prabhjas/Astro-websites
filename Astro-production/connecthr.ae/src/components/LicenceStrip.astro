---
/**
 * Licence & verification band — sits directly under the Elementor footer.
 * White background with the Connect HR brand accent (#0abf94) on #0b1b3a,
 * so it reads as a clean closing band rather than a bolted-on section.
 *
 * Facts come from src/data/licence.json via ../lib/licence. The band renders
 * nothing until that licence is complete, so an unfinished record can never
 * publish a half-empty compliance panel.
 */
import { licence, licenceRows, hasLicencePdf, isLicenceComplete } from "../lib/licence";

const show = isLicenceComplete();
const pdfReady = hasLicencePdf();
---

{
  show && (
    <section class="chr-licence" aria-labelledby="chr-licence-title">
      <div class="chr-licence__inner">
        <div class="chr-licence__details">
          <h2 class="chr-licence__title" id="chr-licence-title">
            License Details
          </h2>
          <p class="chr-licence__lead">
            {licence.businessName} is fully licensed in Dubai, UAE by the {licence.issuingAuthority}.
          </p>

          <dl class="chr-licence__grid">
            {licenceRows.map((row) => (
              <div class="chr-licence__row">
                <dt>{row.label}</dt>
                <dd>
                  {row.label === "License Status" ? (
                    <span class="chr-licence__badge">{row.value}</span>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))}
          </dl>

          <div class="chr-licence__actions">
            <a
              class="chr-licence__btn chr-licence__btn--primary"
              href={licence.verifyUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
            >
              Verify our license
              <span aria-hidden="true">↗</span>
            </a>
            {pdfReady && (
              <a
                class="chr-licence__btn chr-licence__btn--ghost"
                href={licence.pdfPath}
                target="_blank"
                rel="noopener noreferrer"
              >
                Click here to view the license
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>

        <div class="chr-licence__verify">
          <a
            class="chr-licence__qr"
            href={licence.verifyUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            aria-label={`Verify licence ${licence.number} on the official Dubai licence portal`}
          >
            <img
              src={licence.qrPath}
              width="150"
              height="150"
              loading="lazy"
              decoding="async"
              alt={`QR code linking to the official Dubai portal for verifying licence ${licence.number}`}
            />
          </a>
          <p class="chr-licence__qr-caption">
            Scan to verify on the<br />official Dubai licence portal
          </p>
        </div>
      </div>
    </section>
  )
}

<style>
  .chr-licence {
    background: #fff;
    border-top: 1px solid #e3e8f0;
    color: #0b1b3a;
    padding: 40px 16px 44px;
  }

  .chr-licence__inner {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px 48px;
  }

  .chr-licence__details { flex: 1 1 460px; min-width: 0; }

  .chr-licence__title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #0b1b3a;
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .chr-licence__title::after {
    content: "";
    display: block;
    width: 46px;
    height: 3px;
    margin-top: 8px;
    background: #0abf94;
    border-radius: 2px;
  }

  .chr-licence__lead {
    margin: 14px 0 20px;
    font-size: 14px;
    line-height: 1.65;
    color: #5b6b86;
    max-width: 56ch;
  }

  .chr-licence__grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 32px;
  }

  .chr-licence__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e3e8f0;
  }

  .chr-licence__row dt {
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #5b6b86;
    margin: 0;
    font-weight: 600;
  }

  .chr-licence__row dd {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #0b1b3a;
    text-align: right;
  }

  .chr-licence__badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: #e6f8f3;
    border: 1px solid #0abf94;
    color: #067462;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .chr-licence__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .chr-licence__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }

  /*
   * These buttons are <a>, so the mirrored Elementor kit's global link colour
   * applies to them and can out-specify a single class. Every colour rule below
   * is scoped under `.chr-licence` to reach (0,2,0) so the intended colour wins
   * without !important. BTNBG is chosen for >=4.5:1 contrast on white text.
   */
  .chr-licence .chr-licence__btn--primary {
    background: #0045dc;
    color: #fff;
    border: 1px solid #0045dc;
  }

  .chr-licence .chr-licence__btn--primary:hover,
  .chr-licence .chr-licence__btn--primary:focus-visible {
    background: #0b1b3a;
    border-color: #0b1b3a;
    color: #fff;
  }

  .chr-licence .chr-licence__btn--ghost {
    background: transparent;
    color: #067462;
    border: 1px solid #0abf94;
  }

  .chr-licence .chr-licence__btn--ghost:hover,
  .chr-licence .chr-licence__btn--ghost:focus-visible {
    background: #e6f8f3;
    border-color: #0b1b3a;
    color: #0b1b3a;
  }

  .chr-licence__verify { flex: 0 0 auto; text-align: center; margin-inline: auto; }

  .chr-licence__qr {
    display: inline-block;
    padding: 12px;
    background: #fff;
    border-radius: 10px;
    line-height: 0;
    border: 3px solid #0abf94;
  }

  .chr-licence__qr img { width: 150px; height: 150px; display: block; }

  .chr-licence__qr-caption {
    margin: 12px 0 0;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #5b6b86;
  }

  @media (max-width: 767px) {
    .chr-licence { padding: 30px 14px 36px; }
    .chr-licence__grid { grid-template-columns: minmax(0, 1fr); }
    .chr-licence__inner { gap: 26px; }
    .chr-licence__btn { flex: 1 1 100%; justify-content: center; }
  }
</style>
