---
import { resolveSeo, organizationSchema, type SeoInput } from "../lib/seo";
import { resolveHreflangAlternates } from "../lib/hreflang";
import { site, type SeoData } from "../lib/content";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
  /** Load extraCss non-render-blocking (only when complete critical CSS is inlined). */
  asyncCss?: boolean;
  /** LCP preload link descriptors for this route (from cwv-manifest). */
  heroPreloads?: Array<Record<string, string>>;
  currentPath?: string;
}

const {
  seo = {},
  fallback,
  extraCss = [],
  asyncCss = false,
  heroPreloads = [],
  currentPath = "/",
} = Astro.props;
const meta = resolveSeo(seo, fallback);
const hreflangAlternates = resolveHreflangAlternates(currentPath);
const ogLocale = currentPath.startsWith("/ar/") || currentPath === "/ar" ? "ar_AE" : "en_US";

const schemas = [organizationSchema(), ...meta.schemas];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{
  /* Above-the-fold brand font (self-hosted) — preload on routes with inlined critical
     CSS so the hero heading paints in the correct face immediately (LCP) without a
     font-swap shift (CLS). */
  asyncCss && (
    <>
      <link rel="preload" as="font" type="font/woff2" href="/wp-content/uploads/2025/07/GeneralSans-Bold.woff2" crossorigin />
      <link rel="preload" as="font" type="font/woff2" href="/wp-content/uploads/2025/07/GeneralSans-Semibold.woff2" crossorigin />
      <link rel="preload" as="font" type="font/woff2" href="/wp-content/uploads/2025/07/GeneralSans-Medium.woff2" crossorigin />
      <link rel="preload" as="font" type="font/woff2" href="/wp-content/uploads/2025/07/GeneralSans-Regular.woff2" crossorigin />
    </>
  )
}
{
  /* Route LCP preloads (hero image/video poster) from cwv-manifest — discovered
     late otherwise (CSS backgrounds / JS-driven video), so hint them high-priority. */
  heroPreloads.map((p) => <link rel="preload" {...p} />)
}
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<meta name="robots" content={meta.robots} />
<link rel="canonical" href={meta.canonical} />

{
  hreflangAlternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}

<meta property="og:locale" content={ogLocale} />
<meta property="og:type" content={meta.ogType} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:site_name" content={meta.siteName} />
<meta property="og:image" content={meta.ogImage} />
<meta property="og:image:secure_url" content={meta.ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={meta.title} />

{meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}
{meta.modifiedTime && <meta property="article:modified_time" content={meta.modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.ogImage} />

<link rel="icon" href={site.favicon} sizes="32x32" />
<link rel="apple-touch-icon" href={site.favicon} />

{
  asyncCss ? (
    <>
      {/*
        Per-viewport CSS delivery. The inlined critical CSS is generated for the
        MOBILE above-the-fold, so:
        - Mobile: load the full CSS non-blocking (media="print" → all onload). Fast
          FCP; the inline critical covers the mobile fold → no shift.
        - Desktop (≥1025px): a second <link> with media="(min-width:1025px)" is
          render-blocking on desktop (mobile critical doesn't cover the desktop fold,
          so we must have the full CSS before paint to avoid CLS). Desktop is fast
          enough to render-block. Same URL → served from cache, no double download.
        - <noscript>: plain blocking links when JS is off.
      */}
      {extraCss.map((href) => (
        <link
          rel="stylesheet"
          href={href}
          media="print"
          onload="this.media='all';this.onload=null;"
        />
      ))}
      {extraCss.map((href) => (
        <link rel="stylesheet" href={href} media="(min-width: 1025px)" />
      ))}
      <noscript set:html={extraCss.map((h) => `<link rel="stylesheet" href="${h}">`).join("")} />
    </>
  ) : (
    extraCss.map((href) => <link rel="stylesheet" href={href} />)
  )
}

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
