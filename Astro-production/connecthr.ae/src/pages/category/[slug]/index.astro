---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Pagination from "../../../components/Pagination.astro";
import {
  getCategoryBySlug,
  getPostsByCategory,
  paginate,
  POSTS_PER_PAGE,
  stripHtml,
} from "../../../lib/content";
import { renderArchiveShell } from "../../../lib/blog-shell";
import archiveCss from "../../../data/archive-css.json";
import { breadcrumbSchema } from "../../../lib/seo";
import { notFoundResponse } from "../../../lib/not-found";

export const prerender = false;

const slug = String(Astro.params.slug || "");
const category = getCategoryBySlug(slug);
if (!category) {
  return notFoundResponse();
}
const sorted = getPostsByCategory(category.id);
const { items, page, totalPages } = paginate(sorted, 1, POSTS_PER_PAGE);
const archiveHtml = renderArchiveShell({
  title: stripHtml(category.name),
  posts: items,
  categoryName: stripHtml(category.name),
});
---

<BaseLayout
  currentPath={category.path}
  bodyClass={`archive category category-${category.id} elementor-page elementor-page-2953`}
  extraCss={archiveCss as string[]}
  seo={{
    title: `${stripHtml(category.name)} Archives | Connect HR`,
    description: category.description || `Articles in ${category.name} from Connect HR.`,
    canonical: category.path,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blogs/" },
        { name: category.name, url: category.path },
      ]),
    ],
  }}
  menuActivePath="/blogs/"
>
  <div class="sp-page-content sp-archive" set:html={archiveHtml} />
  {
    totalPages > 1 && (
      <div class="sp-container" style="padding: 0 0 3rem">
        <Pagination page={page} totalPages={totalPages} basePath={category.path} />
      </div>
    )
  }
</BaseLayout>
