---
/**
 * Custom 404 for unknown / unprepared URLs.
 * Must return HTTP 404 (not 503) so crawlers drop dead links.
 */
export const prerender = false;

Astro.response.status = 404;
Astro.response.statusText = "Not Found";
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | Connect HR</title>
    <meta
      name="description"
      content="The page you requested could not be found on Connect HR."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/wp-content/uploads/2025/10/connect-hr.png" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=General+Sans:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="/runtime-gtm-v2.js" defer data-runtime-gtm="1"></script>
    <style>
      :root {
        --chr-ink: #101419;
        --chr-teal: #009a79;
        --chr-mist: #f5f7f7;
        --chr-line: #e7e6e7;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: "General Sans", "Segoe UI", sans-serif;
        color: var(--chr-ink);
        background:
          radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0, 154, 121, 0.12), transparent),
          linear-gradient(180deg, #ffffff 0%, var(--chr-mist) 100%);
      }
      .wrap {
        width: min(40rem, calc(100% - 2.5rem));
        margin: 0 auto;
        padding: 3.5rem 0 4rem;
        text-align: center;
      }
      .logo {
        display: inline-block;
        margin-bottom: 2.5rem;
      }
      .logo img {
        display: block;
        width: min(180px, 50vw);
        height: auto;
      }
      .code {
        display: inline-block;
        margin: 0 0 0.75rem;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        background: #ebfef7;
        color: var(--chr-teal);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
      }
      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        font-weight: 700;
      }
      p {
        margin: 0 0 1.75rem;
        color: #5b5b5b;
        line-height: 1.55;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
      }
      .actions a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: 0 1.25rem;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
      }
      .primary {
        background: var(--chr-teal);
        color: #fff;
      }
      .secondary {
        background: #fff;
        color: var(--chr-ink);
        border: 1px solid var(--chr-line);
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <a class="logo" href="/">
        <img src="/wp-content/uploads/2025/07/Logo.svg" width="180" height="40" alt="Connect HR" />
      </a>
      <div class="code">404</div>
      <h1>Page not found</h1>
      <p>
        The page you are looking for may have been moved, renamed, or no longer exists. Try one of
        the links below.
      </p>
      <div class="actions">
        <a class="primary" href="/">Go to homepage</a>
        <a class="secondary" href="/blogs/">Browse blog</a>
        <a class="secondary" href="/contact/">Contact us</a>
      </div>
    </main>
  </body>
</html>
