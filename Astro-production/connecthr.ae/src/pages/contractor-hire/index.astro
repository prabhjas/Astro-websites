      <div class="wrap">
        <div class="sec-head">
          <h2>How Connect Group's Contractor Hire service works</h2>
          <p>Everything between your first conversation and their first day, managed by Connect Group.</p>
        </div>
        <div class="steps">
          {steps.map((s) => (
            <div class="step">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- INDUSTRIES -->
    <section class="block industries">
      <div class="wrap">
        <div class="industries-card">
          <h2>Industries and roles we place contractors in the UAE</h2>
