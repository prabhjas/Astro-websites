    </section>

    <!-- PRICING -->
    <section class="block pricing">
      <div class="wrap">
        <div>
          <p class="eyebrow">Pricing</p>
          <h2>Every engagement is priced around your brief. Not a rate card.</h2>
          <p>Contractor hire in the UAE depends on the role, the duration and whether we are sourcing the person or you already have them in mind. Connect Group builds the full cost of engagement for your specific situation and confirms it in writing before anything moves.</p>
          <p class="fine">No surprises, no hidden fees, nothing marked up without your sign-off.</p>
          <a href="#contact" class="btn btn-light">Get Your Custom Quote</a>
        </div>
        <div class="pricing-art">
          <img src={`${img}/value-crystal.png`} alt="" aria-hidden="true" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="block faq" id="faq">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Frequently Asked Questions</p>
          <h2>What companies ask before they engage their first UAE specialist</h2>
        </div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item" open={f.open}>
              <summary>
                {f.q}
                <svg class="chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="block final-cta">
      <div class="wrap">
