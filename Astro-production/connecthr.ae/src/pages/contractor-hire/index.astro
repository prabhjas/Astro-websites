---
/**
 * /contractor-hire/ — static landing page built from the Figma design
 * "CG v3.0 Website Design → Contractor Hire" (node 5476:6588).
 * Self-contained (own <html>/styles/assets), independent of the Elementor mirror.
 * Assets committed under /public/contractor-hire/img/. SEO from the design content.
 */
export const prerender = true;

const img = "/contractor-hire/img";

const stats = [
  { big: "MoHRE", small: "Licensed and accredited" },
  { big: "10+", small: "Industries we place contractors in" },
  { big: "Zero", small: "Entity needed to hire through us" },
  { big: "5 days", small: "Average contractor onboarding time" },
];

const brands = [
  { src: `${img}/logo-connect.svg`, alt: "Connect Resources" },
  { src: `${img}/logo-kinza.svg`, alt: "Kinza HR" },
  { src: `${img}/logo-connectstaff.svg`, alt: "Connect Staff" },
  { src: `${img}/logo-crsaudi.svg`, alt: "Connect Resources Saudi" },
];

const risks = [
  {
    title: "Misclassification fines",
    body: "MOHRE tests four things: control over hours, integration into your team, economic dependence on you alone, and whether the contractor holds their own valid permit. Fail one and the relationship becomes employment, with fines from AED 100,000 to AED 1,000,000 and full back-payment of gratuity, leave and benefits from day one.",
  },
  {
    title: "Foreign payments, MOHRE will find it",
    body: "Many international companies pay contractors in Dubai through overseas transfers without a UAE employment contract. While it may seem convenient, it can create a serious compliance risk. If MOHRE determines the individual is working without the proper employment status, your business could face fines and compliance issues.",
  },
  {
    title: "No legal way to pay them in the UAE",
    body: "Companies without a UAE entity or trade licence have no framework to pay a contractor compliantly. No WPS registration, no local banking structure, no MOHRE-recognised payment channel. The engagement is effectively illegal from the first invoice.",
  },
];

const audience = [
  "Scaling teams that need expertise without expanding headcount",
  "Project-driven businesses with a scope, a budget and an end date",
  "International companies in the UAE with no entity and no way to pay",
  "Businesses bridging a gap until the right permanent hire is in place",
  "Companies that found the right person but not the right legal structure",
];

const steps = [
  { t: "Define the role and scope", d: "We start with your deliverables, timeline, and budget. That is all we need to get started." },
  { t: "Source and shortlist verified contractors", d: "From there, we identify talent with the right skills and valid UAE permits. Shortlist with you in 48 to 72 hours." },
  { t: "Vet, background check, and confirm permit status", d: "Every contractor is verified for permit, licence, and visa status before they are presented. No permit, no shortlist." },
  { t: "Draft a MOHRE-compliant service agreement", d: "Once you confirm your choice, we draft an MOHRE-compliant service agreement and set up the payment channel. No entity on your side is required." },
  { t: "Onboard, pay, and manage invoices", d: "We set up the payment structure so professionals are paid correctly through a compliant UAE channel." },
  { t: "Monitor compliance throughout the engagement", d: "Permit renewals, contract updates and compliance checks are tracked continuously so nothing lapses mid-project." },
];

const industries = [
  "Technology", "Finance and Accounting", "Engineering", "Marketing and Digital",
  "Legal and Compliance", "HR and Talent", "Healthcare", "Operations",
  "Creative and Design", "Project Management",
];

const testimonials = [
  {
    quote: "We had the right engineer lined up but no UAE entity to pay them. Connect Group had a compliant contract and payment channel running in under a week.",
    name: "Operations Director",
    role: "European engineering firm",
  },
  {
    quote: "They handled the MOHRE side entirely. We briefed the role, approved the shortlist, and the contractor started — no risk sitting on our books.",
    name: "Head of Delivery",
    role: "Technology consultancy",
  },
  {
    quote: "Three separate project hires, three different situations. Every one of them was structured, paid and kept compliant without us lifting a finger.",
    name: "Managing Partner",
    role: "Professional services group",
  },
];

const faqs = [
  {
    q: "We have no UAE entity. Can we still engage a specialist through Connect Group?",
    a: "Yes. This is the most common reason companies come to us. Connect Group acts as the employer of record in the UAE, manages the engagement structure and handles payments through a compliant local channel. You direct the work, we carry the legal and compliance layer. No UAE trade licence, visa quota or MOHRE registration required on your side.",
    open: true,
  },
  {
    q: "How are payments handled if we have no local banking or UAE structure?",
    a: "We pay the contractor through our own MOHRE-recognised, WPS-registered payment channel and invoice you directly. You never need a UAE bank account, a local entity or a WPS setup of your own — the compliant payment structure sits entirely on our side.",
    open: false,
  },
  {
    q: "How quickly can Connect Group source and onboard a specialist for a live project?",
    a: "When you already have the person in mind, a compliant contract and payment channel can be live in a matter of days. When we are sourcing, we typically shortlist verified, permit-ready contractors within 48 to 72 hours and onboard in around five days.",
    open: false,
  },
  {
    q: "Does Emiratisation apply to specialists engaged through Connect Group?",
    a: "Emiratisation obligations attach to the employing entity. Because the specialist is engaged through Connect Group's structure rather than added to your own headcount, the associated obligations are managed on our side — we confirm exactly how this applies to your situation in writing before anything starts.",
    open: false,
  },
  {
    q: "We are based in the UAE but do not want to manage the contractor hiring process ourselves. Can Connect Group handle it for us?",
    a: "Absolutely. Even with your own entity, you can hand the entire engagement to us — sourcing, vetting, the MOHRE-compliant agreement, payments and ongoing compliance monitoring — so your team stays focused on the work while we carry the administrative and legal load.",
    open: false,
  },
];

const footerBrands = ["Connect Resources", "C-UAE", "Connect Freelance", "Connect HR", "Saudi Company Formation"];

const pageTitle = "Contractor Hire UAE — Specialist Talent. On Your Terms. | Connect Group";
const pageDesc = "You have a project. You have the right person. Connect Group gives you a compliant way to engage specialist contractors in the UAE — no entity, no MOHRE registration, no misclassification risk.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href="https://connecthr.ae/contractor-hire/" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --slate-base: #4051b5;
        --slate-dark: #2e3a8c;
        --slate-mid: #7a87da;
        --slate-light: #d4d7f9;
        --slate-bg: #eef0fe;
        --teal-base: #007c91;
        --teal-mid: #4fb7c2;
        --teal-light: #c7ecef;
        --gold-mid: #ffd88a;
        --gold-light: #fff3dd;
        --white: #ffffff;
        --cool-white: #fafafa;
        --charcoal: #1a1a1a;
        --soft-black: #121212;
        --silver: #767676;
        --warm-gray: #d1d1d1;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: "Plus Jakarta Sans", system-ui, sans-serif;
        color: var(--charcoal);
        background: var(--white);
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }
      img { max-width: 100%; display: block; }
      a { color: inherit; text-decoration: none; }
      .wrap { max-width: 1300px; margin: 0 auto; padding: 0 40px; }
      .eyebrow {
        font-size: 13px; font-weight: 600; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--slate-base); margin: 0 0 14px;
      }
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 16px; border-radius: 10px;
        padding: 14px 26px; border: 1.5px solid transparent; cursor: pointer;
        transition: transform .15s ease, opacity .15s ease; line-height: 1;
      }
      .btn:hover { transform: translateY(-2px); }
      .btn-light { background: var(--white); color: var(--soft-black); }
      .btn-outline { background: transparent; color: var(--white); border-color: rgba(255,255,255,.55); }
      .btn-navy { background: var(--slate-base); color: var(--white); }
      h1, h2, h3 { margin: 0; letter-spacing: -0.02em; font-weight: 600; }

      /* ---------------- NAV ---------------- */
      .nav {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between;
        max-width: 1300px; margin: 0 auto; padding: 22px 40px;
      }
      .nav.scrolled { background: rgba(26,26,46,.9); backdrop-filter: blur(10px); border-radius: 0 0 16px 16px; }
      .nav-shell { position: absolute; top: 0; left: 0; right: 0; z-index: 50; }
      .logo { color: var(--white); font-weight: 700; font-size: 26px; letter-spacing: -0.03em; display: inline-flex; align-items: baseline; gap: 6px; }
      .logo sup { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; opacity: .85; }
      .nav-menu { display: flex; gap: 34px; align-items: center; }
      .nav-menu a { color: rgba(255,255,255,.92); font-size: 15px; font-weight: 500; }
      .nav-menu a:hover { color: var(--white); }
      .nav-cta { background: var(--white); color: var(--soft-black); padding: 11px 22px; border-radius: 10px; font-weight: 700; font-size: 15px; }

      /* ---------------- HERO ---------------- */
      .hero {
        position: relative; color: var(--white); overflow: hidden;
        background:
          radial-gradient(60% 80% at 78% 40%, rgba(122,79,214,.55), transparent 60%),
          radial-gradient(50% 60% at 8% 90%, rgba(193,70,46,.25), transparent 60%),
          linear-gradient(135deg, #191c47 0%, #2a2b6e 45%, #3a2c72 100%);
      }
      .hero::after {
        content: ""; position: absolute; inset: 0;
        background-image: url("/contractor-hire/img/hero-photo.jpg");
        background-size: cover; background-position: center; opacity: .35; mix-blend-mode: screen;
        pointer-events: none;
      }
      .hero-inner { position: relative; z-index: 2; }
      .hero-top { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; padding: 40px 0 20px; gap: 20px; }
      .hero-copy { max-width: 640px; }
      .hero h1 { font-size: 64px; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 22px; }
      .hero h1 .gold { color: var(--gold-mid); display: block; }
      .hero h1 .white { color: var(--white); display: block; }
      .hero p.lead { font-size: 18px; line-height: 1.6; color: rgba(255,255,255,.86); max-width: 560px; margin: 0 0 30px; }
      .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; }
      .hero-3d { position: relative; }
      .hero-3d img { width: 100%; max-width: 520px; margin-left: auto; filter: drop-shadow(0 30px 60px rgba(80,40,160,.5)); }

      /* brands */
      .brands { position: relative; z-index: 2; text-align: center; padding: 30px 0 20px; }
      .brands h2 { font-size: 26px; font-weight: 600; margin: 0 0 8px; }
      .brands p { color: rgba(255,255,255,.72); font-size: 15px; margin: 0 auto 26px; max-width: 760px; }
      .brand-row { display: flex; align-items: center; justify-content: center; gap: 60px; flex-wrap: wrap; }
      .brand-row img { height: 40px; width: auto; object-fit: contain; filter: brightness(0) invert(1); opacity: .9; }

      /* stats */
      .stats { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding: 30px 0 70px; }
      .stat { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); border-radius: 16px; padding: 26px 30px; }
      .stat .big { font-size: 34px; font-weight: 600; letter-spacing: -0.02em; }
      .stat .small { font-size: 14px; color: rgba(255,255,255,.78); margin-top: 8px; line-height: 1.45; }

      /* ---------------- SECTION SHELL ---------------- */
      section.block { padding: 90px 0; }
      .sec-head h2 { font-size: 40px; line-height: 1.2; letter-spacing: -0.03em; }
      .lead-muted { color: var(--silver); font-size: 18px; line-height: 1.6; }

      /* RISK */
      .risk { display: grid; grid-template-columns: 1fr 1.15fr; gap: 60px; align-items: start; }
      .risk-left h2 { font-size: 40px; line-height: 1.18; max-width: 460px; }
      .risk-left p { margin-top: 22px; color: var(--silver); font-size: 18px; line-height: 1.6; max-width: 460px; }
      .risk-cards { display: flex; flex-direction: column; gap: 16px; }
      .risk-card { background: var(--cool-white); border: 1px solid #ececf3; border-radius: 16px; padding: 26px 28px; }
      .risk-card h3 { font-size: 22px; font-weight: 600; margin-bottom: 10px; }
      .risk-card p { color: var(--silver); font-size: 15px; line-height: 1.6; margin: 0; }

      /* CTA V1 */
      .cta-v1 {
        position: relative; color: var(--white); text-align: center; overflow: hidden;
        background: linear-gradient(120deg, #2a2b7a 0%, #4b2f97 50%, #6a3aa8 100%);
      }
      .cta-v1::after { content: ""; position: absolute; inset: 0; background-image: url("/contractor-hire/img/cta-holographic.png"); background-size: cover; background-position: center; opacity: .45; mix-blend-mode: screen; }
      .cta-v1 .wrap { position: relative; z-index: 2; max-width: 900px; }
      .cta-v1 h2 { font-size: 44px; line-height: 1.22; letter-spacing: -0.02em; }
      .cta-v1 h2 .gold { color: var(--gold-mid); }
      .cta-v1 p { color: rgba(255,255,255,.85); font-size: 18px; line-height: 1.6; margin: 22px auto 34px; max-width: 720px; }

      /* WHO */
      .who { display: grid; grid-template-columns: 0.85fr 1.1fr; gap: 70px; align-items: center; }
      .who-img { border-radius: 24px; overflow: hidden; aspect-ratio: 1/1; }
      .who-img img { width: 100%; height: 100%; object-fit: cover; }
      .who h2 { font-size: 38px; line-height: 1.2; margin-bottom: 16px; }
      .who > div > p { color: var(--silver); font-size: 18px; line-height: 1.6; margin: 0 0 26px; }
      .checklist { display: flex; flex-direction: column; gap: 16px; }
      .checklist li { display: flex; gap: 14px; align-items: flex-start; list-style: none; font-size: 17px; }
      .checklist { padding: 0; margin: 0; }
      .checklist img { width: 23px; height: 23px; margin-top: 2px; flex: none; }

      /* PROCESS */
      .process { background: var(--cool-white); }
      .process .sec-head { max-width: 900px; margin-bottom: 44px; }
      .process .sec-head p { color: var(--silver); font-size: 18px; margin-top: 12px; }
      .steps { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .step { background: var(--white); border: 1px solid #ececf3; border-radius: 16px; padding: 30px 34px; }
      .step h3 { font-size: 22px; font-weight: 600; margin-bottom: 10px; }
      .step p { color: var(--silver); font-size: 15px; line-height: 1.6; margin: 0; }

      /* INDUSTRIES */
      .industries { background: var(--slate-light); }
      .industries-card { background: var(--white); border-radius: 28px; padding: 64px 40px; text-align: center; }
      .industries-card h2 { font-size: 40px; line-height: 1.2; max-width: 700px; margin: 0 auto 34px; }
      .tags { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; max-width: 1000px; margin: 0 auto; }
      .tag { background: var(--slate-bg); color: var(--slate-dark); font-size: 16px; font-weight: 500; padding: 12px 22px; border-radius: 999px; }

      /* TESTIMONIALS */
      .testi .sec-head { text-align: center; max-width: 780px; margin: 0 auto 48px; }
      .testi .sec-head h2 { font-size: 40px; line-height: 1.2; }
      .testi .sec-head p { color: var(--silver); font-size: 18px; margin-top: 14px; }
      .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
      .testi-card { background: var(--cool-white); border: 1px solid #ececf3; border-radius: 16px; padding: 30px; display: flex; flex-direction: column; }
      .testi-card .qmark { width: 26px; height: 24px; margin-bottom: 20px; }
      .testi-card blockquote { margin: 0; font-size: 17px; line-height: 1.55; color: var(--charcoal); flex: 1; }
      .testi-card .who-name { margin-top: 24px; }
      .testi-card .who-name strong { display: block; font-size: 16px; }
      .testi-card .who-name span { color: var(--silver); font-size: 14px; }

      /* PRICING */
      .pricing { position: relative; color: var(--white); overflow: hidden; background: linear-gradient(120deg, #191c47 0%, #2a2b6e 60%, #3a2c72 100%); }
      .pricing .wrap { position: relative; z-index: 2; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center; }
      .pricing .eyebrow { color: var(--slate-light); }
      .pricing h2 { font-size: 40px; line-height: 1.22; max-width: 560px; }
      .pricing p { color: rgba(255,255,255,.82); font-size: 17px; line-height: 1.6; margin: 22px 0; max-width: 560px; }
      .pricing .fine { color: rgba(255,255,255,.7); font-size: 15px; margin-bottom: 30px; }
      .pricing-art img { margin-left: auto; max-width: 460px; filter: drop-shadow(0 30px 70px rgba(60,30,140,.6)); }

      /* FAQ */
      .faq .sec-head { margin-bottom: 30px; }
      .faq .sec-head h2 { font-size: 40px; line-height: 1.2; max-width: 780px; }
      .faq-list { border-top: 1px solid #e5e5ee; }
      details.faq-item { border-bottom: 1px solid #e5e5ee; padding: 26px 0; }
      details.faq-item summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; cursor: pointer; list-style: none; font-size: 19px; font-weight: 600; color: var(--charcoal); }
      details.faq-item summary::-webkit-details-marker { display: none; }
      details.faq-item .chev { flex: none; width: 22px; height: 22px; color: var(--teal-base); transition: transform .2s ease; }
      details.faq-item[open] .chev { transform: rotate(180deg); }
      details.faq-item p { color: var(--silver); font-size: 16px; line-height: 1.65; margin: 16px 0 0; max-width: 1150px; }

      /* FINAL CTA */
      .final-cta { text-align: center; position: relative; overflow: hidden; background: var(--cool-white); }
      .final-cta h2 { font-size: 52px; line-height: 1.12; letter-spacing: -0.03em; }
      .final-cta p { color: var(--silver); font-size: 18px; margin: 20px auto 32px; max-width: 620px; }

      /* FOOTER */
      .footer { position: relative; color: var(--white); overflow: hidden; background: linear-gradient(160deg, #0e0f1f 0%, #15173a 55%, #0c2b3a 100%); }
      .footer::after { content: ""; position: absolute; right: -60px; bottom: -80px; width: 620px; height: 620px; background: radial-gradient(circle at 60% 60%, rgba(90,80,230,.5), transparent 62%); pointer-events: none; }
      .footer .wrap { position: relative; z-index: 2; padding-top: 90px; padding-bottom: 40px; }
      .footer h2 { font-size: 34px; font-weight: 600; }
      .footer .sub { color: rgba(255,255,255,.72); margin: 12px 0 34px; font-size: 16px; }
      .form { max-width: 780px; }
      .form label { display: block; font-size: 15px; margin: 0 0 8px; color: rgba(255,255,255,.9); }
      .form .field { margin-bottom: 22px; }
      .form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
      .form input, .form textarea { width: 100%; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.16); border-radius: 10px; padding: 14px 16px; color: var(--white); font-family: inherit; font-size: 15px; }
      .form textarea { min-height: 96px; resize: vertical; }
      .form input::placeholder, .form textarea::placeholder { color: rgba(255,255,255,.4); }
      .footer-meta { margin-top: 70px; }
      .footer-logo { color: var(--white); font-weight: 700; font-size: 28px; letter-spacing: -0.03em; }
      .footer-logo sup { font-size: 11px; font-weight: 600; letter-spacing: .2em; opacity: .85; }
      .footer h4 { font-size: 14px; color: rgba(255,255,255,.6); font-weight: 500; margin: 34px 0 14px; }
      .footer-brands { display: flex; flex-wrap: wrap; gap: 12px; }
      .footer-brands span { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); border-radius: 8px; padding: 8px 14px; font-size: 14px; }
      .footer-links { display: flex; gap: 40px; margin: 30px 0 22px; font-size: 16px; }
      .socials { display: flex; gap: 14px; }
      .socials a { width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(255,255,255,.3); display: inline-flex; align-items: center; justify-content: center; }
      .socials img { width: 16px; height: 16px; filter: brightness(0) invert(1); }
      .copyright { color: rgba(255,255,255,.5); font-size: 14px; margin-top: 28px; }

      /* ---------------- RESPONSIVE ---------------- */
      @media (max-width: 960px) {
        .wrap, .nav { padding-left: 24px; padding-right: 24px; }
        .hero-top { grid-template-columns: 1fr; }
        .hero-3d { display: none; }
        .hero h1 { font-size: 44px; }
        .stats { grid-template-columns: repeat(2, 1fr); }
        .risk, .who, .steps, .pricing .wrap { grid-template-columns: 1fr; gap: 34px; }
        .testi-grid { grid-template-columns: 1fr; }
        .nav-menu { display: none; }
        section.block { padding: 60px 0; }
        .sec-head h2, .risk-left h2, .who h2, .industries-card h2, .testi .sec-head h2, .pricing h2, .faq .sec-head h2 { font-size: 30px; }
        .cta-v1 h2 { font-size: 30px; }
        .final-cta h2 { font-size: 36px; }
        .form .row { grid-template-columns: 1fr; }
        .brand-row { gap: 32px; }
        .pricing-art { display: none; }
      }
      @media (max-width: 560px) {
        .stats { grid-template-columns: 1fr; }
        .hero h1 { font-size: 36px; }
      }
    </style>
  </head>

  <body>
    <div class="hero">
      <!-- NAV -->
      <div class="nav-shell">
        <nav class="nav" id="nav">
          <a href="/" class="logo">connect<sup>GROUP</sup></a>
          <div class="nav-menu">
            <a href="#what">What We Do</a>
            <a href="#brands">Our Brands</a>
            <a href="#faq">Resources</a>
            <a href="/about-us/">About Us</a>
          </div>
          <a href="#contact" class="nav-cta">Let's Talk</a>
        </nav>
      </div>

      <!-- HERO -->
      <div class="hero-inner wrap">
        <div class="hero-top">
          <div class="hero-copy">
            <p class="eyebrow" style="color: var(--slate-light)">Contractor Hire UAE</p>
            <h1>
              <span class="gold">Specialist talent.</span>
              <span class="white">On your terms.</span>
            </h1>
            <p class="lead">
              You have a project. You have the right person. The only thing standing between you and
              getting started is a compliant way to engage them in the UAE. That is exactly what
              Connect Group provides.
            </p>
            <div class="hero-btns">
              <a href="#contact" class="btn btn-light">Speak to a Specialist</a>
              <a href="#contact" class="btn btn-outline">Schedule a Meeting</a>
            </div>
          </div>
          <div class="hero-3d">
