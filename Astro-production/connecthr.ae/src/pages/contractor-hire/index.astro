    <!-- FOOTER -->
    <footer class="footer" id="contact">
      <div class="wrap">
        <h2>Start Your Journey With Us</h2>
        <p class="sub">Let us know what you're looking for, and we'll help you take the next step.</p>
        <form class="form" method="post" action="/api/contact/">
          <div class="field">
            <label for="fn">Full Name*</label>
            <input id="fn" name="name" required />
          </div>
          <div class="row">
            <div class="field">
              <label for="em">Email ID*</label>
              <input id="em" name="email" type="email" required />
            </div>
            <div class="field">
              <label for="ph">Contact Number</label>
              <input id="ph" name="phone" type="tel" />
            </div>
          </div>
          <div class="field">
            <label for="msg">Message (Optional)</label>
            <textarea id="msg" name="message" placeholder="Type your message..."></textarea>
          </div>
          <button type="submit" class="btn btn-light">Submit</button>
        </form>

        <div class="footer-meta">
          <div class="footer-logo">connect<sup>GROUP</sup></div>
          <h4>Meet Our Brands:</h4>
