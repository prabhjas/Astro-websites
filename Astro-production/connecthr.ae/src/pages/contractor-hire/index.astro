          <div class="footer-links">
            <a href="#faq">Resources</a>
            <a href="/about-us/">About Us</a>
          </div>
          <div class="socials">
            <a href="#" aria-label="Facebook"><img src={`${img}/social-facebook.svg`} alt="" /></a>
            <a href="#" aria-label="Instagram"><img src={`${img}/social-instagram.svg`} alt="" /></a>
            <a href="#" aria-label="LinkedIn"><img src={`${img}/social-linkedin.svg`} alt="" /></a>
          </div>
          <p class="copyright">© Connect Group 2026. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Sticky nav gets a solid bg once scrolled
      (function () {
        var nav = document.getElementById("nav");
        function onScroll() {
          if (window.scrollY > 40) nav.classList.add("scrolled");
          else nav.classList.remove("scrolled");
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
