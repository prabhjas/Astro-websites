---
import AuthorArchive from "../../../components/AuthorArchive.astro";
import { authors, getPostsByAuthor } from "../../../lib/content";
import type { AuthorEntry } from "../../../lib/content-types";

export function getStaticPaths() {
  const bySlug = new Map<string, AuthorEntry>();
  for (const author of authors) bySlug.set(author.slug, author);

  // Canonical internal author page matches live: /author/adm_connecthr/
  if (!bySlug.has("adm_connecthr") && authors[0]) {
    bySlug.set("adm_connecthr", {
      ...authors[0],
      slug: "adm_connecthr",
      path: "/author/adm_connecthr/",
    });
  }

  return [...bySlug.values()].map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

const { author } = Astro.props as { author: AuthorEntry };
const posts = getPostsByAuthor(author.id);
---

<AuthorArchive author={author} posts={posts} pageNum={1} />
