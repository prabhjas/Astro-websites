---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageByPath } from "../lib/content";
import { computeScriptNeeds } from "../lib/script-needs";
import { promoteHeroImages } from "../lib/promote-hero";
import cwvManifest from "../data/cwv-manifest.json";

export const prerender = false;

const page = getPageByPath("/");
if (!page) throw new Error("Home page missing from content data");

const heroHrefs = (
  (cwvManifest.routes as Record<string, { hero?: Array<{ as?: string; href?: string }> }>)["/"]
    ?.hero || []
)
  .filter((h) => (h.as ?? "image") === "image" && h.href)
  .map((h) => h.href as string);
const html = promoteHeroImages(String(page.bodyHtml || page.content || ""), heroHrefs);
const extraCss = [
  ...(page.pageCss || []),
  page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
];
const scriptNeeds = computeScriptNeeds(String(html || ""), true);
---

<BaseLayout
  currentPath="/"
  lang="en"
  bodyClass={`home page page-id-${page.id} elementor-page-${page.id}`}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title,
    description: page.seo.description,
    canonical: "/",
    ogImage: page.seo.ogImage,
    schemas: [...(page.seo.schemas || [])],
  }}
  scriptNeeds={scriptNeeds}
>
  <div class="sp-page-content" set:html={html} />
</BaseLayout>
