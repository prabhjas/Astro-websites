---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PostCard from "../components/PostCard.astro";
import {
  getCategories,
  getPageByPath,
  getPublishedPostByPath,
  getCaseStudyByPath,
  getRelatedPosts,
  formatDate,
  stripHtml,
  normalizePath,
} from "../lib/content";
import { articleSchema, breadcrumbSchema } from "../lib/seo";
import { notFoundResponse } from "../lib/not-found";

export const prerender = false;

const slugParam = Astro.params.slug;
const slugPath = Array.isArray(slugParam) ? slugParam.join("/") : String(slugParam || "");
const path = normalizePath(`/${slugPath}`);

const page = getPageByPath(path);
const caseStudy = page ? null : getCaseStudyByPath(path);
const post = page || caseStudy ? null : getPublishedPostByPath(path);

if (!page && !caseStudy && !post) {
  return notFoundResponse();
}

const entry = page || caseStudy || post!;
const lang: "en" | "ar" = path.startsWith("/ar/") || path === "/ar/" ? "ar" : "en";
const html = ("bodyHtml" in entry && entry.bodyHtml) || entry.content;
const catNames = post ? getCategories().filter((c) => post.categories.includes(c.id)) : [];

const homeCrumb = lang === "ar" ? { name: "الرئيسية", href: "/ar/" } : { name: "Home", href: "/" };

const pageCrumbs =
  page || caseStudy
    ? [homeCrumb, { name: stripHtml(entry.title), href: undefined as string | undefined }]
    : [];

const related = post ? getRelatedPosts(post, 3) : [];
const postCrumbs = post
  ? [homeCrumb, { name: "Blog", href: "/blogs/" }, { name: stripHtml(post.title) }]
  : [];

const seo =
  page || caseStudy
    ? {
        title: entry.seo.title,
        description: entry.seo.description,
        canonical: path,
        ogImage: entry.seo.ogImage,
        schemas: [
          ...(entry.seo.schemas || []),
          breadcrumbSchema(pageCrumbs.map((c) => ({ name: c.name, url: c.href || path }))),
        ],
      }
    : {
        title: post!.seo.title || stripHtml(post!.title),
        description: post!.seo.description || stripHtml(post!.excerpt),
        canonical: path,
        ogImage: post!.seo.ogImage || post!.featuredImage,
        ogType: "article" as const,
        publishedTime: post!.date,
        modifiedTime: post!.modified,
        authorName: post!.authorName,
        schemas: [
          ...(post!.seo.schemas || []),
          breadcrumbSchema(postCrumbs.map((c) => ({ name: c.name, url: c.href || path }))),
          articleSchema({
            title: stripHtml(post!.title),
            description: post!.seo.description || stripHtml(post!.excerpt),
            url: path,
            image: post!.featuredImage || post!.seo.ogImage,
            datePublished: post!.date,
            dateModified: post!.modified,
            authorName: post!.authorName,
          }),
        ],
      };

const extraCss = [
  ...((entry as { pageCss?: string[] }).pageCss || []),
  (entry as { elementorCss?: string }).elementorCss ||
    `/wp-content/uploads/elementor/css/post-${entry.id}.css`,
];

const bodyClass = page
  ? `page page-id-${page.id} elementor-page elementor-page-${page.id}`
  : caseStudy
    ? `case_studies single single-case_studies postid-${caseStudy.id} elementor-page elementor-page-${caseStudy.id}`
    : `single single-post postid-${post!.id} post post-id-${post!.id} elementor-page elementor-page-${post!.id}`;

// Posts render their Elementor body when they have one; otherwise the article template.
const postUsesElementor = !!post?.bodyHtml && /elementor-page|data-elementor-id/.test(post.bodyHtml);
---

<BaseLayout
  currentPath={path}
  lang={lang}
  bodyClass={bodyClass}
  fallback={entry.seo}
  extraCss={extraCss}
  seo={seo}
  menuActivePath={post ? "/blogs/" : undefined}
>
  {
    page || caseStudy ? (
      <div class="sp-page-content" set:html={html} />
    ) : postUsesElementor ? (
      <div class="sp-page-content" set:html={post!.bodyHtml} />
    ) : (
      <article class="sp-article sp-container">
        <header class="sp-article__header">
          <Breadcrumbs items={postCrumbs} />
          <h1 set:html={post!.title} />
          <div class="sp-article__meta">
            <time datetime={post!.date}>{formatDate(post!.date)}</time>
            {post!.authorName && (
              <>
                {" "}
                · <a href={`/author/${post!.authorSlug}/`}>{post!.authorName}</a>
              </>
            )}
            {catNames.length > 0 && (
              <>
                {" "}
                ·{" "}
                {catNames.map((c, i) => (
                  <>
                    {i > 0 ? ", " : ""}
                    <a href={c.path}>{c.name}</a>
                  </>
                ))}
              </>
            )}
          </div>
        </header>
        {post!.featuredImage && (
          <figure style="margin: 0 0 1.75rem">
            <img
              src={post!.featuredImage}
              alt={stripHtml(post!.title)}
              width="1200"
              height="675"
              loading="eager"
            />
          </figure>
        )}
        <div class="sp-article__content" set:html={html} />
        {related.length > 0 && (
          <section class="sp-related">
            <h2>Related Posts</h2>
            <div class="sp-blog-grid">
              {related.map((p) => (
                <PostCard post={p} />
              ))}
            </div>
          </section>
        )}
      </article>
    )
  }
</BaseLayout>
