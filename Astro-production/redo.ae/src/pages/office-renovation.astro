    </section>

    <!-- Section 4: Client stories — same structure as homepage -->
    <section class="or-quotes" id="clients">
      <div class="or-wrap">
        <h2>OUR CLIENT STORIES</h2>
        <p class="or-lead">
          From fresh designs to impressive results, our clients live the REDO magic every day.
        </p>
        <div class="or-quotes__slider">
          <button class="or-quotes__arrow" type="button" aria-label="Previous" data-or-quotes-prev>
            <svg aria-hidden="true" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z"
              ></path>
            </svg>
          </button>
          <div class="or-quotes__viewport">
            <div class="or-quotes__track" data-or-quotes-track>
              {
                quotes.map((item) => (
                  <article class="or-quote">
                    <div class="or-quote__text">
                      <img
                        class="or-quote__mark"
                        src="/wp-content/uploads/2023/12/quote-icon.png"
                        alt=""
                        width="104"
                        height="104"
                      />
                      <p>{item.text}</p>
                    </div>
                    <div class="or-quote__who">
                      <img src={item.photo} alt="" width="72" height="72" />
