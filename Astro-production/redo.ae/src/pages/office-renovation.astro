          height="650"
        />
      </div>
      <div class="or-split__copy">
        <h2>WHY CHOOSE REDO FOR YOUR OFFICE RENOVATION?</h2>
        <div class="or-why-grid">
          <article>
            <h3>
              <img class="or-check-img" src="/service/office-renovation/check-circle.svg" alt="" width="26" height="26" />
