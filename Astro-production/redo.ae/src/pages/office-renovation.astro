---
/**
 * Office renovation service page.
 * Design: Figma REDO Website By Alejandro, node 629:3333 (SERVICEPAGE DESKTOP V2).
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/lp-best-renovation/EstimateForm.astro';
import {
  getSharedChromeScriptsHtml,
  getSharedChromeStylesheetLinksHtml,
  getSharedFooterHtml,
  getSharedHeaderHtmlForSlug,
  injectLicenceSection,
} from '../lib/shared-chrome.js';

const headerHtml = getSharedHeaderHtmlForSlug('office-renovation');
const footerHtml = injectLicenceSection(getSharedFooterHtml() || '');
const chromeCssHtml = getSharedChromeStylesheetLinksHtml();
const chromeScriptsHtml = getSharedChromeScriptsHtml({
  postId: 0,
  title: 'Office Renovation Dubai | Workplace Fit-Out by REDO',
});

const partners = [
  { src: '/wp-content/uploads/2024/09/Bango-Design.png', alt: 'BAGNODESIGN' },
  { src: '/wp-content/uploads/2024/09/Dulux.png', alt: 'Dulux' },
  { src: '/wp-content/uploads/2024/09/Danube-Group.png', alt: 'Danube Group' },
  { src: '/wp-content/uploads/2024/09/Berger.png', alt: 'Berger' },
  { src: '/wp-content/uploads/2024/09/Caparol.png', alt: 'Caparol' },
  { src: '/wp-content/uploads/2024/09/Meraki.png', alt: 'Meraki Ceramics' },
  { src: '/wp-content/uploads/2024/09/ELBA.png', alt: 'ELBA' },
];

const projects = [
  {
    src: '/service/office-renovation/gallery-1.jpg',
    alt: 'Office workspace before renovation',
  },
  {
    src: '/service/office-renovation/gallery-2.jpg',
    alt: 'Modern reception with blue feature wall',
  },
  {
    src: '/service/office-renovation/gallery-3.png',
    alt: 'Collaborative meeting space with high tables',
  },
  {
    src: '/service/office-renovation/gallery-4.png',
    alt: 'Communal breakroom with wooden tables',
  },
];

const quotes = [
  {
    text: 'REDO is the most reliable renovation company we’ve ever worked with! My mom and I needed to make our home more accessible for her, and their expertise made it perfect. The bathroom, the stairs, even the hallways— all feel safer. My mom is more comfortable than ever, and our home feels completely transformed with just a few thoughtful changes!',
    name: '- Mark J',
    photo: '/wp-content/uploads/2024/09/1-2.png',
  },
  {
    text: 'I was looking for a renovation company near me and hit the jackpot with REDO! They’ve been amazing in helping me renovate my interiors and install a brand-new HVAC system. Their support was incredible, and now my home feels so much more comfortable and cozy. They truly are the best in the business!',
    name: '- David M',
    photo: '/wp-content/uploads/2024/01/testimonial-1.png',
  },
  {
    text: 'As a custom home renovation company, REDO exceeded all my expectations! I’ve lived in my house for a year, but my kitchen always felt off. Their team listened to my ideas, transformed the space, and gave me the kitchen of my dreams. I couldn’t be happier with how it turned out!',
    name: 'Lily R.',
    photo: '/wp-content/uploads/2024/01/testimonial-4.png',
  },
  {
    text: 'I was nervous about starting a bathroom renovation, but REDO made it so easy! They guided me through every step, from design to ensuring everything—plumbing, electrical—was done perfectly. My bathroom looks incredible now, and the whole process was way smoother than I ever expected!',
    name: '- Omar Farooq',
    photo: '/wp-content/uploads/2024/01/testimonial-3.png',
  },
];

const compareRows = [
  {
    cat: 'PRICE',
    yes: ['No hidden costs', 'Competitive Pricing, Lowest Price Guarantee for Branded Products'],
    no: ['20-40% Hike betweens first quote & final cost', 'Higher prices charged for branded products'],
  },
  {
    cat: 'CONVENIENCE',
    yes: ['One Stop Shop for all interior and Home Renovations needs'],
    no: ['Approx 15-20 market trips to the find everything'],
  },
  {
    cat: 'DESIGN',
    yes: ['Free Design Consultation', 'Personalised Design with 3D Visuals'],
    no: ['No Design or Cookie-cutter designs and 2D visuals', '3D Designs at extra cost'],
  },
  {
    cat: 'TIMELINES',
    yes: ['45 Days installations for kitchens, wardrobes and cabinets', 'Regular updates with Project tracking'],
    no: ['Unreliable timelines', 'No communication or Update delays'],
  },
  {
    cat: 'QUALITY',
    yes: ['Branded material primarily procured directly from manufacturers', 'Quality Checks'],
    no: ['Inferior material used to cut costs', 'No quality check', 'Out sourced to small contractors'],
  },
  {
    cat: 'WARRANTY',
    yes: [
      'Upto 10 year warranty on kitchens, Wardrobes and cabinets Works',
      'Warranty for painting Works provided by the Paint manufactured for large projects.',
    ],
    no: ['No warranty offered for products or services'],
  },
];
---

<BaseLayout
  showChrome={false}
  bodyClass="wp-singular page page-template-default page-id-office-renovation wp-embed-responsive wp-theme-hello-elementor wp-child-theme-hello-elementor-child-theme hello-elementor-default elementor-default elementor-kit-6 elementor-page"
  seo={{
    title: 'Office Renovation Dubai | Workplace Fit-Out by REDO',
    description:
      'Office renovation in Dubai by REDO: space planning, interior fit-out, furniture, and technology integration. Transparent pricing, licensed team, and a clear programme.',
    robots: 'index, follow',
    canonical: 'https://redo.ae/office-renovation/',
    og: {
      title: 'Office Renovation Dubai | Workplace Fit-Out by REDO',
      description:
        'Office renovation in Dubai by REDO: space planning, interior fit-out, furniture, and technology integration.',
      type: 'website',
      image: '/wp-content/uploads/2025/08/After-office-renovation-1.webp',
    },
  }}
>
  <Fragment slot="head">
    <Fragment set:html={chromeCssHtml} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/wp-content/plugins/country-phone-field-contact-form-7/assets/css/intlTelInput.min.css" />
    <link rel="stylesheet" href="/css/redo-licence.css" />
    <link
      rel="stylesheet"
      href="/wp-content/cache/min/1/wp-content/plugins/sticky-floating-forms-lite/assets/css/frontend.css"
    />
    <link rel="stylesheet" href="/wp-content/cache/min/1/wp-includes/css/dashicons.min.css" />
    <style>
      .cww-ssf-outer-wrapp .cww-ssf-toggle,
      .cww-ssf-outer-wrapp .cww-ssf-toggle:visited {
        background-color: #1f2125;
        border-color: #1f2125;
        color: #fff;
      }
      .cww-ssf-outer-wrapp .cww-ssf-toggle:hover {
        background-color: #e51515;
        border-color: #e51515;
      }
    </style>
    <link rel="stylesheet" href="/css/page-design/office-renovation.css" />
    <style>
      @font-face {
        font-family: 'SF Pro Display';
        font-style: normal;
        font-weight: normal;
        font-display: swap;
        src: url('/wp-content/uploads/2023/12/sf-pro-text-regular.woff') format('woff'),
          url('/wp-content/uploads/2023/12/SF-Pro-Display-Regular.ttf') format('truetype');
      }
    </style>
  </Fragment>

  {/* Shared Home/Apartment Elementor header (theme builder id 13) */}
  <Fragment set:html={headerHtml} />

  <div class="or-page">
    <!-- Section 1: Hero (Figma 629:3337) -->
