                    </div>
                  </article>
                ))
              }
            </div>
          </div>
          <button class="or-quotes__arrow" type="button" aria-label="Next" data-or-quotes-next>
            <svg aria-hidden="true" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Section 5: Gradient CTA + quote form (Figma 737:3573) -->
    <section class="or-cta" id="quote">
      <div class="or-wrap or-cta__inner">
        <div class="or-cta__copy">
          <h2>READY TO REIMAGINE YOUR WORKSPACE?</h2>
          <p>
            At <strong>REDO</strong>, your renovation cost is based on your space, the scope of work, and chosen
            materials—ensuring transparent and fair pricing. Unlike others, we never add hidden fees or unnecessary
            charges. Our goal is clear: to deliver accurate pricing from start to finish, with no surprises—just
            exceptional results.
          </p>
        </div>
        <div class="or-cta__form">
          <p class="or-cta__form-lead">
            <strong>Fill the form</strong> and find out how much would cost to renovate your Office.
          </p>
          <EstimateForm
            formId="or-mid-form"
            formName="Office renovation service — quote"
            theme="light"
            showMessage={true}
            messageLabel="Message (Optional)"
            messagePlaceholder=""
            showWhatsapp={false}
            buttonLabel="Get in Touch"
          />
        </div>
      </div>
    </section>

    <!-- Section 6: REDO vs typical comparison (Figma 703:3482) -->
    <section class="or-compare">
      <div class="or-wrap or-compare__wrap">
        <div class="or-table" role="table">
          <div class="or-table__head" role="row">
            <div class="or-table__logo" role="columnheader">
              <img src="/service/office-renovation/logo-redo-dark.svg" alt="REDO" width="148" height="40" />
            </div>
            <div role="columnheader">REDO Renovation Experience</div>
            <div role="columnheader">Typical Experience</div>
          </div>
          {
            compareRows.map((row) => (
              <div class="or-table__row" role="row">
                <div class="or-cat" role="cell">{row.cat}</div>
                <div class="or-yes" role="cell">
                  {row.yes.map((line) => (
                    <span class="or-flag">
                      <img src="/service/office-renovation/fe-check.svg" alt="" width="15" height="15" />
                      {line}
                    </span>
                  ))}
                </div>
                <div class="or-no" role="cell">
                  {row.no.map((line) => (
                    <span class="or-flag">
                      <img src="/service/office-renovation/fe-check.svg" alt="" width="15" height="15" />
                      {line}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Section 7: Latest projects (Figma 649:5870) -->
    <section class="or-projects" id="projects">
      <div class="or-wrap or-projects__wrap">
        <p class="or-kicker">PROJECTS</p>
        <div class="or-projects__head">
          <button class="or-projects__nav" type="button" data-or-gallery-prev>
            <span class="or-projects__nav-arrow" aria-hidden="true">←</span>
            <span>PREVIOUS</span>
          </button>
          <div class="or-projects__titles">
            <h2>Our latest work in Jumeirah Golf Estates</h2>
            <span class="or-note">(*Displayed pictures are approved by the property owner)</span>
          </div>
          <button class="or-projects__nav" type="button" data-or-gallery-next>
            <span>NEXT</span>
            <span class="or-projects__nav-arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>
      <div class="or-gallery" data-or-gallery>
        <div class="or-gallery__track" data-or-gallery-track>
          {
            projects.map((item) => (
              <img src={item.src} alt={item.alt} width="490" height="312" loading="lazy" />
            ))
          }
        </div>
      </div>
    </section>

    <!-- Section 8: Partners (Figma 904:3707) -->
    <section class="or-partners">
      <h2>our partners</h2>
      <div class="or-partners__row">
        {
          partners.map((logo) => (
            <img src={logo.src} alt={logo.alt} width="120" height="48" loading="lazy" />
          ))
        }
      </div>
    </section>

    <!-- Section 9: Team (Figma 741:3616 + 703:3481) -->
    <section class="or-team-block" aria-label="Our team">
      <div class="or-team-banner">our Team</div>
      <div class="or-team">
        <img
          src="/service/office-renovation/team.jpg"
          alt="REDO team"
          width="1512"
          height="486"
          loading="lazy"
        />
      </div>
    </section>

    <!-- Section 10: Book a consultation (Figma 629:5005) -->
    <section
      class="or-book"
      id="consult"
      style="background-image:url('/service/office-renovation/book-bg.jpg')"
    >
      <div class="or-wrap or-book__inner">
        <div class="or-book__copy">
          <img
            class="or-chat"
            src="/service/office-renovation/chat-icon.svg"
            alt=""
            width="67"
            height="67"
          />
          <h2>BOOK A CONSULTATION<br />WITH US</h2>
        </div>
        <EstimateForm
          formId="or-book-form"
          formName="Office renovation service — consultation"
          theme="light"
          showMessage={true}
          showWhatsapp={false}
          buttonLabel="Get in Touch"
        />
      </div>
    </section>
  </div>

  {/* Shared Elementor footer with LICENSE DETAILS below main columns (Home / Exterior order) */}
  <Fragment set:html={footerHtml} />

  {/* Sticky REQUEST INQUIRY — same Sticky Floating Forms widget as Exterior Revamp */}
  <div id="cww-sff-disp-wrap-outer" class="cww-ssf-outer-wrapp btn-position-right modal">
    <div class="cww-sff-inner">
      <div class="toggle-wrapp layout-one">
        <a class="cww-ssf-toggle" href="javascript:void(0)">REQUEST INQUIRY</a>
      </div>
      <div class="cww-sff-wrapp">
        <i class="dashicons dashicons-no-alt" aria-label="Close"></i>
        <div class="or-sticky-form">
          <EstimateForm
            formId="or-sticky-form"
            formName="Office renovation service — sticky inquiry"
            theme="light"
            showMessage={true}
            messageLabel="Message (Optional)"
            messagePlaceholder="Your message..."
            phonePlaceholder="Your number"
            showWhatsapp={false}
            buttonLabel="Get in Touch"
          />
        </div>
      </div>
    </div>
  </div>
  <div class="cww-sf-form-overlay"></div>

  <Fragment set:html={chromeScriptsHtml} />
  <script src="/wp-content/plugins/country-phone-field-contact-form-7/assets/js/intlTelInput.min.js" is:inline></script>
  <script is:inline>
    var sff_data = { ajaxurl: '/wp-admin/admin-ajax.php', open_type: 'modal' };
  </script>
  <script
    defer
    src="/wp-content/cache/min/1/wp-content/plugins/sticky-floating-forms-lite/assets/js/frontend.js"
  ></script>
  <script src="/js/astro-mirror-fixes.js?v=geo1" defer></script>
  <script>
    // @ts-nocheck
    import { captureAttribution, populateAttributionFields } from '../lib/attribution/client';

    document.addEventListener('DOMContentLoaded', function () {
      var gallery = document.querySelector('[data-or-gallery]');
      var galleryTrack = document.querySelector('[data-or-gallery-track]');
      var galleryPrev = document.querySelector('[data-or-gallery-prev]');
      var galleryNext = document.querySelector('[data-or-gallery-next]');

      function bindSmoothCarousel(track, prevBtn, nextBtn, gapDesktop, gapMobile) {
        if (!track || !prevBtn || !nextBtn) return;
        var busy = false;

        function gapNow() {
          if (typeof gapMobile === 'number' && window.matchMedia('(max-width: 960px)').matches) {
            return gapMobile;
          }
          return gapDesktop;
        }

        function slide(dir) {
          if (busy) return;
          var items = Array.prototype.slice.call(track.children);
          if (items.length < 2) return;
          var gap = gapNow();
          var step = items[0].getBoundingClientRect().width + gap;
          busy = true;

          if (dir < 0) {
            track.style.transition = 'none';
            track.insertBefore(items[items.length - 1], items[0]);
            track.style.transform = 'translateX(' + -step + 'px)';
            void track.offsetWidth;
            track.style.transition = 'transform 0.45s ease';
            track.style.transform = 'translateX(0)';
            function finishPrev() {
              track.removeEventListener('transitionend', finishPrev);
              track.style.transition = '';
              busy = false;
            }
            track.addEventListener('transitionend', finishPrev);
            return;
          }

          track.style.transition = 'transform 0.45s ease';
          track.style.transform = 'translateX(' + -step + 'px)';
          function finishNext() {
            track.removeEventListener('transitionend', finishNext);
            track.style.transition = 'none';
            track.appendChild(items[0]);
            track.style.transform = 'translateX(0)';
            void track.offsetWidth;
            track.style.transition = '';
            busy = false;
          }
          track.addEventListener('transitionend', finishNext);
        }

        prevBtn.addEventListener('click', function () {
          slide(-1);
        });
        nextBtn.addEventListener('click', function () {
          slide(1);
        });
      }

      bindSmoothCarousel(galleryTrack, galleryPrev, galleryNext, 10, 10);
      bindSmoothCarousel(
        document.querySelector('[data-or-quotes-track]'),
        document.querySelector('[data-or-quotes-prev]'),
        document.querySelector('[data-or-quotes-next]'),
        48,
        0,
      );

      document.querySelectorAll('.lp-form').forEach(function (form) {
        var submitBtn = form.querySelector('button[type="submit"]');
        var status = form.querySelector('.lp-form__status');
        var submitting = false;
        var formId = form.id;
        var formName = form.getAttribute('data-form-name') || '';

        function setHidden(name, value) {
          var input = form.querySelector('[name="' + name + '"]');
          if (input) input.value = value || '';
        }

        function captureTracking() {
          var captured = captureAttribution(formId, formName);
          populateAttributionFields(form, captured.firstTouch, captured.lastTouch);
          setHidden('page_url', window.location.href);
          setHidden('submission_page_url', window.location.href);
          setHidden('referrer_url', document.referrer || '');
          if (!form.dataset.submissionId) form.dataset.submissionId = crypto.randomUUID();
          setHidden('submission_id', form.dataset.submissionId);
        }

        captureTracking();

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (submitting) return;
          form.querySelectorAll('.lp-form__error').forEach(function (el) {
            el.textContent = '';
          });
          if (status) {
            status.hidden = true;
            status.textContent = '';
            status.classList.remove('lp-form__status--error', 'lp-form__status--success');
          }
          captureTracking();
          setHidden('submitted_at', new Date().toISOString());

          var phone = form.querySelector('.cg-phone-input');
          var countryCodeInput = form.querySelector('[name="phone-country-code"]');
          if (window.jQuery && phone && window.jQuery(phone).data('plugin_intlTelInput')) {
            try {
              var full = window.jQuery(phone).intlTelInput('getNumber');
              if (full) phone.value = full;
              var dial = window.jQuery(phone).intlTelInput('getSelectedCountryData');
              if (dial && countryCodeInput) countryCodeInput.value = '+' + dial.dialCode;
            } catch (err) {}
          }

          submitting = true;
          if (submitBtn) submitBtn.disabled = true;

          fetch('/api/contact/', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          })
            .then(function (response) {
              return response.json().then(function (data) {
                return { ok: response.ok, data: data };
              });
            })
            .then(function (result) {
              if (status) status.hidden = false;
              if (result.ok && result.data && result.data.success) {
                if (status) {
                  status.textContent = result.data.message || 'Thank you. Your enquiry has been received.';
                  status.classList.add('lp-form__status--success');
                }
                form.reset();
                form.dataset.submissionId = crypto.randomUUID();
                captureTracking();
                return;
              }
              if (status) {
                status.textContent =
                  (result.data && result.data.message) ||
                  'We could not submit your enquiry at the moment. Please try again shortly.';
                status.classList.add('lp-form__status--error');
              }
            })
            .catch(function () {
              if (status) {
                status.hidden = false;
                status.textContent = 'We could not submit your enquiry at the moment. Please try again shortly.';
                status.classList.add('lp-form__status--error');
              }
            })
            .finally(function () {
              submitting = false;
              if (submitBtn) submitBtn.disabled = false;
            });
        });
      });
    });
  </script>
</BaseLayout>
