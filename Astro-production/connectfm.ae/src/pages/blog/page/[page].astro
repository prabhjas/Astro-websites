---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getPosts, paginate, POSTS_PER_PAGE } from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/seo";

export const prerender = false;

export function getStaticPaths() {
  return [];
}

const pageNum = Number(Astro.params.page || "2");
const sorted = [...getPosts()].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const { items, page, totalPages } = paginate(sorted, pageNum, POSTS_PER_PAGE);
if (pageNum < 2 || pageNum > totalPages) {
  return Astro.redirect("/blog/", 301);
}
---

<BaseLayout
  currentPath="/blog/"
  seo={{
    title: `Blog — Page ${page} | Connect FM`,
    description: "Facility management guides and tips from Connect FM across Dubai and the UAE.",
    canonical: `/blog/page/${page}/`,
    schemas: [
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog/" },
      ]),
    ],
  }}
>
  <section class="sp-archive-hero">
    <div class="sp-container">
      <Breadcrumbs
        items={[
          { name: "Home", href: "/" },
          { name: "Blog", href: "/blog/" },
          { name: `Page ${page}` },
        ]}
      />
      <h1>Blog</h1>
      <p>Page {page} of {totalPages}</p>
    </div>
  </section>
  <section class="sp-container" style="padding: 1rem 0 4rem">
    <div class="sp-blog-grid">
      {items.map((post) => <PostCard post={post} />)}
    </div>
    <Pagination page={page} totalPages={totalPages} basePath="/blog/" />
  </section>
</BaseLayout>
