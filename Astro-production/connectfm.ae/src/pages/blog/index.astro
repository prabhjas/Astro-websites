---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  BLOG_LOAD_MORE_PER_PAGE,
  renderBlogCardsHtml,
} from "../../lib/blog-card-html";
import { getCategories, getPageByPath, getPosts, stripHtml } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/seo";

export const prerender = false;

/** Live archive is /blog/ (Elementor loop-grid). Wire Load More for e-loop. */
const page = getPageByPath("/blog/");
if (!page) throw new Error("Blog page missing");

const sortedPosts = getPosts().sort((a, b) => +new Date(b.date) - +new Date(a.date));
const totalPosts = sortedPosts.length;
let html = page.bodyHtml || page.content;

const initialItems = (html.match(/e-loop-item-/g) || []).length || BLOG_LOAD_MORE_PER_PAGE;
const cards = renderBlogCardsHtml(sortedPosts.slice(0, initialItems));
const hasMore = totalPosts > initialItems;

html = html.replace(
  /(<div[^>]*class="[^"]*elementor-loop-container[^"]*"[^>]*>)([\s\S]*?)(<\/div>\s*(?:<div[^>]*class="[^"]*e-loop__load-more|<\/div>\s*<div[^>]*class="[^"]*e-load-more))/i,
  (_full, open, inner, closeStart) => {
    const styleMatch = String(inner).match(/<style\b[^>]*>[\s\S]*?<\/style>/i);
    const styleBlock = styleMatch ? styleMatch[0] + "\n" : "";
    return `${open}${styleBlock}${cards}${closeStart}`;
  },
);

if (hasMore) {
  html = html.replace(
    /<div([^>]*class="[^"]*e-loop__load-more[^"]*"[^>]*)>/i,
    `<div$1 data-sp-blog-load-more="1" data-next-page="2" data-per-page="${initialItems}" data-offset="${initialItems}">`,
  );
  html = html.replace(
    /<nav([^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*)>/i,
    `<nav$1 data-sp-blog-load-more="1" data-next-page="2" data-per-page="${initialItems}" data-offset="${initialItems}">`,
  );
} else {
  html = html.replace(
    /<div[^>]*class="[^"]*e-loop__load-more[^"]*"[^>]*>[\s\S]*?<\/div>/i,
    "",
  );
  html = html.replace(/<nav[^>]*class="[^"]*ecs-load-more-button[^"]*"[^>]*>[\s\S]*?<\/nav>/i, "");
}

let loopSeen = 0;
const loopMatches = html.match(/<div[^>]*class="[^"]*elementor-loop-container[^"]*"[^>]*>/gi) || [];
const loopIndex = loopMatches.length;
html = html.replace(/<div([^>]*class="[^"]*elementor-loop-container[^"]*"[^>]*)>/gi, (_full, attrs) => {
  loopSeen += 1;
  if (loopSeen === loopIndex && !/data-sp-blog-grid/.test(attrs)) {
    return `<div${attrs} data-sp-blog-grid="1">`;
  }
  return `<div${attrs}>`;
});

let ecsSeen = 0;
const ecsMatches = html.match(/<div[^>]*class="[^"]*ecs-posts[^"]*"[^>]*>/gi) || [];
const gridIndex = ecsMatches.length;
html = html.replace(/<div([^>]*class="[^"]*ecs-posts[^"]*"[^>]*)>/gi, (_full, attrs) => {
  ecsSeen += 1;
  if (ecsSeen === gridIndex && !/data-sp-blog-grid/.test(attrs)) {
    return `<div${attrs} data-sp-blog-grid="1">`;
  }
  return `<div${attrs}>`;
});

const posts = sortedPosts;
const usedCatIds = new Set(posts.flatMap((p) => p.categories || []));
const catOptions = getCategories()
  .filter((c) => usedCatIds.has(c.id))
  .filter((c) => !/^!/.test(c.name || "") && c.slug !== "bez-rubriki" && c.slug !== "public")
  .sort((a, b) => stripHtml(a.name).localeCompare(stripHtml(b.name)));

const catSelectInner = [
  `<option value="-1">Select Category</option>`,
  ...catOptions.map((c) => {
    const name = stripHtml(c.name).replace(/&/g, "&amp;").replace(/</g, "&lt;");
    const path = (c.path || `/category/${c.slug}/`).replace(/"/g, "");
    return `<option class="level-0" value="${c.id}" data-path="${path}">${name}</option>`;
  }),
].join("\n\t");

html = html.replace(
  /(<select\s+name=['"]cat['"]\s+id=['"]cat['"]\s+class=['"]postform['"]\s*>)[\s\S]*?(<\/select>)/i,
  `$1\n\t${catSelectInner}\n$2`,
);

const extraCss = [
  ...(page.pageCss || []),
  page.elementorCss || `/wp-content/uploads/elementor/css/post-${page.id}.css`,
  "/css/insights-category.css",
];
---

<BaseLayout
  currentPath="/blog/"
  bodyClass={`page page-id-${page.id} elementor-page-${page.id}`}
  extraCss={extraCss}
  fallback={page.seo}
  seo={{
    title: page.seo.title || "Blog | Connect FM",
    description:
      page.seo.description ||
      "Facility management guides and tips from Connect FM across Dubai and the UAE.",
    canonical: "/blog/",
    ogImage: page.seo.ogImage,
    schemas: [
      ...(page.seo.schemas || []),
      breadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog/" },
      ]),
    ],
  }}
>
  <div class="sp-page-content" set:html={html} />
</BaseLayout>
