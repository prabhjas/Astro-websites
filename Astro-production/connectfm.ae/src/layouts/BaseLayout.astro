---
import SEOHead from "../components/SEOHead.astro";
import ElementorHeader from "../components/ElementorHeader.astro";
import ElementorFooter from "../components/ElementorFooter.astro";
import LicenceStrip from "../components/LicenceStrip.astro";
import ElementorScripts from "../components/ElementorScripts.astro";
import type { SeoInput } from "../lib/seo";
import type { SeoData } from "../lib/content";
import liveCssOrder from "../data/live-css-order.json";
import { resolveInternalAdminDir } from "../env/server";
import { readGlobalGtmConfig, sanitiseGtmSnippet } from "../lib/gtm/store";
import "../styles/global.css";

interface Props {
  seo?: SeoInput;
  fallback?: SeoData;
  extraCss?: string[];
  currentPath?: string;
  /** Force header nav active item (e.g. "/blog/" on single posts) */
  menuActivePath?: string;
  bodyClass?: string;
}

const {
  seo = {},
  fallback,
  extraCss = [],
  currentPath = Astro.url.pathname,
  menuActivePath,
  bodyClass = "",
} = Astro.props;

/** Live connectfm.ae Elementor kit is post-8. */
const KIT_CSS = "/wp-content/uploads/elementor/css/post-8.css";
const FOREIGN_KIT_BLOCKLIST = new Set([
  "/wp-content/uploads/elementor/css/post-10.css",
  "/wp-content/uploads/elementor/css/post-19.css",
]);
/** Connect FM brand face is DM Sans — drop competing Elementor google-font sheets. */
const FOREIGN_FONT_RE =
  /google-fonts\/css\/(roboto|robotoslab|nunito|bebasneue|poppins|manrope|montserrat|inter)\.css/i;

function allowStylesheet(href: string): boolean {
  if (FOREIGN_KIT_BLOCKLIST.has(href)) return false;
  if (FOREIGN_FONT_RE.test(href)) return false;
  if (href.includes("/elementor/css/post-10.css")) return false;
  if (href.includes("/elementor/css/post-19.css")) return false;
  return true;
}

const globalCss = [
  "/wp-content/plugins/contact-form-7/includes/css/styles.css",
  "/wp-content/plugins/country-phone-field-contact-form-7/assets/css/intlTelInput.min.css",
  "/wp-content/plugins/country-phone-field-contact-form-7/assets/css/countrySelect.min.css",
  "/wp-content/themes/hello-elementor/theme.min.css",
  "/wp-content/themes/hello-elementor/header-footer.min.css",
  "/wp-content/plugins/elementor/assets/css/frontend.min.css",
  "/wp-content/plugins/elementor/assets/lib/swiper/v8/css/swiper.min.css",
  "/wp-content/plugins/elementor/assets/css/conditionals/e-swiper.min.css",
  KIT_CSS,
  "/wp-content/uploads/elementor/google-fonts/css/dmsans.css",
  "/wp-content/plugins/elementor/assets/css/widget-image.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-heading.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-divider.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-icon-list.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-accordion.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-toggle.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-tabs.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-icon-box.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-image-box.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-spacer.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-text-editor.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-video.min.css",
  "/wp-content/plugins/elementor/assets/css/widget-social-icons.min.css",
  "/wp-content/plugins/elementor-pro/assets/css/widget-nav-menu.min.css",
  "/wp-content/plugins/elementor-pro/assets/css/modules/sticky.min.css",
  "/wp-content/plugins/elementor-pro/assets/css/widget-loop-common.min.css",
  "/wp-content/plugins/elementor-pro/assets/css/widget-loop-grid.min.css",
  "/wp-content/themes/hello-elementor/style.css",
];

/** Exact stylesheet order from live homepage (?nowprocket=1), minus page-specific CSS handled via extraCss */
const baseCss = [
  ...globalCss,
  ...(liveCssOrder as string[]).filter((href) => !globalCss.includes(href) && allowStylesheet(href)),
];

// Figma page-design overlays must load AFTER Elementor + migration-overrides
// so hero/layout !important rules win (e.g. smart-homes-sec2-4.css).
const pageDesignCss = extraCss.filter((href) => href.startsWith("/css/page-design/"));
const otherExtraCss = extraCss.filter((href) => !href.startsWith("/css/page-design/"));

const stylesheets = [
  ...new Set([
    ...baseCss,
    ...otherExtraCss,
    "/css/wp-custom.css",
    "/css/connectfm-typography.css",
    "/css/elementor-bg-fallback.css",
    "/css/simplePagination.min.css",
    "/css/migration-overrides.css",
    ...pageDesignCss,
  ]),
].filter(allowStylesheet);
---

<!doctype html>
<html lang="en-AE">
  <head>
    <SEOHead seo={seo} fallback={fallback} extraCss={stylesheets} />
    <meta
      name="sp-contact-endpoint"
      content={import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/"}
    />
    <script is:inline define:vars={{ contactEndpoint: import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/" }}>
      window.__SP_CONTACT_ENDPOINT__ = contactEndpoint;
    </script>
    <script src="/runtime-gtm.js" defer data-runtime-gtm="1"></script>
  </head>
  <body
    class:list={[
      "wp-custom-logo",
      "elementor-default",
      "elementor-kit-8",
      "elementor-page",
      bodyClass,
    ]}
  >
    <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
    <ElementorHeader currentPath={currentPath} menuActivePath={menuActivePath} />
    <main id="content" class="site-main">
      <div class="page-content">
        <slot />
      </div>
    </main>
    <ElementorFooter />
    <LicenceStrip />
    <ElementorScripts />
  </body>
</html>
