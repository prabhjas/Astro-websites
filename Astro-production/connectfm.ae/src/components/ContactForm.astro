---
/**
 * Astro contact form → /api/contact (Pipedrive + lead store).
 * Field names align with the operations dashboard contact parser.
 */
interface Props {
  formId?: string;
  formName?: string;
}

const {
  formId = "eor-contact-lead",
  formName = "Connect UAE Contact Form",
} = Astro.props;
---

<form
  id={formId}
  class="sp-form"
  method="post"
  action={import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact/"}
  data-sp-contact-form
  novalidate
>
  <input type="text" name="website" class="sp-form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="form_name" value={formName} />
  <input type="hidden" name="form_id" value={formId} />
  <input type="hidden" name="submission_id" value="" />
  <input type="hidden" name="page_url" value="" />
  <input type="hidden" name="initial_url" value="" />
  <input type="hidden" name="gclid" value="" />
  <input type="hidden" name="campaign_id" value="" />
  <input type="hidden" name="adgroup_id" value="" />
  <input type="hidden" name="creative_id" value="" />
  <input type="hidden" name="keyword" value="" />
  <input type="hidden" name="matchtype" value="" />
  <input type="hidden" name="device" value="" />
  <input type="hidden" name="network" value="" />

  <div class="sp-form__row">
    <label>
      First Name*
      <input type="text" name="first-name" required autocomplete="given-name" />
    </label>
    <label>
      Last Name*
      <input type="text" name="last-name" required autocomplete="family-name" />
    </label>
  </div>
  <div class="sp-form__row">
    <label>
      Email*
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label>
      Phone Number*
      <input type="tel" name="phone" class="wpcf7-phonetext" required autocomplete="tel" aria-required="true" />
    </label>
  </div>
  <label>
    Message
    <textarea name="message" rows="5"></textarea>
  </label>
  <button type="submit">Get in Touch</button>
  <p class="sp-form__status" data-sp-form-status role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector("[data-sp-contact-form]");
  const params = new URLSearchParams(window.location.search);

  if (form instanceof HTMLFormElement) {
    const set = (name: string, value: string) => {
      const el = form.querySelector(`[name="${name}"]`);
      if (el instanceof HTMLInputElement) el.value = value;
    };
    set("page_url", window.location.href);
    set("initial_url", window.location.href);
    set("submission_id", crypto.randomUUID());
    for (const key of [
      "gclid",
      "campaign_id",
      "adgroup_id",
      "creative_id",
      "keyword",
      "matchtype",
      "device",
      "network",
    ]) {
      if (params.has(key)) set(key, params.get(key) || "");
    }
  }
</script>

<style>
  .sp-form__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }
</style>
