---
import headerHtml from "../data/header.html?raw";

interface Props {
  currentPath?: string;
  /** Force a nav href active (e.g. "/blog/" for single posts) */
  menuActivePath?: string;
}

const { currentPath = "/", menuActivePath } = Astro.props;

function normalize(path: string) {
  if (!path || path === "/") return "/";
  return path.endsWith("/") ? path : `${path}/`;
}

const path = normalize(menuActivePath || currentPath);

function pickActiveHref(current: string, hrefs: string[]) {
  const matches = hrefs
    .map(normalize)
    .filter((h) => {
      if (h === "/") return current === "/";
      return current === h || current.startsWith(h);
    })
    .sort((a, b) => b.length - a.length);
  return matches[0] || "";
}

function withActiveState(html: string, current: string) {
  let out = html
    .replace(/\s*elementor-item-active/g, "")
    .replace(/\s*current-menu-item/g, "")
    .replace(/\s*current_page_item/g, "")
    .replace(/\s*current-menu-ancestor/g, "")
    .replace(/\s*current-menu-parent/g, "")
    .replace(/\s*aria-current="page"/g, "");

  const allHrefs = [...out.matchAll(/\bhref="(\/[^"#]*)"/g)].map((m) => m[1]);
  const activeDeep = pickActiveHref(current, allHrefs);
  if (!activeDeep) return out;

  let activeTop = activeDeep;
  const topHrefs = ["/", "/about-us/", "/blog/", "/contact/", "/contact-us/"];
  if (!topHrefs.includes(normalize(activeDeep))) {
    const liBlocks = out.split(/<\/li>/i);
    for (const block of liBlocks) {
      if (!block.includes(`href="${activeDeep}"`) && !block.includes(`href="${normalize(activeDeep)}"`))
        continue;
      const top = block.match(
        /<a\s+[^>]*class="elementor-item(?![^"]*sub-item)[^"]*"[^>]*href="(\/[^"#]*)"|<a\s+[^>]*href="(\/[^"#]*)"[^>]*class="elementor-item(?![^"]*sub-item)[^"]*"/i,
      );
      if (top) {
        activeTop = top[1] || top[2];
        break;
      }
    }
  }

  const markTop = normalize(activeTop);
  const markDeep = normalize(activeDeep);

  out = out.replace(/<a\s+([^>]*?)>/gi, (full, attrs: string) => {
    const hrefMatch = attrs.match(/\bhref="([^"]+)"/i);
    if (!hrefMatch) return full;
    const h = normalize(hrefMatch[1]);
    const isSub = /\belementor-sub-item\b/.test(attrs);
    const isTopPointer = h === markTop && !isSub;
    const isDeep = h === markDeep;
    if (!isTopPointer && !isDeep) return full;

    let next = attrs;
    if (isTopPointer) {
      if (/\bclass="/i.test(next)) {
        next = next.replace(/\bclass="([^"]*)"/i, (_m, cls: string) => {
          const cleaned = cls.replace(/\belementor-item-active\b/g, "").replace(/\s+/g, " ").trim();
          return `class="${cleaned} elementor-item-active"`;
        });
      } else {
        next = `class="elementor-item elementor-item-active" ${next}`;
      }
      if (!/\baria-current=/i.test(next)) next += ` aria-current="page"`;
    } else if (isDeep && isSub) {
      if (!/\baria-current=/i.test(next)) next += ` aria-current="page"`;
    }
    return `<a ${next}>`;
  });

  out = out.replace(
    /<li\b([^>]*class=")([^"]*)("[\s\S]*?<a\b[^>]*\b(?:elementor-item-active|aria-current="page")\b)/gi,
    (full, pre, cls, rest) => {
      const beforeNested = rest.split(/<li\b/i)[0];
      if (!/elementor-item-active|aria-current="page"/.test(beforeNested)) {
        if (!/\bcurrent-menu-ancestor\b/.test(cls)) {
          return `<li${pre}${cls} current-menu-ancestor${rest}`;
        }
        return full;
      }
      let c = cls;
      if (!/\bcurrent-menu-item\b/.test(c)) c += " current-menu-item";
      if (!/\bcurrent_page_item\b/.test(c)) c += " current_page_item";
      return `<li${pre}${c}${rest}`;
    },
  );

  return out;
}


function stripMenuDummyHashHrefs(html: string) {
  return html.replace(/<a\b([^>]*)>/gi, (full, attrs: string) => {
    if (!/\bhref="#"/i.test(attrs)) return full;
    if (
      /\b(w-nav-control|elementor-button|elementor-icon|mean-expand|w-toplink|modeltheme-trigger|lwptoc_toggle_label)\b/.test(
        attrs,
      )
    ) {
      return full;
    }
    if (
      !/\b(elementor-item|elementor-sub-item|elementor-item-anchor|menu-link|w-nav-anchor|mega-menu-link)\b/.test(
        attrs,
      )
    ) {
      return full;
    }
    const next = attrs.replace(/\s*href="#"/i, "").replace(/\s*\belementor-item-anchor\b/g, "");
    return `<a${next}>`;
  });
}

const html = stripMenuDummyHashHrefs(withActiveState(headerHtml, path));
---

<header class="sp-elementor-header" data-sp-elementor-header set:html={html} />

<style is:global>

/* Hide dummy '#' on submenu / dropdown hover.
   Elementor pointer ::before and WP heading permalinks must not show on
   dropdown links. Top-level underline pointers and carets stay intact. */
.elementor-nav-menu--dropdown a::before,
.elementor-nav-menu--dropdown .elementor-item::before,
.elementor-nav-menu--dropdown .elementor-sub-item::before,
.elementor-sub-item::before,
.e-n-menu-content a::before,
.e-n-menu-content .elementor-icon-box-title a::after,
.e-n-menu-content .elementor-heading-title a::after,
.w-nav-list.level_2 .w-nav-anchor::before,
.w-nav-list.level_3 .w-nav-anchor::before,
.w-nav-list.submenu .w-nav-anchor::before,
.ast-nav-menu .sub-menu .menu-link::before,
.main-header-menu .sub-menu .menu-link::before,
.navbar .dropdown-menu > li > a::before,
#navbar .sub-menu a::before {
  content: none !important;
}

.elementor-location-header h1 a:hover::after,
.elementor-location-header h2 a:hover::after,
.elementor-location-header h3 a:hover::after,
.elementor-location-header h4 a:hover::after,
.elementor-location-header h5 a:hover::after,
.elementor-location-header h6 a:hover::after,
.elementor-location-header .elementor-icon-box-title a:hover::after,
.elementor-location-header .elementor-heading-title a:hover::after,
.e-n-menu-content .elementor-icon-box-title a:hover::after,
.e-n-menu-content .elementor-heading-title a:hover::after {
  content: none !important;
}

</style>
<script is:inline src="/scripts/eor-mobile-nav.js"></script>
<script is:inline src="/scripts/e-n-menu-mobile.js"></script>
