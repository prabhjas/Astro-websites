---
/**
 * Licence & verification band — sits directly under the Elementor footer.
 * Mirrors the footer's black / Bebas Neue / yellow-accent styling so it reads as
 * the last line of the footer rather than a bolted-on section.
 * The machine-readable half lives in organizationSchema() (JSON-LD) and llms.txt.
 */
import { licence, licenceRows, hasLicencePdf } from "../lib/licence";

const pdfReady = hasLicencePdf();
---

<section class="sp-licence" aria-labelledby="sp-licence-title">
  <div class="sp-licence__inner">
    <div class="sp-licence__details">
      <h2 class="sp-licence__title" id="sp-licence-title">License Details</h2>
      <p class="sp-licence__lead">
        {licence.businessName} is fully licensed in Dubai, UAE by the {licence.issuingAuthority}.
      </p>

      <dl class="sp-licence__grid">
        {
          licenceRows.map((row) => (
            <div class="sp-licence__row">
              <dt>{row.label}</dt>
              <dd>
                {row.label === "License Status" ? (
                  <span class="sp-licence__badge">{row.value}</span>
                ) : (
                  row.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="sp-licence__actions">
        <a
          class="sp-licence__btn sp-licence__btn--primary"
          href={licence.verifyUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
        >
          Verify our license
          <span aria-hidden="true">↗</span>
        </a>
        {
          pdfReady && (
            <a
              class="sp-licence__btn sp-licence__btn--ghost"
              href={licence.pdfPath}
              target="_blank"
              rel="noopener noreferrer"
            >
              Click here to view the license
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>

    <div class="sp-licence__verify">
      <a
        class="sp-licence__qr"
        href={licence.verifyUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        aria-label={`Verify licence ${licence.number} on the official Dubai licence portal`}
      >
        <img
          src={licence.qrPath}
          width="150"
          height="150"
          loading="lazy"
          decoding="async"
          alt={`QR code linking to the official Dubai portal for verifying licence ${licence.number}`}
        />
      </a>
      <p class="sp-licence__qr-caption">
        Scan to verify on the<br />official Dubai licence portal
      </p>
    </div>
  </div>
</section>

<style>
  .sp-licence {
    background: #000;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    padding: 34px 10px 40px;
  }

  .sp-licence__inner {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px 48px;
  }

  .sp-licence__details {
    flex: 1 1 460px;
    min-width: 0;
  }

  .sp-licence__title {
    font-family: "Bebas Neue", Sans-serif;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #fff;
    margin: 0 0 6px;
  }

  .sp-licence__title::after {
    content: "";
    display: block;
    width: 46px;
    height: 3px;
    margin-top: 8px;
    background: #ffdd04;
  }

  .sp-licence__lead {
    margin: 14px 0 18px;
    font-size: 14px;
    line-height: 1.6;
    color: #b9b9b9;
    max-width: 52ch;
  }

  .sp-licence__grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 32px;
  }

  .sp-licence__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .sp-licence__row dt {
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8f8f8f;
    margin: 0;
  }

  .sp-licence__row dd {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    text-align: right;
  }

  .sp-licence__badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(255, 221, 4, 0.15);
    border: 1px solid rgba(255, 221, 4, 0.55);
    color: #ffdd04;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sp-licence__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  .sp-licence__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .sp-licence__btn--primary {
    background: #ffdd04;
    color: #000;
    border: 1px solid #ffdd04;
  }

  .sp-licence__btn--primary:hover,
  .sp-licence__btn--primary:focus-visible {
    background: #df790d;
    border-color: #df790d;
    color: #fff;
  }

  .sp-licence__btn--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .sp-licence__btn--ghost:hover,
  .sp-licence__btn--ghost:focus-visible {
    border-color: #ffdd04;
    color: #ffdd04;
  }

  .sp-licence__verify {
    flex: 0 0 auto;
    text-align: center;
    margin-inline: auto;
  }

  .sp-licence__qr {
    display: inline-block;
    padding: 12px;
    background: #fff;
    border-radius: 8px;
    line-height: 0;
    border: 3px solid #ffdd04;
  }

  .sp-licence__qr img {
    width: 150px;
    height: 150px;
    display: block;
  }

  .sp-licence__qr-caption {
    margin: 12px 0 0;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #8f8f8f;
  }

  @media (max-width: 767px) {
    .sp-licence {
      padding: 28px 10px 34px;
    }

    .sp-licence__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .sp-licence__inner {
      gap: 26px;
    }

    .sp-licence__btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
