{
  "name": "astro-websites-fleet",
  "private": true,
  "description": "Connect Group Astro production fleet — pnpm workspace + version catalog",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "fleet:list": "node scripts/fleet-local.mjs list",
    "fleet:up": "node scripts/fleet-local.mjs up evolutionmiddleast,cbss,spheavyrental",
    "fleet:smoke": "node scripts/fleet-local.mjs smoke evolutionmiddleast,cbss,spheavyrental",
    "fleet:status": "node scripts/fleet-local.mjs status evolutionmiddleast,cbss,spheavyrental",
    "fleet:stop": "node scripts/fleet-local.mjs stop evolutionmiddleast,cbss,spheavyrental",
    "fleet:install": "pnpm install",
    "fleet:build": "pnpm -r --filter './Astro-production/*' run build",
    "fleet:build:trio": "pnpm --filter evolutionmiddleast-astro --filter astro-cbss --filter spheavy-rental run build",
    "fleet:plan": "node scripts/ci/fleet-plan.mjs",
    "fleet:validate": "node scripts/ci/fleet-validate-site.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "astro": "catalog:",
    "playwright": "1.62.1",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18"
    }
  }
}
