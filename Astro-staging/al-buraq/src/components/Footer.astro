---
const services = [
  { label: 'Licensing', href: '/licensing/' },
  { label: 'HR Outsourcing', href: '/outsourcing/' },
  { label: 'Business Center', href: '/business-center/' },
  { label: 'Corporate Sponsorship', href: '/corporate-sponsorship/' },
];
const links = [
  { label: 'Contact Us', href: '/contact-us/' },
  { label: 'About Us', href: '/about-us/' },
  { label: 'Terms & Conditions', href: '/terms/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' },
];
const socials = [
  { href: 'https://www.facebook.com/AlBuraqDubai/', label: 'Facebook', icon: '<path d="M7.305 20H11.152V11.99H14.62L15 8.01H11.152V6c0-.265.101-.52.281-.707.18-.188.425-.293.68-.293H15V1H12.114C10.839 1 9.615 1.527 8.713 2.464 7.812 3.402 7.305 4.674 7.305 6v2.01H5V11.99h2.305V20z"/>' },
  { href: 'https://www.instagram.com/alburaqgroup/', label: 'Instagram', icon: '<path d="M6.22 1h7.56C16.66 1 19 3.47 19 6.51v7.98C19 17.53 16.66 20 13.78 20H6.22C3.34 20 1 17.53 1 14.49V6.51C1 3.47 3.34 1 6.22 1zm-.1 2a3.12 3.12 0 0 0-3.12 3.12v7.76A3.12 3.12 0 0 0 6.12 17h7.76A3.12 3.12 0 0 0 17 13.88V6.12A3.12 3.12 0 0 0 13.88 3H6.12zM10 6.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm0 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm4-2.25a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z"/>' },
  { href: 'https://www.linkedin.com/company/al-buraq-group/', label: 'LinkedIn', icon: '<path d="M4.778 3.779a1.778 1.778 0 1 1-3.556 0 1.778 1.778 0 0 1 3.556 0zM1.222 6.889h3.111V19H1.222V6.889zm5.445 0H9.74v1.653h.047c.458-.87 1.576-1.787 3.245-1.787C16.253 6.755 17 9.11 17 11.875V19h-3.11v-6.44c0-1.536-.027-3.512-2.139-3.512-2.142 0-2.47 1.673-2.47 3.4V19H6.667V6.889z"/>' },
];
---

<footer class="bg-dark text-white">
  <div class="container-site py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div>
        <a href="/">
          <img src="/images/2024/12/LOGO-AL-BURAQ-GROUP-white-1.webp" alt="Al Buraq Group" width="140" height="42" class="h-10 w-auto mb-5" loading="lazy" />
        </a>
        <p class="text-[#BABABA] text-sm font-body leading-relaxed mb-5">
          Corporate business solutions in the UAE — licensing, outsourcing, business centers, and corporate sponsorship.
        </p>
        <p class="text-xs font-ui uppercase tracking-widest text-[#BABABA] mb-3">Follow us:</p>
        <div class="flex gap-3">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="text-[#BABABA] hover:text-primary transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 21" set:html={s.icon}></svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-5">Our Services</h3>
        <ul class="space-y-2.5">
          {services.map((s) => (
            <li>
              <a href={s.href} class="text-[#BABABA] text-sm font-body hover:text-white transition-colors">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-5">Quick Links</h3>
        <ul class="space-y-2.5">
          {links.map((l) => (
            <li>
              <a href={l.href} class="text-[#BABABA] text-sm font-body hover:text-white transition-colors">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-5">Contact</h3>
        <ul class="space-y-3 text-sm text-[#BABABA] font-body">
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
            </svg>
            <a href="tel:+97143316688" class="hover:text-white transition-colors">+971 4 33 16 688</a>
          </li>
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <a href="mailto:info@alburaq.ae" class="hover:text-white transition-colors">info@alburaq.ae</a>
          </li>
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/>
            </svg>
            <span>Floor 8 &amp; 9, City Tower 2, Sheikh Zayed Road, Dubai, UAE</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#BABABA] font-body">
      <p>Privacy Policy &copy; <strong class="text-primary">Al buraq</strong>. All Rights Reserved</p>
      <div class="flex gap-4">
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms/" class="hover:text-white transition-colors">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>
