---
const nav = [
  { label: 'Home', href: '/' },
  {
    label: 'What We Do',
    href: '#',
    children: [
      { label: 'Licensing', href: '/licensing/' },
      { label: 'Outsourcing', href: '/outsourcing/' },
      { label: 'Payroll Outsourcing UAE', href: '/payroll-outsourcing/' },
      { label: 'Business Center', href: '/business-center/' },
      { label: 'Corporate Sponsorship', href: '/corporate-sponsorship/' },
    ],
  },
  { label: 'Blogs', href: '/blog/' },
  { label: 'About Us', href: '/about-us/' },
  { label: 'Contact Us', href: '/contact-us/' },
];
const current = Astro.url.pathname;
---

<div class="bg-dark text-[#BABABA] text-xs py-2.5">
  <div class="container-site flex flex-col sm:flex-row items-center justify-between gap-1">
    <span class="font-ui">HQ: Floor 8 &amp; 9, City Tower 2, Sheikh Zayed Road, Dubai, UAE</span>
    <div class="flex items-center gap-6 font-ui">
      <a href="mailto:info@alburaq.ae" class="hover:text-white transition-colors">info@alburaq.ae</a>
      <a href="tel:+97143316688" class="hover:text-white transition-colors">+971 4 33 16 688</a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-white border-b border-light shadow-sm">
  <div class="container-site">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex-shrink-0">
        <img src="/images/2024/12/LOGO-AL-BURAQ-GROUP-color.svg" alt="Al Buraq Group" width="160" height="48" class="h-12 w-auto" loading="eager" />
      </a>

      <nav class="hidden lg:flex items-center" aria-label="Main navigation">
        {nav.map((item) => (
          item.children ? (
            <div class="relative group">
              <button class="flex items-center gap-1 px-4 py-2 text-xs font-ui font-semibold uppercase tracking-widest text-dark hover:text-primary transition-colors">
                {item.label}
                <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="currentColor" viewBox="0 0 320 512">
                  <path d="M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7.8-28.3 0L17.2 226.1C4.6 213.5 13.5 192 31.3 192z"/>
                </svg>
              </button>
              <div class="absolute top-full left-0 hidden group-hover:block bg-white shadow-lg min-w-[220px] py-2 z-50 border border-light">
                {item.children.map((child) => (
                  <a href={child.href} class="block px-5 py-2.5 text-xs font-ui font-semibold uppercase tracking-widest text-dark hover:text-primary hover:bg-[#f9f9f9] transition-colors">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} class:list={['px-4 py-2 text-xs font-ui font-semibold uppercase tracking-widest transition-colors', current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'text-primary' : 'text-dark hover:text-primary']}>
              {item.label}
            </a>
          )
        ))}
      </nav>

      <button id="menu-toggle" class="lg:hidden p-2 text-dark" aria-label="Open menu" aria-expanded="false">
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <nav id="mobile-menu" class="hidden lg:hidden border-t border-light pb-2" aria-label="Mobile navigation">
      {nav.map((item) => (
        item.children ? (
          <div>
            <div class="px-4 py-3 text-xs font-ui font-semibold uppercase tracking-widest text-dark border-b border-light">{item.label}</div>
            {item.children.map((child) => (
              <a href={child.href} class="block px-8 py-2.5 text-xs font-ui text-muted hover:text-primary border-b border-light transition-colors">{child.label}</a>
            ))}
          </div>
        ) : (
          <a href={item.href} class="block px-4 py-3 text-xs font-ui font-semibold uppercase tracking-widest text-dark border-b border-light hover:text-primary transition-colors">{item.label}</a>
        )
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iOpen = document.getElementById('icon-open');
  const iClose = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    const open = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', open);
    iOpen?.classList.toggle('hidden', !open);
    iClose?.classList.toggle('hidden', open);
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
