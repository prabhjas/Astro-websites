---
import Base from '../../layouts/Base.astro';

const officeTypes = [
  {
    icon: '/images/2024/12/Private-Suites-icon-red.webp',
    title: 'Private Suites',
    desc: 'Fully furnished private office suites for teams of 1 to 20+. Secure, professional, and ready to use from day one.',
  },
  {
    icon: '/images/2024/12/Flexi-desk-icon-red.webp',
    title: 'Flexi Desks',
    desc: 'Hot-desking options for flexible working. Use the space as much or as little as your business requires.',
  },
  {
    icon: '/images/2024/12/Meeting-Rooms-icon-red.webp',
    title: 'Meeting Rooms',
    desc: 'Fully equipped meeting rooms available by the hour. Professional setting for client meetings and team sessions.',
  },
  {
    icon: '/images/2024/12/Work-stations-icon-red.webp',
    title: 'Workstations',
    desc: 'Dedicated workstations in a shared professional environment. Your own space without the cost of a private office.',
  },
  {
    icon: '/images/2024/12/Video-conferencing-rooms-icon-red.webp',
    title: 'Video Conferencing',
    desc: 'State-of-the-art video conferencing facilities for virtual meetings with clients and partners worldwide.',
  },
  {
    icon: '/images/2024/12/Value-added-services-icon-red.webp',
    title: 'Value-Added Services',
    desc: 'Receptionist services, mail handling, business address, printing, and secretarial support on demand.',
  },
];

const advantages = [
  'Registered UAE business address on Sheikh Zayed Road',
  'No upfront capital outlay — move in ready',
  'Flexible lease terms — monthly, quarterly, or annual',
  'High-speed internet & full IT infrastructure',
  '24/7 access with security',
  "Location in the heart of Dubai's business district",
];
---

<Base
  title="Business Center Dubai | Al Buraq Group"
  description="Premium business center in Dubai offering private offices, flexi desks, meeting rooms, and virtual office solutions. Elevate your UAE business presence."
>

  <!-- Hero -->
  <section class="relative bg-secondary overflow-hidden">
    <img
      src="/images/2024/12/background-all-servicesv2.webp"
      alt="Business Center Dubai"
      class="absolute inset-0 w-full h-full object-cover opacity-20"
    />
    <div class="relative z-10 container mx-auto px-6 max-w-6xl py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-primary text-sm font-semibold uppercase tracking-widest mb-4 block">Our Services</span>
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Business Center</h1>
          <p class="text-gray-300 text-xl leading-relaxed mb-8">
            The fully equipped offices give your business a professional presence in the UAE — offering substantial benefits over traditional leased office spaces.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="bg-primary text-white font-semibold px-8 py-3.5 rounded hover:opacity-90 transition">
              Get Started
            </a>
            <a href="/contact-us/#book" class="border-2 border-white text-white font-semibold px-8 py-3.5 rounded hover:bg-white hover:text-secondary transition">
              Book a Tour
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img
            src="/images/2024/12/BUSINESS-CENTER-SERVICE-MAIN-IMAGE.webp"
            alt="Business Center"
            class="w-full max-w-md ml-auto rounded-2xl shadow-2xl"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img
            src="/images/2024/12/BUSINESS-CENTER-IMAGE-BODY.webp"
            alt="Business Center Dubai"
            class="w-full rounded-2xl shadow-xl object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <span class="text-sm font-semibold uppercase tracking-widest text-primary mb-3 block">What We Offer</span>
          <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">
            A Professional Presence in the Heart of Dubai
          </h2>
          <p class="text-muted leading-relaxed mb-4">
            Al Buraq's business center is located in City Tower 2 on Sheikh Zayed Road — one of Dubai's most prestigious business addresses. Whether you're a startup or an established company, our flexible office solutions give you everything you need to operate professionally.
          </p>
          <p class="text-muted leading-relaxed mb-6">
            Start small with a flexi desk or virtual office, and expand seamlessly as your team grows. Our fully serviced spaces eliminate the overhead of traditional office leases while providing a credible, professional environment for your business.
          </p>

          <h3 class="font-bold text-secondary mb-4">Key Advantages</h3>
          <ul class="space-y-2">
            {advantages.map((a) => (
              <li class="flex items-start gap-3">
                <img src="/images/2024/12/check-icon.webp" alt="" class="w-5 h-5 mt-0.5 flex-shrink-0" />
                <span class="text-muted text-sm">{a}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Office types -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">Our Office Solutions</h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          Choose the workspace that fits your business — from a single desk to a full private suite.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {officeTypes.map((o) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:border-primary hover:shadow-md transition-all">
            <img src={o.icon} alt={o.title} class="w-12 h-12 mb-4 object-contain" loading="lazy" />
            <h3 class="font-bold text-secondary mb-2">{o.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{o.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-secondary relative overflow-hidden">
    <img src="/images/2024/12/background-red-cta.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" aria-hidden="true" />
    <div class="relative z-10 container mx-auto px-6 max-w-6xl text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Ready to Elevate Your Business Presence?</h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">
        Book a tour of our Dubai business center and find the perfect workspace for your team.
      </p>
      <a href="/contact-us/" class="inline-block bg-primary text-white font-bold px-10 py-4 rounded hover:opacity-90 transition">
        Book a Tour
      </a>
    </div>
  </section>

</Base>
