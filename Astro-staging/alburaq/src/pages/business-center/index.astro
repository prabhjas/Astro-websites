---
import Base from '../../layouts/Base.astro';

const officeTypes = [
  { icon: '/images/2024/12/Private-Suites-icon-red.webp', title: 'Private Suites', desc: 'Fully furnished private office suites for teams of 1 to 20+. Secure, professional, and ready to use from day one.' },
  { icon: '/images/2024/12/Flexi-desk-icon-red.webp', title: 'Flexi Desks', desc: 'Hot-desking options for flexible working. Use the space as much or as little as your business requires.' },
  { icon: '/images/2024/12/Meeting-Rooms-icon-red.webp', title: 'Meeting Rooms', desc: 'Fully equipped meeting rooms available by the hour. Professional setting for client meetings and team sessions.' },
  { icon: '/images/2024/12/Work-stations-icon-red.webp', title: 'Workstations', desc: 'Dedicated workstations in a shared professional environment. Your own space without the cost of a private office.' },
  { icon: '/images/2024/12/Video-conferencing-rooms-icon-red.webp', title: 'Video Conferencing', desc: 'State-of-the-art video conferencing facilities for virtual meetings with clients and partners worldwide.' },
  { icon: '/images/2024/12/Value-added-services-icon-red.webp', title: 'Value-Added Services', desc: 'Receptionist services, mail handling, business address, printing, and secretarial support on demand.' },
];

const advantages = [
  'Registered UAE business address on Sheikh Zayed Road',
  'No upfront capital outlay — move in ready',
  'Flexible lease terms — monthly, quarterly, or annual',
  'High-speed internet & full IT infrastructure',
  '24/7 access with security',
  "Location in the heart of Dubai's business district",
];
---

<Base title="Business Center Dubai | Al Buraq Group" description="Premium business center in Dubai offering private offices, flexi desks, meeting rooms, and virtual office solutions.">

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2024/12/background-all-servicesv2.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">Our Services</span>
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">Business Center</h1>
          <p class="text-[#BABABA] text-xl font-body leading-relaxed mb-8">The fully equipped offices give your business a professional presence in the UAE — offering substantial benefits over traditional leased office spaces.</p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="btn-primary">Get Started</a>
            <a href="/contact-us/#book" class="inline-block bg-transparent text-white text-sm font-ui px-7 py-3 border border-white hover:bg-white hover:text-dark transition-colors">Book a Tour</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/images/2024/12/BUSINESS-CENTER-SERVICE-MAIN-IMAGE.webp" alt="Business Center" class="w-full max-w-md ml-auto shadow-2xl" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img src="/images/2024/12/BUSINESS-CENTER-IMAGE-BODY.webp" alt="Business Center Dubai" class="w-full shadow-xl object-cover" loading="lazy" />
        </div>
        <div>
          <span class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-3 block">What We Offer</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-6">A Professional Presence in the Heart of Dubai</h2>
          <p class="text-muted font-body leading-relaxed mb-4">Al Buraq's business center is located in City Tower 2 on Sheikh Zayed Road — one of Dubai's most prestigious business addresses. Whether you're a startup or an established company, our flexible office solutions give you everything you need to operate professionally.</p>
          <p class="text-muted font-body leading-relaxed mb-6">Start small with a flexi desk or virtual office, and expand seamlessly as your team grows. Our fully serviced spaces eliminate the overhead of traditional office leases while providing a credible, professional environment for your business.</p>
          <h3 class="font-heading font-bold text-dark mb-4">Key Advantages</h3>
          <ul class="space-y-2">
            {advantages.map((a) => (
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 mt-1 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span class="text-muted font-body text-sm">{a}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-light">
    <div class="container-site">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4">Our Office Solutions</h2>
        <p class="text-muted font-body text-lg max-w-2xl mx-auto">Choose the workspace that fits your business — from a single desk to a full private suite.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {officeTypes.map((o) => (
          <div class="bg-white p-6 border border-[#E9E9E9] hover:border-primary hover:shadow-md transition-all">
            <div class="bg-primary p-2 self-start inline-block mb-4">
              <img src={o.icon} alt={o.title} class="w-8 h-8 object-contain brightness-0 invert" loading="lazy" />
            </div>
            <h3 class="font-heading font-bold text-dark mb-2">{o.title}</h3>
            <p class="text-muted font-body text-sm leading-relaxed">{o.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-dark text-center">
    <div class="container-site">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">Ready to Elevate Your Business Presence?</h2>
      <p class="text-[#BABABA] font-body text-lg mb-10 max-w-xl mx-auto">Book a tour of our Dubai business center and find the perfect workspace for your team.</p>
      <a href="/contact-us/" class="btn-primary">Book a Tour</a>
    </div>
  </section>

</Base>
