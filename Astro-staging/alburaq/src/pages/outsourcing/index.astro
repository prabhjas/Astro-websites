---
import Base from '../../layouts/Base.astro';

const benefits = [
  { title: 'Visa & Work Permits', desc: 'We handle UAE residence visas and work permits for your staff — removing the administrative complexity entirely.' },
  { title: 'Employment Contracts', desc: 'Fully compliant employment contracts drafted and managed in accordance with UAE Labour Law.' },
  { title: 'HR Administration', desc: 'End-to-end HR admin: onboarding, offboarding, leave management, and employee records.' },
  { title: 'Staff Deployment', desc: 'Rapidly deploy skilled staff under our license to fill roles across your UAE operations.' },
  { title: 'Compliance Management', desc: 'Stay compliant with MOHRE regulations, Emiratisation quotas, and annual reporting requirements.' },
  { title: 'Cost Reduction', desc: 'Reduce overhead costs by outsourcing your workforce management to our specialist team.' },
];
---

<Base title="HR Outsourcing UAE | Al Buraq Group" description="Al Buraq provides comprehensive HR outsourcing solutions in the UAE — visas, contracts, payroll, and full workforce management.">

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2024/12/background-all-servicesv2.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">Our Services</span>
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">Outsourcing Services</h1>
          <p class="text-[#BABABA] text-xl font-body leading-relaxed mb-8">With Al Buraq's outsourcing solutions, businesses avoid the challenges of visa restrictions and manpower shortages. Smooth operations guaranteed.</p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="btn-primary">Get Started</a>
            <a href="/contact-us/#book" class="inline-block bg-transparent text-white text-sm font-ui px-7 py-3 border border-white hover:bg-white hover:text-dark transition-colors">Book a Meeting</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/images/2024/12/HR-OUTSOURCING-SERVICE-MAIN-PAGE.webp" alt="HR Outsourcing" class="w-full max-w-md ml-auto shadow-2xl" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img src="/images/2024/12/HR-OUTSOURCING-IMAGE-BODY.webp" alt="HR outsourcing" class="w-full shadow-xl object-cover" loading="lazy" />
        </div>
        <div>
          <span class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-3 block">What We Offer</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-6">Your Full HR Department, Outsourced</h2>
          <p class="text-muted font-body leading-relaxed mb-4">Managing a workforce in the UAE involves navigating complex visa requirements, labour law obligations, and government reporting deadlines. Al Buraq's outsourcing service removes all of this complexity.</p>
          <p class="text-muted font-body leading-relaxed mb-4">We act as the employer of record for your UAE-based staff — issuing visas, handling contracts, and managing all HR administration under our established licenses. You get the talent; we handle the paperwork.</p>
          <p class="text-muted font-body leading-relaxed mb-8">Ideal for international companies entering the UAE market, or established businesses looking to reduce HR overhead and maintain full compliance.</p>
          <a href="/contact-us/" class="btn-primary">Talk to an Expert</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-light">
    <div class="container-site">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4">What's Included</h2>
        <p class="text-muted font-body text-lg max-w-2xl mx-auto">Comprehensive outsourcing that covers every aspect of your UAE workforce.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {benefits.map((b) => (
          <div class="bg-white p-6 border border-[#E9E9E9] hover:border-primary hover:shadow-md transition-all">
            <div class="bg-primary w-8 h-1 mb-4"></div>
            <h3 class="font-heading font-bold text-dark mb-2">{b.title}</h3>
            <p class="text-muted font-body text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-dark text-center">
    <div class="container-site">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">Streamline Your Workforce Today</h2>
      <p class="text-[#BABABA] font-body text-lg mb-10 max-w-xl mx-auto">Let Al Buraq handle all HR complexity so your business can focus on what it does best.</p>
      <a href="/contact-us/" class="btn-primary">Contact Us Now</a>
    </div>
  </section>

</Base>
