---
import Base from '../../layouts/Base.astro';

const types = [
  { title: 'Commercial License', desc: 'For trading companies importing, exporting, and distributing goods across the UAE and internationally.' },
  { title: 'Professional License', desc: 'For service-based businesses, consultancies, freelancers, and professional firms.' },
  { title: 'Industrial License', desc: 'For manufacturing operations and industrial activities within the UAE.' },
  { title: 'Free Zone License', desc: '100% foreign ownership in designated free zones with full profit repatriation.' },
  { title: 'Mainland License', desc: 'Operate anywhere in the UAE with access to the full local market.' },
  { title: 'Offshore License', desc: 'International business structures for holding companies and cross-border operations.' },
];
---

<Base title="Business Licensing UAE | Al Buraq Group" description="Expert business licensing services in the UAE. Al Buraq guides you through obtaining the right license to launch and operate your business.">

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2024/12/background-all-servicesv2.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">Our Services</span>
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">Licensing</h1>
          <p class="text-[#BABABA] text-xl font-body leading-relaxed mb-8">Companies and entrepreneurs get guidance on obtaining the necessary licenses to launch and operate business ventures in the UAE.</p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="btn-primary">Start Your License</a>
            <a href="/contact-us/#book" class="inline-block bg-transparent text-white text-sm font-ui px-7 py-3 border border-white hover:bg-white hover:text-dark transition-colors">Book a Meeting</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/images/2024/12/LICENSING-SERVICE-MAIN-IMAGE.webp" alt="Licensing UAE" class="w-full max-w-md ml-auto shadow-2xl" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img src="/images/2024/12/LICENSING-IMAGE-BODY.webp" alt="Business licensing" class="w-full shadow-xl object-cover" loading="lazy" />
        </div>
        <div>
          <span class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-3 block">What We Offer</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-6">The Right License for Your Business</h2>
          <p class="text-muted font-body leading-relaxed mb-4">Navigating UAE licensing requirements can be complex. Al Buraq simplifies the entire process — from identifying the correct license type to handling all government submissions on your behalf.</p>
          <p class="text-muted font-body leading-relaxed mb-4">With 18 years of experience and privileged access to unique licensing opportunities not normally available to foreign entrepreneurs, we give your business a distinct competitive advantage.</p>
          <p class="text-muted font-body leading-relaxed mb-8">Whether you're setting up a mainland company, free zone entity, or offshore structure, we match your business activity to the optimal licensing framework.</p>
          <a href="/contact-us/" class="btn-primary">Get Expert Advice</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-light">
    <div class="container-site">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4">License Types We Handle</h2>
        <p class="text-muted font-body text-lg max-w-2xl mx-auto">We cover the full spectrum of UAE business licenses across all jurisdictions.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {types.map((t) => (
          <div class="bg-white p-6 border border-[#E9E9E9] hover:border-primary hover:shadow-md transition-all">
            <div class="bg-primary w-8 h-1 mb-4"></div>
            <h3 class="font-heading font-bold text-dark mb-2">{t.title}</h3>
            <p class="text-muted font-body text-sm leading-relaxed">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-dark text-center">
    <div class="container-site">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">Ready to Get Licensed?</h2>
      <p class="text-[#BABABA] font-body text-lg mb-10 max-w-xl mx-auto">Our licensing experts are ready to guide you from application to approval.</p>
      <a href="/contact-us/" class="btn-primary">Start Today</a>
    </div>
  </section>

</Base>
