---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Contact Us | Al Buraq - Corporate Business Solutions UAE"
  description="Get in touch with Al Buraq Group. Schedule a consultation for corporate business solutions, licensing, outsourcing, and sponsorship services in the UAE."
>

  <!-- Hero -->
  <section class="relative bg-secondary overflow-hidden">
    <img
      src="/images/2024/12/Background-contact-us.webp"
      alt="Contact Al Buraq Group"
      class="absolute inset-0 w-full h-full object-cover opacity-25"
    />
    <div class="relative z-10 container mx-auto px-6 max-w-6xl py-24 text-center">
      <span class="text-primary text-sm font-semibold uppercase tracking-widest mb-4 block">Get In Touch</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Contact Us</h1>
      <p class="text-gray-300 text-xl max-w-2xl mx-auto">
        Complete the form and schedule your personalized consultation today!
      </p>
    </div>
  </section>

  <!-- Contact section -->
  <section class="py-20 bg-white" id="book">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16 items-start">

        <!-- Contact info -->
        <div>
          <h2 class="text-3xl font-bold text-secondary mb-6">Let's Talk</h2>
          <p class="text-muted leading-relaxed mb-10">
            Our team is ready to help you navigate the complexities of doing business in the UAE, Qatar, and Saudi Arabia. Reach out and we'll get back to you promptly.
          </p>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-secondary mb-1">Head Office</p>
                <p class="text-muted text-sm">Floor 8 &amp; 9, City Tower 2, Sheikh Zayed Road, Dubai, UAE</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-secondary mb-1">Phone</p>
                <a href="tel:+97143316688" class="text-primary hover:underline text-sm">+971 4 33 16 688</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-secondary mb-1">Email</p>
                <a href="mailto:info@alburaq.ae" class="text-primary hover:underline text-sm">info@alburaq.ae</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                  <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.122 1.52 5.856L0 24l6.335-1.502A11.946 11.946 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.885 0-3.65-.49-5.187-1.352l-.371-.22-3.762.893.947-3.656-.242-.382A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-secondary mb-1">WhatsApp</p>
                <a href="https://wa.me/971501234567" target="_blank" rel="noopener" class="text-primary hover:underline text-sm">Chat with us on WhatsApp</a>
              </div>
            </div>
          </div>

          <!-- Images -->
          <div class="grid grid-cols-2 gap-4 mt-10">
            <img src="/images/2024/12/image-Contact-us-2.webp" alt="Al Buraq office" class="rounded-xl object-cover w-full h-40" loading="lazy" />
            <img src="/images/2024/12/image-Contact-us-3.webp" alt="Al Buraq team" class="rounded-xl object-cover w-full h-40" loading="lazy" />
          </div>
        </div>

        <!-- Contact form -->
        <div class="bg-gray-50 rounded-2xl p-8 shadow-sm">
          <h3 class="text-2xl font-bold text-secondary mb-2">Send Us a Message</h3>
          <p class="text-muted text-sm mb-8">We'll get back to you within 24 hours.</p>

          <form
            id="contact-form"
            action="https://formspree.io/f/alburaq"
            method="POST"
            class="space-y-5"
          >
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="first_name" class="block text-sm font-semibold text-secondary mb-1.5">First Name <span class="text-red-500">*</span></label>
                <input
                  type="text" id="first_name" name="first_name" required
                  placeholder="John"
                  class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white transition"
                />
              </div>
              <div>
                <label for="last_name" class="block text-sm font-semibold text-secondary mb-1.5">Last Name <span class="text-red-500">*</span></label>
                <input
                  type="text" id="last_name" name="last_name" required
                  placeholder="Smith"
                  class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white transition"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-secondary mb-1.5">Email Address <span class="text-red-500">*</span></label>
              <input
                type="email" id="email" name="email" required
                placeholder="john@company.com"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white transition"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-semibold text-secondary mb-1.5">Phone Number</label>
              <input
                type="tel" id="phone" name="phone"
                placeholder="+971 50 000 0000"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white transition"
              />
            </div>

            <div>
              <label for="service" class="block text-sm font-semibold text-secondary mb-1.5">Service Interested In</label>
              <select
                id="service" name="service"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white transition"
              >
                <option value="">Select a service</option>
                <option value="Corporate Sponsorship">Corporate Sponsorship</option>
                <option value="Licensing">Licensing</option>
                <option value="Outsourcing Services">Outsourcing Services</option>
                <option value="Payroll Outsourcing">Payroll Outsourcing UAE</option>
                <option value="Business Center">Business Center</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-secondary mb-1.5">Message <span class="text-red-500">*</span></label>
              <textarea
                id="message" name="message" required rows="5"
                placeholder="Tell us about your business needs..."
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white transition resize-none"
              ></textarea>
            </div>

            <!-- Honeypot -->
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

            <button
              type="submit"
              class="w-full bg-primary text-white font-semibold py-3.5 rounded-lg hover:opacity-90 transition text-sm tracking-wide"
            >
              Submit Message
            </button>

            <div id="form-success" class="hidden text-center py-3 text-green-600 font-semibold text-sm">
              ✓ Thank you! We'll be in touch shortly.
            </div>
            <div id="form-error" class="hidden text-center py-3 text-red-500 font-semibold text-sm">
              Something went wrong. Please try again or email us directly.
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>

</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');
  const error = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.reset();
        success?.classList.remove('hidden');
        error?.classList.add('hidden');
      } else {
        throw new Error('Server error');
      }
    } catch {
      error?.classList.remove('hidden');
      success?.classList.add('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Submit Message';
    }
  });
</script>
