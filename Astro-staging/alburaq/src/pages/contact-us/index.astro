---
import Base from '../../layouts/Base.astro';
---

<Base title="Contact Al Buraq | UAE Corporate Business Solutions" description="Get in touch with Al Buraq Group. Contact us for licensing, outsourcing, business center, and corporate sponsorship inquiries in the UAE.">

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2024/12/background-all-servicesv2.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-24 lg:py-28">
      <div class="max-w-xl">
        <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">Get In Touch</span>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-4">Contact Us</h1>
        <p class="text-[#BABABA] text-lg font-body">Reach out to our team and take the next step toward your business goals in the UAE.</p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-start">

        <!-- Contact form -->
        <div id="book">
          <h2 class="text-2xl font-heading font-bold text-dark mb-8">Send Us a Message</h2>
          <form
            action="https://formspree.io/f/alburaq"
            method="POST"
            class="space-y-5"
          >
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="fname" class="block text-xs font-ui font-semibold uppercase tracking-widest text-dark mb-2">First Name</label>
                <input type="text" id="fname" name="first_name" required class="w-full border border-[#E9E9E9] px-4 py-3 font-body text-sm focus:outline-none focus:border-primary transition-colors" />
              </div>
              <div>
                <label for="lname" class="block text-xs font-ui font-semibold uppercase tracking-widest text-dark mb-2">Last Name</label>
                <input type="text" id="lname" name="last_name" required class="w-full border border-[#E9E9E9] px-4 py-3 font-body text-sm focus:outline-none focus:border-primary transition-colors" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-ui font-semibold uppercase tracking-widest text-dark mb-2">Email Address</label>
              <input type="email" id="email" name="email" required class="w-full border border-[#E9E9E9] px-4 py-3 font-body text-sm focus:outline-none focus:border-primary transition-colors" />
            </div>
            <div>
              <label for="phone" class="block text-xs font-ui font-semibold uppercase tracking-widest text-dark mb-2">Phone Number</label>
              <input type="tel" id="phone" name="phone" class="w-full border border-[#E9E9E9] px-4 py-3 font-body text-sm focus:outline-none focus:border-primary transition-colors" />
            </div>
            <div>
              <label for="service" class="block text-xs font-ui font-semibold uppercase tracking-widest text-dark mb-2">Service Interested In</label>
              <select id="service" name="service" class="w-full border border-[#E9E9E9] px-4 py-3 font-body text-sm focus:outline-none focus:border-primary transition-colors bg-white">
                <option value="">Select a service...</option>
                <option value="licensing">Licensing</option>
                <option value="outsourcing">HR Outsourcing</option>
                <option value="payroll">Payroll Outsourcing</option>
                <option value="business-center">Business Center</option>
                <option value="corporate-sponsorship">Corporate Sponsorship</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-xs font-ui font-semibold uppercase tracking-widest text-dark mb-2">Message</label>
              <textarea id="message" name="message" rows="5" class="w-full border border-[#E9E9E9] px-4 py-3 font-body text-sm focus:outline-none focus:border-primary transition-colors resize-none"></textarea>
            </div>
            <button type="submit" class="btn-primary w-full text-center">Submit Message</button>
          </form>
        </div>

        <!-- Contact details -->
        <div class="space-y-8">
          <h2 class="text-2xl font-heading font-bold text-dark">Our Details</h2>

          <div>
            <div class="flex items-center gap-3 mb-1">
              <div class="bg-primary p-2">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/></svg>
              </div>
              <span class="text-xs font-ui font-semibold uppercase tracking-widest text-dark">Head Office</span>
            </div>
            <p class="text-muted font-body text-sm ml-10">Floor 8 &amp; 9, City Tower 2, Sheikh Zayed Road, Dubai, UAE</p>
          </div>

          <div>
            <div class="flex items-center gap-3 mb-1">
              <div class="bg-primary p-2">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
              </div>
              <span class="text-xs font-ui font-semibold uppercase tracking-widest text-dark">Phone</span>
            </div>
            <p class="ml-10"><a href="tel:+97143316688" class="text-muted font-body text-sm hover:text-primary transition-colors">+971 4 33 16 688</a></p>
          </div>

          <div>
            <div class="flex items-center gap-3 mb-1">
              <div class="bg-primary p-2">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              </div>
              <span class="text-xs font-ui font-semibold uppercase tracking-widest text-dark">Email</span>
            </div>
            <p class="ml-10"><a href="mailto:info@alburaq.ae" class="text-muted font-body text-sm hover:text-primary transition-colors">info@alburaq.ae</a></p>
          </div>

          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="bg-primary p-2">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
              </div>
              <span class="text-xs font-ui font-semibold uppercase tracking-widest text-dark">Working Hours</span>
            </div>
            <p class="text-muted font-body text-sm ml-10">Monday – Friday: 9:00 AM – 6:00 PM</p>
            <p class="text-muted font-body text-sm ml-10">Saturday: 10:00 AM – 2:00 PM</p>
          </div>

          <!-- Map placeholder -->
          <div class="mt-6 bg-light h-52 flex items-center justify-center border border-[#E9E9E9]">
            <a href="https://maps.google.com/?q=City+Tower+2+Sheikh+Zayed+Road+Dubai" target="_blank" rel="noopener" class="btn-primary">View on Google Maps</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
