---
import Base from '../../layouts/Base.astro';

const features = [
  { title: 'WPS Compliant Payroll', desc: 'Full compliance with UAE Wages Protection System (WPS) — salaries transferred on time through authorized SIF files.' },
  { title: 'Multi-Currency Processing', desc: 'Process payroll in AED, USD, EUR and other currencies for your international workforce.' },
  { title: 'End-of-Service Gratuity', desc: 'Accurate calculation and provisioning of end-of-service benefits per UAE Labour Law requirements.' },
  { title: 'Payslip Management', desc: 'Automated, branded payslip generation and distribution to employees each pay cycle.' },
  { title: 'Leave & Absence Tracking', desc: 'Track annual leave, sick leave, and public holidays integrated directly into payroll calculations.' },
  { title: 'Regulatory Reporting', desc: 'Monthly and annual compliance reporting to MOHRE, GPSSA, and other relevant authorities.' },
];
---

<Base title="Payroll Outsourcing UAE | Al Buraq Group" description="WPS-compliant payroll outsourcing services in the UAE. Al Buraq handles your payroll processing, end-of-service gratuity, and all regulatory reporting.">

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2024/12/background-all-servicesv2.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">Our Services</span>
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">Payroll Outsourcing UAE</h1>
          <p class="text-[#BABABA] text-xl font-body leading-relaxed mb-8">Accurate, WPS-compliant payroll processing for businesses of all sizes. Let us handle your entire payroll operation so you can focus on growth.</p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="btn-primary">Get Started</a>
            <a href="/contact-us/#book" class="inline-block bg-transparent text-white text-sm font-ui px-7 py-3 border border-white hover:bg-white hover:text-dark transition-colors">Book a Meeting</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/images/2024/12/HR-OUTSOURCING-SERVICE-MAIN-PAGE.webp" alt="Payroll Outsourcing" class="w-full max-w-md ml-auto shadow-2xl" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img src="/images/2024/12/HR-OUTSOURCING-IMAGE-BODY.webp" alt="Payroll processing" class="w-full shadow-xl object-cover" loading="lazy" />
        </div>
        <div>
          <span class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-3 block">What We Offer</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-6">Complete Payroll Management for UAE Businesses</h2>
          <p class="text-muted font-body leading-relaxed mb-4">Managing payroll in the UAE requires strict compliance with WPS regulations, labour law, and timely reporting to multiple government authorities. Any error can result in significant fines and operational disruptions.</p>
          <p class="text-muted font-body leading-relaxed mb-4">Al Buraq's payroll outsourcing service takes the entire payroll burden off your plate. Our certified payroll specialists ensure every salary run is accurate, on time, and fully compliant with all UAE regulations.</p>
          <p class="text-muted font-body leading-relaxed mb-8">From a team of 5 to an organization of 500+, our scalable payroll solution grows with your business while maintaining the same high standard of accuracy and compliance.</p>
          <a href="/contact-us/" class="btn-primary">Get a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-light">
    <div class="container-site">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4">What's Included</h2>
        <p class="text-muted font-body text-lg max-w-2xl mx-auto">A comprehensive payroll service covering every aspect of employee compensation management.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((f) => (
          <div class="bg-white p-6 border border-[#E9E9E9] hover:border-primary hover:shadow-md transition-all">
            <div class="bg-primary p-2 self-start inline-block mb-4">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <h3 class="font-heading font-bold text-dark mb-2">{f.title}</h3>
            <p class="text-muted font-body text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-dark text-center">
    <div class="container-site">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">Take the Payroll Burden Off Your Plate</h2>
      <p class="text-[#BABABA] font-body text-lg mb-10 max-w-xl mx-auto">Let our payroll specialists handle everything while you focus on what matters most — growing your business.</p>
      <a href="/contact-us/" class="btn-primary">Contact Us Now</a>
    </div>
  </section>

</Base>
