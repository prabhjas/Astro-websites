---
import Base from '../../layouts/Base.astro';

const features = [
  { title: 'WPS Compliant Payroll', desc: 'Full compliance with UAE Wages Protection System (WPS) — salaries transferred on time through authorized SIF files.' },
  { title: 'Multi-Currency Processing', desc: 'Process payroll in AED, USD, EUR and other currencies for your international workforce.' },
  { title: 'End-of-Service Gratuity', desc: 'Accurate calculation and provisioning of end-of-service benefits per UAE Labour Law requirements.' },
  { title: 'Payslip Management', desc: 'Automated, branded payslip generation and distribution to employees each pay cycle.' },
  { title: 'Leave & Absence Tracking', desc: 'Track annual leave, sick leave, and public holidays integrated directly into payroll calculations.' },
  { title: 'Regulatory Reporting', desc: 'Monthly and annual compliance reporting to MOHRE, GPSSA, and other relevant authorities.' },
];
---

<Base
  title="Payroll Outsourcing UAE | Al Buraq Group"
  description="WPS-compliant payroll outsourcing services in the UAE. Al Buraq handles your payroll processing, end-of-service gratuity, and all regulatory reporting."
>

  <!-- Hero -->
  <section class="relative bg-secondary overflow-hidden">
    <img
      src="/images/2024/12/background-all-servicesv2.webp"
      alt="Payroll Outsourcing UAE"
      class="absolute inset-0 w-full h-full object-cover opacity-20"
    />
    <div class="relative z-10 container mx-auto px-6 max-w-6xl py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-primary text-sm font-semibold uppercase tracking-widest mb-4 block">Our Services</span>
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Payroll Outsourcing UAE</h1>
          <p class="text-gray-300 text-xl leading-relaxed mb-8">
            Accurate, WPS-compliant payroll processing for businesses of all sizes. Let us handle your entire payroll operation so you can focus on growth.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="bg-primary text-white font-semibold px-8 py-3.5 rounded hover:opacity-90 transition">
              Get Started
            </a>
            <a href="/contact-us/#book" class="border-2 border-white text-white font-semibold px-8 py-3.5 rounded hover:bg-white hover:text-secondary transition">
              Book a Meeting
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img
            src="/images/2024/12/HR-OUTSOURCING-SERVICE-MAIN-PAGE.webp"
            alt="Payroll Outsourcing"
            class="w-full max-w-md ml-auto rounded-2xl shadow-2xl"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img
            src="/images/2024/12/HR-OUTSOURCING-IMAGE-BODY.webp"
            alt="Payroll processing"
            class="w-full rounded-2xl shadow-xl object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <span class="text-sm font-semibold uppercase tracking-widest text-primary mb-3 block">What We Offer</span>
          <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">
            Complete Payroll Management for UAE Businesses
          </h2>
          <p class="text-muted leading-relaxed mb-4">
            Managing payroll in the UAE requires strict compliance with WPS regulations, labour law, and timely reporting to multiple government authorities. Any error can result in significant fines and operational disruptions.
          </p>
          <p class="text-muted leading-relaxed mb-4">
            Al Buraq's payroll outsourcing service takes the entire payroll burden off your plate. Our certified payroll specialists ensure every salary run is accurate, on time, and fully compliant with all UAE regulations.
          </p>
          <p class="text-muted leading-relaxed mb-8">
            From a team of 5 to an organization of 500+, our scalable payroll solution grows with your business while maintaining the same high standard of accuracy and compliance.
          </p>
          <a href="/contact-us/" class="inline-block bg-primary text-white font-semibold px-8 py-3.5 rounded hover:opacity-90 transition">
            Get a Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">What's Included</h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          A comprehensive payroll service covering every aspect of employee compensation management.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((f) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:border-primary hover:shadow-md transition-all">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 class="font-bold text-secondary mb-2">{f.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-secondary relative overflow-hidden">
    <img src="/images/2024/12/background-red-cta.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" aria-hidden="true" />
    <div class="relative z-10 container mx-auto px-6 max-w-6xl text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Take the Payroll Burden Off Your Plate</h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">
        Let our payroll specialists handle everything while you focus on what matters most — growing your business.
      </p>
      <a href="/contact-us/" class="inline-block bg-primary text-white font-bold px-10 py-4 rounded hover:opacity-90 transition">
        Contact Us Now
      </a>
    </div>
  </section>

</Base>
