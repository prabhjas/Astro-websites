---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} | Al Buraq`}
  description={post.data.description}
  image={post.data.image}
>

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2025/01/Background-Insights-image.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-20 lg:py-24">
      <div class="max-w-3xl">
        {post.data.category && (
          <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">{post.data.category}</span>
        )}
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-white leading-[1.3]">{post.data.title}</h1>
        {post.data.date && (
          <p class="text-[#BABABA] text-sm font-ui mt-4">
            {new Date(post.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            {post.data.author && <> &middot; By {post.data.author}</>}
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-[1fr_300px] gap-12">

        <article>
          {post.data.image && (
            <img src={post.data.image} alt={post.data.title} class="w-full mb-10 object-cover" loading="eager" />
          )}
          <div class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-dark prose-headings:font-bold prose-a:text-primary prose-p:text-muted prose-p:font-body prose-li:text-muted prose-li:font-body">
            <Content />
          </div>
        </article>

        <aside class="space-y-8">
          <div class="bg-dark p-6 text-white">
            <img src="/images/2024/12/middle-logo-white-1.svg" alt="Al Buraq" class="h-10 w-auto mb-4" loading="lazy" />
            <h3 class="font-heading font-bold text-lg mb-3">Ready to grow your business?</h3>
            <p class="text-[#BABABA] text-sm font-body mb-5">Our experts are ready to help you navigate the UAE business landscape.</p>
            <a href="/contact-us/" class="btn-primary block text-center">Contact Us Now</a>
          </div>

          <div class="bg-light p-6">
            <h3 class="font-heading font-bold text-dark mb-4 text-sm uppercase tracking-widest">Our Services</h3>
            <ul class="space-y-2">
              {['Licensing', 'HR Outsourcing', 'Payroll Outsourcing', 'Business Center', 'Corporate Sponsorship'].map(s => (
                <li>
                  <a href={`/${s.toLowerCase().replace(/ /g, '-')}/`} class="text-sm text-muted font-body hover:text-primary transition-colors flex items-center gap-2">
                    <span class="w-1 h-1 bg-primary inline-block flex-shrink-0"></span>{s}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>

      </div>
    </div>
  </section>

</Base>
