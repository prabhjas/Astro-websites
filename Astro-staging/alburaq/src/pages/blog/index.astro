---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime()
);
---

<Base
  title="Business Insights & UAE Business Blog | Al Buraq"
  description="Expert insights on business setup, licensing, outsourcing, and corporate solutions in the UAE. Stay informed with Al Buraq's business blog."
>

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2025/01/Background-Insights-image.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-24 lg:py-28">
      <div class="max-w-xl">
        <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">Insights & News</span>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-4">Business Insights</h1>
        <p class="text-[#BABABA] text-lg font-body">Expert guides on UAE business setup, licensing, outsourcing, and corporate solutions.</p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-site">
      {posts.length === 0 ? (
        <p class="text-muted font-body">No posts yet.</p>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="bg-white border border-[#E9E9E9] hover:border-primary hover:shadow-md transition-all flex flex-col">
              {post.data.image && (
                <a href={`/blog/${post.id}/`}>
                  <img src={post.data.image} alt={post.data.title} class="w-full h-52 object-cover" loading="lazy" />
                </a>
              )}
              <div class="p-6 flex flex-col flex-1">
                {post.data.category && (
                  <span class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-2">{post.data.category}</span>
                )}
                <h2 class="font-heading font-bold text-dark text-lg leading-snug mb-3 flex-1">
                  <a href={`/blog/${post.id}/`} class="hover:text-primary transition-colors">
                    {post.data.title}
                  </a>
                </h2>
                {post.data.description && (
                  <p class="text-sm text-muted font-body leading-relaxed mb-3 line-clamp-2">{post.data.description}</p>
                )}
                {post.data.date && (
                  <p class="text-xs text-muted font-ui mb-3">
                    {new Date(post.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </p>
                )}
                <a href={`/blog/${post.id}/`} class="text-sm font-ui font-semibold text-primary hover:underline">
                  Read More &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

</Base>
