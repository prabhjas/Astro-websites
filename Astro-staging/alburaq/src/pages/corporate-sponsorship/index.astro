---
import Base from '../../layouts/Base.astro';

const benefits = [
  { title: 'Verified Local Sponsors', desc: 'We match you with pre-vetted UAE nationals who have the industry knowledge and government connections your business needs.' },
  { title: 'Transparent Agreements', desc: 'Clear, legally sound sponsorship contracts that define roles, responsibilities, and profit-sharing terms from day one.' },
  { title: 'Government Liaison', desc: 'Your sponsor actively represents your business in dealings with UAE government authorities.' },
  { title: 'Full Business Control', desc: 'You retain full operational control of your business. The sponsor fulfills the legal requirement, nothing more.' },
  { title: 'Industry Expertise', desc: 'Sponsors selected for their specific industry knowledge and established relationships in your sector.' },
  { title: '18+ Years of Trust', desc: 'Hundreds of successful sponsorship arrangements spanning 18+ years of operation in the UAE.' },
];
---

<Base title="Corporate Sponsorship UAE | Al Buraq Group" description="Al Buraq connects international businesses with trusted UAE local sponsors for corporate sponsorship arrangements. Full compliance, full control.">

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2024/12/background-all-servicesv2.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">Our Services</span>
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">Corporate Sponsorship</h1>
          <p class="text-[#BABABA] text-xl font-body leading-relaxed mb-8">We connect your business with the ideal local sponsor. They represent your interests effectively in dealings with the government.</p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="btn-primary">Find a Sponsor</a>
            <a href="/contact-us/#book" class="inline-block bg-transparent text-white text-sm font-ui px-7 py-3 border border-white hover:bg-white hover:text-dark transition-colors">Book a Meeting</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/images/2024/12/CORPORATE-SPONSORSHIP-SERVICE-MAIN-IMAGE.webp" alt="Corporate Sponsorship" class="w-full max-w-md ml-auto shadow-2xl" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img src="/images/2024/12/CORPORATE-SPONSORSHIP-IMAGE-BODY.webp" alt="Corporate Sponsorship" class="w-full shadow-xl object-cover" loading="lazy" />
        </div>
        <div>
          <span class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-3 block">What We Offer</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-6">The Right Sponsor Makes All the Difference</h2>
          <p class="text-muted font-body leading-relaxed mb-4">For many business activities in the UAE, foreign entrepreneurs are required to partner with a UAE national local sponsor. Choosing the wrong sponsor can create serious complications — Al Buraq ensures you choose the right one.</p>
          <p class="text-muted font-body leading-relaxed mb-4">We maintain a network of trusted UAE nationals across multiple industries, each carefully selected for their business acumen, government connections, and professional reputation.</p>
          <p class="text-muted font-body leading-relaxed mb-8">Our transparent agreements mean you retain full day-to-day operational control while your sponsor fulfills their legal role. A genuine partnership built on trust.</p>
          <a href="/contact-us/" class="btn-primary">Speak to an Advisor</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-light">
    <div class="container-site">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4">Why Al Buraq for Corporate Sponsorship?</h2>
        <p class="text-muted font-body text-lg max-w-2xl mx-auto">We do more than introduce you to a sponsor — we manage the entire relationship.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {benefits.map((b) => (
          <div class="bg-white p-6 border border-[#E9E9E9] hover:border-primary hover:shadow-md transition-all">
            <div class="bg-primary w-8 h-1 mb-4"></div>
            <h3 class="font-heading font-bold text-dark mb-2">{b.title}</h3>
            <p class="text-muted font-body text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-dark text-center">
    <div class="container-site">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">Find Your Ideal UAE Sponsor Today</h2>
      <p class="text-[#BABABA] font-body text-lg mb-10 max-w-xl mx-auto">Tell us about your business and we'll match you with the perfect local sponsor for your industry.</p>
      <a href="/contact-us/" class="btn-primary">Contact Us Now</a>
    </div>
  </section>

</Base>
