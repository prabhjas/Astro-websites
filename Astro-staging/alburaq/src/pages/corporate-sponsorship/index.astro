---
import Base from '../../layouts/Base.astro';

const benefits = [
  { title: 'Government Representation', desc: 'Your local sponsor actively represents your business in all dealings with UAE government entities, ensuring smooth compliance.' },
  { title: 'Beneficial Ownership Protection', desc: 'Our nominee partnership structure protects your ownership interests while fulfilling local legal requirements.' },
  { title: 'Industry-Specific Expertise', desc: 'We match you with sponsors who have deep knowledge of your specific industry and regulatory landscape.' },
  { title: 'Long-Term Partnership', desc: 'We build lasting relationships, not just transactions. Our sponsors are committed to your ongoing business success.' },
  { title: 'Legal Compliance', desc: 'Full compliance with UAE commercial law, trade regulations, and annual licensing requirements.' },
  { title: 'Transparent Agreements', desc: 'Clear, legally-binding sponsorship agreements that protect both parties with full transparency.' },
];
---

<Base
  title="Corporate Sponsorship UAE | Al Buraq Group"
  description="Al Buraq connects your business with the ideal UAE local sponsor. Expert corporate sponsorship services for foreign companies operating in the UAE."
>

  <!-- Hero -->
  <section class="relative bg-secondary overflow-hidden">
    <img
      src="/images/2024/12/background-all-servicesv2.webp"
      alt="Corporate Sponsorship UAE"
      class="absolute inset-0 w-full h-full object-cover opacity-20"
    />
    <div class="relative z-10 container mx-auto px-6 max-w-6xl py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-primary text-sm font-semibold uppercase tracking-widest mb-4 block">Our Services</span>
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Corporate Sponsorship</h1>
          <p class="text-gray-300 text-xl leading-relaxed mb-8">
            We connect your business with the ideal local sponsor. They represent your interests effectively in dealings with the government.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="bg-primary text-white font-semibold px-8 py-3.5 rounded hover:opacity-90 transition">
              Get Started
            </a>
            <a href="/contact-us/#book" class="border-2 border-white text-white font-semibold px-8 py-3.5 rounded hover:bg-white hover:text-secondary transition">
              Book a Meeting
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img
            src="/images/2024/12/CORPORATE-SPONSORSHIP-SERVICE-MAIN-IMAGE-v2-1-1.webp"
            alt="Corporate Sponsorship Service"
            class="w-full max-w-md ml-auto rounded-2xl shadow-2xl"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- About the service -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img
            src="/images/2024/12/CORPORATE-SPONSORSHIP-IMAGE-BODY.webp"
            alt="Corporate Sponsorship"
            class="w-full rounded-2xl shadow-xl object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <span class="text-sm font-semibold uppercase tracking-widest text-primary mb-3 block">What We Offer</span>
          <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">
            The Right Sponsor for Your Business
          </h2>
          <p class="text-muted leading-relaxed mb-4">
            In the UAE, many business activities require a local sponsor — a UAE national who holds a portion of the company shares. Finding the right sponsor is critical to your business success.
          </p>
          <p class="text-muted leading-relaxed mb-4">
            Al Buraq Group has built an extensive network of qualified, reputable local sponsors across all business sectors. We carefully match each client with a sponsor whose background, expertise, and government connections align with the client's business needs.
          </p>
          <p class="text-muted leading-relaxed mb-8">
            Our beneficial ownership protection services ensure that while your sponsor fulfills legal requirements, your actual business control and ownership interests are fully protected through legally binding side agreements.
          </p>
          <ul class="space-y-3">
            {['Sponsor matching based on industry & sector', 'Full legal agreements & documentation', 'Ongoing sponsor relationship management', 'Government liaison & representation'].map((item) => (
              <li class="flex items-start gap-3">
                <img src="/images/2024/12/check-icon.webp" alt="" class="w-5 h-5 mt-0.5 flex-shrink-0" />
                <span class="text-muted text-sm">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">Why Choose Al Buraq for Sponsorship?</h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          18+ years of experience connecting businesses with the right local partners.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {benefits.map((b) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:border-primary hover:shadow-md transition-all">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 class="font-bold text-secondary mb-2">{b.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-secondary relative overflow-hidden">
    <img src="/images/2024/12/background-red-cta.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" aria-hidden="true" />
    <div class="relative z-10 container mx-auto px-6 max-w-6xl text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        Ready to Find Your Ideal Local Sponsor?
      </h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">
        Contact us today and let our experts match you with the right sponsor for your business.
      </p>
      <a href="/contact-us/" class="inline-block bg-primary text-white font-bold px-10 py-4 rounded hover:opacity-90 transition">
        Contact Us Now
      </a>
    </div>
  </section>

</Base>
