---
import Base from '../layouts/Base.astro';

const services = [
  { title: 'Corporate Sponsorship', desc: 'We connect your business with the ideal local sponsor. They represent your interests effectively in dealings with the government.', icon: '/images/2024/12/Coporate-Sponsorship-icon-v2.webp', href: '/corporate-sponsorship/' },
  { title: 'Licensing', desc: 'Companies and entrepreneurs get guidance on obtaining the necessary licenses. Launch and operate your business ventures in the UAE.', icon: '/images/2024/12/Licensing-icon-v2.webp', href: '/licensing/' },
  { title: 'Outsourcing Services', desc: "With Al Buraq's outsourcing solutions, businesses avoid the challenges of visa restrictions and manpower shortages. Smooth operations are a guarantee.", icon: '/images/2024/12/Outsourcing-icon-v2.webp', href: '/outsourcing/' },
  { title: 'Business Center', desc: 'The fully equipped offices give your business a professional presence in the UAE. Offering substantial benefits over traditional leased office spaces.', icon: '/images/2024/12/Business-Center-icon-v2.webp', href: '/business-center/' },
];

const features = [
  { title: 'Best Location', desc: "Your registered business address, designed to elevate your company's professional image and provide a credible presence in the market." },
  { title: 'Unique Licenses', desc: 'With 18 years in the market, we have the privilege of helping foreign entrepreneurs obtain unique licenses that are typically not available to them.' },
  { title: 'Premium Customer Care', desc: 'A single point of contact: A dedicated manager, specially trained to speak your preferred language and communicate according to your time zone.' },
  { title: 'Ideal Local Sponsor', desc: 'A local sponsor with the expertise, industry knowledge, and reputation to represent your business effectively with the government.' },
];

const testimonials = [
  { name: 'Christian Gonzales', photo: '/images/2024/12/Testimonial2.webp', text: 'Worked with Al Buraq Group for our local business sponsorship needs. Their team expertly matched us with a local sponsor who understood our vision. We experienced smooth communication with government entities. All thanks to their deep market knowledge!' },
  { name: 'Laura Hill', photo: '/images/2024/12/Testimonial5.webp', text: 'Al Buraq taught me that, while around the world we rely on large consulting and legal firms to get things done, the UAE is different. Here, to make things happen, you turn to corporate sponsorship companies.' },
  { name: 'Anderson Moreo', photo: '/images/2024/12/Testimonial7.webp', text: 'Our partnership with Al Buraq, which has now grown into a true friendship, spans over 15 years. While the UAE has evolved and laws have changed, their level of service quality and the range of solutions they offer have remained consistently excellent.' },
];

const stats = [
  { number: '700+', label: 'Clients and special relationships' },
  { number: '130+', label: 'Experts driving the company\'s success' },
  { number: '18+',  label: 'Years of Excellence & Expertise' },
  { number: '3',    label: 'Locations in the GCC' },
];

const clientLogos = [
  { src: '/images/2024/12/AGCNET-logo-gray.png', alt: 'AGCNET' },
  { src: '/images/2024/12/Bombardier-logo-gray.png', alt: 'Bombardier' },
  { src: '/images/2024/12/Brand-Rex-logo-gray.png', alt: 'Brand Rex' },
  { src: '/images/2024/12/Dialight-logo-gray.png', alt: 'Dialight' },
  { src: '/images/2024/12/Glanbia-logo-gray.png', alt: 'Glanbia' },
  { src: '/images/2024/12/Lockheed-martin-logo-gray.png', alt: 'Lockheed Martin' },
  { src: '/images/2024/12/Nether-Locks-logo-gray.png', alt: 'Nether Locks' },
  { src: '/images/2024/12/Omkar-logo-gray.png', alt: 'Omkar' },
  { src: '/images/2024/12/Roamware-logo-gray.png', alt: 'Roamware' },
  { src: '/images/2024/12/SBI-logo-gray.png', alt: 'SBI' },
  { src: '/images/2024/12/Toshiba-logo-gray.png', alt: 'Toshiba' },
  { src: '/images/2024/12/Wood-Mackenzie-logo-gray.png', alt: 'Wood Mackenzie' },
  { src: '/images/2024/12/bausch-lomb-logo-gray.png', alt: 'Bausch + Lomb' },
  { src: '/images/2024/12/brinks-logo-gray.png', alt: 'Brinks' },
  { src: '/images/2024/12/esaar-logo-gray.png', alt: 'Esaar' },
  { src: '/images/2024/12/varian-medical-systems-logo-gray.png', alt: 'Varian Medical' },
];
---

<Base
  title="Corporate Business Solutions in UAE | Al Buraq"
  description="Al Buraq offers tailored corporate business solutions in the UAE. Transform your business challenges into growth opportunities."
>

  <!-- ── HERO ── White BG left, Dubai photo right -->
  <section class="relative overflow-hidden bg-white min-h-[560px]">
    <!-- Desktop: right half = Dubai photo -->
    <div class="hidden lg:block absolute right-0 top-0 bottom-0 w-1/2">
      <img
        src="/images/2024/12/SECTION-HERO-HOME-PAGE-DUBAI.webp"
        alt="Dubai business district"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <!-- gradient blend left edge -->
      <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-white to-transparent"></div>
    </div>

    <!-- Mobile: full background image -->
    <div class="lg:hidden absolute inset-0">
      <img src="/images/2024/12/SECTION-HERO-HOME-MOBILE.webp" alt="" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-white/70"></div>
    </div>

    <div class="relative z-10 container-site py-24 lg:py-28">
      <div class="max-w-[580px]">
        <h1 class="text-[42px] lg:text-[60px] font-heading font-bold text-dark leading-[1.4] mb-6">
          A Trusted Leader in Corporate Business Solutions &amp; Corporate Sponsorship Services
        </h1>
        <p class="text-dark text-xl font-body leading-relaxed mb-8">
          From providing innovative corporate business solutions to helping our clients build successful enterprises, we assist in achieving their long-term goals and objectives.
        </p>

        <!-- Approved by -->
        <div class="flex items-center gap-4 mb-8">
          <span class="text-xs font-ui font-semibold uppercase tracking-widest text-muted">Approved by</span>
          <img src="/images/2024/12/Ministry-of-Economy-73pxv2.webp" alt="Ministry of Economy UAE" class="h-9 w-auto" loading="eager" />
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <a href="/contact-us/" class="btn-primary">Contact Us Now</a>
          <a href="/contact-us/#book" class="btn-outline">Book a Meeting</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CLIENT LOGOS ── -->
  <section class="py-10 bg-light border-y border-[#d8d8d8]">
    <div class="container-site">
      <div class="flex flex-wrap justify-center items-center gap-8 lg:gap-12">
        {clientLogos.map((logo) => (
          <img src={logo.src} alt={logo.alt} class="h-7 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition" loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <!-- ── SERVICES ── White BG, cards with icon on red square -->
  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="text-center mb-14">
        <h2 class="text-[32px] lg:text-[48px] font-heading font-bold text-dark mb-4">Our Professional Services</h2>
        <p class="text-dark font-body text-base max-w-2xl mx-auto leading-relaxed">
          Customized solutions designed, directing companies to achieve their goals and grow their Dubai businesses.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((s) => (
          <a href={s.href} class="group bg-white border border-[#E9E9E9] hover:border-primary hover:shadow-md transition-all flex flex-col">
            <div class="bg-primary p-3 self-start m-5 mb-0">
              <img src={s.icon} alt={s.title} class="w-10 h-10 object-contain brightness-0 invert" loading="lazy" />
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="text-base font-heading font-bold text-dark mb-2 group-hover:text-primary transition-colors">{s.title}</h3>
              <p class="text-sm font-body text-muted leading-relaxed flex-1">{s.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WANT TO LEARN MORE banner ── -->
  <section class="py-10 bg-light">
    <div class="container-site text-center">
      <p class="text-dark font-body text-base">
        Want to learn more? We'll show you how we can help your business succeed and grow in the UAE!
      </p>
    </div>
  </section>

  <!-- ── ABOUT / TRANSFORMING ── -->
  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img src="/images/2024/12/general-image1-1-1.webp" alt="Al Buraq team" class="w-full object-cover" loading="lazy" />
        </div>
        <div>
          <h2 class="text-[32px] lg:text-[40px] font-heading font-bold text-dark mb-2">Transforming Ambitions</h2>
          <h2 class="text-[32px] lg:text-[40px] font-heading font-bold text-muted mb-6">into Reality</h2>
          <p class="text-dark font-body leading-relaxed mb-4">
            We've successfully created a business hub that tackles the challenges faced by UAE, Qatar, and Saudi Arabian companies. Al Buraq's dedicated team is committed to your success. From offering expert guidance, to local insights, we stand with a vast network of connections.
          </p>
          <p class="text-dark font-body leading-relaxed mb-8">
            Our premium services are a surety of compliance in a business environment. Enabling clients to achieve ambitious goals that many others might consider out of reach. Choose us for our proven track record, corporate business solutions, and unwavering support – your success is our top priority.
          </p>
          <a href="/about-us/" class="btn-primary">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── ABOUT TEXT SECTION ── -->
  <section class="py-20 bg-light">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="text-[32px] font-heading font-bold text-dark mb-2">About US</h2>
          <p class="text-dark font-body leading-relaxed mb-4">
            Al Buraq is a leading name in corporate business services, licensing, outsourcing, and business center solutions. Catering clients across the UAE, Qatar, and Saudi Arabia. Successfully operating with 18 years of experience, Al Buraq UAE has earned a solid reputation for delivering expert services.
          </p>
          <p class="text-dark font-body leading-relaxed">
            Businesses get instant assistance and avoid the complexities of these time-to-time changing markets. The ultimate corporate services provider is here to support your business's growth and success in the region.
          </p>
        </div>
        <div>
          <h3 class="text-xl font-heading font-bold text-dark mb-8">It's not just services; it's the value they bring.</h3>
          <p class="text-muted font-body text-sm mb-8">
            At Al Buraq Group, we focus on delivering not just services, but real value to your business.
          </p>
          <div class="grid grid-cols-2 gap-6">
            {features.map((f) => (
              <div>
                <h4 class="font-heading font-bold text-dark text-sm mb-2">{f.title}</h4>
                <p class="text-muted font-body text-xs leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS ── -->
  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="text-center mb-14">
        <h2 class="text-[28px] lg:text-[36px] font-heading font-bold text-dark">
          They've given us the opportunity to share their valued perspective
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {testimonials.map((t) => (
          <div class="border border-[#E9E9E9] p-8 flex flex-col">
            <p class="text-dark font-body text-[18px] leading-[1.4] flex-1 mb-6 italic">"{t.text}"</p>
            <div class="flex items-center gap-3">
              <img src={t.photo} alt={t.name} class="w-[50px] h-[50px] rounded-full object-cover" loading="lazy" />
              <span class="font-heading font-bold text-dark text-[22px]">{t.name}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── QUOTE BANNER ── -->
  <section class="py-10 bg-dark">
    <div class="container-site text-center">
      <p class="text-white font-body text-base">Business is not just about profit, but about creativity and patience.</p>
    </div>
  </section>

  <!-- ── STATS ── Dark navy BG -->
  <section class="py-20 bg-dark">
    <div class="container-site">
      <div class="text-center mb-14">
        <p class="text-[#E9E9E9] font-body text-sm mb-3">Take a look at</p>
        <h2 class="text-[32px] lg:text-[48px] font-heading font-bold text-white mb-4">
          18 Years of Experience, Measured in Numbers
        </h2>
        <p class="text-[#BABABA] font-body max-w-2xl mx-auto">
          What you see are numbers, but they represent valuable lessons, countless hours of hard work, and an unwavering commitment to achieving perfection.
        </p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {stats.map((s) => (
          <div>
            <div class="text-[60px] font-heading font-bold text-primary leading-none mb-2">{s.number}</div>
            <div class="text-[#BABABA] font-body text-sm leading-snug">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CONTACT CTA ── Dark navy BG -->
  <section class="py-20 bg-dark">
    <div class="container-site text-center">
      <p class="text-[#E9E9E9] font-body text-sm mb-3">Take the next step towards success.</p>
      <p class="text-white font-body text-lg mb-10 max-w-xl mx-auto">
        <span class="text-primary font-body">Complete the application form</span> and schedule your personalized consultation today!
      </p>
      <a href="/contact-us/" class="btn-primary">Submit Message</a>
    </div>
  </section>

</Base>
