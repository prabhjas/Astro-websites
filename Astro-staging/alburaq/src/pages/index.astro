---
import Base from '../layouts/Base.astro';

const services = [
  { title: 'Corporate Sponsorship', desc: 'We connect your business with the ideal local sponsor. They represent your interests effectively in dealings with the government.', icon: '/images/2024/12/Coporate-Sponsorship-icon-v2.webp', href: '/corporate-sponsorship/' },
  { title: 'Licensing', desc: 'Companies and entrepreneurs get guidance on obtaining the necessary licenses. Launch and operate your business ventures in the UAE.', icon: '/images/2024/12/Licensing-icon-v2.webp', href: '/licensing/' },
  { title: 'Outsourcing Services', desc: "With Al Buraq's outsourcing solutions, businesses avoid the challenges of visa restrictions and manpower shortages. Smooth operations are a guarantee.", icon: '/images/2024/12/Outsourcing-icon-v2.webp', href: '/outsourcing/' },
  { title: 'Business Center', desc: 'The fully equipped offices give your business a professional presence in the UAE. Offering substantial benefits over traditional leased office spaces.', icon: '/images/2024/12/Business-Center-icon-v2.webp', href: '/business-center/' },
];

const features = [
  { title: 'Best Location', desc: 'Your registered business address, designed to elevate your company\'s professional image and provide a credible presence in the market.', img: '/images/2024/12/IMAGE-11.webp' },
  { title: 'Unique Licenses', desc: 'With 18 years in the market, we have the privilege of helping foreign entrepreneurs obtain unique licenses that are typically not available to them.', img: '/images/2024/12/IMAGE-2-1.webp' },
  { title: 'Premium Customer Care', desc: 'A single point of contact: A dedicated manager, specially trained to speak your preferred language and communicate according to your time zone.', img: '/images/2024/12/IMAGE-3.webp' },
  { title: 'Ideal Local Sponsor', desc: 'A local sponsor with the expertise, industry knowledge, and reputation to represent your business effectively with the government.', img: '/images/2024/12/IMAGE-4-1.webp' },
];

const testimonials = [
  { name: 'Christian Gonzales', photo: '/images/2024/12/Testimonial2.webp', text: 'Worked with Al Buraq Group for our local business sponsorship needs. Their team expertly matched us with a local sponsor who understood our vision. We experienced smooth communication with government entities. All thanks to their deep market knowledge!' },
  { name: 'Laura Hill', photo: '/images/2024/12/Testimonial5.webp', text: 'Al Buraq taught me that, while around the world we rely on large consulting and legal firms to get things done, the UAE is different. Here, to make things happen, you turn to corporate sponsorship companies.' },
  { name: 'Anderson Moreo', photo: '/images/2024/12/Testimonial7.webp', text: 'Our partnership with Al Buraq, which has now grown into a true friendship, spans over 15 years. While the UAE has evolved and laws have changed, their level of service quality and the range of solutions they offer have remained consistently excellent.' },
];

const stats = [
  { number: '700+', label: 'Clients and special relationships' },
  { number: '130+', label: 'Experts driving the company\'s success' },
  { number: '18+', label: 'Years of Excellence & Expertise' },
  { number: '3', label: 'Locations in the GCC' },
];

const clientLogos = [
  { src: '/images/2024/12/AGCNET-logo-gray.png', alt: 'AGCNET' },
  { src: '/images/2024/12/Bombardier-logo-gray.png', alt: 'Bombardier' },
  { src: '/images/2024/12/Brand-Rex-logo-gray.png', alt: 'Brand Rex' },
  { src: '/images/2024/12/Dialight-logo-gray.png', alt: 'Dialight' },
  { src: '/images/2024/12/Glanbia-logo-gray.png', alt: 'Glanbia' },
  { src: '/images/2024/12/Lockheed-martin-logo-gray.png', alt: 'Lockheed Martin' },
  { src: '/images/2024/12/Nether-Locks-logo-gray.png', alt: 'Nether Locks' },
  { src: '/images/2024/12/Omkar-logo-gray.png', alt: 'Omkar' },
  { src: '/images/2024/12/Roamware-logo-gray.png', alt: 'Roamware' },
  { src: '/images/2024/12/SBI-logo-gray.png', alt: 'SBI' },
  { src: '/images/2024/12/Toshiba-logo-gray.png', alt: 'Toshiba' },
  { src: '/images/2024/12/Wood-Mackenzie-logo-gray.png', alt: 'Wood Mackenzie' },
  { src: '/images/2024/12/bausch-lomb-logo-gray.png', alt: 'Bausch + Lomb' },
  { src: '/images/2024/12/brinks-logo-gray.png', alt: 'Brinks' },
  { src: '/images/2024/12/esaar-logo-gray.png', alt: 'Esaar' },
  { src: '/images/2024/12/varian-medical-systems-logo-gray.png', alt: 'Varian Medical' },
];
---

<Base
  title="Corporate Business Solutions in UAE | Al Buraq"
  description="Al Buraq offers tailored corporate business solutions in the UAE. Transform your business challenges into growth opportunities."
>

  <!-- ═══════════════════════════════════════════
       HERO — white left half, Dubai photo right
       WP: elementor-6070903 / padding 6rem top 12rem bottom
       ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white">
    <!-- Right half: Dubai photo (desktop only) -->
    <div class="hidden lg:block absolute right-0 top-0 bottom-0 w-1/2">
      <img
        src="/images/2024/12/SECTION-HERO-HOME-PAGE-DUBAI.webp"
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
      />
      <!-- Gradient that blends photo into white on left edge -->
      <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-white to-transparent"></div>
    </div>

    <!-- Mobile: full background image -->
    <div class="lg:hidden absolute inset-0">
      <img src="/images/2024/12/SECTION-HERO-HOME-MOBILE.webp" alt="" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-white/80"></div>
    </div>

    <!-- Content (left half on desktop, full width on mobile) -->
    <div class="relative z-10 container-site">
      <div class="lg:w-1/2 py-24 lg:pt-24 lg:pb-48 pr-0 lg:pr-12">
        <h1 class="font-heading font-bold text-[60px] leading-[1.4] text-dark mb-5">
          A Trusted Leader in Corporate Business Solutions &amp; Corporate Sponsorship Services
        </h1>
        <p class="font-body text-[20px] leading-[1.4] text-dark mb-8">
          From providing innovative corporate business solutions to helping our clients build successful enterprises, we assist in achieving their long-term goals and objectives.
        </p>

        <!-- Approved by -->
        <div class="flex items-center gap-5 mb-8">
          <div class="border-r border-black pr-5">
            <p class="font-body text-[15px] text-dark">Approved by</p>
          </div>
          <img src="/images/2024/12/Ministry-of-Economy-73pxv2.webp" alt="Ministry of Economy UAE" class="h-9 w-auto" loading="eager" />
        </div>

        <!-- CTAs — WP: red button + transparent/black border button -->
        <div class="flex flex-wrap gap-0">
          <a href="/contact-us/" class="inline-block bg-primary text-white font-body text-sm px-6 py-[15px] border border-primary hover:bg-red-700 hover:border-red-700 transition-colors">
            Contact Us Now
          </a>
          <a href="/contact-us/#book" class="inline-block bg-transparent text-dark font-body text-sm px-6 py-[15px] border border-dark hover:bg-dark hover:text-white transition-colors">
            Book a Meeting
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       SERVICES — WP: elementor-0e6899f
       White bg, 4rem padding, icon-box left-aligned
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-white">
    <div class="container-site">

      <!-- Two-line heading: faint top + bold bottom -->
      <div class="mb-14">
        <p class="text-center font-heading font-bold text-[32px] text-dark opacity-[0.15] leading-none">Know our</p>
        <h2 class="text-center font-heading font-bold text-[48px] text-dark leading-[1.4]">Our Professional Services</h2>
        <p class="text-center font-body text-[16px] text-dark leading-[1.4] mt-3 max-w-2xl mx-auto">
          Customized solutions designed, directing companies to achieve their goals and grow their Dubai businesses.
        </p>
      </div>

      <!-- 4 service cards — left-aligned icon + text, border #E9E9E9 -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((s) => (
          <a href={s.href} class="group bg-white border border-[#E9E9E9] p-8 flex gap-[15px] hover:border-primary hover:shadow-md transition-all">
            <img src={s.icon} alt={s.title} class="w-14 h-14 object-contain flex-shrink-0" loading="lazy" />
            <div>
              <h3 class="font-heading font-semibold text-[24px] leading-[1.4] text-dark mb-2 group-hover:text-primary transition-colors">{s.title}</h3>
              <p class="font-body text-[16px] leading-[1.4] text-muted">{s.desc}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- "See All Services" pill -->
      <div class="text-center mt-8">
        <a href="/contact-us/" class="inline-block font-body text-[16px] text-dark px-6 py-1.5 rounded-full bg-white shadow-[0_0_10px_0_rgba(0,0,0,0.25)]">
          Explore Our Services
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       ABOUT ROW 1 — text left, image right
       WP: elementor-cee558d / padding 4rem / gap 50px
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-[50px] items-center">
        <!-- Text -->
        <div>
          <p class="font-heading font-bold text-[32px] text-dark opacity-[0.15] leading-none">About Us</p>
          <h2 class="font-heading font-bold text-[48px] leading-[1.4] text-dark">Transforming Ambitions into Reality</h2>
          <p class="font-body text-[16px] leading-[1.4] text-dark mt-2">
            We've successfully created a business hub that tackles the challenges faced by UAE, Qatar, and Saudi Arabian companies.
            Al Buraq's dedicated team is committed to your success. From offering expert guidance to local insights, we stand with
            a vast network of connections.
          </p>
          <p class="font-body text-[16px] leading-[1.4] text-dark mt-4">
            Our premium services are a surety of compliance in a business environment. Enabling clients to achieve ambitious goals
            that many others might consider out of reach. Choose us for our proven track record, corporate business solutions, and
            unwavering support – your success is our top priority.
          </p>
          <a href="/about-us/" class="btn-primary mt-8 inline-block">Learn More About Us</a>
        </div>
        <!-- Image -->
        <div>
          <img src="/images/2024/12/general-image1-1-1.webp" alt="Al Buraq team" class="w-full object-cover rounded-[2px]" loading="lazy" />
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       ABOUT ROW 2 — image left, text right
       WP: elementor-5f1a1d4 / padding 4rem / gap 50px
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-white border-t border-[#E9E9E9]">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-[50px] items-center">
        <!-- Image -->
        <div>
          <img src="/images/2024/12/general-image1-2.webp" alt="Al Buraq solutions" class="w-full object-cover rounded-[2px]" loading="lazy" />
        </div>
        <!-- Text -->
        <div>
          <p class="font-heading font-bold text-[32px] text-dark opacity-[0.15] leading-none">What We Do</p>
          <h2 class="font-heading font-bold text-[48px] leading-[1.4] text-dark">Empowering Your Business in the UAE</h2>
          <p class="font-body text-[16px] leading-[1.4] text-dark mt-2">
            Our mission is to empower foreign companies to gain greater control over their UAE, Qatar and Saudi Arabia business operations.
            Through our corporate nominee partnership service, we help mitigate risks associated with local company laws.
          </p>
          <p class="font-body text-[16px] leading-[1.4] text-dark mt-4">
            Al Buraq's dedicated team of 130+ experts delivers premium services ensuring compliance in a complex business environment,
            enabling clients to achieve ambitious goals with confidence.
          </p>
          <a href="/contact-us/" class="btn-primary mt-8 inline-block">Contact Us Now</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       FEATURE CARDS — 4 tall photo cards with red labels
       WP: elementor-e665f05 / 4 cols / padding-top:20rem / red box at bottom
       ═══════════════════════════════════════════ -->
  <section class="bg-white">
    <div class="container-site">
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {features.map((f) => (
          <div class="relative overflow-hidden" style={`background-image:url('${f.img}'); background-size:cover; background-position:center;`}>
            <!-- Spacer to give height -->
            <div class="pt-[280px] lg:pt-[320px]"></div>
            <!-- Red label box at bottom -->
            <div class="bg-primary p-[10px]">
              <h3 class="font-heading font-semibold text-[24px] leading-[1.4] text-white">{f.title}</h3>
              <p class="font-body text-[16px] leading-[1.4] text-white">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       CLIENT LOGOS — WP: elementor-12f134a / 7 cols / border-right #E4E9F3
       ═══════════════════════════════════════════ -->
  <section class="py-8 bg-white border-y border-[#E4E9F3]">
    <div class="container-site">
      <div class="flex flex-wrap justify-center items-center">
        {clientLogos.map((logo) => (
          <div class="border-r border-[#E4E9F3] px-6 py-3 last:border-r-0">
            <img src={logo.src} alt={logo.alt} class="h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       TESTIMONIALS — WP: elementor-11aa355
       white bg cards with border #E9E9E9, carousel on WP (we do 3-col grid)
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-white">
    <div class="container-site">
      <h2 class="text-center font-heading font-bold text-[48px] leading-[1.4] text-dark pb-12">
        They've given us the opportunity to share their valued perspective
      </h2>

      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="bg-white border border-[#E9E9E9] p-8 flex flex-col">
            <p class="font-body text-[18px] leading-[1.4] text-dark flex-1 mb-8">"{t.text}"</p>
            <div class="flex items-center gap-4">
              <img src={t.photo} alt={t.name} class="w-[50px] h-[50px] rounded-full object-cover" loading="lazy" />
              <div>
                <p class="font-heading font-bold text-[22px] text-dark">{t.name}</p>
                <p class="font-body text-[14px] text-muted">Verified Client</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       STATS — WP: elementor-9140fe0 / bg #1F232B / padding 4rem
       Heading + 4 stat boxes with right borders
       ═══════════════════════════════════════════ -->
  <section class="bg-dark py-16">
    <div class="container-site">
      <!-- Heading above stats -->
      <div class="text-center mb-10">
        <h2 class="font-heading font-bold text-[48px] leading-[1.4] text-white py-2">
          18 Years of Experience, Measured in Numbers
        </h2>
        <p class="font-body text-[16px] leading-[1.4] text-white">
          What you see are numbers, but they represent valuable lessons, countless hours of hard work,
          and an unwavering commitment to achieving perfection.
        </p>
      </div>

      <!-- Stat boxes — right border between items -->
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {stats.map((s, i) => (
          <div class={`text-center px-8 py-8 ${i < stats.length - 1 ? 'border-r border-[#E9E9E9]/30' : ''}`}>
            <p class="font-['Roboto',sans-serif] font-semibold text-[60px] leading-[1.4] text-primary">{s.number}</p>
            <p class="font-body text-[20px] leading-[1.4] text-white">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       BOTTOM CTA — WP: elementor-8578fc7
       Left 50% = IMAGE-CONTACT-US-1.webp
       Right 50% = dark bg #1F232B, white text + form
       ═══════════════════════════════════════════ -->
  <section class="bg-white">
    <div class="grid lg:grid-cols-2 min-h-[400px]">
      <!-- Left: Contact image -->
      <div class="relative min-h-[300px] lg:min-h-0">
        <img
          src="/images/2024/12/IMAGE-CONTACT-US-1.webp"
          alt="Contact Al Buraq"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      </div>

      <!-- Right: Dark box with text -->
      <div class="bg-dark p-[50px] flex flex-col justify-center">
        <h2 class="font-body font-bold text-[38px] leading-[1.2] text-white mb-4">
          Take the next step towards success.
        </h2>
        <p class="font-ui font-medium text-[18px] leading-[1.2] text-white mb-8 pb-4">
          Complete the application form and schedule your personalized consultation today!
        </p>
        <a href="/contact-us/" class="btn-primary self-start">Contact Us Now</a>
      </div>
    </div>
  </section>

</Base>
