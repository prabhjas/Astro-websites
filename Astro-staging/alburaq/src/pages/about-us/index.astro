---
import Base from '../../layouts/Base.astro';

const timeline = [
  { year: '2006', title: 'Founded', desc: 'Al Buraq Group was established in Dubai, UAE, with a mission to empower foreign companies.' },
  { year: '2010', title: 'Regional Expansion', desc: 'Extended services to Qatar and Saudi Arabia, becoming a true GCC corporate solutions provider.' },
  { year: '2015', title: '500+ Clients', desc: 'Reached a milestone of 500 clients across industries — from SMEs to multinational corporations.' },
  { year: '2020', title: 'Digital Transformation', desc: 'Launched digital service delivery and expanded payroll outsourcing capabilities across the GCC.' },
  { year: '2024', title: '18 Years Strong', desc: 'Over 700 clients, 130+ experts, 3 GCC locations. Continuing to lead in corporate business solutions.' },
];

const values = [
  { title: 'Integrity', desc: 'We operate with full transparency and honesty in every client relationship and business dealing.' },
  { title: 'Expertise', desc: '18+ years of deep market knowledge that turns complex regulatory challenges into smooth business journeys.' },
  { title: 'Commitment', desc: 'Your success is our measure of success. We go beyond service delivery to become your long-term partner.' },
  { title: 'Innovation', desc: 'Continuously evolving our solutions to meet the changing legal and business landscape of the GCC region.' },
];

const testimonials = [
  {
    name: 'Christian Gonzales',
    photo: '/images/2024/12/Testimonial2.webp',
    text: 'Worked with Al Buraq Group for our local business sponsorship needs. Their team expertly matched us with a local sponsor who understood our vision. We experienced smooth communication with government entities. All thanks to their deep market knowledge!',
  },
  {
    name: 'Laura Hill',
    photo: '/images/2024/12/Testimonial5.webp',
    text: 'Al Buraq taught me that, while around the world we rely on large consulting and legal firms to get things done, the UAE is different. Here, to make things happen, you turn to corporate sponsorship companies.',
  },
  {
    name: 'Anderson Moreo',
    photo: '/images/2024/12/Testimonial7.webp',
    text: 'Our partnership with Al Buraq, which has now grown into a true friendship, spans over 15 years. While the UAE has evolved and laws have changed, their level of service quality and the range of solutions they offer have remained consistently excellent.',
  },
];

const stats = [
  { number: '700+', label: 'Clients & Special Relationships' },
  { number: '130+', label: 'Experts Driving Success' },
  { number: '18+',  label: 'Years of Excellence' },
  { number: '3',    label: 'GCC Locations' },
];
---

<Base
  title="About Us - Al Buraq | 18 Years of Corporate Business Solutions in UAE"
  description="With over 18 years of experience, Al Buraq Group is one of the longest-standing and most trusted names in corporate sponsorship and business solutions in the UAE."
>

  <!-- Hero -->
  <section class="relative bg-secondary overflow-hidden">
    <img
      src="/images/2024/12/About-us-Background.webp"
      alt="About Al Buraq Group"
      class="absolute inset-0 w-full h-full object-cover opacity-30"
    />
    <div class="relative z-10 container mx-auto px-6 max-w-6xl py-24 lg:py-32 text-center">
      <span class="text-primary text-sm font-semibold uppercase tracking-widest mb-4 block">Our Company</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">About Us</h1>
      <p class="text-gray-300 text-xl max-w-3xl mx-auto leading-relaxed">
        With over 18 years of experience, we are one of the longest-standing and most trusted names in the corporate sponsorship services industry.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-10">
        <a href="/contact-us/" class="bg-primary text-white font-semibold px-8 py-3.5 rounded hover:opacity-90 transition">
          Contact Us Now
        </a>
        <a href="/contact-us/#book" class="border-2 border-white text-white font-semibold px-8 py-3.5 rounded hover:bg-white hover:text-secondary transition">
          Book a Meeting
        </a>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-sm font-semibold uppercase tracking-widest text-primary mb-3 block">Our Mission</span>
          <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-6">
            Empowering Foreign Companies in the GCC
          </h2>
          <p class="text-muted leading-relaxed mb-4">
            Our mission is to empower foreign companies to gain greater control over their UAE, Qatar and Saudi Arabia business operations. Through our corporate nominee partnership service, we help mitigate risks associated with local company laws.
          </p>
          <p class="text-muted leading-relaxed mb-4">
            We've successfully created a business hub that tackles the challenges faced by companies entering the GCC market. Al Buraq's dedicated team is committed to your success — from offering expert guidance and local insights, we stand with a vast network of connections.
          </p>
          <p class="text-muted leading-relaxed mb-8">
            Our premium services ensure compliance in a complex business environment, enabling clients to achieve ambitious goals that many others might consider out of reach.
          </p>
          <a href="/contact-us/" class="inline-block bg-primary text-white font-semibold px-8 py-3.5 rounded hover:opacity-90 transition">
            Get Started
          </a>
        </div>
        <div>
          <img
            src="/images/2024/12/general-image1-2.webp"
            alt="Al Buraq mission"
            class="w-full rounded-2xl shadow-xl object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-20 bg-secondary relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="/images/2024/12/background-all-servicesv2.webp" alt="" class="w-full h-full object-cover" aria-hidden="true" />
    </div>
    <div class="relative z-10 container mx-auto px-6 max-w-6xl">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {stats.map((s) => (
          <div>
            <div class="text-5xl font-bold text-primary mb-2">{s.number}</div>
            <div class="text-gray-400 text-sm leading-snug">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-14">
        <span class="text-sm font-semibold uppercase tracking-widest text-primary mb-3 block">What We Stand For</span>
        <h2 class="text-3xl md:text-4xl font-bold text-secondary">Our Core Values</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((v) => (
          <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 hover:border-primary hover:shadow-md transition-all">
            <h3 class="font-bold text-secondary text-lg mb-3">{v.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-secondary">
          They've given us the opportunity to share their valued perspective
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {testimonials.map((t) => (
          <div class="bg-gray-50 rounded-xl p-8 flex flex-col">
            <svg class="w-8 h-8 text-primary mb-4 opacity-50" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            <p class="text-muted leading-relaxed flex-1 mb-6 italic">"{t.text}"</p>
            <div class="flex items-center gap-3">
              <img src={t.photo} alt={t.name} class="w-12 h-12 rounded-full object-cover" loading="lazy" />
              <span class="font-semibold text-secondary">{t.name}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-primary">
    <div class="container mx-auto px-6 max-w-6xl text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        Business is not just about profit, but about creativity and patience.
      </h2>
      <a href="/contact-us/" class="inline-block bg-white text-primary font-bold px-10 py-4 rounded hover:bg-secondary hover:text-white transition">
        Contact Us Now
      </a>
    </div>
  </section>

</Base>
