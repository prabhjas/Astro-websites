---
import Base from '../../layouts/Base.astro';

const values = [
  { title: 'Expertise', desc: '18+ years navigating UAE business regulations — we bring deep, current knowledge to every client engagement.' },
  { title: 'Integrity', desc: 'Transparent agreements, honest advice, and no hidden fees. What we promise, we deliver.' },
  { title: 'Dedication', desc: 'A dedicated account manager for each client, available in your preferred language and time zone.' },
  { title: 'Results', desc: 'Our success is measured by your success. 700+ clients trust us to deliver measurable business outcomes.' },
];

const stats = [
  { number: '700+', label: 'Clients Served' },
  { number: '130+', label: 'Team Members' },
  { number: '18+', label: 'Years of Experience' },
  { number: '3', label: 'GCC Locations' },
];
---

<Base title="About Al Buraq Group | Corporate Business Solutions UAE" description="Learn about Al Buraq — 18+ years of corporate business solutions in the UAE, Qatar, and Saudi Arabia. Trusted by 700+ clients worldwide.">

  <section class="relative bg-dark overflow-hidden">
    <img src="/images/2024/12/background-all-servicesv2.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
    <div class="relative z-10 container-site py-24 lg:py-32">
      <div class="max-w-2xl">
        <span class="text-primary text-xs font-ui font-semibold uppercase tracking-widest mb-4 block">Our Story</span>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">About Al Buraq Group</h1>
        <p class="text-[#BABABA] text-xl font-body leading-relaxed">A leading corporate business solutions provider with 18 years of excellence in the UAE, Qatar, and Saudi Arabia.</p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <img src="/images/2024/12/general-image1-1-1.webp" alt="Al Buraq team" class="w-full shadow-xl object-cover" loading="lazy" />
        </div>
        <div>
          <span class="text-xs font-ui font-semibold uppercase tracking-widest text-primary mb-3 block">Who We Are</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-6">Transforming Ambitions into Reality</h2>
          <p class="text-muted font-body leading-relaxed mb-4">Al Buraq is a leading name in corporate business services, licensing, outsourcing, and business center solutions, catering to clients across the UAE, Qatar, and Saudi Arabia.</p>
          <p class="text-muted font-body leading-relaxed mb-4">Successfully operating for 18+ years, Al Buraq has earned a solid reputation for delivering expert services that enable businesses to thrive in these dynamic markets.</p>
          <p class="text-muted font-body leading-relaxed mb-8">We've created a business hub that tackles the real challenges faced by companies entering or expanding in the GCC. Our dedicated team of 130+ experts is committed to your long-term success.</p>
          <a href="/contact-us/" class="btn-primary">Work With Us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-dark">
    <div class="container-site">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {stats.map((s) => (
          <div>
            <div class="text-[60px] font-heading font-bold text-primary leading-none mb-2">{s.number}</div>
            <div class="text-[#BABABA] font-body text-sm">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-light">
    <div class="container-site">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4">Our Core Values</h2>
        <p class="text-muted font-body text-lg max-w-2xl mx-auto">The principles that guide everything we do for our clients.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((v) => (
          <div class="bg-white p-6 border border-[#E9E9E9] text-center">
            <div class="bg-primary w-10 h-1 mx-auto mb-4"></div>
            <h3 class="font-heading font-bold text-dark mb-2">{v.title}</h3>
            <p class="text-muted font-body text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-dark text-center">
    <div class="container-site">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">Ready to Grow Your Business in the UAE?</h2>
      <p class="text-[#BABABA] font-body text-lg mb-10 max-w-xl mx-auto">Join 700+ businesses that trust Al Buraq to navigate the UAE business landscape.</p>
      <a href="/contact-us/" class="btn-primary">Get in Touch</a>
    </div>
  </section>

</Base>
