# C-01-REFRESH-SCHEMA: named-internal-manual-v1
# /etc/caddy — production fleet Caddyfile (Aug 2026)
#
# THIS FILE IS THE LIVE SERVER TARGET. Install as /etc/caddy/Caddyfile
# (or keep in sync with whatever is currently live on 178.105.150.67).
#
# Source of truth in git: caddy/Caddyfile.production
# How to add a site: docs/CONNECT-CADDY-DEPLOYMENT.md
#
# Cloudflare SSL mode must be Full (not Flexible). Origin uses named CA astro_origin_2026 (payroll uses payroll_origin_isolated_2026).
# Validate before reloading:
#   sudo -u caddy caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# Sites in this file (ports): Evolution 5080, CBSS 5081, SP Heavy 5082, Iberia 5083,
# Connect HR 5084, Connect Group 5085, Connect FM 5087, Connect Resources SA 5088,
# Iberia EOR 5089, EOR Middle East 5090, Connect Staff 5091, C-UAE 5092, KinzaHR 5093,
# Connect FZ 5096, Royal Visa 5097, Connect Resources INT 5098.
# Deploy snippets also live under Astro-production/<domain>/deploy/.

{
	# The service is intentionally unprivileged. Cloudflare Full does not need
	# Caddy's private origin CA installed in the host-wide OS trust store.
	skip_install_trust

	# Cloudflare is the public HTTP/3 edge. Keep the origin on mature TCP-based
	# HTTP/1.1 and HTTP/2, reducing exposed protocol surface and UDP listeners.
	servers {
		protocols h1 h2
	}
	auto_https ignore_loaded_certs
	pki {
		ca astro_origin_2026 {
			name "Astro Origin Authority 2026"
			root_cn "Astro Origin Authority 2026 ECC Root"
			intermediate_cn "Astro Origin Authority 2026 ECC Intermediate"
		}
		ca payroll_origin_isolated_2026 {
			name "Payroll Origin Isolated Authority 2026"
			root_cn "Payroll Origin Isolated Authority 2026 ECC Root"
			intermediate_cn "Payroll Origin Isolated Authority 2026 ECC Intermediate"
		}
	}
}

# Astro production fleet. Each domain proxies the complete request surface to
# its loopback-only Node service, including pages, client assets and /api/*.
# Cloudflare terminates public TLS; origin hop uses named CA + paired manual cert loaders.
# Cloudflare SSL mode must be Full, not Flexible. Bare hostnames enable HTTP→HTTPS redirects.
#
# Validate before reloading:
#   sudo -u caddy caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy

# Collapse HTTP requests on alternate hostnames directly to the canonical HTTPS
# URL in one permanent redirect. This avoids an HTTP -> HTTPS -> canonical-host
# chain while preserving the full path and query string.
http://evolutionmiddleast.com, http://www.cbss.ae, http://www.spheavyrental.ae, http://www.iberiaworkforce.com, http://www.connecthr.ae, http://www.connectgroup.co, http://www.connectfm.ae, http://www.connectresources.sa, http://www.iberiaeor.com, http://www.eormiddleast.com, http://www.connectstaff.ae, http://www.c-uae.com, http://www.kinzahr.com, http://www.connectfz.com, http://www.royalvisa.ae, http://connectresourcesint.com, http://www.connectresources.ae, http://www.connectfreelance.ae, http://www.redo.ae, http://www.thefreelancergate.com, http://www.ngmanpower.com, http://www.emiratiguard.com, http://www.emiratisationgate.org, http://www.emiratisationgateway.com, http://www.freelancerdxb.com, http://payrollmiddleast.org, http://www.pittant.com, http://www.peomiddleast.com, http://www.kpmpro.ae, http://www.mbs-consultancy.com, http://www.connectzone.ae, http://www.movey.ae, http://www.emiratisationhub.com, http://www.companyformationsaudi.com, http://www.alburaq.ae, http://www.saudicompanyformation.com, http://www.snapsale.ae {
	@evolution host evolutionmiddleast.com
	redir @evolution https://www.evolutionmiddleast.com{uri} permanent

	@cbss host www.cbss.ae
	redir @cbss https://cbss.ae{uri} permanent

	@spheavyrental host www.spheavyrental.ae
	redir @spheavyrental https://spheavyrental.ae{uri} permanent

	@iberiaworkforce host www.iberiaworkforce.com
	redir @iberiaworkforce https://iberiaworkforce.com{uri} permanent

	@connecthr host www.connecthr.ae
	redir @connecthr https://connecthr.ae{uri} permanent

	@connectgroup host www.connectgroup.co
	redir @connectgroup https://connectgroup.co{uri} permanent

	@connectfm host www.connectfm.ae
	redir @connectfm https://connectfm.ae{uri} permanent

	@connectresources_sa host www.connectresources.sa
	redir @connectresources_sa https://connectresources.sa{uri} permanent

	@iberiaeor host www.iberiaeor.com
	redir @iberiaeor https://iberiaeor.com{uri} permanent

	@eormiddleast host www.eormiddleast.com
	redir @eormiddleast https://eormiddleast.com{uri} permanent

	@connectstaff host www.connectstaff.ae
	redir @connectstaff https://connectstaff.ae{uri} permanent

	@cuae host www.c-uae.com
	redir @cuae https://c-uae.com{uri} permanent

	@kinzahr host www.kinzahr.com
	redir @kinzahr https://kinzahr.com{uri} permanent

	@connectfz host www.connectfz.com
	redir @connectfz https://connectfz.com{uri} permanent

	@royalvisa host www.royalvisa.ae
	redir @royalvisa https://royalvisa.ae{uri} permanent

	@connectresourcesint host connectresourcesint.com
	redir @connectresourcesint https://www.connectresourcesint.com{uri} permanent

	@connectresources_ae host www.connectresources.ae
	redir @connectresources_ae https://connectresources.ae{uri} permanent

	@connectfreelance host www.connectfreelance.ae
	redir @connectfreelance https://connectfreelance.ae{uri} permanent

	@redo host www.redo.ae
	redir @redo https://redo.ae{uri} permanent

	@thefreelancergate host www.thefreelancergate.com
	redir @thefreelancergate https://thefreelancergate.com{uri} permanent

	@ngmanpower host www.ngmanpower.com
	redir @ngmanpower https://ngmanpower.com{uri} permanent

	@emiratiguard host www.emiratiguard.com
	redir @emiratiguard https://emiratiguard.com{uri} permanent

	@emiratisationgate host www.emiratisationgate.org
	redir @emiratisationgate https://emiratisationgate.org{uri} permanent

	@emiratisationgateway host www.emiratisationgateway.com
	redir @emiratisationgateway https://emiratisationgateway.com{uri} permanent

	@freelancerdxb host www.freelancerdxb.com
	redir @freelancerdxb https://freelancerdxb.com{uri} permanent

	# payrollmiddleast.org is www-canonical (apex -> www), unlike its neighbours.
	@payrollmiddleast host payrollmiddleast.org
	redir @payrollmiddleast https://www.payrollmiddleast.org{uri} permanent

	@pittant host www.pittant.com
	redir @pittant https://pittant.com{uri} permanent

	@peomiddleast host www.peomiddleast.com
	redir @peomiddleast https://peomiddleast.com{uri} permanent

	@kpmpro host www.kpmpro.ae
	redir @kpmpro https://kpmpro.ae{uri} permanent
	@mbs host www.mbs-consultancy.com
	redir @mbs https://mbs-consultancy.com{uri} permanent

	@connectzone host www.connectzone.ae
	redir @connectzone https://connectzone.ae{uri} permanent

	@movey host www.movey.ae
	redir @movey https://movey.ae{uri} permanent

	@emiratisationhub host www.emiratisationhub.com
	redir @emiratisationhub https://emiratisationhub.com{uri} permanent

	@companyformationsaudi host www.companyformationsaudi.com
	redir @companyformationsaudi https://companyformationsaudi.com{uri} permanent

	@alburaq host www.alburaq.ae
	redir @alburaq https://alburaq.ae{uri} permanent

	@saudicompanyformation host www.saudicompanyformation.com
	redir @saudicompanyformation https://saudicompanyformation.com{uri} permanent

	@snapsale host www.snapsale.ae
	redir @snapsale https://snapsale.ae{uri} permanent
}

# evolutionmiddleast.com -> evolutionmiddleast.service
evolutionmiddleast.com, www.evolutionmiddleast.com {
	tls force_automate {
		issuer internal {
			ca astro_origin_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/evolutionmiddleast.com/evolutionmiddleast.com.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/evolutionmiddleast.com/evolutionmiddleast.com.key
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.evolutionmiddleast.com/www.evolutionmiddleast.com.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.evolutionmiddleast.com/www.evolutionmiddleast.com.key
	encode zstd gzip

	# Canonical host follows PUBLIC_SITE_URL for consistent SEO signals.
	@noncanonical host evolutionmiddleast.com
	redir @noncanonical https://www.evolutionmiddleast.com{uri} permanent

	reverse_proxy 127.0.0.1:5080

	@static path_regexp static \.(css|js|woff|woff2|webp|jpg|jpeg|png|gif|svg|ico|avif|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/evolutionmiddleast.com-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}

