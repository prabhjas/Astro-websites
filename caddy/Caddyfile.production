	# Fail closed for every current or future API not explicitly carved into
	# the secretless lane above. Those routes remain on the attested backend.
	@trusted_api path /api /api/ /api/*
	handle @trusted_api {
		reverse_proxy 127.0.0.1:5094
	}

	# Caddy owns the only redirect permitted in the presentation lane. This
	# keeps every response generated by developer code from redirecting users.
	@frontend_needs_slash {
		method GET HEAD
		not path /
		not path */
		not path *.*
	}
	handle @frontend_needs_slash {
		redir {path}/?{query} permanent
	}

	# The trusted middleware owns WordPress resized-image fallback redirects.
	# Existing variants still receive the old status-aware media cache class.
	@wp_thumbnail_variant {
		method GET HEAD
		path_regexp wp_thumbnail_variant ^/wp-content/uploads/.*-\d+x\d+\.(?:jpe?g|png|gif|webp|avif)$
	}
	handle @wp_thumbnail_variant {
		reverse_proxy 127.0.0.1:5094 {
			@ok status 200
			handle_response @ok {
				header {
					defer
					Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
				}
				copy_response
			}
		}
	}

