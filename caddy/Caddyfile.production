		# M-08: deny device APIs these marketing sites never use. Autoplay and
		# fullscreen are deliberately NOT restricted (hero video / galleries).
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		X-Permitted-Cross-Domain-Policies none
	}
	log {
		output file /var/log/caddy/snapsale.ae-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
