		-Server
		-Via
		Content-Security-Policy "object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://dev.connectfreelance.ae https://fonts.googleapis.com; font-src 'self' data: https://dev.connectfreelance.ae https://fonts.gstatic.com; img-src 'self' data: blob: https://arumjournal.com https://dev.connectfreelance.ae https://hoyonline.tv https://i.ytimg.com https://secure.gravatar.com https://www.google-analytics.com https://www.googletagmanager.com https://www.signaturesalonstudios.com; connect-src 'self' https://api.stripe.com https://region1.google-analytics.com https://www.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://js.stripe.com https://maps.google.com https://www.googletagmanager.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		X-Permitted-Cross-Domain-Policies none
	}
	handle_errors {
		header {
			-Server
			-Via
			Cache-Control "no-store"
			Content-Type "text/plain; charset=utf-8"
			Content-Security-Policy "object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			Referrer-Policy no-referrer
			Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
			X-Permitted-Cross-Domain-Policies none
		}
		respond "Service unavailable" {err.status_code}
	}
	log {
		output file /var/log/caddy/connectfreelance.ae-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}

# redo.ae -> redo.service
redo.ae, www.redo.ae {
	tls force_automate {
		issuer internal {
			ca astro_origin_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/redo.ae/redo.ae.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/redo.ae/redo.ae.key
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.redo.ae/www.redo.ae.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.redo.ae/www.redo.ae.key
	encode zstd gzip

	@noncanonical host www.redo.ae
	redir @noncanonical https://redo.ae{uri} permanent

	# Cache policy is status-aware: long lifetimes are only ever attached to a
	# 200 response, so a missing or failed asset can no longer be pinned at the
	# edge (M-01). Only content-hashed build output is "immutable"; unversioned
	# assets stay revalidatable so a deploy actually reaches returning visitors.
	@astro_hashed path /_astro/*
	handle @astro_hashed {
		reverse_proxy 127.0.0.1:5095 {
			@ok status 200
			handle_response @ok {
				header {
					defer
					Cache-Control "public, max-age=31536000, immutable"
				}
				copy_response
			}
		}
	}

	@static_media path_regexp static_media \.(woff|woff2|ttf|otf|webp|jpg|jpeg|png|gif|svg|ico|avif)$
	handle @static_media {
		reverse_proxy 127.0.0.1:5095 {
			@ok status 200
			handle_response @ok {
				header {
					defer
					Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
				}
				copy_response
			}
		}
	}

	@static_code path_regexp static_code \.(css|js|mjs)$
	handle @static_code {
		reverse_proxy 127.0.0.1:5095 {
			@ok status 200
			handle_response @ok {
				header {
					defer
					Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
				}
				copy_response
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:5095
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
