# connectfreelance.ae split: trusted secret backend + secretless presentation
connectfreelance.ae, www.connectfreelance.ae {
	tls force_automate {
		issuer internal {
			ca astro_origin_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/connectfreelance.ae/connectfreelance.ae.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/connectfreelance.ae/connectfreelance.ae.key
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.connectfreelance.ae/www.connectfreelance.ae.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.connectfreelance.ae/www.connectfreelance.ae.key
	encode zstd gzip

	# Root, not candidate code, maps public route suffixes to response MIME.
	# Unknown suffixes are presentation HTML; API handlers override to JSON.
	map {path} {front_content_type} {
		~(?i)\.css$ "text/css; charset=utf-8"
		~(?i)\.(?:js|mjs)$ "text/javascript; charset=utf-8"
		~(?i)\.json$ "application/json; charset=utf-8"
		~(?i)\.xml$ "application/xml; charset=utf-8"
		~(?i)\.txt$ "text/plain; charset=utf-8"
		~(?i)\.pdf$ application/pdf
		~(?i)\.(?:jpg|jpeg)$ image/jpeg
		~(?i)\.png$ image/png
		~(?i)\.gif$ image/gif
		~(?i)\.webp$ image/webp
		~(?i)\.avif$ image/avif
		~(?i)\.svg$ image/svg+xml
		~(?i)\.ico$ image/x-icon
		~(?i)\.woff2$ font/woff2
		~(?i)\.woff$ font/woff
		~(?i)\.ttf$ font/ttf
		~(?i)\.otf$ font/otf
		default "text/html; charset=utf-8"
	}

	# Reject non-origin targets which Caddy exposes to this host route, plus path
	# forms whose normalization can change ownership. Caddy normalizes absolute
	# form before host routing; the pinned Cloudflare/firewall boundary covers
	# that explicitly documented ingress residual. The wrapper repeats the path
	# checks for direct-UDS/canary defense in depth.
	@non_origin_target not vars_regexp origin_form {http.request.orig_uri} ^/
	handle @non_origin_target {
		header Cache-Control "no-store"
		respond "Bad request" 400
	}
	@ambiguous_path vars_regexp raw_ambiguous {http.request.orig_uri} `(?i)^(?://|[^?]*(?:%25|%2f|%5c|%2e|%3b|%0[0-9a-f]|%1[0-9a-f]|%7f|\\|//|;|(?:^|/)\.{1,2}(?:/|$)))`
	handle @ambiguous_path {
		header Cache-Control "no-store"
		respond "Bad request" 400
	}

	# Root-owned denies execute before either application. These framework and
	# retired UI surfaces are not used by the reviewed presentation release.
	@edge_deny path /_image /_image/ /_image/* /_server-islands /_server-islands/* /internal /internal/*
	handle @edge_deny {
		header Cache-Control "no-store"
		respond "Not found" 404
	}

	# V1 freezes runtime redirect mutation while presentation bypasses the
	# backend redirect middleware. A root verifier also requires zero rules.
	@redirect_mutation_frozen {
		method POST
		path /api/internal/redirects/save /api/internal/redirects/save/
		path /api/internal/redirects/delete /api/internal/redirects/delete/
		path /api/internal/redirects/bulk-delete /api/internal/redirects/bulk-delete/
		path /api/internal/redirects/import /api/internal/redirects/import/
	}
	handle @redirect_mutation_frozen {
		header Cache-Control "no-store"
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":"redirects_locked","message":"Redirect changes are frozen during the secretless presentation pilot."}` 423
	}

	# Canonical-host redirection follows the raw-target, framework, and
	# redirect-mutation guards so the alias cannot bypass those root decisions.
	@noncanonical host www.connectfreelance.ae
	handle @noncanonical {
		redir https://connectfreelance.ae{uri} permanent
	}

	# Secrets, state, PII, runtime configuration, SEO control files, geolocation,
	# and every reviewed redirect source remain on the manually attested backend.
	@trusted_backend {
		path /api/contact /api/contact/ /api/internal /api/internal/*
		path /api/geo/country /api/geo/country/
		path /runtime-gtm.js /runtime-gtm.js/
		path /robots.txt /robots.txt/ /sitemap_index.xml /sitemap_index.xml/
		path /page-sitemap.xml /page-sitemap.xml/ /post-sitemap.xml /post-sitemap.xml/
		path /llm.txt /llm.txt/ /llms.txt /llms.txt/
		path /about /about/ /contact /contact/ /blog /blog/ /home /home/
		path /index.php /index.php/ /health-insurance /health-insurance/
		path /services /services/ /become-a-partner /become-a-partner/
		path /freelance-visa-dubai /freelance-visa-dubai/ /insurance /insurance/
		path /author/jerryl-lance-alva /author/jerryl-lance-alva/
		path /author/desery-dandan /author/desery-dandan/
		path /author/jerryl /author/jerryl/
		path /https-connectfreelance-ae-freelance-business-ideas-to-launch-in-2023 /https-connectfreelance-ae-freelance-business-ideas-to-launch-in-2023/
	}
	handle @trusted_backend {
		reverse_proxy 127.0.0.1:5094
	}

	# Preserve Astro's current bare-API canonicalization without trusting a
	# candidate 3xx. Explicit query placeholders retain the original query.
	@frontend_api_read_bare {
		method GET HEAD
		path /api/blog/listing /api/blog/load-more /api/health
	}
	handle @frontend_api_read_bare {
		redir {path}/?{query} 301
	}
	@frontend_blog_post_bare {
		method POST
		path /api/blog/listing
	}
	handle @frontend_blog_post_bare {
		redir {path}/?{query} 308
	}

	# Blog listing is the sole public body-bearing frontend API. Its POST form
	# is exact-path, JSON-only and bounded. Load-more and health are read-only.
	@frontend_blog_read {
		method GET HEAD
		path /api/blog/listing /api/blog/listing/ /api/blog/load-more /api/blog/load-more/
	}
	handle @frontend_blog_read {
		header Cache-Control "no-store"
		request_header -X-*
		reverse_proxy 127.0.0.1:5094 {
			lb_policy first
			lb_try_duration 2s
			lb_try_interval 100ms
			fail_duration 30s
			max_fails 1
			header_up -Authorization
			header_up -Origin
			header_up -Referer
			header_up -CF-*
			header_up -CDN-Loop
			header_up -Sec-*
			header_up -Baggage
			header_up -DNT
			header_up -Early-Data
			header_up -Priority
			header_up -Traceparent
			header_up -Tracestate
			header_up -X-Auth-*
			header_up -X-Api-Key
			header_up -Cookie*
			header_up -Forwarded
			header_up -Proxy-*
			header_up -Via
			header_up -X-Internal-*
			header_up -X-Real-IP
			header_up -True-Client-IP
			header_up X-Forwarded-For 127.0.0.1
			header_up X-Forwarded-Host connectfreelance.ae
			header_up X-Forwarded-Proto https
			header_up Host connectfreelance.ae
			header_down -Accept-CH
			header_down -Accept-CH-Lifetime
			header_down -Access-Control-*
			header_down -Alt-Svc
			header_down -Authentication-Info
			header_down -Cache-Control
			header_down -CDN-Cache-Control
			header_down -Clear-Site-Data
			header_down -Content-Disposition
			header_down -Content-Security-Policy*
			header_down -Cross-Origin-*
			header_down -ETag
			header_down -Expires
			header_down -Last-Modified
			header_down -Link
			header_down -NEL
			header_down -Proxy-Authenticate
			header_down -Report-To
			header_down -Reporting-Endpoints
			header_down -WWW-Authenticate
			header_down -Location
			header_down -Permissions-Policy
			header_down -Referrer-Policy
			header_down -Refresh
			header_down -Server
			header_down -Set-Cookie*
			header_down -Strict-Transport-Security
			header_down -Surrogate-Control
			header_down -Timing-Allow-Origin
			header_down -Trailer
			header_down -Via
			header_down -X-Robots-Tag
			header_down -X-Accel-*
			header_down -X-Content-Type-Options
			header_down -X-Frame-Options
			header_down -X-Permitted-Cross-Domain-Policies
			header_down -X-Sendfile
			header_down -X-AspNet-*
			header_down -X-Powered-By
			header_down Content-Type "application/json; charset=utf-8"
			@upstream_redirect status 3xx
			handle_response @upstream_redirect {
				respond "Untrusted frontend redirect denied" 502
			}
		}
	}

	@frontend_blog_post {
		method POST
		path /api/blog/listing /api/blog/listing/
		header_regexp blog_json Content-Type `(?i)^application/json(?:[\t ]*;[\t ]*charset=(?:utf-8|utf8))?$`
	}
	handle @frontend_blog_post {
		request_body {
			max_size 65536
		}
		header Cache-Control "no-store"
		request_header -Origin
		request_header -X-*
		reverse_proxy 127.0.0.1:5094 {
			lb_policy first
			lb_try_duration 2s
			lb_try_interval 100ms
			fail_duration 30s
			max_fails 1
			header_up -Authorization
			header_up -Referer
			header_up -CF-*
			header_up -CDN-Loop
			header_up -Sec-*
