	redir @snapsale https://snapsale.ae{uri} permanent

}

# evolutionmiddleast.com -> evolutionmiddleast.service
evolutionmiddleast.com, www.evolutionmiddleast.com {
	tls force_automate {
		issuer internal {
			ca astro_origin_2026
			lifetime 120h
		}
	}
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/evolutionmiddleast.com/evolutionmiddleast.com.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/evolutionmiddleast.com/evolutionmiddleast.com.key
	tls /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.evolutionmiddleast.com/www.evolutionmiddleast.com.crt /var/lib/caddy/.local/share/caddy/certificates/astro_origin_2026/www.evolutionmiddleast.com/www.evolutionmiddleast.com.key
	encode zstd gzip

	# Canonical host follows PUBLIC_SITE_URL for consistent SEO signals.
	@noncanonical host evolutionmiddleast.com
	redir @noncanonical https://www.evolutionmiddleast.com{uri} permanent

	# Cache policy is status-aware: long lifetimes are only ever attached to a
	# 200 response, so a missing or failed asset can no longer be pinned at the
	# edge (M-01). Only content-hashed build output is "immutable"; unversioned
	# assets stay revalidatable so a deploy actually reaches returning visitors.
	@astro_hashed path /_astro/*
	handle @astro_hashed {
		reverse_proxy 127.0.0.1:5080 {
			@ok status 200
			handle_response @ok {
				header {
					defer
					Cache-Control "public, max-age=31536000, immutable"
				}
				copy_response
			}
		}
	}

	@static_media path_regexp static_media \.(woff|woff2|ttf|otf|webp|jpg|jpeg|png|gif|svg|ico|avif)$
	handle @static_media {
		reverse_proxy 127.0.0.1:5080 {
			@ok status 200
			handle_response @ok {
				header {
					defer
					Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
				}
				copy_response
			}
		}
	}

	@static_code path_regexp static_code \.(css|js|mjs)$
	handle @static_code {
		reverse_proxy 127.0.0.1:5080 {
			@ok status 200
			handle_response @ok {
				header {
					defer
					Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
				}
				copy_response
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:5080
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# M-08: deny device APIs these marketing sites never use. Autoplay and
		# fullscreen are deliberately NOT restricted (hero video / galleries).
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		X-Permitted-Cross-Domain-Policies none
	}
	log {
		output file /var/log/caddy/evolutionmiddleast.com-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}

