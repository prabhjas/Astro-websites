https://iberiaworkforce.com, https://www.iberiaworkforce.com {
	# Serve HTTPS on 443 with Caddy's own self-signed cert so Cloudflare's
	# "Full" SSL mode can connect to the origin. Port 80 stays open too, so
	# "Flexible" mode also works. (For "Full (strict)" a Cloudflare Origin
	# Certificate is needed instead of this internal cert.)
